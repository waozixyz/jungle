#import, file "../../retro/language.zi";
// Spoken alphabet first, with optional illustrated word examples.
#import "app_context"
#import "app_protocol"
#import "geometry"
#import "number_text"
#import "std/format"
#import "text_align"
#import "text_buffer"
#import, file "abc_data.zi";
#import, file "abc_ladder.zi";
#import, file "abc_progress.zi";
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "../../retro/book_theme.zi";
#import, file "../../host/jungle_text.zi";

FONT :: "assets/jungle-book/font.png"
SOUNDS :: "assets/abc/sounds/"
abc_width: s32;
abc_height: s32;
abc_padding: s32;
abc_gap: s32;
learn_letter: s32;
learn_slot: s32;
simple: bool = true;
settings_loaded: bool;
ladder_loaded: bool;
last_language: s32 = -1;
voice_pending: bool;
examples: bool;
sequence_playing: bool;
letter_started: float64;
voice_idle_started: float64;
WordName :: (at: s32) -> string {
    if language == 1 { return WordName_de(at) }
    if language == 2 { return WordName_es(at) }
    return WordName_en(at)
}

WordVoice :: (at: s32) -> string {
    if language == 1 { return ifx simple then WordVoice_de_simple(at) else WordVoice_de_spelling(at) }
    if language == 2 { return ifx simple then WordVoice_es_simple(at) else WordVoice_es_spelling(at) }
    return ifx simple then WordVoice_en_simple(at) else WordVoice_en_spelling(at)
}

WordSeconds :: (at: s32) -> float64 {
    if language == 1 { return ifx simple then WordSeconds_de_simple(at) else WordSeconds_de_spelling(at) }
    if language == 2 { return ifx simple then WordSeconds_es_simple(at) else WordSeconds_es_spelling(at) }
    return ifx simple then WordSeconds_en_simple(at) else WordSeconds_en_spelling(at)
}

LetterWords :: (letter: s32) -> s32 { return LetterWordCount(language, letter) }

CurrentWord :: () -> s32 {
    count := LetterWords(learn_letter)
    if count == 0 { return -1 }
    if learn_slot >= count { learn_slot = 0 }
    return LetterWord(language, learn_letter, learn_slot)
}

// The word's letters, spaced apart, sit beside it in spelling mode.
SpacedLetters :: (word: string) -> string {
    text: Vec(u8)
    for at: cast(s64)0..word.count - 1 {
        code := word[at]
        if code >= #char "a" && code <= #char "z" { code = code - 32 }
        if at > 0 { unused VecPush(text, #char " ") }
        unused VecPush(text, code)
    }
    return BuilderFinish(text)
}

BigLetter :: (letter: s32) -> string {
    upper := LetterText(language, letter)
    if upper == "ß" { return upper }
    return Cat(upper, " ", LetterLower(language, letter))
}

// Hosts and keyboards deliver letters as either case; match both.
LetterForKey :: (key: s32) -> s32 {
    if key >= 97 && key <= 122 { key = key - 32 }
    if key < 65 || key > 90 { return -1 }
    for letter: cast(s32)0..LetterCount(language) - 1 {
        text := LetterText(language, letter)
        if text.count > 0 && text[0] == cast(u8)key { return letter }
    }
    return -1
}

Sound :: (name: string) { GameSound(Cat(SOUNDS, name, ".wav")) }

OpenLetter :: (letter: s32, speak: bool) {
    learn_letter = letter
    learn_slot = 0
    voice_pending = speak
    letter_started = retro.now
    voice_idle_started = 0.0
}

RefreshLanguage :: () {
    if language == last_language { return }
    last_language = language
    OpenLetter(0, true)
}

ResponsiveAbc :: (bounds: Rectangle) {
    abc_width = cast(s32)bounds.width
    abc_height = cast(s32)bounds.height
    fit := bounds.width / 320.0
    if bounds.height / 200.0 < fit { fit = bounds.height / 200.0 }
    abc_padding = cast(s32)(14.0 * fit) + 8
    if abc_padding < 24 { abc_padding = 24 }
    abc_gap = ifx abc_width < 600 || abc_height < 400 then 8 else 16
    retro.x = bounds.x
    retro.y = bounds.y
    retro.scale = 1.0
    BookPaperSized(abc_width, abc_height)
}

TouchButton :: (id: s32, x: s32, y: s32, width: s32, height: s32, text: string, selected: bool = false) -> bool {
    press := RetroTap(id, x, y, width, height, text)
    BookBox(x, y, width, height, ifx selected || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
        ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 8.0)
    font: s32 = ifx width < 160 then 14 else 18
    translated := Tr(text)
    while font > 10 && cast(s32)translated.count * font * 3 / 5 > width - 12 { font -= 1 }
    BookText(x + 6, y, width - 12, height, text, font)
    return press.clicked
}

// Balance complete rows across the whole page, rather than leaving the
// right half empty. Spanish N, Ñ, O stay next to each other.
StripMetrics :: (width: s32) -> (columns: s32, cell: s32, height: s32, used: s32) {
    count := LetterCount(language)
    columns := width / 42
    if columns > 15 { columns = 15 }
    if columns < 5 { columns = 5 }
    rows := (count + columns - 1) / columns
    if abc_height < 400 { rows = 1 }
    else { columns = (count + rows - 1) / rows }
    cell := (width - (columns - 1) * 6) / columns
    height: s32 = ifx abc_height < 400 then 28 else ifx abc_width < 360 then 30 else 42
    return columns, cell, height, rows * (height + 6) - 6
}

LetterStrip :: (x: s32, y: s32, width: s32) {
    columns, cell, height, _ := StripMetrics(width)
    first := ifx abc_height < 400 then (learn_letter / columns) * columns else 0
    last := ifx abc_height < 400 then first + columns else LetterCount(language)
    if last > LetterCount(language) { last = LetterCount(language) }
    for letter: first..last - 1 {
        at := letter - first
        bx := x + (at % columns) * (cell + 6)
        by := y + (at / columns) * (height + 6)
        press := RetroTap(100 + letter, bx, by, cell, height, LetterText(language, letter))
        selected := letter == learn_letter
        BookBox(bx, by, cell, height, ifx selected || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
            ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 7.0)
        BookText(bx, by, cell, height, LetterText(language, letter), height * 2 / 3)
        if press.clicked { sequence_playing = false; OpenLetter(letter, true) }
    }
}

MoveLetter :: (step: s32) {
    sequence_playing = false
    total := LetterCount(language)
    OpenLetter((learn_letter + step + total) % total, true)
}

ToggleSequence :: () {
    if sequence_playing { sequence_playing = false; return }
    examples = false
    sequence_playing = true
    OpenLetter(ifx learn_letter == LetterCount(language) - 1 then 0 else learn_letter, true)
}

// Stay on each letter for at least four seconds, including a quiet pause
// after its recording. A loading or playing recording never gets skipped.
AdvanceSequence :: () {
    if !sequence_playing || examples || voice_pending { return }
    state := AppService("jungle.voice-state", "")
    if state == "loading" || state == "playing" { voice_idle_started = 0.0; return }
    if voice_idle_started == 0.0 { voice_idle_started = retro.now }
    if retro.now - letter_started < 4.0 || retro.now - voice_idle_started < 1.5 { return }
    if learn_letter + 1 == LetterCount(language) { sequence_playing = false; return }
    OpenLetter(learn_letter + 1, true)
}

ExamplePanel :: (x: s32, y: s32, width: s32, height: s32) {
    word := CurrentWord()
    if word < 0 {
        BookText(x + 4, y, width - 8, height, "Try another letter", 16, TextAlign.TextAlignCenter, true, true)
        return
    }
    control: s32 = ifx abc_height < 400 || abc_width < 600 then 30 else 38
    footer := control
    label: s32 = ifx abc_height < 400 then 24 else ifx abc_width < 600 then 28 else 42
    spelling: s32 = ifx simple then 0 else ifx abc_height < 400 then 16 else 24
    edge := height - footer - label - spelling - 12
    if edge > width - 16 { edge = width - 16 }
    if edge < 20 { edge = 20 }
    picture_x := x + (width - edge) / 2
    picture_y := y + (height - footer - label - spelling - edge) / 2
    BookBox(picture_x, picture_y, edge, edge, 0xf7f1e3ff, 0xdacdb5ff, 10.0)
    BookPicture(WordScene(word), picture_x + 4, picture_y + 4, edge - 8, edge - 8)
    tap := RetroTap(210, picture_x, picture_y, edge, edge, WordName(word))
    if tap.clicked { voice_pending = true }
    font: s32 = ifx abc_width < 600 then 22 else 32
    name := WordName(word)
    while font > 12 && cast(s32)name.count * font * 3 / 5 > width - 8 { font -= 1 }
    BookText(x, picture_y + edge, width, label, name, font, TextAlign.TextAlignCenter, false)
    if !simple {
        BookText(x, picture_y + edge + label, width, spelling, SpacedLetters(name),
            ifx abc_width < 600 then 12 else 16, TextAlign.TextAlignCenter, false)
    }
    if TouchButton(32, x, y + height - footer, width, control, "Next example") {
        learn_slot = (learn_slot + 1) % LetterWords(learn_letter)
        voice_pending = true
    }
}

LearnView :: () {
    width := abc_width - abc_padding * 2
    control: s32 = ifx abc_height < 400 then 32 else 40
    mode_width := (width - abc_gap) / 2
    if TouchButton(20, abc_padding, abc_padding, mode_width, control, "Letters", !examples) && examples {
        examples = false; sequence_playing = true; OpenLetter(learn_letter, true)
    }
    if TouchButton(21, abc_padding + mode_width + abc_gap, abc_padding, mode_width, control, "Examples", examples) && !examples {
        examples = true; sequence_playing = false; OpenLetter(learn_letter, true)
    }
    _, _, _, strip_used := StripMetrics(width)
    strip_top := abc_height - abc_padding - strip_used
    LetterStrip(abc_padding, strip_top, width)
    transport_y := strip_top - abc_gap - control
    button := (width - abc_gap * 2) / 3
    if TouchButton(40, abc_padding, transport_y, button, control, "Previous") { MoveLetter(-1) }
    if TouchButton(41, abc_padding + button + abc_gap, transport_y, button, control,
        ifx sequence_playing then "Pause" else "Play", sequence_playing) { ToggleSequence() }
    if TouchButton(42, abc_padding + (button + abc_gap) * 2, transport_y, button, control, "Next") { MoveLetter(1) }
    top := abc_padding + control + abc_gap
    height := transport_y - abc_gap - top
    letter_width := ifx examples then (width - abc_gap) * 2 / 5 else width
    letter_height := ifx examples then height - control - 30 else height - 24
    font := letter_height * 2 / 3
    if font > letter_width * 2 / 5 { font = letter_width * 2 / 5 }
    if font < 24 { font = 24 }
    BookText(abc_padding, top, letter_width, letter_height, BigLetter(learn_letter), font, TextAlign.TextAlignCenter, false)
    tap := RetroTap(50, abc_padding, top, letter_width, letter_height, "Hear letter")
    if tap.clicked {
        unused AppService("jungle.voice", LetterVoice(language, learn_letter))
        voice_pending = false; letter_started = retro.now; voice_idle_started = 0.0
    }
    if examples {
        BookText(abc_padding, top + letter_height, letter_width, 22, "Tap to listen", 12, TextAlign.TextAlignCenter, true, true)
        if TouchButton(31, abc_padding, top + height - control, letter_width, control, "Spelling", !simple) {
            simple = !simple
            unused DocumentWrite("mode.txt", ifx simple then "simple" else "spelling")
            voice_pending = true
        }
        split := abc_padding + letter_width + abc_gap / 2
        BookBox(split, top, 1, height, 0xe5d9c3ff)
        ExamplePanel(split + abc_gap / 2, top, width - letter_width - abc_gap, height)
    } else {
        BookText(abc_padding, top + height - 24, width, 24, "Tap to listen", 14, TextAlign.TextAlignCenter, true, true)
    }
    if voice_pending {
        word := CurrentWord()
        unused AppService("jungle.voice", ifx examples && word >= 0 then WordVoice(word) else LetterVoice(language, learn_letter))
        voice_pending = false
    }
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        settings_loaded = false; ladder_loaded = false
        examples = false; sequence_playing = true
        voice_pending = true; voice_idle_started = 0.0
        learn_letter = 0; learn_slot = 0; last_language = -1
        AppIdentity("jungle.abc")
        AppDescribe("ABC Book", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx !ladder_loaded || AbcSave() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    if !settings_loaded { simple = DocumentRead("mode.txt") != "spelling"; settings_loaded = true }
    RetroBegin(AppSession(), AppBounds(), FONT, AppNow(), AppKey(), BLACK)
    ResponsiveAbc(AppBounds())
    RefreshLanguage()
    if !ladder_loaded { AbcLoad(); ladder_loaded = true }
    key := retro.key
    if key == KEY_ESCAPE { GameHome(); return 0 }
    if key == KEY_RIGHT { MoveLetter(1) }
    if key == KEY_LEFT { MoveLetter(-1) }
    if key == 32 { ToggleSequence() }
    if key == KEY_ENTER { voice_pending = true; letter_started = retro.now; voice_idle_started = 0.0 }
    letter := LetterForKey(key)
    if letter >= 0 { sequence_playing = false; OpenLetter(letter, true) }
    AdvanceSequence()
    LearnView()
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

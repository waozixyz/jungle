#import, file "../../retro/language.zi";
// Animal Counting: Animal Math's counting game. The eighteen native sprites
// sit in the original's fixed places, the ladder runs 4, 5, 6, 9, 12 and 18,
// six right answers move up, six misses move back, and the eighth right answer
// brings one of the original praises.
#import "app_context"
#import "app_protocol"
#import "geometry"
#import "number_text"
#import "text_buffer"
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "../../retro/book_theme.zi";
#import, file "counting.zi";
#import, file "counting_progress.zi";
#import, file "../../host/jungle_text.zi";

FONT :: "assets/animal-count/font.png"
SOUNDS :: "assets/animal-count/sounds/"
HOW_MANY :: "How many animals?"
YOU_GOT_IT :: "You got it!"
TRY_AGAIN :: "Try again!"
// Animal Math's eighteen counting places, exactly as in ANIMALS.PAS.
place_x: [18]s32 = .[164, 132, 132, 164, 100, 100, 132, 164, 100, 68, 68, 68, 36, 36, 36, 196, 196, 196];
place_y: [18]s32 = .[100, 100, 72, 72, 72, 100, 128, 128, 128, 100, 72, 128, 72, 100, 128, 72, 100, 128];
praises: [8]string = .[" GOOD JOB ", "   WOW    ", "  GREAT   ", "FANTASTIC ", "ALL RIGHT ", " TERRIFIC ", "  SUPER   ", " AWESOME  "];
typed: [2]u8;
typed_count: s32;
state_message: string = "";
state_until: float64 = -10.0;
praise_until: float64 = -10.0;
praise_word: string = "";
loaded: bool;
reward_started: float64;
reward_head: s32;

Join :: (a: string, b: string = "", c: string = "") -> string {
    text: Vec(u8)
    parts: [3]string = .[a, b, c]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Number :: (value: s32) -> string {
    digits: [24]u8
    return Join(FormatInteger(cast(s64)value, digits[:]))
}

Sound :: (name: string) { GameSound(Join(SOUNDS, name, ".wav")) }

NextNumber :: () {
    NextCount()
    typed_count = 0
    typed[0] = 0
    typed[1] = 0
}

animal_pictures: [18]string = .["tiger", "frog", "butterfly", "ladybug", "snail", "elephant",
    "giraffe", "monkey", "panda", "lion", "zebra", "crocodile", "parrot", "toucan", "rabbit", "cat", "dog", "sheep"];

ItemPath :: (which: s32) -> string {
    return Join("assets/animal-count/pictures/", animal_pictures[which % 18], ".png")
}

touch_key: s32;
keypad_labels: [12]string = .["1","2","3","4","5","6","7","8","9","<","0","OK"];

CountingView :: () {
    bounds := AppBounds()
    width := cast(s32)bounds.width
    height := cast(s32)bounds.height
    retro.x = bounds.x
    retro.y = bounds.y
    retro.scale = 1.0
    padding: s32 = ifx width < 600 then 12 else 24
    gap: s32 = 8
    portrait := height > width
    BookPalette()
    BookBox(0, 0, width, height, 0xfffcf3ff)
    if BookButton(30, padding, padding, 60, 44, "Menu") { GameHome() }
    BookText(padding + 70, padding, width - padding * 2 - 70, 44, HOW_MANY, 25)
    key_width := width - padding * 2
    key_height: s32 = 48
    key_x := padding
    key_y := height - padding - key_height * 4 - gap * 3
    animal_x := padding
    animal_y := padding + 60
    animal_width := width - padding * 2
    animal_height := key_y - animal_y - 70
    if !portrait {
        key_width = width / 3
        if key_width > 360 { key_width = 360 }
        if key_width < 230 { key_width = 230 }
        key_x = width - padding - key_width
        key_y = (height - key_height * 4 - gap * 3) / 2 + 40
        if key_y + key_height * 4 + gap * 3 > height - padding { key_y = height - padding - key_height * 4 - gap * 3 }
        animal_width = key_x - padding * 2
        animal_height = height - animal_y - padding - 30
    }
    if animal_height < 70 { animal_height = 70 }
    BookBox(animal_x, animal_y, animal_width, animal_height, 0xf7f1e3ff, 0xdacdb5ff, 8.0)
    columns: s32 = ifx portrait then 4 else 6
    rows := (number + columns - 1) / columns
    size := (animal_width - gap * 2) / columns
    fit := (animal_height - gap * 2) / rows
    if fit < size { size = fit }
    if size > 100 { size = 100 }
    for index: cast(s32)0..number - 1 {
        x := animal_x + (animal_width - columns * size) / 2 + (index % columns) * size
        y := animal_y + (animal_height - rows * size) / 2 + (index / columns) * size
        BookPicture(ItemPath(item), x + 3, y + 3, size - 6, size - 6)
    }
    answer := ifx typed_count > 0 then TextView(typed[:typed_count]) else "?"
    BookText(key_x, key_y - 56, key_width, 48, answer, 34)
    touch_key = 0
    button_width := (key_width - gap * 2) / 3
    for index: cast(s32)0..11 {
        x := key_x + (index % 3) * (button_width + gap)
        y := key_y + (index / 3) * (key_height + gap)
        press := RetroTap(320 + index, x, y, button_width, key_height, keypad_labels[index])
        BookBox(x, y, button_width, key_height, ifx press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0xdacdb5ff, 7.0)
        BookText(x, y, button_width, key_height, keypad_labels[index], 24)
        if press.clicked {
            touch_key = ifx index < 9 then 49 + index else ifx index == 9 then KEY_BACKSPACE else ifx index == 10 then 48 else KEY_ENTER
        }
    }
    if retro.now < state_until {
        BookText(animal_x, height - padding - 26, animal_width, 26, state_message, 18)
    }
}

CountingReward :: () {
    BookPaper()
    BookText(24, 19, 272, 30, praise_word, 21)
    BookPicture(ItemPath(reward_head), 110, 58, 100, 100)
    for index: cast(s32)0..7 {
        BookBox(119 + index * 11, 169, 5, 5, 0x2e6956ff, 0, 3.0)
    }
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        loaded = false
        state_until = -10.0
        praise_until = -10.0
        AppIdentity("jungle.animals")
        AppDescribe("Animal Counting", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx !loaded || CountSave() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    now := AppNow()
    if !loaded {
        CountLoad()
        random_state = cast(u32)(cast(u64)(now * 1000.0) & cast(u64)0x7fffffff) | cast(u32)1
        NextNumber()
        loaded = true
    }
    RetroBegin(AppSession(), AppBounds(), FONT, now, AppKey(), BLACK)
    if AppKey() == KEY_ESCAPE { GameHome(); return 0 }
    if now < praise_until { CountingReward(); return 0 }
    CountingView()
    key := ifx touch_key != 0 then touch_key else retro.key
    if key == KEY_ESCAPE { GameHome(); return 0 }
    if key >= 48 && key <= 57 && typed_count < 2 {
        typed[typed_count] = cast(u8)key
        typed_count += 1
    }
    if (key == 81 || key == 113) && typed_count < 2 {
        typed[typed_count] = #char "Q"
        typed_count += 1
    }
    if key == KEY_BACKSPACE && typed_count > 0 {
        typed_count -= 1
        typed[typed_count] = 0
    }
    if key == KEY_ENTER && typed_count > 0 && typed[0] == #char "Q" { GameHome(); return 0 }
    if key == KEY_ENTER && typed_count > 0 {
        answer: s32 = cast(s32)(typed[0] - #char "0")
        if typed_count == 2 { answer = answer * 10 + cast(s32)(typed[1] - #char "0") }
        if CountAnswer(answer) {
            state_message = YOU_GOT_IT
            state_until = retro.now + 1.0
            Sound(Join("right-", Number((count - 1) % 8)))
            if count % 8 == 0 {
                praise_word = praises[RandomNumber(8) - 1]
                reward_head = RandomNumber(18) - 1
                reward_started = now
                praise_until = now + 1.5
                Sound("reward")
            }
            NextNumber()
        } else {
            state_message = TRY_AGAIN
            state_until = retro.now + 1.5
            Sound("miss")
            typed_count = 0
            typed[0] = 0
            typed[1] = 0
        }
        unused CountSave()
    }
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

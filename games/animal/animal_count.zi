#import, file "../../retro/language.zi";
// Animal Counting: Animal Math's counting game, extended gently through twenty.
// six right answers move up, six misses move back, and the eighth right answer
// brings one of the original praises.
#import "app_context"
#import "app_protocol"
#import "geometry"
#import "number_text"
#import "text_buffer"
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "../../retro/book_theme.zi";
#import, file "counting.zi";
#import, file "counting_progress.zi";
#import, file "counting_layout.zi";
#import, file "counting_exercises.zi";
#import, file "../../host/jungle_text.zi";

FONT :: "assets/animal-count/font.png"
SOUNDS :: "assets/animal-count/sounds/"
HOW_MANY :: "How many animals?"
YOU_GOT_IT :: "You got it!"
TRY_AGAIN :: "Try again!"
praises: [8]string = .[" GOOD JOB ", "   WOW    ", "  GREAT   ", "FANTASTIC ", "ALL RIGHT ", " TERRIFIC ", "  SUPER   ", " AWESOME  "];
typed: [2]u8;
typed_count: s32;
state_message: string = "";
state_until: float64 = -10.0;
praise_until: float64 = -10.0;
praise_word: string = "";
loaded: bool;
reward_started: float64;
reward_head: s32;

Join :: (a: string, b: string = "", c: string = "") -> string {
    text: Vec(u8)
    parts: [3]string = .[a, b, c]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Number :: (value: s32) -> string {
    digits: [24]u8
    return Join(FormatInteger(cast(s64)value, digits[:]))
}

Sound :: (name: string) { GameSound(Join(SOUNDS, name, ".wav")) }

options: CountOptions;
exercise: CountExercise;

CountWords :: (en: string, de: string, es: string) -> string {
    return ifx language == 1 then de else ifx language == 2 then es else en
}

CountPrompt :: () -> string {
    if options.mode == COUNT_ADD { return CountWords("How many together?", "Wie viele zusammen?", "¿Cuántos en total?") }
    if options.mode == COUNT_SUBTRACT { return CountWords("How many stay?", "Wie viele bleiben?", "¿Cuántos quedan?") }
    return HOW_MANY
}

CountVoice :: (clip: string) {
    unused AppService("jungle.voice", Cat(SOUNDS, LanguageCode(), "/", clip, ".wav"))
}

CountSay :: () {
    if options.mode == COUNT_MODE {
        unused AppService("jungle.voice", Cat(SOUNDS, "question-", LanguageCode(), ".wav"))
    } else { CountVoice(ifx options.mode == COUNT_ADD then "add" else "subtract") }
}

CountSettingsSave :: () -> bool { return DocumentWrite("counting-options.txt", CountOptionsText(options)) }

NextNumber :: () {
    if options.mode == COUNT_MODE && options.limit == 0 {
        NextCount()
        exercise = CountExercise.{COUNT_MODE, number, 0, number}
    } else {
        exercise = CountExerciseNew(options.mode, options.limit, cast(s32)(RandomNext() & cast(u32)0x7fffffff))
        number = exercise.result
        item = RandomNumber(18) - 1
    }
    CountSay()
    typed_count = 0
    typed[0] = 0
    typed[1] = 0
}

animal_pictures: [18]string = .["tiger", "frog", "butterfly", "ladybug", "snail", "elephant",
    "giraffe", "monkey", "panda", "lion", "zebra", "crocodile", "parrot", "toucan", "rabbit", "cat", "dog", "sheep"];

ItemPath :: (which: s32) -> string {
    return Join("assets/animal-count/pictures/", animal_pictures[which % 18], ".png")
}

touch_key: s32;
keypad_labels: [12]string = .["1","2","3","4","5","6","7","8","9","<","0","OK"];

// The same groups of five serve counting, joining and animals leaving.
CountingGroups :: (amount: s32, x: s32, y: s32, width: s32, height: s32, leaving: bool = false) {
    layout := CountLayout(amount, x, y, width, height)
    for group: cast(s32)0..layout.groups - 1 {
        gx := layout.x + (group % layout.columns) * (layout.edge + layout.gap)
        gy := layout.y + (group / layout.columns) * (layout.edge + layout.gap)
        BookBox(gx, gy, layout.edge, layout.edge, ifx leaving then cast(u32)0xf1e9ddff else cast(u32)0xe9f0e3ff, 0xc8d7bdff, 6.0)
        size := CountGroupAmount(amount, group)
        for index: cast(s32)0..size - 1 {
            spot := CountSpot(size, index)
            inset := layout.cell / 12
            if inset < 1 { inset = 1 }
            px := gx + layout.inset + spot.x * layout.cell + inset
            py := gy + layout.inset + spot.y * layout.cell + inset
            edge := layout.cell - inset * 2
            BookPicture(ItemPath(item), px, py, edge, edge)
            if leaving { BookBox(px, py, edge, edge, 0xfffcf390) }
        }
    }
    if amount == 0 { BookBox(x + width / 4, y + height / 4, width / 2, height / 2, 0xe9f0e3ff, 0xc8d7bdff, 6.0) }
}

CountControls :: (width: s32, compact: bool) {
    bh: s32 = ifx compact then 18 else 30
    bw := (width - 48) / 3
    labels: [3]string = .[CountWords("Count", "Zählen", "Contar"), CountWords("Add · to 5", "Plus · bis 5", "Sumar · hasta 5"), CountWords("Subtract · to 5", "Minus · bis 5", "Restar · hasta 5")]
    for m: cast(s32)0..2 {
        if BookButton(400 + m, 20 + m * (bw + 4), 14, bw, bh, labels[m], options.mode == m) {
            options.mode = m
            unused CountSettingsSave()
            NextNumber()
            state_until = -10.0
        }
    }
    if options.mode == COUNT_MODE {
        ranges: [4]s32 = .[0,5,10,20]
        rw := (width - 52) / 4
        for r: cast(s32)0..3 {
            label := ifx r == 0 then CountWords("Auto", "Auto", "Auto") else Cat("1–", NumberText(ranges[r]))
            if BookButton(410 + r, 20 + r * (rw + 4), 18 + bh, rw, bh, label, options.limit == ranges[r]) {
                options.limit = ranges[r]
                unused CountSettingsSave()
                NextNumber()
                state_until = -10.0
            }
        }
    } else {
        BookText(20, 18 + bh, width - 40, bh, CountWords("Pictures · within 5", "Bilder · bis 5", "Dibujos · hasta 5"), 11)
    }
}

CountingView :: () {
    touch_key = 0
    bounds := AppBounds()
    portrait := bounds.height > bounds.width
    width: s32 = 320
    height: s32 = ifx portrait then 540 else 200
    scale := bounds.width / cast(float32)width
    if bounds.height / cast(float32)height < scale { scale = bounds.height / cast(float32)height }
    retro.scale = scale
    retro.x = bounds.x + (bounds.width - cast(float32)width * scale) / 2.0
    retro.y = bounds.y + (bounds.height - cast(float32)height * scale) / 2.0
    BookPaperSized(width, height)
    CountControls(width, !portrait)
    BookText(20, ifx portrait then 84 else 55, 280, 20, CountPrompt(), 14)
    ax: s32 = 20
    ay: s32 = ifx portrait then 110 else 79
    aw: s32 = ifx portrait then 280 else 190
    ah: s32 = ifx portrait then 190 else 72
    if options.mode == COUNT_MODE { CountingGroups(number, ax, ay, aw, ah) }
    else {
        half := (aw - 24) / 2
        first := ifx options.mode == COUNT_ADD then exercise.left else exercise.result
        CountingGroups(first, ax, ay, half, ah)
        BookText(ax + half, ay + ah / 2 - 12, 24, 24, ifx options.mode == COUNT_ADD then "+" else "→", 18)
        CountingGroups(exercise.right, ax + half + 24, ay, half, ah, options.mode == COUNT_SUBTRACT)
        if options.mode == COUNT_SUBTRACT {
            BookText(ax + half + 24, ay + ah - 12, half, 14, CountWords("Leaving", "Gehen weg", "Se van"), 8)
        }
    }
    kx: s32 = ifx portrait then 24 else 222
    ky: s32 = ifx portrait then 350 else 105
    kw: s32 = ifx portrait then 272 else 76
    kh: s32 = ifx portrait then 34 else 15
    gap: s32 = ifx portrait then 6 else 3
    answer := ifx typed_count > 0 then TextView(typed[:typed_count]) else "?"
    BookBox(kx, ky - 27, kw, 24, 0xfffcf3ff, 0xbba98bff, 4.0)
    BookText(kx, ky - 27, kw, 24, answer, 18)
    bw := (kw - gap * 2) / 3
    for index: cast(s32)0..11 {
        if BookButton(320 + index, kx + index % 3 * (bw + gap), ky + index / 3 * (kh + gap), bw, kh, keypad_labels[index]) {
            touch_key = ifx index < 9 then 49 + index else ifx index == 9 then KEY_BACKSPACE else ifx index == 10 then 48 else KEY_ENTER
        }
    }
    if retro.now < state_until { BookText(20, height - 43, ifx portrait then 280 else 190, 16, state_message, 10) }
    if BookButton(420, 20, height - 25, ifx portrait then 280 else 190, 17, CountWords("Hear again", "Noch einmal hören", "Escuchar otra vez")) { CountSay() }
}

CountingReward :: () {
    BookPaper()
    BookText(24, 19, 272, 30, praise_word, 21)
    BookPicture(ItemPath(reward_head), 110, 58, 100, 100)
    for index: cast(s32)0..7 {
        BookBox(119 + index * 11, 169, 5, 5, 0x2e6956ff, 0, 3.0)
    }
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        loaded = false
        state_until = -10.0
        praise_until = -10.0
        AppIdentity("jungle.animals")
        AppDescribe("Animal Counting", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx !loaded || (CountSave() && CountSettingsSave()) then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    now := AppNow()
    if !loaded {
        CountLoad()
        options = CountOptionsRead(DocumentRead("counting-options.txt"))
        random_state = cast(u32)(cast(u64)(now * 1000.0) & cast(u64)0x7fffffff) | cast(u32)1
        NextNumber()
        loaded = true
    }
    RetroBegin(AppSession(), AppBounds(), FONT, now, AppKey(), BLACK)
    if AppKey() == KEY_ESCAPE { GameHome(); return 0 }
    if now < praise_until { CountingReward(); return 0 }
    CountingView()
    key := ifx touch_key != 0 then touch_key else retro.key
    if key == KEY_ESCAPE { GameHome(); return 0 }
    if key >= 48 && key <= 57 && typed_count < 2 {
        typed[typed_count] = cast(u8)key
        typed_count += 1
    }
    if (key == 81 || key == 113) && typed_count < 2 {
        typed[typed_count] = #char "Q"
        typed_count += 1
    }
    if key == KEY_BACKSPACE && typed_count > 0 {
        typed_count -= 1
        typed[typed_count] = 0
    }
    if key == KEY_ENTER && typed_count > 0 && typed[0] == #char "Q" { GameHome(); return 0 }
    if key == KEY_ENTER && typed_count > 0 {
        answer: s32 = cast(s32)(typed[0] - #char "0")
        if typed_count == 2 { answer = answer * 10 + cast(s32)(typed[1] - #char "0") }
        // Fixed exercises share rewards/count totals, preserving Auto's exact ladder.
        saved_level := level; saved_right := right_run; saved_miss := miss_run
        correct := CountAnswer(answer)
        if options.mode != COUNT_MODE || options.limit != 0 {
            level = saved_level; right_run = saved_right; miss_run = saved_miss
        }
        if correct {
            state_message = YOU_GOT_IT
            state_until = retro.now + 1.0
            Sound(Join("right-", Number((count - 1) % 8)))
            if count % 8 == 0 {
                praise_word = praises[RandomNumber(8) - 1]
                reward_head = RandomNumber(18) - 1
                reward_started = now
                praise_until = now + 1.5
                Sound("reward")
            }
            NextNumber()
            if answer == 0 { CountVoice("zero") }
        } else {
            state_message = TRY_AGAIN
            state_until = retro.now + 1.5
            Sound("miss")
            typed_count = 0
            typed[0] = 0
            typed[1] = 0
        }
        unused CountSave()
    }
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

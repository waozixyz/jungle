// Preserve Jungle profiles while using Animal Math's original counting rules.
#import "app_context"
#import, file "counting.zi";
#import, file "../../host/jungle_text.zi";

CountSave :: () -> bool {
    return DocumentWrite("progress.txt", Cat("animal ", NumberText(level), " ", NumberText(count),
        " ", NumberText(right_run), " ", NumberText(miss_run), "\n"))
}

CountLoad :: () { CountProgressRead(DocumentRead("progress.txt")) }

// Parse the legacy record without changing its representation.
CountProgressRead :: (text: string) {
    if text.count < 7 || text[:7] != "animal " { return }
    at: s64 = 7
    values: [4]s32
    for field: cast(s32)0..3 {
        values[field] = ReadWhole(text, *at)
        if values[field] < 0 { return }
        if field < 3 && (at >= text.count || text[at] != #char " ") { return }
        at += 1
    }
    if values[0] < 1 || values[0] > MAX_LEVEL { return }
    level = values[0]
    count = values[1]
    right_run = ifx values[2] < 6 then values[2] else 0
    miss_run = ifx values[3] < 6 then values[3] else 0
}

page_paths :: (at: s32) -> string {
    if at < 48 { return page_paths_0[at - 0] }
    if at < 96 { return page_paths_48[at - 48] }
    if at < 144 { return page_paths_96[at - 96] }
    if at < 192 { return page_paths_144[at - 144] }
    if at < 240 { return page_paths_192[at - 192] }
    if at < 284 { return page_paths_240[at - 240] }
    return ""
}

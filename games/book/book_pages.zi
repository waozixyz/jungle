page_spelling_de :: (at: s32) -> string {
    if at < 48 { return page_spelling_de_0[at - 0] }
    if at < 96 { return page_spelling_de_48[at - 48] }
    if at < 144 { return page_spelling_de_96[at - 96] }
    if at < 192 { return page_spelling_de_144[at - 144] }
    if at < 240 { return page_spelling_de_192[at - 192] }
    if at < 288 { return page_spelling_de_240[at - 240] }
    if at < 336 { return page_spelling_de_288[at - 288] }
    if at < 384 { return page_spelling_de_336[at - 336] }
    if at < 432 { return page_spelling_de_384[at - 384] }
    if at < 435 { return page_spelling_de_432[at - 432] }
    return ""
}

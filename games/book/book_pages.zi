    if at < 48 { return page_spelling_es_0[at - 0] }
    if at < 96 { return page_spelling_es_48[at - 48] }
    if at < 144 { return page_spelling_es_96[at - 96] }
    if at < 192 { return page_spelling_es_144[at - 144] }
    if at < 240 { return page_spelling_es_192[at - 192] }
    if at < 284 { return page_spelling_es_240[at - 240] }
    return ""
}

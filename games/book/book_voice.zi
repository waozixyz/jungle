VoicePath_de_spelling :: (at: s32) -> string {
    if at < 48 { return voice_paths_de_spelling_0[at - 0] }
    if at < 96 { return voice_paths_de_spelling_48[at - 48] }
    if at < 144 { return voice_paths_de_spelling_96[at - 96] }
    if at < 192 { return voice_paths_de_spelling_144[at - 144] }
    if at < 240 { return voice_paths_de_spelling_192[at - 192] }
    if at < 288 { return voice_paths_de_spelling_240[at - 240] }
    if at < 336 { return voice_paths_de_spelling_288[at - 288] }
    if at < 384 { return voice_paths_de_spelling_336[at - 336] }
    if at < 432 { return voice_paths_de_spelling_384[at - 384] }
    if at < 435 { return voice_paths_de_spelling_432[at - 432] }
    return ""
}

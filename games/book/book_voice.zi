VoicePath_en_simple :: (at: s32) -> string {
    if at < 48 { return voice_paths_en_simple_0[at - 0] }
    if at < 96 { return voice_paths_en_simple_48[at - 48] }
    if at < 144 { return voice_paths_en_simple_96[at - 96] }
    if at < 192 { return voice_paths_en_simple_144[at - 144] }
    if at < 240 { return voice_paths_en_simple_192[at - 192] }
    if at < 284 { return voice_paths_en_simple_240[at - 240] }
    return ""
}

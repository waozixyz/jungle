#import, file "../../retro/language.zi";
// Picture Book: a category-first book that turns by itself. Each page is one
// watercolor scene with its word, and optional spelling, on top. Narration
// finishes before the next page; arrows, Enter, a tap or a swipe also turn pages.
#import "app_context"
#import "app_protocol"
#import "geometry"
#import "text_align"
#import "scroll_widget"
#import "scroll_props"
#import "tree"
#import "swipe"
#import "swipe_props"
#import, file "book_pages.zi";
#import, file "book_voice.zi";
#import, file "book_preferences.zi";
#import "number_text"
#import "text_buffer"
#import "byte_text_linux"
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "../../retro/book_theme.zi";

FONT :: "assets/jungle-book/font.png"
PAGE_SECONDS :: 12.0
page: s32;
page_started: float64;
choosing_category: bool = true;
finished: bool;
finished_started: float64;
category: s32;
book_scroll: s32;
book_tab: s32;
voice_idle_started: float64;
voice_pending: bool;
simple: bool = true;
settings_loaded: bool;
swipe_tracking: bool;
swipe_start: Vector2;
swipe_started: float64;
playing: bool = true;
repeat_all: bool = true;
playback_speed: s32 = 1;
paused_at: float64;
managing_books: bool;
SaveBookChoice :: (index: s32) {
    unused DocumentWrite(Join("hidden-", category_ids[index], ".txt"), ifx hidden_books[index] then "yes" else "no")
    unused DocumentWrite(Join("skip-", category_ids[index], ".txt"), ifx excluded_books[index] then "yes" else "no")
}

TogglePlayback :: () {
    playing = !playing
    if !playing { paused_at = retro.now }
    else {
        elapsed := retro.now - paused_at
        page_started += elapsed
        finished_started += elapsed
        if voice_idle_started > 0.0 { voice_idle_started += elapsed }
    }
    unused AppService("jungle.voice-control", ifx playing then "resume" else "pause")
}

Join :: (a: string, b: string = "", c: string = "") -> string {
    text: Vec(u8)
    parts: [3]string = .[a, b, c]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Number :: (value: s32) -> string {
    digits: [24]u8
    return Join(FormatInteger(cast(s64)value, digits[:]))
}

PageIndex :: () -> s32 { return category_starts[category] + page }
PageName :: () -> string {
    at := PageIndex()
    if language == 1 { return page_names_de(at) }
    if language == 2 { return page_names_es(at) }
    return page_names_en(at)
}
PageVoice :: () -> string {
    at := PageIndex()
    if language == 1 { return ifx simple then VoicePath_de_simple(at) else VoicePath_de_spelling(at) }
    if language == 2 { return ifx simple then VoicePath_es_simple(at) else VoicePath_es_spelling(at) }
    return ifx simple then VoicePath_en_simple(at) else VoicePath_en_spelling(at)
}
PageHold :: () -> float64 {
    at := PageIndex()
    duration: float64
    if language == 1 { duration = ifx simple then VoiceSeconds_de_simple(at) else VoiceSeconds_de_spelling(at) }
    else if language == 2 { duration = ifx simple then VoiceSeconds_es_simple(at) else VoiceSeconds_es_spelling(at) }
    else { duration = ifx simple then VoiceSeconds_en_simple(at) else VoiceSeconds_en_spelling(at) }
    quiet := ifx playback_speed == 0 then 5.0 else ifx playback_speed == 1 then 3.0 else 1.0
    spoken := duration + quiet
    minimum := ifx playback_speed == 0 then 10.0 else ifx playback_speed == 2 then 3.0 else ifx simple then 6.0 else PAGE_SECONDS
    return ifx spoken > minimum then spoken else minimum
}

Turn :: (step: s32) {
    count := category_counts[category]
    if finished {
        if step >= 0 { return }
        finished = false
        page = count - 1
    } else {
        next := page + step
        if next < 0 { return }
        if next >= count {
            finished = true
            finished_started = retro.now
            swipe_tracking = false
            voice_pending = false
            unused AppService("jungle.voice", "")
            return
        }
        page = next
    }
    page_started = retro.now
    paused_at = retro.now
    voice_idle_started = 0.0
    voice_pending = true
}

OpenBook :: () {
    if !BookAllowed(category) { return }
    book_tab = category_groups[category]
    choosing_category = false
    finished = false
    swipe_tracking = false
    page = 0
    page_started = retro.now
    voice_idle_started = 0.0
    voice_pending = true
    paused_at = retro.now
}

Spelling :: () -> string {
    at := PageIndex()
    if language == 1 { return page_spelling_de(at) }
    if language == 2 { return page_spelling_es(at) }
    return page_spelling_en(at)
}

// Book layouts use the actual viewport; gameplay state and narration are shared.
book_width: s32;
book_height: s32;
book_padding: s32;
book_gap: s32;
shelf_columns: s32;
shelf_card_width: s32;
shelf_card_height: s32;
shelf_view_height: s32;

TouchButton :: (id: s32, x: s32, y: s32, width: s32, height: s32, text: string, selected: bool = false) -> bool {
    press := RetroTap(id, x, y, width, height, text)
    BookBox(x, y, width, height, ifx selected || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
        ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 8.0)
    font: s32 = 18
    while font > 10 && cast(s32)Tr(text).count * font * 3 / 5 > width - 12 { font -= 1 }
    BookText(x + 6, y, width - 12, height, text, font)
    return press.clicked
}

ResponsiveBook :: (bounds: Rectangle) {
    book_width = cast(s32)bounds.width
    book_height = cast(s32)bounds.height
    fit := bounds.width / 320.0
    if bounds.height / 200.0 < fit { fit = bounds.height / 200.0 }
    book_padding = cast(s32)(14.0 * fit) + 12
    if book_padding < 24 { book_padding = 24 }
    book_gap = ifx book_width < 600 then 12 else 20
    retro.x = bounds.x
    retro.y = bounds.y
    retro.scale = 1.0
    BookPaperSized(book_width, book_height)
    shelf_columns = ifx book_width < 600 then 1 else 2
    shelf_card_width = (book_width - book_padding * 2 - book_gap * (shelf_columns - 1) - 10) / shelf_columns
    shelf_card_height = ifx book_width < 600 then 92 else 120
    if managing_books { shelf_card_height += 52 }
    shelf_view_height = book_height - book_padding * 2 - 64
    if shelf_view_height < 80 { shelf_view_height = 80 }
}

BookShelf :: () {
    handled := false
    tab_gap: s32 = 8
    tab_columns: s32 = ifx book_width < 600 then 2 else 4
    tab_rows := 4 / tab_columns
    tab_width := (book_width - book_padding * 2 - tab_gap * (tab_columns - 1)) / tab_columns
    for index: cast(s32)0..3 {
        if TouchButton(700 + index, book_padding + (index % tab_columns) * (tab_width + tab_gap), book_padding + (index / tab_columns) * 52, tab_width, 44, book_groups[index], book_tab == index) {
            book_tab = index
            category = shelf_order[group_starts[index]]
            book_scroll = 0
            handled = true
        }
    }
    visible: [CATEGORY_COUNT]s32
    count: s32 = 0
    for slot: cast(s32)0..group_counts[book_tab] - 1 {
        index := shelf_order[group_starts[book_tab] + slot]
        if managing_books || BookAllowed(index) { visible[count] = index; count += 1 }
    }
    rows := (count + shelf_columns - 1) / shelf_columns
    content_height := rows * (shelf_card_height + book_gap)
    tab_height := tab_rows * 52 + 4
    view_top := book_padding + tab_height
    view_height := shelf_view_height - tab_height
    scrolled := Scroll(retro.session, ScrollProps.{.key = cast(u64)600,
        .bounds = RetroRect(book_padding, view_top, book_width - book_padding * 2, view_height),
        .scale = 1.0, .content_height = content_height, .scroll_offset = book_scroll, .keep_scrollbar = true})
    book_scroll = scrolled.scroll_offset
    if scrolled.opened {
        saved_y := retro.y
        retro.y -= cast(float32)book_scroll
        for slot: cast(s32)0..count - 1 {
            index := visible[slot]
            x := book_padding + (slot % shelf_columns) * (shelf_card_width + book_gap)
            y := view_top + (slot / shelf_columns) * (shelf_card_height + book_gap)
            press := RetroTap(100 + index, x, y, shelf_card_width, shelf_card_height - ifx managing_books then 52 else 0, category_names[index])
            selected := index == category
            BookBox(x, y, shelf_card_width, shelf_card_height, ifx selected then cast(u32)0xe5eee1ff else cast(u32)0xf7f1e3ff,
                ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 9.0)
            card_body := shelf_card_height - ifx managing_books then 52 else 0
            picture := card_body - 14
            BookPicture(category_previews[index], x + 7, y + 7, picture, picture)
            title_width := shelf_card_width - picture - 24
            title_font: s32 = 24
            while title_font > 12 && cast(s32)Tr(category_names[index]).count * title_font * 3 / 5 > title_width { title_font -= 1 }
            BookText(x + picture + 14, y + card_body / 2 - 28, title_width, 32, category_names[index], title_font, TextAlign.TextAlignStart)
            count_text: Vec(u8)
            BuilderPrint(*count_text, "% %", category_counts[index], Tr("pages"))
            BookText(x + picture + 14, y + card_body / 2 + 8, shelf_card_width - picture - 24, 22, BuilderFinish(count_text), 15, TextAlign.TextAlignStart, false, true)
            if press.clicked && !managing_books { category = index; OpenBook() }
            if managing_books {
                button := (shelf_card_width - 24) / 2
                if TouchButton(800 + index * 2, x + 8, y + card_body, button, 42, ifx hidden_books[index] then "Show book" else "Hide book", !hidden_books[index]) {
                    hidden_books[index] = !hidden_books[index]; SaveBookChoice(index)
                }
                if TouchButton(801 + index * 2, x + 16 + button, y + card_body, button, 42, ifx excluded_books[index] then "Skip autoplay" else "In autoplay", !excluded_books[index]) {
                    excluded_books[index] = !excluded_books[index]; SaveBookChoice(index)
                }
            }
        }
        retro.y = saved_y
        unused End(retro.session)
    }
    footer := book_height - book_padding - 48
    if count == 0 { BookText(book_padding, view_top, book_width - book_padding * 2, 64, "No visible books", 20) }
    x := book_padding
    if managing_books {
        button := (book_width - book_padding * 2 - book_gap) / 2
        if TouchButton(62, x, footer, button, 48, ifx repeat_all then "Repeat on" else "Repeat off", repeat_all) {
            repeat_all = !repeat_all
            unused DocumentWrite("repeat.txt", ifx repeat_all then "on" else "off")
            handled = true
        }
        if TouchButton(32, x + button + book_gap, footer, button, 48, "Done") { managing_books = false; book_scroll = 0; handled = true }
    } else {
        mode_width := (book_width - book_padding * 2 - book_gap * 2) / 3
        if TouchButton(30, x, footer, mode_width, 48, "Simple", simple) { simple = true; unused DocumentWrite("mode.txt", "simple"); handled = true }
        if TouchButton(31, x + mode_width + book_gap, footer, mode_width, 48, "Spelling", !simple) { simple = false; unused DocumentWrite("mode.txt", "spelling"); handled = true }
        if TouchButton(32, x + (mode_width + book_gap) * 2, footer, mode_width, 48, ifx book_width < 480 then "Manage" else "Manage books") { managing_books = true; book_scroll = 0; handled = true }
    }
    if count > 0 && (retro.key == KEY_LEFT || retro.key == KEY_RIGHT || retro.key == KEY_UP || retro.key == KEY_DOWN) {
        slot: s32 = 0
        for at: cast(s32)0..count - 1 { if visible[at] == category { slot = at } }
        step: s32 = ifx retro.key == KEY_LEFT then -1 else ifx retro.key == KEY_RIGHT then 1 else ifx retro.key == KEY_UP then -shelf_columns else shelf_columns
        slot = (slot + step + count) % count
        category = visible[slot]
        top := (slot / shelf_columns) * (shelf_card_height + book_gap)
        if top < book_scroll { book_scroll = top }
        if top + shelf_card_height > book_scroll + view_height { book_scroll = top + shelf_card_height - view_height }
    }
    if retro.key == 83 { simple = true; unused DocumentWrite("mode.txt", "simple") }
    if retro.key == 68 { simple = false; unused DocumentWrite("mode.txt", "spelling") }
    if retro.key >= 49 && retro.key <= 57 && retro.key < 49 + CATEGORY_COUNT { category = retro.key - 49; OpenBook() }
    if retro.key == 48 && CATEGORY_COUNT >= 10 { category = 9; OpenBook() }
    if retro.key == KEY_ENTER && !handled && !managing_books { OpenBook() }
    if retro.key == KEY_ESCAPE { GameHome() }
}

// The scenes fade into this paper, so a page reaches every edge of the screen.
PagePaper :: () { BookBox(0, 0, book_width, book_height, 0xfcf2d4ff) }

// A whole scene as large as the page allows; its faded edges meet the paper,
// so nothing of the picture is cut off.
SceneRect :: () -> (x: s32, y: s32, size: s32) {
    size := ifx book_width < book_height then book_width else book_height
    return (book_width - size) / 2, (book_height - size) / 2, size
}

FINISHED_SECONDS :: 8.0

CaptionWidth :: () -> s32 { return ifx book_width - 32 < 560 then book_width - 32 else 560 }

PlaybackAction :: (id: s32, x: s32, y: s32, width: s32, text: string) -> bool {
    press := RetroTap(id, x, y, width, 42, text)
    if press.down { BookBox(x + 4, y + 3, width - 8, 36, 0xdcebdcff, 0, 9.0) }
    font: s32 = 18
    while font > 10 && cast(s32)Tr(text).count * font * 3 / 5 > width - 16 { font -= 1 }
    BookText(x + 8, y, width - 16, 42, text, font)
    return press.clicked
}

PlaybackControls :: (can_hear: bool = true) {
    width := ifx can_hear then CaptionWidth() else 180
    x := (book_width - width) / 2
    y := book_height - 58
    if !can_hear { BookBox(x, y, width, 42, 0xfffcf3e8, 0xdacdb5ff, 14.0) }
    button := ifx can_hear then width / 2 else width
    if PlaybackAction(61, x, y, button, ifx playing then "Pause" else "Play") { TogglePlayback() }
    if can_hear {
        BookBox(x + button, y + 10, 1, 22, 0xdacdb5ff)
        if PlaybackAction(63, x + button, y, width - button, "Hear word") {
            voice_pending = true; page_started = retro.now; paused_at = retro.now; voice_idle_started = 0.0
        }
    }
}

FinishedBook :: () {
    next_category := NextBookCategory(category, repeat_all)
    automatic := next_category >= 0 && repeat_all && playing
    if next_category < 0 { next_category = category }
    landscape := book_width > book_height
    PagePaper()
    BookText(book_padding, book_padding / 2, book_width - book_padding * 2, 48, "Book finished", 30)
    top := book_padding / 2 + 56
    bottom := book_height - book_padding - 52
    cover: s32
    cover_x: s32
    cover_y: s32
    text_x: s32
    text_y: s32
    text_width: s32
    if landscape {
        cover = bottom - top
        if cover > book_width / 2 - book_padding * 2 { cover = book_width / 2 - book_padding * 2 }
        cover_x = book_width / 2 - cover - book_gap
        cover_y = top + (bottom - top - cover) / 2
        text_x = book_width / 2 + book_gap
        text_width = book_width / 2 - book_padding - book_gap
        if text_width > 420 { text_width = 420 }
        text_y = top + (bottom - top) / 2 - 104
    } else {
        cover = book_width - book_padding * 2
        if cover > bottom - top - 230 { cover = bottom - top - 230 }
        if cover < 80 { cover = 80 }
        cover_x = (book_width - cover) / 2
        cover_y = top
        text_x = book_padding
        text_width = book_width - book_padding * 2
        text_y = cover_y + cover + 14
    }
    // The next book's cover, framed like a card on the shelf.
    BookBox(cover_x - 6, cover_y - 6, cover + 12, cover + 12, 0xfffcf3ff, 0xdacdb5ff, 14.0)
    BookPicture(category_previews[next_category], cover_x, cover_y, cover, cover)
    BookText(text_x, text_y, text_width, 44, category_names[next_category], 34)
    count_text: Vec(u8)
    BuilderPrint(*count_text, "% %", category_counts[next_category], Tr("pages"))
    BookText(text_x, text_y + 42, text_width, 24, BuilderFinish(count_text), 19, TextAlign.TextAlignCenter, false, true)
    // A quiet bar shows when the next book opens by itself.
    progress := ((ifx playing then retro.now else paused_at) - finished_started) / FINISHED_SECONDS
    if progress > 1.0 { progress = 1.0 }
    bar_width := text_width - 40
    BookText(text_x, text_y + 74, text_width, 22, ifx automatic then "Next book starts shortly" else "Autoplay paused", 18, TextAlign.TextAlignCenter, true, true)
    BookBox(text_x + 20, text_y + 100, bar_width, 8, 0xeee4cfff, 0, 4.0)
    if automatic { BookBox(text_x + 20, text_y + 100, cast(s32)(cast(float64)bar_width * progress), 8, 0x2e6956ff, 0, 4.0) }
    button_width := (text_width - book_gap) / 2
    all_books := TouchButton(40, text_x, text_y + 124, button_width, 52, "All books")
    next_book := TouchButton(41, text_x + button_width + book_gap, text_y + 124, button_width, 52, "Read this book", true)
    if all_books || retro.key == KEY_ESCAPE { choosing_category = true; finished = false }
    else if next_book || retro.key == KEY_ENTER || retro.key == KEY_RIGHT || (automatic && retro.now - finished_started >= FINISHED_SECONDS) {
        category = next_category
        OpenBook()
    }
    if retro.key == KEY_LEFT { Turn(-1) }
    PlaybackControls(false)
}

// A page is one whole scene with its word on top. Tap the left side to go
// back and anywhere else to turn the page; the title bar's back arrow returns
// to the books.
ReadingPage :: () {
    PagePaper()
    x, y, size := SceneRect()
    landscape := book_width >= book_height
    for ahead: cast(s32)1..2 {
        if page + ahead < category_counts[category] { unused RetroImageReady(page_paths(PageIndex() + ahead)) }
    }
    BookPicture(page_paths(PageIndex()), x, y, size, size)
    label_width := CaptionWidth()
    label_height: s32 = ifx simple then 72 else 108
    label_x := (book_width - label_width) / 2
    label_y := book_height - label_height - 66
    BookBox(label_x, label_y, label_width, label_height + 50, 0xfffcf3e8, 0xdacdb5ff, 20.0)
    font: s32 = ifx landscape then 46 else 38
    while font > 16 && cast(s32)PageName().count * font * 3 / 5 > label_width - 32 { font -= 1 }
    BookText(label_x + 16, label_y + 6, label_width - 32, 60, PageName(), font, TextAlign.TextAlignCenter, false)
    if !simple {
        spelling_font: s32 = 22
        while spelling_font > 12 && cast(s32)Spelling().count * spelling_font * 3 / 5 > label_width - 32 { spelling_font -= 1 }
        BookText(label_x + 16, label_y + 64, label_width - 32, 34, Spelling(), spelling_font)
    }
    BookBox(label_x + 16, book_height - 62, label_width - 32, 1, 0xdacdb5ff)
    touch := RetroTap(12, 0, 0, book_width, book_height - 64, "Swipe to turn the page", true)
    now := retro.now
    if touch.down && !swipe_tracking {
        swipe_start = Vector2.{touch.x, touch.y}
        swipe_started = now
        swipe_tracking = true
    }
    direction := SwipeDirection.SwipeNone
    moved := false
    if touch.released && swipe_tracking {
        delta := Vector2.{touch.x - swipe_start.x, touch.y - swipe_start.y}
        moved = SwipeMaxDistanceFor(delta) >= 8.0
        gesture := SwipeReleaseStateFor(delta, cast(u32)SwipeDirection.SwipeHorizontal,
            1.25, 40.0, now - swipe_started, 0.0, moved)
        direction = gesture.direction
        swipe_tracking = false
    }
    if !touch.down && !touch.released { swipe_tracking = false }
    tapped := touch.clicked && !moved
    back_side := tapped && touch.x < retro.x + cast(float32)(book_width / 3)
    if back_side || retro.key == KEY_LEFT || direction == SwipeDirection.SwipeRight { Turn(-1) }
    else if tapped || retro.key == KEY_RIGHT || retro.key == KEY_ENTER || direction == SwipeDirection.SwipeLeft { Turn(1) }
    if retro.key == KEY_ESCAPE {
        choosing_category = true
        swipe_tracking = false
        voice_pending = false
        unused AppService("jungle.voice", "")
    }
    PlaybackControls()
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        choosing_category = true
        finished = false
        settings_loaded = false
        voice_pending = false
        swipe_tracking = false
        page = 0
        category = 0
        book_scroll = 0
        book_tab = 0
        playing = true; paused_at = 0.0; playback_speed = 1
        managing_books = false
        AppIdentity("jungle.book")
        AppDescribe("Picture Book", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return 0 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    if !settings_loaded {
        simple = DocumentRead("mode.txt") != "spelling"
        repeat_all = DocumentRead("repeat.txt") != "off"
        for index: cast(s32)0..CATEGORY_COUNT - 1 {
            hidden_books[index] = DocumentRead(Join("hidden-", category_ids[index], ".txt")) == "yes"
            excluded_books[index] = DocumentRead(Join("skip-", category_ids[index], ".txt")) == "yes"
        }
        settings_loaded = true
    }
    now := AppNow()
    bounds := AppBounds()
    RetroBegin(AppSession(), bounds, FONT, now, AppKey(), BLACK)
    ResponsiveBook(bounds)
    if retro.key == 10001 { playback_speed = (playback_speed + 1) % 3 }
    if retro.key == 32 && !choosing_category { TogglePlayback() }
    if playing && !voice_pending && !choosing_category && !finished && !swipe_tracking {
        state := AppService("jungle.voice-state", "")
        if state == "loading" || state == "playing" { voice_idle_started = 0.0 }
        else if voice_idle_started == 0.0 { voice_idle_started = now }
        quiet := ifx playback_speed == 0 then 5.0 else ifx playback_speed == 1 then 3.0 else 1.0
        if now - page_started >= PageHold() && voice_idle_started > 0.0 && now - voice_idle_started >= quiet { Turn(1) }
    }
    if choosing_category { BookShelf() }
    else if finished { FinishedBook() }
    else { ReadingPage() }
    if voice_pending && !choosing_category && !finished {
        unused AppService("jungle.voice", PageVoice())
        if !playing { unused AppService("jungle.voice-control", "pause") }
        voice_pending = false
    }
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

// Little Drums' rules contain no clock, sound or UI effects.
#import, file "../../host/jungle_text.zi";

DRUMS_PADS :: 8
DRUMS_FREE :: 0
DRUMS_COPY :: 1
DRUMS_READY :: 0
DRUMS_DEMO :: 1
DRUMS_TURN :: 2
DRUMS_DONE :: 3
DRUMS_IGNORED :: 0
DRUMS_HIT :: 1
DRUMS_RETRY :: 2
DRUMS_COMPLETE :: 3
DRUMS_GAP :: 0.75

Drums :: struct {
    mode: s32
    length: s32
    wins: s32
    pattern: [5]s32
    phase: s32
    demo_index: s32
    copied: s32
    next_hit: float64
    last_time: float64
}

DrumsNew :: () -> Drums { return Drums.{.length = 2} }

DrumsRandom :: (seed: *s64) -> s32 {
    seed.* = seed.* * 48271 % 2147483647
    return cast(s32)(seed.* % DRUMS_PADS)
}

// Start with two sounds. Two completed patterns offer the next length,
// up to five; replaying a pattern never changes its difficulty.
DrumsStart :: (d: *Drums, seed: s32, now: float64) {
    if d.length < 2 || d.length > 5 { d.length = 2; d.wins = 0 }
    if d.wins >= 2 { if d.length < 5 { d.length += 1 }; d.wins = 0 }
    random: s64 = cast(s64)(seed & 0x7fffffff) % 2147483646 + 1
    for i: cast(s32)0..d.length - 1 { d.pattern[i] = DrumsRandom(*random) }
    d.mode = DRUMS_COPY
    DrumsReplay(d, now)
}

DrumsReplay :: (d: *Drums, now: float64) {
    if d.mode != DRUMS_COPY { return }
    d.phase = DRUMS_DEMO; d.demo_index = 0; d.copied = 0
    d.next_hit = now + 0.35; d.last_time = now
}

DrumsFree :: (d: *Drums) {
    d.mode = DRUMS_FREE; d.phase = DRUMS_READY; d.copied = 0
}

// Emits at most one sound. Schedule from the actual emission time rather
// than a stale deadline: slow frames cannot cause a rapid catch-up burst.
// The final note gets its full quiet gap before input is enabled.
DrumsTick :: (d: *Drums, now: float64) -> s32 {
    if d.mode != DRUMS_COPY || d.phase != DRUMS_DEMO { return -1 }
    if now < d.last_time { d.next_hit = now + 0.35 }
    d.last_time = now
    if now < d.next_hit { return -1 }
    if d.demo_index >= d.length { d.phase = DRUMS_TURN; return -1 }
    pad := d.pattern[d.demo_index]
    d.demo_index += 1; d.next_hit = now + DRUMS_GAP
    return pad
}

DrumsChoose :: (d: *Drums, pad: s32) -> s32 {
    if pad < 0 || pad >= DRUMS_PADS { return DRUMS_IGNORED }
    if d.mode == DRUMS_FREE { return DRUMS_HIT }
    if d.phase != DRUMS_TURN { return DRUMS_IGNORED }
    if pad != d.pattern[d.copied] {
        d.copied = 0
        return DRUMS_RETRY
    }
    d.copied += 1
    if d.copied < d.length { return DRUMS_HIT }
    d.phase = DRUMS_DONE
    if d.wins < 2 { d.wins += 1 }
    return DRUMS_COMPLETE
}

// Persist only learning progress. Every opening is Free Play, with no
// half-played demonstrations or unfinished gestures restored.
DrumsSaveText :: (d: Drums) -> string {
    return Cat("drums 1 ", NumberText(d.length), " ", NumberText(d.wins), "\n")
}

DrumsRead :: (text: string, result: *Drums) -> bool {
    if text.count != 11 && text.count != 12 { return false }
    if text[:8] != "drums 1 " || text[9] != #char " " { return false }
    if text.count == 12 && text[11] != #char "\n" { return false }
    length := cast(s32)(text[8]) - cast(s32)(#char "0")
    wins := cast(s32)(text[10]) - cast(s32)(#char "0")
    if length < 2 || length > 5 || wins < 0 || wins > 2 { return false }
    result.* = Drums.{.length = length, .wins = wins}
    return true
}

// A 16×16 summary of each transparent PNG's alpha coverage. Presses use the
// sprite's full bounds for capture, then this body mask rejects empty corners.
DRUMS_BIG_MASK: [16]u16 = .[
    0x07e0, 0x1ff8, 0x3ffc, 0x3ffc, 0x1ffc, 0x1ffc, 0x1ff8, 0x1ff8,
    0x0ff0, 0x07e0, 0x07e0, 0x07e0, 0x0ff0, 0x0ff0, 0x0ff0, 0x03c0
];
DRUMS_LITTLE_MASK: [16]u16 = .[
    0x0000, 0x1ff0, 0x3ffc, 0x7ffe, 0x7ffe, 0x7fff, 0x7fff, 0x7fff,
    0x7fff, 0x7ffe, 0x3ffe, 0x3ffe, 0x3ffc, 0x1ffc, 0x0ff8, 0x03e0
];
DRUMS_SHAKER_MASK: [16]u16 = .[
    0x0000, 0x1800, 0x7c3c, 0x7e7e, 0x7e7f, 0xff7f, 0x7fff, 0x7e7e,
    0x3e7c, 0x0e78, 0x0770, 0x07e0, 0x07e0, 0x07e0, 0x00c0, 0x0000
];
DRUMS_BELL_MASK: [16]u16 = .[
    0x03c0, 0x03c0, 0x03c0, 0x03c0, 0x03c0, 0x03c0, 0x03c0, 0x03c0,
    0x07e0, 0x07e0, 0x07f0, 0x0ff0, 0x1ff8, 0x1ff8, 0x1ff8, 0x07e0
];

DRUMS_XYLOPHONE_MASK: [16]u16 = .[
    0x0000, 0x0000, 0x0000, 0x0000, 0x3f00, 0x3fe0, 0x7ffe, 0x7fff,
    0xffff, 0xffff, 0x3fff, 0x3ffe, 0x01fe, 0x0034, 0x0000, 0x0000
];
DRUMS_GUITAR_MASK: [16]u16 = .[
    0x01c0, 0x01c0, 0x01c0, 0x01c0, 0x0180, 0x0180, 0x0180, 0x03c0,
    0x07e0, 0x07e0, 0x07e0, 0x07e0, 0x0ff0, 0x0ff0, 0x07e0, 0x03c0
];
DRUMS_CYMBAL_MASK: [16]u16 = .[
    0x0000, 0x0180, 0x1ff8, 0x3ffc, 0x3ffc, 0x3ffc, 0x1ff8, 0x03c0,
    0x01c0, 0x0180, 0x0180, 0x03c0, 0x07e0, 0x0cb0, 0x1818, 0x0000
];
DRUMS_TAMBOURINE_MASK: [16]u16 = .[
    0x0000, 0x0000, 0x0fc0, 0x3ff8, 0x7ffc, 0x7ffe, 0xfffe, 0xffff,
    0xffff, 0x7fff, 0x3fff, 0x1ffe, 0x0ffc, 0x01f0, 0x0000, 0x0000
];

DrumsMaskRow :: (pad: s32, row: s32) -> u16 {
    if pad == 0 { return DRUMS_BIG_MASK[row] }
    if pad == 1 { return DRUMS_LITTLE_MASK[row] }
    if pad == 2 { return DRUMS_SHAKER_MASK[row] }
    if pad == 3 { return DRUMS_BELL_MASK[row] }
    if pad == 4 { return DRUMS_XYLOPHONE_MASK[row] }
    if pad == 5 { return DRUMS_GUITAR_MASK[row] }
    if pad == 6 { return DRUMS_CYMBAL_MASK[row] }
    return DRUMS_TAMBOURINE_MASK[row]
}

DrumsBodyHit :: (pad: s32, x: s32, y: s32, width: s32, height: s32,
        point_x: s32, point_y: s32) -> bool {
    if pad < 0 || pad >= DRUMS_PADS || width <= 0 || height <= 0 { return false }
    if point_x < x || point_y < y || point_x >= x + width || point_y >= y + height { return false }
    cell_x := (point_x - x) * 16 / width
    cell_y := (point_y - y) * 16 / height
    row := DrumsMaskRow(pad, cell_y)
    return ((cast(u32)row >> cast(u32)(15 - cell_x)) & cast(u32)1) != cast(u32)0
}

// Room reference scenes, with objects hanging on the wall, resting on a
// shelf, and standing at different depths on the floor. These are deliberately
// separate compositions, rather than a row/grid reflow. Fit includes labels.
DrumsLayout :: struct { left: s32; top: s32; fit: s32; wide: bool; room_top: s32; room_height: s32 }
DrumsPlace :: struct { x: s32; y: s32; edge: s32 }

DRUMS_PORTRAIT_X: [8]s32 = .[8, 156, 158, 30, 255, 155, 0, 298];
DRUMS_PORTRAIT_Y: [8]s32 = .[340, 380, 42, 40, 455, 100, 150, 385];
DRUMS_PORTRAIT_EDGE: [8]s32 = .[160, 105, 55, 80, 125, 240, 180, 78];
DRUMS_LANDSCAPE_X: [8]s32 = .[70, 270, 245, 65, 430, 560, 325, 680];
DRUMS_LANDSCAPE_Y: [8]s32 = .[180, 230, 23, 17, 245, 36, 57, 260];
DRUMS_LANDSCAPE_EDGE: [8]s32 = .[160, 104, 52, 78, 125, 235, 180, 78];

DrumsRoomLayout :: (width: s32, height: s32, copying: bool = false) -> DrumsLayout {
    wide := width > height
    scene_width: s32 = ifx wide then 800 else 400
    scene_height: s32 = ifx wide then 410 else 624
    top: s32 = ifx copying then 112 else 60
    available := height - top - (ifx copying then 72 else 8)
    fit := (width - 24) * 1000 / scene_width
    tall := available * 1000 / scene_height
    if tall < fit { fit = tall }
    if fit < 0 { fit = 0 }
    return DrumsLayout.{.left = (width - scene_width * fit / 1000) / 2,
        .top = top + (available - scene_height * fit / 1000) / 2, .fit = fit, .wide = wide,
        .room_top = top, .room_height = available}
}

// A short, damped horizontal shake keeps the floor contact height fixed.
DrumsShakeX :: (elapsed: float64) -> s32 {
    if elapsed < 0.0 || elapsed >= 0.30 { return 0 }
    step := cast(s32)(elapsed / 0.05)
    amount: s32 = ifx step < 2 then 3 else ifx step < 4 then 2 else 1
    return ifx step % 2 == 0 then amount else -amount
}

DrumsRoomPlace :: (pad: s32, room: DrumsLayout) -> DrumsPlace {
    if pad < 0 || pad >= DRUMS_PADS { return DrumsPlace.{} }
    x := ifx room.wide then DRUMS_LANDSCAPE_X[pad] else DRUMS_PORTRAIT_X[pad]
    y := ifx room.wide then DRUMS_LANDSCAPE_Y[pad] else DRUMS_PORTRAIT_Y[pad]
    edge := ifx room.wide then DRUMS_LANDSCAPE_EDGE[pad] else DRUMS_PORTRAIT_EDGE[pad]
    return DrumsPlace.{.x = room.left + x * room.fit / 1000,
        .y = room.top + y * room.fit / 1000, .edge = edge * room.fit / 1000}
}

// Opaque cut-out bases: bell 1196/1254, shaker 1140/1254. A shelf
// meets those feet/handles, never the text beneath the full image square.
DrumsShelfPlace :: (pad: s32, room: DrumsLayout) -> DrumsPlace {
    picture := DrumsRoomPlace(pad, room)
    base: s32 = ifx pad == 3 then 95 else 91
    return DrumsPlace.{.x = picture.x + picture.edge / 10,
        .y = picture.y + picture.edge * base / 100, .edge = picture.edge * 8 / 10}
}

DrumsLabelY :: (pad: s32, place: DrumsPlace) -> s32 {
    return place.y + place.edge + (ifx pad == 2 || pad == 3 then 28 else 0)
}

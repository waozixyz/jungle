// Independent plants, grown by moist elapsed time. All clocks are injected.
#import, file "../../host/jungle_text.zi";
#import "std/vec"
#import, file "../../retro/language.zi";

GardenView :: struct { x: s32; y: s32; width: s32; height: s32; scale: float32 }
// The painting, crop positions and pointer targets share this cover transform.
GardenCover :: (width: s32, height: s32, iw: s32, ih: s32) -> GardenView {
    scale := cast(float32)width/cast(float32)iw
    down := cast(float32)height/cast(float32)ih
    if down > scale { scale = down }
    w := cast(s32)(cast(float32)iw*scale); h := cast(s32)(cast(float32)ih*scale)
    return GardenView.{(width-w)/2,(height-h)/2,w,h,scale}
}

GARDEN_PLOTS :: 6
GARDEN_KINDS :: 6
GARDEN_HOUR :: 3600
GARDEN_SEED_TIME :: GARDEN_HOUR
GardenPlot :: struct {
    kind: s32 // zero is an empty plot; seed kinds are 1..6
    planted: s64
    watered: s64
    updated: s64
    growth: s64 // seconds spent in moist soil
    dead: bool
    x: s32 // thousandths of the painted bed, independent of viewport size
    y: s32
}
Garden :: struct {
    plots: [GARDEN_PLOTS]GardenPlot
    selected: s32 // 0 watering can, 1..6 seeds
}
GardenText :: (en: string, de: string, es: string) -> string {
    if LanguageCode() == "de" { return de }
    if LanguageCode() == "es" { return es }
    return en
}
GardenKind :: (kind: s32) -> string {
    names: [6]string = .["sunflower", "tomato", "carrot", "strawberry", "pumpkin", "cabbage"]
    if kind < 1 || kind > GARDEN_KINDS { return "" }
    return names[kind - 1]
}
GardenName :: (kind: s32) -> string {
    if kind == 1 { return GardenText("Sunflower", "Sonnenblume", "Girasol") }
    if kind == 2 { return GardenText("Tomato", "Tomate", "Tomate") }
    if kind == 3 { return GardenText("Carrot", "Karotte", "Zanahoria") }
    if kind == 4 { return GardenText("Strawberry", "Erdbeere", "Fresa") }
    if kind == 5 { return GardenText("Pumpkin", "Kürbis", "Calabaza") }
    if kind == 6 { return GardenText("Cabbage", "Kohl", "Repollo") }
    return GardenText("Water", "Wasser", "Agua")
}
GardenGrowTime :: (kind: s32) -> s64 {
    hours: [6]s32 = .[72, 96, 72, 48, 120, 72]
    if kind < 1 || kind > 6 { return 0 }
    return cast(s64)hours[kind - 1] * GARDEN_HOUR
}
GardenDryTime :: (kind: s32) -> s64 {
    hours: [6]s32 = .[30, 24, 30, 18, 24, 18]
    if kind < 1 || kind > 6 { return 0 }
    return cast(s64)hours[kind - 1] * GARDEN_HOUR
}
GardenDeathTime :: (kind: s32) -> s64 {
    hours: [6]s32 = .[96, 72, 96, 60, 72, 48]
    if kind < 1 || kind > 6 { return 0 }
    return cast(s64)hours[kind - 1] * GARDEN_HOUR
}
GardenTick :: (p: *GardenPlot, now: s64) {
    if p.kind == 0 || p.dead || now <= p.updated { return }
    wet_end := p.watered + GardenDryTime(p.kind)
    end := ifx now < wet_end then now else wet_end
    if end > p.updated {
        p.growth += end - p.updated
        limit := GardenGrowTime(p.kind)
        if p.growth > limit { p.growth = limit }
    }
    p.updated = now
    if now - p.watered >= GardenDeathTime(p.kind) { p.dead = true }
}
GardenDry :: (p: GardenPlot, now: s64) -> bool {
    return p.kind != 0 && !p.dead && now >= p.watered + GardenDryTime(p.kind)
}
GardenStage :: (p: GardenPlot) -> s32 {
    if p.kind == 0 { return 0 }
    if p.growth < GARDEN_SEED_TIME { return 0 }
    if p.growth >= GardenGrowTime(p.kind) { return 3 }
    if p.growth >= GardenGrowTime(p.kind) / 3 { return 2 }
    return 1
}
GardenPlant :: (g: *Garden, plot: s32, kind: s32, now: s64) -> bool {
    if plot < 0 || plot >= GARDEN_PLOTS || kind < 1 || kind > GARDEN_KINDS || now <= 0 { return false }
    GardenTick(*g.plots[plot], now)
    if g.plots[plot].kind != 0 { return false }
    g.plots[plot] = GardenPlot.{.kind = kind, .planted = now, .watered = now, .updated = now,
        .x = GardenDefaultX(plot), .y = GardenDefaultY(plot)}
    return true
}
GardenDefaultX :: (plot: s32) -> s32 { return 260 + plot % 3 * 240 }
GardenDefaultY :: (plot: s32) -> s32 { return ifx plot < 3 then 570 else 730 }
// The inset trapezoid follows the soil inside the accepted painted wooden bed.
GardenSoil :: (x: s32, y: s32) -> bool {
    if y < 410 || y > 730 { return false }
    left := 190 - (y - 410) * 90 / 320
    return x >= left && x <= 1000 - left
}
GardenPlaceSlot :: (g: Garden, x: s32, y: s32) -> s32 {
    if !GardenSoil(x, y) { return -1 }
    empty: s32 = -1
    for i: cast(s32)0..GARDEN_PLOTS - 1 {
        p := g.plots[i]
        if p.kind == 0 { if empty < 0 { empty = i }; continue }
        dx := x - p.x; dy := y - p.y
        // Elliptical ground spacing allows leaves to overlap in perspective.
        if dx * dx * 100 + dy * dy * 169 < 1822500 { return -1 }
    }
    return empty
}
GardenPlantAt :: (g: *Garden, kind: s32, x: s32, y: s32, now: s64) -> s32 {
    slot := GardenPlaceSlot(g.*, x, y)
    if slot < 0 || !GardenPlant(g, slot, kind, now) { return -1 }
    g.plots[slot].x = x; g.plots[slot].y = y
    return slot
}
GardenDrawOrder :: (g: Garden) -> [GARDEN_PLOTS]s32 {
    order: [GARDEN_PLOTS]s32
    for i: cast(s32)0..GARDEN_PLOTS - 1 { order[i] = i }
    for pass: cast(s32)1..GARDEN_PLOTS - 1 {
        for j: cast(s32)0..GARDEN_PLOTS - 2 {
            if g.plots[order[j]].y > g.plots[order[j + 1]].y {
                swap := order[j]; order[j] = order[j + 1]; order[j + 1] = swap
            }
        }
    }
    return order
}
// Depth shrinks plants painted higher up the bed; Y is thousandths of the scene.
GardenDepthScale :: (y: s32) -> s32 {
    depth := y
    if depth < 410 { depth = 410 }; if depth > 730 { depth = 730 }
    return 80 + (depth - 410) * 20 / 320
}
GARDEN_PAPER_ROOM :: 30 // screen units from the paper's middle to clear of anything else
// Where the sunflower's hidden paper lies, in screen units of a WIDTH by HEIGHT
// garden: a quiet corner of the scene, clear of every plant at its full grown
// size, never in the tray of seed packets and tools. `show` is false until a
// healthy plant has fully grown, and when the screen leaves no such corner.
GardenPaperSpot :: (g: Garden, width: s32, height: s32) -> (show: bool, x: s32, y: s32) {
    grown := false
    for p: g.plots { if p.kind != 0 && !p.dead && GardenStage(p) == 3 { grown = true } }
    if !grown || width <= 0 || height <= 0 { return false, 0, 0 }
    tray: s32 = ifx width < 600 then 180 else 94
    scene := height - tray
    edge := width * 24 / 100
    cap := scene * 34 / 100
    if edge > cap { edge = cap }
    room: s32 = GARDEN_PAPER_ROOM
    if scene < room * 4 || width < room * 4 { return false, 0, 0 }
    for c: cast(s32)0..5 {
        x := room + 4
        if c == 0 || c == 3 { x = width - room - 4 }
        if c >= 4 { x = width / 2 }
        y := tray + room + 4
        if c == 2 || c == 3 || c == 5 { y = height - room - 4 }
        clear := true
        for p: g.plots {
            if p.kind == 0 { continue }
            half := edge * GardenDepthScale(p.y) / 100
            if half < 36 { half = 36 }
            px := width * p.x / 1000
            py := tray + scene * p.y / 1000
            // The plant's box: edge wide, edge tall above its base, a little below.
            if x > px - half / 2 - room && x < px + half / 2 + room && y > py - half - room && y < py + 10 + room { clear = false }
        }
        if clear { return true, x, y }
    }
    return false, 0, 0
}
GardenWater :: (g: *Garden, plot: s32, now: s64) -> bool {
    if plot < 0 || plot >= GARDEN_PLOTS || now <= 0 { return false }
    p := *g.plots[plot]
    GardenTick(p, now)
    if p.kind == 0 || p.dead || now < p.updated { return false }
    p.watered = now
    return true
}
GardenClear :: (g: *Garden, plot: s32, now: s64) -> bool {
    if plot < 0 || plot >= GARDEN_PLOTS { return false }
    GardenTick(*g.plots[plot], now)
    // Only a withered plant can be cleared; growing plants stay safe.
    if !g.plots[plot].dead { return false }
    g.plots[plot] = GardenPlot.{}
    return true
}
GardenSave :: (g: Garden) -> Text {
    out: Vec(u8)
    BuilderPrint(*out, "garden 3 %\n", g.selected)
    for p: g.plots {
        BuilderPrint(*out, "% % % % % % % %\n", p.kind, p.planted, p.watered, p.updated, p.growth, ifx p.dead then 1 else 0, p.x, p.y)
    }
    return BuilderFinish(out)
}
GardenNumber :: (text: string, at: *s64) -> s64 {
    if at.* >= text.count || text[at.*] < #char "0" || text[at.*] > #char "9" { return -1 }
    n: s64
    while at.* < text.count && text[at.*] >= #char "0" && text[at.*] <= #char "9" {
        if n > 25340230079 { return -1 }
        n = n * 10 + cast(s64)(text[at.*] - #char "0"); at.* += 1
    }
    if n > 253402300799 { return -1 }
    return n
}
GardenRead :: (text: string, result: *Garden) -> bool {
    if text.count < 11 || text.count > 1200 { return false }
    positioned := text[:9] == "garden 3 "
    if !positioned && text[:9] != "garden 2 " { return false }
    at: s64 = 9
    selected := GardenNumber(text, *at)
    if selected < 0 || selected > GARDEN_KINDS || at >= text.count || text[at] != #char "\n" { return false }
    at += 1
    parsed: Garden
    parsed.selected = cast(s32)selected
    for i: cast(s32)0..GARDEN_PLOTS - 1 {
        values: [8]s64
        last: s32 = ifx positioned then 7 else 5
        for field: cast(s32)0..last {
            values[field] = GardenNumber(text, *at)
            if values[field] < 0 || at >= text.count { return false }
            separator := ifx field == last then #char "\n" else #char " "
            if text[at] != separator { return false }
            at += 1
        }
        if values[0] > GARDEN_KINDS || values[5] > 1 || values[6] > 1000 || values[7] > 1000 { return false }
        if values[0] == 0 {
            for j: cast(s32)1..last { if values[j] != 0 { return false } }
        } else {
            if values[1] <= 0 || values[2] < values[1] || values[3] < values[2] || values[4] > GardenGrowTime(cast(s32)values[0]) || values[4] > values[3] - values[1] { return false }
            if positioned && !GardenSoil(cast(s32)values[6], cast(s32)values[7]) { return false }
        }
        parsed.plots[i] = GardenPlot.{.kind = cast(s32)values[0], .planted = values[1], .watered = values[2], .updated = values[3], .growth = values[4], .dead = values[5] == 1,
            .x = cast(s32)values[6], .y = cast(s32)values[7]}
        if !positioned && values[0] != 0 {
            parsed.plots[i].x = GardenDefaultX(i); parsed.plots[i].y = GardenDefaultY(i)
        }
    }
    if at != text.count { return false }
    result.* = parsed
    return true
}
// Preserve the one plant from the earlier sequence when opening its save.
GardenMigrate :: (text: string, result: *Garden, now: s64) -> bool {
    if text.count < 16 || text.count > 32 || text[:9] != "garden 1 " || now <= 0 { return false }
    at: s64 = 9
    v: [4]s32
    for i: cast(s32)0..3 {
        v[i] = ReadWhole(text, *at)
        if v[i] < 0 || at >= text.count || text[at] != (ifx i == 3 then #char "\n" else #char " ") { return false }
        at += 1
    }
    if at != text.count || v[0] > 5 || v[1] > 1 || v[2] > 1 || v[3] > 1 { return false }
    if (v[0] == 0 && v[1] != 0) || ((v[0] == 5 || v[2] == 1) && v[3] == 0) { return false }
    migrated: Garden
    if v[0] >= 2 {
        unused GardenPlant(*migrated, 0, 1, now)
        if v[0] == 5 {
            migrated.plots[0].planted = now - GardenGrowTime(1)
            migrated.plots[0].growth = GardenGrowTime(1)
        }
    }
    result.* = migrated
    return true
}

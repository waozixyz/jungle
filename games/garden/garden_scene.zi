// Save coordinates remain in the original continuous bed. Four quadrants map
// onto inset soil quads in each approved painting; no save data is rewritten.
#import, file "garden_fields.zi";
#import "kryon/cursor"
GardenPoint :: struct { x: float64; y: float64 }
GardenQuad :: (bed: s32, portrait: bool) -> [4]GardenPoint {
    q: [4]GardenPoint
    if bed < 0 || bed > 3 { return q }
    // The painted soil's corners, found in each painting by tools/farm_fields.py.
    first := (bed + (ifx portrait then 4 else 0)) * 4
    for corner: cast(s32)0..3 {
        q[corner] = GardenPoint.{.x = cast(float64)GARDEN_SOIL_X[first + corner], .y = cast(float64)GARDEN_SOIL_Y[first + corner]}
    }
    return q
}
GardenBlend :: (q: [4]GardenPoint, u: float64, v: float64) -> GardenPoint {
    return GardenPoint.{.x = (1-u)*(1-v)*q[0].x + u*(1-v)*q[1].x + u*v*q[2].x + (1-u)*v*q[3].x,
        .y = (1-u)*(1-v)*q[0].y + u*(1-v)*q[1].y + u*v*q[2].y + (1-u)*v*q[3].y}
}
GardenScenePoint :: (x: s32, y: s32, portrait: bool) -> GardenPoint {
    left := 190 - (y - 410) * 90 / 320
    right := x > 500; front := y > 570
    u := ifx right then cast(float64)(x-500) / cast(float64)(500-left) else cast(float64)(x-left) / cast(float64)(500-left)
    v := cast(float64)(y - (ifx front then 570 else 410)) / 160.0
    return GardenBlend(GardenQuad((ifx front then 2 else 0) + (ifx right then 1 else 0), portrait), u, v)
}
GardenSceneMap :: (x: float64, y: float64, portrait: bool) -> (sx: s32, sy: s32) {
    for bed: cast(s32)0..3 {
        q := GardenQuad(bed, portrait)
        u: float64 = 0.5; v: float64 = 0.5
        for step: cast(s32)0..11 {
            p := GardenBlend(q,u,v)
            ux := (1-v)*(q[1].x-q[0].x)+v*(q[2].x-q[3].x)
            uy := (1-v)*(q[1].y-q[0].y)+v*(q[2].y-q[3].y)
            vx := (1-u)*(q[3].x-q[0].x)+u*(q[2].x-q[1].x)
            vy := (1-u)*(q[3].y-q[0].y)+u*(q[2].y-q[1].y)
            det := ux*vy-uy*vx
            u -= ((p.x-x)*vy-(p.y-y)*vx)/det
            v -= (ux*(p.y-y)-uy*(p.x-x))/det
        }
        if u < -0.001 || u > 1.001 || v < -0.001 || v > 1.001 { continue }
        sy := cast(s32)(410.0 + (ifx bed >= 2 then 160.0 else 0.0) + v*160.0 + 0.5)
        left := 190 - (sy-410)*90/320
        sx := cast(s32)(cast(float64)(ifx bed%2 == 1 then 500 else left) + u*cast(float64)(500-left) + 0.5)
        if bed >= 2 && sy <= 570 { sy = 571 }
        if bed < 2 && sy > 570 { sy = 570 }
        if bed%2 == 1 && sx <= 500 { sx = 501 }
        if bed%2 == 0 && sx > 500 { sx = 500 }
        return sx, sy
    }
    return -1000, -1000
}
// The bed whose whole painted field, soil and bamboo frame, holds painting
// pixel X, Y, or -1. Front beds come first: they are painted over the back ones.
GardenFieldAt :: (x: float64, y: float64, portrait: bool) -> s32 {
    for back: cast(s32)0..3 {
        bed := 3 - back
        field := bed + (ifx portrait then 4 else 0)
        first := GARDEN_FIELD_FIRST[field]
        last := first + GARDEN_FIELD_POINTS[field] - 1
        inside := false
        j := last
        for i: first..last {
            xi := cast(float64)GARDEN_FIELD_X[i]; yi := cast(float64)GARDEN_FIELD_Y[i]
            xj := cast(float64)GARDEN_FIELD_X[j]; yj := cast(float64)GARDEN_FIELD_Y[j]
            below_i := yi > y; below_j := yj > y
            if below_i != below_j && x < (xj - xi) * (y - yi) / (yj - yi) + xi { inside = !inside }
            j = i
        }
        if inside { return bed }
    }
    return -1
}
// The rectangle a bed's whole-field glow covers, in painting pixels.
GardenFieldRect :: (bed: s32, portrait: bool) -> (x: s32, y: s32, w: s32, h: s32) {
    if bed < 0 || bed > 3 { return 0, 0, 0, 0 }
    at := (bed + (ifx portrait then 4 else 0)) * 4
    return GARDEN_FIELD_GLOW[at], GARDEN_FIELD_GLOW[at + 1], GARDEN_FIELD_GLOW[at + 2], GARDEN_FIELD_GLOW[at + 3]
}

// The cursor over a bed's press while the pointer is on picture field FIELD
// (GardenFieldAt): a tap there opens that bed, so the press points; in the
// corners of its frame, off every painted bed, the calm arrow shows.
GardenPressCursor :: (field: s32) -> s32 {
    return ifx field >= 0 then 0 else cast(s32)CursorShape.CursorArrow
}

// A quiet, persistent garden. The host supplies the shared Back/sound title bar.
#import "kryon/app_context"
#import "kryon/app_protocol"
#import "kryon/pointer_input"
#import "kryon/frame_snapshot"
#import "kryon/text_align"
#import "kryon/geometry"
#import "kryon/image_props"
#import "kryon/image_widget"
#import, file "../../host/jungle_text.zi";
#import, file "garden.zi";
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "../../retro/book_theme.zi";
#import, file "../../retro/paper.zi";
#import, file "../../retro/paper_rules.zi";
#import, file "../../retro/collectibles.zi";

garden: Garden;
loaded: bool;
width: s32;
height: s32;
tray_height: s32;
press_map: bool;
held_seed: s32;
press_tool: s32 = -1;
focus_plot: s32;
water_plot: s32 = -1;
water_at: float64;
seed_plot: s32 = -1;
seed_at: float64;
last_tick: s64;
secret_paper: SecretPaper;

Save :: () -> bool { return DocumentWrite("garden.txt", GardenSave(garden)) }
Picture :: (name: string, x: s32, y: s32, w: s32, h: s32) {
    Image(retro.session, ImageProps.{.asset_path = Cat("assets/garden/art/", name, ".png"),
        .preview_path = Cat("assets/garden/previews/", name, ".png"),
        .bounds = RetroRect(x, y, w, h), .fit = ImageFit.ImageFitContain, .smooth = true, .alt_text = name})
}
TrayColumns :: () -> s32 { return ifx width < 600 then 4 else 7 }
ToolAt :: (x: s32, y: s32) -> s32 {
    columns := TrayColumns()
    rows: s32 = ifx columns == 4 then 2 else 1
    cell_w := (width - 16) / columns
    cell_h := (tray_height - 16) / rows
    if x < 8 || x >= 8 + cell_w * columns || y < 8 || y >= tray_height - 8 { return -1 }
    index := (y - 8) / cell_h * columns + (x - 8) / cell_w
    if index > 6 { return -1 }
    return ifx index == 6 then 0 else index + 1
}
PlotX :: (plot: s32) -> s32 {
    return width * garden.plots[plot].x / 1000
}
PlotY :: (plot: s32) -> s32 {
    return tray_height + (height - tray_height) * garden.plots[plot].y / 1000
}
PlotEdge :: (plot: s32, now: s64) -> s32 {
    p := garden.plots[plot]
    edge := width * 24 / 100
    cap := (height - tray_height) * 34 / 100
    if edge > cap { edge = cap }
    edge = edge * DepthScale(garden.plots[plot].y) / 100
    if !p.dead && !GardenDry(p, now) {
        stage := GardenStage(p)
        if stage == 0 { edge = edge * 34 / 100 }
        if stage == 1 { edge = edge * 45 / 100 }
        if stage == 2 { edge = edge * 75 / 100 }
    }
    return edge
}
MapX :: (x: s32) -> s32 { return x * 1000 / width }
MapY :: (y: s32) -> s32 { return (y - tray_height) * 1000 / (height - tray_height) }
DepthScale :: (y: s32) -> s32 { return GardenDepthScale(y) }
PlotAt :: (x: s32, y: s32) -> s32 {
    // Reverse the actual paint order: frontmost visible plant owns overlaps.
    order := GardenDrawOrder(garden)
    i: s32 = GARDEN_PLOTS - 1
    while i >= 0 {
        plot := order[i]
        if garden.plots[plot].kind != 0 {
            edge := PlotEdge(plot, cast(s64)retro.now)
            if edge < 36 { edge = 36 }
            if x >= PlotX(plot) - edge / 2 && x < PlotX(plot) + edge / 2 && y >= PlotY(plot) - edge && y <= PlotY(plot) + 10 { return plot }
        }
        i -= 1
    }
    return -1
}
ChooseTool :: (tool: s32) {
    // Tapping the held packet again puts its seed back; Water also cancels.
    if tool == held_seed && held_seed > 0 { held_seed = 0; garden.selected = 0 }
    else { garden.selected = tool; held_seed = tool }
    unused Save()
}
UsePlot :: (plot: s32, now: s64) {
    if plot < 0 || plot >= GARDEN_PLOTS || held_seed > 0 { return }
    GardenTick(*garden.plots[plot], now)
    if garden.plots[plot].dead {
        unused GardenClear(*garden, plot, now)
        unused Save(); return
    }
    if garden.selected == 0 && GardenWater(*garden, plot, now) {
        water_plot = plot; water_at = retro.now
        unused Save()
    }
}
PlaceSeed :: (x: s32, y: s32, now: s64) {
    if held_seed == 0 { return }
    plot := GardenPlantAt(*garden, held_seed, x, y, now)
    if plot < 0 { return } // Invalid drops retain the one held seed.
    seed_plot = plot; seed_at = retro.now; held_seed = 0
    unused Save()
}
SeedShape :: (cx: s32, base: s32, depth: s32) {
    edge := 20 * DepthScale(depth) / 100
    BookBox(cx - edge / 2, base - edge, edge, edge, 0x825c37ff, 0x65452dff, cast(float32)edge / 2.0)
    BookBox(cx - edge / 4, base - edge + 3, edge / 3, edge / 2, 0xd0aa70ff, 0, cast(float32)edge / 5.0)
}
Seed :: (plot: s32, cx: s32, base: s32) {
    elapsed := retro.now - seed_at
    if seed_plot == plot && elapsed >= 0 && elapsed < 0.9 {
        remaining := 1.0 - elapsed / 0.9
        base -= cast(s32)(48.0 * remaining * remaining)
    }
    SeedShape(cx, base, garden.plots[plot].y)
}
Tray :: () {
    BookBox(6, 4, width - 12, tray_height - 8, 0xeadcc1ff, 0xc4ad83ff, 16)
    columns := TrayColumns()
    rows: s32 = ifx columns == 4 then 2 else 1
    cw := (width - 16) / columns
    ch := (tray_height - 16) / rows
    for i: cast(s32)0..6 {
        tool := ifx i == 6 then 0 else i + 1
        x := 8 + i % columns * cw
        y := 8 + i / columns * ch
        if garden.selected == tool && (tool == 0 || held_seed > 0) { BookBox(x + 2, y + 1, cw - 4, ch - 2, 0xfff7d5ff, 0xa3ad75ff, 12) }
        name := ifx tool == 0 then "watering-can" else Cat(GardenKind(tool), "-packet")
        Picture(name, x + 4, y + 2, cw - 8, ch - 24)
        BookText(x + 2, y + ch - 23, cw - 4, 20, GardenName(tool), 12, TextAlign.TextAlignCenter, false)
    }
}
Scene :: (now: s64) {
    Image(retro.session, ImageProps.{.asset_path = "assets/garden/art/bed.png", .preview_path = "assets/garden/previews/bed.png",
        .bounds = RetroRect(0, tray_height, width, height - tray_height), .fit = ImageFit.ImageFitStretch, .smooth = true,
        .alt_text = GardenText("Garden bed", "Gartenbeet", "Huerto")})
    // Ground depth determines overlap, independent of storage slot.
    order := GardenDrawOrder(garden)
    for i: order {
        p := garden.plots[i]
        cx := PlotX(i); base := PlotY(i)
        if p.kind == 0 { continue }
        stage := GardenStage(p)
        if stage == 0 && !p.dead && !GardenDry(p, now) { Seed(i, cx, base); continue }
        suffix := ifx stage < 2 then "sprout" else ifx stage == 2 then "small" else "mature"
        if GardenDry(p, now) { suffix = "dry" }
        if p.dead { suffix = "withered" }
        edge := PlotEdge(i, now)
        Picture(Cat(GardenKind(p.kind), "-", suffix), cx - edge / 2, base - edge, edge, edge)
        // Thirst is visible without any spoken instruction.
        if GardenDry(p, now) { Picture("water-drop", cx + edge / 4, base - edge - 12, 20, 24) }
    }
    elapsed := retro.now - water_at
    if water_plot >= 0 && elapsed >= 0 && elapsed < 1.2 {
        cx := PlotX(water_plot); base := PlotY(water_plot)
        Picture("watering-can", cx - 72, base - 125, 84, 84)
        for drop: cast(s32)0..4 {
            fall := (cast(s32)(elapsed * 160) + drop * 19) % 76
            Picture("water-drop", cx - 10 + drop * 4, base - 72 + fall, 12, 17)
        }
    }
}
GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY { loaded = false; AppIdentity("jungle.garden"); AppDescribe("Grow a Garden", ""); return APP_PROTOCOL }
    if mode == APP_SAVE { return ifx !loaded || Save() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    bounds := AppBounds()
    scale := bounds.width / 400.0
    if bounds.height / 640.0 < scale { scale = bounds.height / 640.0 }
    if bounds.width > bounds.height {
        scale = bounds.height / 430.0
        if bounds.width / 760.0 < scale { scale = bounds.width / 760.0 }
    }
    if scale > 1.8 { scale = 1.8 }
    if scale <= 0 { return 0 }
    retro = Retro.{.session = AppSession(), .x = bounds.x, .y = bounds.y, .scale = scale, .now = AppNow(), .key = AppKey()}
    width = cast(s32)(bounds.width / scale); height = cast(s32)(bounds.height / scale)
    tray_height = ifx width < 600 then 180 else 94
    now := cast(s64)retro.now
    BookPalette(); BookBox(0, 0, width, height, 0xfffcf3ff)
    if !loaded {
        if !DocumentStorageReady() { Scene(now); Tray(); return 0 }
        text := DocumentRead("garden.txt")
        if !GardenRead(text, *garden) && !GardenMigrate(text, *garden, now) { garden = Garden.{.selected = 1} }
        loaded = true; press_map = false; held_seed = 0; press_tool = -1; water_plot = -1; seed_plot = -1; last_tick = 0
    }
    if now != last_tick {
        for i: cast(s32)0..GARDEN_PLOTS - 1 { GardenTick(*garden.plots[i], now) }
        // Moist time is also reconciled on reopen; persist once a minute.
        if now / 60 != last_tick / 60 { unused Save() }
        last_tick = now
    }
    if retro.key == KEY_ESCAPE {
        if held_seed > 0 { ChooseTool(0) }
        else { unused Save(); GameHome(); return 0 }
    }
    if retro.key >= 49 && retro.key <= 54 { ChooseTool(retro.key - 48) }
    if retro.key == 87 { ChooseTool(0) }
    if retro.key == KEY_LEFT { focus_plot = (focus_plot + 5) % 6 }
    if retro.key == KEY_RIGHT { focus_plot = (focus_plot + 1) % 6 }
    if retro.key == KEY_DOWN || retro.key == KEY_UP { focus_plot = (focus_plot + 3) % 6 }
    if retro.key == KEY_ENTER {
        if held_seed > 0 { PlaceSeed(GardenDefaultX(focus_plot), GardenDefaultY(focus_plot), now) }
        else { UsePlot(focus_plot, now) }
    }
    pointer := SamplePointer()
    // AppBounds and SamplePointer share host logical coordinates, including zoom.
    px := cast(s32)((pointer.x - retro.x) / retro.scale)
    py := cast(s32)((pointer.y - retro.y) / retro.scale)
    snapshot := CaptureFrameInput(retro.session)
    active := !snapshot.available || snapshot.focused
    if !active { press_map = false; press_tool = -1; held_seed = 0 }
    if active && snapshot.secondary.pressed { ChooseTool(0); press_map = false; press_tool = -1 }
    // The sunflower's hidden paper sits clear of every plant and tool; a tap on
    // it is the paper's and never plants, waters or picks. A flight begun finishes anywhere.
    paper_show, paper_x, paper_y := GardenPaperSpot(garden, width, height)
    paper_index := CollectibleForGame("jungle-garden.zx")
    paper_size := SecretPaperSize(ifx bounds.width < bounds.height then bounds.width else bounds.height, retro.scale)
    over_paper := paper_show && paper_index >= 0 && SecretPaperShown(secret_paper, paper_index, GameCollected(collectible_ids[paper_index])) &&
        SecretPaperHit(paper_x, paper_y, paper_size, px, py)
    if active && pointer.pressed && !over_paper {
        press_tool = ToolAt(px, py)
        press_map = px >= 0 && px < width && py >= tray_height && py < height
        if press_tool >= 0 { ChooseTool(press_tool) }
    }
    if active && pointer.released {
        if px >= 0 && px < width && py >= tray_height && py < height && (press_tool >= 0 || press_map) {
            if held_seed > 0 { PlaceSeed(MapX(px), MapY(py), now) }
            else { UsePlot(PlotAt(px, py), now) }
        }
        press_tool = -1; press_map = false
    }
    Scene(now); Tray()
    if paper_show || secret_paper.state == SECRET_PAPER_FLYING {
        unused SecretPaperFrame(*secret_paper, paper_index, paper_x, paper_y, retro.now)
    }
    if active && px >= 0 && px < width && py >= tray_height && py < height {
        if held_seed > 0 {
            valid := GardenPlaceSlot(garden, MapX(px), MapY(py)) >= 0
            BookBox(px - 12, py - 4, 24, 8, 0, ifx valid then cast(u32)0xdce8a5ff else cast(u32)0xc37c60ff, 4)
            SeedShape(px, py - 7, MapY(py))
        } else if garden.selected == 0 {
            Picture("watering-can", px - 34, py - 64, 68, 68)
        }
    }
    return 0
}
#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

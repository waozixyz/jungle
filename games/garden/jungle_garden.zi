// Farm is the approved painting; the host owns Back and sound controls.
#import "kryon/app_context"
#import "kryon/app_protocol"
#import "kryon/image_props"
#import "kryon/image_widget"
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY { AppIdentity("jungle.garden"); AppDescribe("Farm", ""); return APP_PROTOCOL }
    // Legacy garden.txt is deliberately neither read nor rewritten.
    if mode != APP_FRAME { return 0 }
    if AppKey() == KEY_ESCAPE { GameHome(); return 0 }
    bounds := AppBounds()
    path := ifx bounds.width < bounds.height then "assets/garden/art/scene-portrait.webp" else "assets/garden/art/scene-landscape.webp"
    shown := RetroImageShown(path)
    if shown != "" {
        Image(AppSession(), ImageProps.{.asset_path = shown, .preview_path = RetroImagePreview(path),
            .bounds = bounds, .fit = ImageFit.ImageFitContain, .smooth = true, .alt_text = "Farm"})
    }
    return 0
}
#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

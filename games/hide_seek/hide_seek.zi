// Hide & Seek rules and validated saves, without drawing.
// One gentle hide-and-find game. Each round is one of four scenes with its
// own natural hiding places: a basket (in), a bush (behind), a table (under)
// or a tree (up in). Friends hide in all but one place and stay completely
// out of sight until the child looks there; nothing peeks, previews or names
// the friend before it is found. A round is done once every friend is found,
// and the next round moves to the next scene.
#import "std/format"
#import, file "../../host/jungle_text.zi";
#import, file "../../retro/language.zi";

// Earlier saves held one of three levels; every level now loads as this one
// hide-and-find game, keeping its counts.
HIDE_MODES :: 3
HIDE_PEEKABOO :: 0
HIDE_FIND :: 1
HIDE_REMEMBER :: 2
HIDE_KINDS :: 4
HIDE_MAX_PLACES :: 4
HIDE_ANIMALS :: 12
HIDE_MAX_ROUNDS :: 100000
HIDE_SCENES :: 4
HIDE_SLOTS :: 3

// Hiding places, each teaching its own position word.
HIDE_BASKET :: 0
HIDE_BUSH :: 1
HIDE_TABLE :: 2
HIDE_TREE :: 3

// Scenes, in the order the rounds visit them.
HIDE_COTTAGE_YARD :: 0
HIDE_FENCED_GARDEN :: 1
HIDE_COZY_HOUSE :: 2
HIDE_FARM_COURTYARD :: 3

// What tapping a place did.
HIDE_IGNORED :: 0
HIDE_REVEALED :: 1
HIDE_EMPTY :: 2
HIDE_AGAIN :: 3

// How much of a hiding friend shows: nothing until found.
HIDE_NO_PEEK :: 0
HIDE_SHOWN :: 3

hide_animals: [12]string = .["frog", "rabbit", "cat", "dog", "monkey", "panda", "duck", "hen", "pig",
    "sheep", "tiger", "parrot"];
hide_positions: [4]string = .["in", "behind", "under", "up"];

// Every scene's hiding places, back to front so nearer props are painted
// last: outdoors a tree, bush and basket; indoors a table and basket; the
// farm a table, bush and basket. -1 marks an unused slot.
hide_slot_kinds: [12]s32 = .[3, 1, 0, 1, 3, 0, 2, 0, -1, 2, 1, 0];
// Per mille of the stage: centre x, ground line, size by height and size
// by width, for tall (portrait) and wide (landscape) stages. Depths vary:
// far props sit higher and smaller, near ones lower and larger.
hide_tall_x: [12]s32 = .[270, 700, 360, 240, 730, 300, 520, 330, 0, 330, 700, 330];
hide_tall_ground: [12]s32 = .[500, 660, 905, 470, 640, 915, 640, 925, 0, 520, 700, 930];
hide_tall_size_h: [12]s32 = .[260, 250, 270, 200, 300, 270, 600, 280, 0, 450, 250, 270];
hide_tall_size_w: [12]s32 = .[480, 400, 420, 320, 420, 420, 760, 420, 0, 560, 400, 420];
hide_wide_x: [12]s32 = .[180, 520, 800, 200, 520, 830, 360, 740, 0, 230, 560, 840];
hide_wide_ground: [12]s32 = .[640, 740, 925, 700, 760, 930, 790, 930, 0, 700, 800, 935];
hide_wide_size_h: [12]s32 = .[380, 380, 420, 330, 420, 400, 820, 430, 0, 640, 360, 400];
hide_wide_size_w: [12]s32 = .[220, 200, 200, 180, 230, 190, 400, 200, 0, 300, 200, 190];

HideSeek :: struct {
    // Always HIDE_FIND; kept so saves stay readable by earlier releases.
    mode: s32
    // Friends found.
    rounds: s32
    // Friends found in the earlier Remember level, kept in the save.
    remembered: s32
    scene: s32
    // The scene's arrangement, mirrored left to right.
    mirror: bool
    places: s32
    kinds: [4]s32
    animals: [4]s32
    // Which places hide a friend; the others are empty.
    hides: [4]bool
    revealed: [4]bool
    // Places already looked at.
    looked: [4]bool
}

HideSeekPlaces :: (scene: s32) -> s32 {
    if scene < 0 || scene >= HIDE_SCENES { return 0 }
    places: s32
    for slot: cast(s32)0..HIDE_SLOTS - 1 { if hide_slot_kinds[scene * HIDE_SLOTS + slot] >= 0 { places += 1 } }
    return places
}

HideSeekSlotKind :: (scene: s32, place: s32) -> s32 {
    if scene < 0 || scene >= HIDE_SCENES || place < 0 || place >= HIDE_SLOTS { return -1 }
    return hide_slot_kinds[scene * HIDE_SLOTS + place]
}

HideSeekRandom :: (random: *s64) -> s64 {
    random.* = (random.* * 48271) % 2147483647
    return random.*
}

// This round's friends, as a bit per animal for the next round to leave out.
HideSeekAvoid :: (h: HideSeek) -> s32 {
    mask: s32
    for i: cast(s32)0..h.places - 1 {
        if h.hides[i] && h.animals[i] >= 0 && h.animals[i] < HIDE_ANIMALS { mask |= 1 << h.animals[i] }
    }
    return mask
}

// A new round depending only on its arguments. `avoid` (see HideSeekAvoid)
// keeps the previous friends out of the round. A scene outside 0..3 comes
// from the seed. Any earlier level is the one hide-and-find game.
HideSeekNew :: (mode: s32, seed: s32, rounds: s32 = 0, avoid: s32 = -1, remembered: s32 = 0, scene: s32 = -1) -> HideSeek {
    h := HideSeek.{.mode = HIDE_FIND, .rounds = rounds, .remembered = remembered}
    if h.rounds < 0 || h.rounds > HIDE_MAX_ROUNDS { h.rounds = 0 }
    if h.remembered < 0 || h.remembered > HIDE_MAX_ROUNDS { h.remembered = 0 }
    random: s64 = cast(s64)(seed & 0x7fffffff) % 2147483646 + 1
    h.scene = ifx scene >= 0 && scene < HIDE_SCENES then scene else cast(s32)(HideSeekRandom(*random) % cast(s64)HIDE_SCENES)
    h.places = HideSeekPlaces(h.scene)
    h.mirror = (HideSeekRandom(*random) & 1) == 1
    // Leave out at most the previous round's friends, so enough remain.
    skip: s32 = ifx avoid > 0 && avoid < (1 << HIDE_ANIMALS) then avoid else 0
    skipped: s32
    for a: cast(s32)0..HIDE_ANIMALS - 1 { if (skip & (1 << a)) != 0 { skipped += 1 } }
    if skipped > HIDE_ANIMALS - HIDE_MAX_PLACES { skip = 0 }
    animals: [12]s32
    count: s32
    for a: cast(s32)0..HIDE_ANIMALS - 1 { if (skip & (1 << a)) == 0 { animals[count] = a; count += 1 } }
    empty := cast(s32)(HideSeekRandom(*random) % cast(s64)h.places)
    for i: cast(s32)0..h.places - 1 {
        h.kinds[i] = HideSeekSlotKind(h.scene, i)
        k := i + cast(s32)(HideSeekRandom(*random) % cast(s64)(count - i))
        swap := animals[i]; animals[i] = animals[k]; animals[k] = swap
        h.animals[i] = animals[i]
        h.hides[i] = i != empty
    }
    return h
}

HideSeekHides :: (h: HideSeek, place: s32) -> bool {
    if place < 0 || place >= h.places { return false }
    return h.hides[place]
}

HideSeekFriends :: (h: HideSeek) -> s32 {
    friends: s32
    for i: cast(s32)0..h.places - 1 { if h.hides[i] { friends += 1 } }
    return friends
}

// A friend is drawn only once it has been found.
HideSeekPeek :: (h: HideSeek, place: s32) -> s32 {
    if !HideSeekHides(h, place) || !h.revealed[place] { return HIDE_NO_PEEK }
    return HIDE_SHOWN
}

HideSeekDone :: (h: HideSeek) -> bool {
    if h.places <= 0 { return false }
    for i: cast(s32)0..h.places - 1 { if h.hides[i] && !h.revealed[i] { return false } }
    return true
}

HideSeekFound :: (h: HideSeek) -> s32 {
    found: s32
    for i: cast(s32)0..h.places - 1 { if h.revealed[i] { found += 1 } }
    return found
}

// Looks at a place. An empty place only remembers it was looked at; a
// found friend can be tapped again; a finished round ignores other taps.
HideSeekTap :: (h: *HideSeek, place: s32) -> s32 {
    if place < 0 || place >= h.places { return HIDE_IGNORED }
    if h.revealed[place] { return HIDE_AGAIN }
    if HideSeekDone(h.*) { return HIDE_IGNORED }
    h.looked[place] = true
    if !h.hides[place] { return HIDE_EMPTY }
    h.revealed[place] = true
    if h.rounds < HIDE_MAX_ROUNDS { h.rounds += 1 }
    return HIDE_REVEALED
}

// The next round moves to the next scene with other friends.
HideSeekNext :: (h: HideSeek, seed: s32) -> HideSeek {
    scene := ifx h.scene >= 0 && h.scene < HIDE_SCENES then (h.scene + 1) % HIDE_SCENES else 0
    return HideSeekNew(HIDE_FIND, seed, h.rounds, HideSeekAvoid(h), h.remembered, scene)
}

// A completed round moves on by itself once its gentle celebration ends.
// Unfinished rounds never move.
HIDE_CELEBRATE_SECONDS :: 2.5
HideSeekAdvanceReady :: (h: HideSeek, elapsed: float64) -> bool {
    return HideSeekDone(h) && elapsed >= HIDE_CELEBRATE_SECONDS
}

HideSeekAdvance :: (h: HideSeek, seed: s32) -> HideSeek {
    if !HideSeekDone(h) { return h }
    return HideSeekNext(h, seed)
}

// A held activation belongs to the round where it began. The release frame
// stays blocked so Press cannot turn it into a new click.
HideSeekInputGuard :: (guarded: bool, pointer_down: bool, pointer_released: bool, enter_down: bool) -> bool {
    return guarded && (pointer_down || pointer_released || enter_down)
}

// Original 420px cut-out foot/claw supports. Monkey and parrot tails extend
// below their feet, so the alpha bounding-box bottom is not their support.
hide_animal_feet: [12]s32 = .[377, 408, 399, 386, 342, 412, 412, 412, 386, 397, 381, 352];

// Measured opaque extents of the unchanged square 1254px props: support
// line, top, left and right. Layout uses one scale for both axes.
HIDE_PROP_PIXELS :: 1254
hide_prop_bases: [4]s32 = .[1085, 1120, 1038, 1235];
hide_prop_tops: [4]s32 = .[376, 288, 265, 11];
hide_prop_lefts: [4]s32 = .[36, 19, 22, 16];
hide_prop_rights: [4]s32 = .[1229, 1237, 1231, 1240];

// The square bitmap edge for a prop of this size.
HideSeekPropEdge :: (kind: s32, size: s32) -> s32 {
    if kind == HIDE_BUSH { return size }
    if kind == HIDE_TREE { return size * 135 / 100 }
    return size * 105 / 100
}

HideSeekArt :: struct {
    x: s32
    y: s32
    edge: s32
    animal_cx: s32
    animal_base: s32
    animal_edge: s32
    // The friend is drawn before the whole, uncropped prop, so the prop
    // covers it naturally; otherwise it sits in front (on a tree branch).
    behind: bool
}

// Where a found friend stands. The prop is always drawn whole: a friend in
// the basket rises above its back rim, one behind the bush steps out past
// its side, one under the table stands between the legs below the cloth,
// and one up in the tree sits on its low left branch. Feet never move.
// `toward` is the side of the open stage (see HideSeekPlaceLayout).
HideSeekArtLayout :: (kind: s32, cx: s32, ground: s32, size: s32, progress: float32, animal: s32 = 0, toward: s32 = -1) -> HideSeekArt {
    p := progress
    if p < 0.0 { p = 0.0 }; if p > 1.0 { p = 1.0 }
    k := ifx kind < 0 || kind >= HIDE_KINDS then HIDE_BASKET else kind
    edge := HideSeekPropEdge(k, size)
    x := cx - edge / 2
    y := ground - edge * hide_prop_bases[k] / HIDE_PROP_PIXELS
    art := HideSeekArt.{.x = x, .y = y, .edge = edge, .behind = true}
    if k == HIDE_BASKET {
        art.animal_cx = x + edge * 632 / HIDE_PROP_PIXELS
        art.animal_base = y + edge * 640 / HIDE_PROP_PIXELS
        art.animal_edge = edge * 56 / 100
    } else if k == HIDE_BUSH {
        // Out toward the open middle of the stage, never off its edge.
        side: s32 = ifx toward > 0 then 1 else -1
        art.animal_cx = cx + side * (size * 36 / 100 + cast(s32)(p * cast(float32)size * 0.12))
        art.animal_base = ground
        art.animal_edge = size * 50 / 100
    } else if k == HIDE_TABLE {
        // The front legs stand at 167-261 and 995-1092, the back legs end
        // at 880 and the cloth's hem at 715: the friend stays inside them.
        art.animal_cx = x + edge * (590 + cast(s32)(p * 38.0)) / HIDE_PROP_PIXELS
        art.animal_base = y + edge * 1000 / HIDE_PROP_PIXELS
        art.animal_edge = edge * 22 / 100
    } else {
        // The low left branch's top is at 630-640 around x 235.
        art.animal_cx = x + edge * 235 / HIDE_PROP_PIXELS
        art.animal_base = y + edge * 640 / HIDE_PROP_PIXELS
        art.animal_edge = edge * 26 / 100
        art.behind = false
    }
    return art
}

// Grounded stage geometry for one scene, independent of reveal state or
// time. Places come back to front; each hit region is its prop's own
// opaque box, so places never share a tap.
HideSeekPlaceLayout :: struct {
    kind: s32
    // 1 when the open middle of the stage is to the right, else -1.
    toward: s32
    cx: s32
    ground: s32
    size: s32
    x: s32
    y: s32
    width: s32
    height: s32
}

HideSeekSceneLayout :: (width: s32, height: s32, places: s32, place: s32, scene: s32 = 0, mirror: bool = false) -> HideSeekPlaceLayout {
    s := ifx scene < 0 || scene >= HIDE_SCENES then 0 else scene
    slot := ifx place < 0 || place >= HideSeekPlaces(s) || place >= places then 0 else place
    at := s * HIDE_SLOTS + slot
    tall := width < height
    fx := ifx tall then hide_tall_x[at] else hide_wide_x[at]
    if mirror { fx = 1000 - fx }
    ground := height * (ifx tall then hide_tall_ground[at] else hide_wide_ground[at]) / 1000
    size := height * (ifx tall then hide_tall_size_h[at] else hide_wide_size_h[at]) / 1000
    by_width := width * (ifx tall then hide_tall_size_w[at] else hide_wide_size_w[at]) / 1000
    if by_width < size { size = by_width }
    kind := hide_slot_kinds[at]
    // The prop's top stays on the stage.
    room := (ground - 4) * HIDE_PROP_PIXELS / (hide_prop_bases[kind] - hide_prop_tops[kind])
    if HideSeekPropEdge(kind, size) > room { size = size * room / HideSeekPropEdge(kind, size) }
    if size < 1 { size = 1 }
    edge := HideSeekPropEdge(kind, size)
    cx := width * fx / 1000
    if cx - edge / 2 < 0 { cx = edge / 2 }
    if cx + edge - edge / 2 > width { cx = width - edge + edge / 2 }
    left := cx - edge / 2
    top := ground - edge * (hide_prop_bases[kind] - hide_prop_tops[kind]) / HIDE_PROP_PIXELS
    x := left + edge * hide_prop_lefts[kind] / HIDE_PROP_PIXELS
    return HideSeekPlaceLayout.{.kind = kind, .toward = ifx cx < width / 2 then 1 else -1, .cx = cx, .ground = ground, .size = size,
        .x = x, .y = top, .width = left + edge * hide_prop_rights[kind] / HIDE_PROP_PIXELS - x, .height = ground - top}
}

HideSeekRoundLayout :: (h: HideSeek, width: s32, height: s32, place: s32) -> HideSeekPlaceLayout {
    return HideSeekSceneLayout(width, height, h.places, place, h.scene, h.mirror)
}

HideSeekKind :: (h: HideSeek, place: s32) -> s32 {
    if place < 0 || place >= h.places { return h.kinds[0] }
    return h.kinds[place]
}

// The spoken answer once a friend is found: its place, never its name.
HideSeekCue :: (kind: s32) -> string {
    return ifx kind < 0 || kind >= HIDE_KINDS then hide_positions[0] else hide_positions[kind]
}

HideSeekCuePath :: (cue: string, code: string) -> string {
    return Cat("assets/hide_seek/sounds/", code, "/", cue, ".wav")
}

// Only the friends found are kept; a round starts fresh.
HideSeekText :: (h: HideSeek) -> string {
    return Cat("hideseek 2 ", NumberText(h.mode), " ", NumberText(h.rounds), " ", NumberText(h.remembered), "\n")
}

// Reads "hideseek 2 <level> <found> <remembered>", or the earlier
// "hideseek 1 <mode> <found>" with its two modes. The caller loads any
// level as the one hide-and-find game.
HideSeekRead :: (text: string, mode: *s32, rounds: *s32, remembered: *s32) -> bool {
    if text.count < 11 || text[:9] != "hideseek " || text[10] != #char " " { return false }
    version := text[9]
    if version != #char "1" && version != #char "2" { return false }
    modes: s32 = ifx version == #char "1" then 2 else HIDE_MODES
    at: s64 = 11
    saved_mode := ReadWhole(text, *at)
    if saved_mode < 0 || saved_mode >= modes || at >= text.count || text[at] != #char " " { return false }
    at += 1
    saved_rounds := ReadWhole(text, *at)
    if saved_rounds < 0 || saved_rounds > HIDE_MAX_ROUNDS { return false }
    saved_remembered: s32
    if version == #char "2" {
        if at >= text.count || text[at] != #char " " { return false }
        at += 1
        saved_remembered = ReadWhole(text, *at)
        if saved_remembered < 0 || saved_remembered > HIDE_MAX_ROUNDS { return false }
    }
    if at < text.count && text[at] == #char "\n" { at += 1 }
    if at != text.count { return false }
    mode.* = saved_mode; rounds.* = saved_rounds; remembered.* = saved_remembered
    return true
}

// Game-local English, German and Spanish wording.
HideSeekWords :: (en: string, de: string, es: string) -> string {
    if language == 1 { return de }
    if language == 2 { return es }
    return en
}

// The spoken answer for a kind of place, as written words.
HideSeekPlaceWords :: (kind: s32) -> string {
    if kind == HIDE_BUSH { return HideSeekWords("Behind the bush!", "Hinter dem Busch!", "¡Detrás del arbusto!") }
    if kind == HIDE_TABLE { return HideSeekWords("Under the table!", "Unter dem Tisch!", "¡Debajo de la mesa!") }
    if kind == HIDE_TREE { return HideSeekWords("Up in the tree!", "Oben im Baum!", "¡Arriba en el árbol!") }
    return HideSeekWords("In the basket!", "Im Korb!", "¡En la cesta!")
}

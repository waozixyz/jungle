// Hide & Seek: friendly animals hide in a basket, behind a bush, under a
// table or up in a tree, in four different scenes. Nothing shows where they
// are: the child looks behind each hiding place to find them all, then the
// friends hide again in the next scene.
#import "kryon/app_context"
#import "kryon/app_protocol"
#import "kryon/geometry"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/frame_snapshot"
#import "kryon/input_protocol"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "kryon/drawing_props"
#import "kryon/text_align"
#import "kryon/text_props"
#import "kryon/text_widget"
#import "std/utf8"
Heart :: #import "mingcute/mingcute_filled_heart";
Search :: #import "mingcute/mingcute_regular_search";
Again :: #import "mingcute/mingcute_regular_refresh_2";
Next :: #import "mingcute/mingcute_regular_arrow_right";
Volume :: #import "mingcute/mingcute_regular_volume";
#import, file "hide_seek.zi";
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "../../retro/book_theme.zi";
#import, file "../../host/jungle_text.zi";
#import, file "../../retro/language.zi";

SAVE_FILE :: "hide_seek.txt"
REVEAL_SECONDS :: 0.6
// An empty place wiggles briefly and the card says to keep looking.
WIGGLE_SECONDS :: 0.45
NOTE_SECONDS :: 1.8
// A queued prompt waits this long at most for the answer before it.
VOICE_WAIT_SECONDS :: 6.0

game: HideSeek;
loaded: bool;
reveal_at: [4]float64;
looked_at: [4]float64;
// The last empty look or find, for the prompt card's short note.
note_at: float64;
note_kind: s32;
note_found: bool;
prompt_pending: bool;
voice_after: float64;
focus_place: s32;
keyboard_active: bool;
view_width: s32;
view_height: s32;
view_scale: float32;
round_serial: s32;
completed_at: float64;
input_guard: bool;

Words :: (en: string, de: string, es: string) -> string { return HideSeekWords(en, de, es) }

Save :: () -> bool { return DocumentWrite(SAVE_FILE, HideSeekText(game)) }

Seed :: () -> s32 { return cast(s32)(cast(s64)(retro.now * 1000.0) % 2147483646) }

ItemPath :: (animal: s32) -> string { return Cat("assets/jungle-book/items/", hide_animals[animal], ".png") }
CuePath :: (cue: string) -> string { return HideSeekCuePath(cue, LanguageCode()) }

// Speaks one cue. Friends are never named: the game only says
// "Peekaboo! Who is hiding?" and, once a friend is found, where it was.
Say :: (path: string) {
    unused AppService("jungle.voice", path)
    prompt_pending = false
    voice_after = retro.now + 0.35
}

Hush :: () {
    prompt_pending = false
    unused AppService("jungle.voice", "")
}

// A new round's prompt follows once the last answer has finished speaking.
SayQueued :: () {
    if !prompt_pending || retro.now < voice_after { return }
    state := AppService("jungle.voice-state", "")
    if (state == "playing" || state == "paused") && retro.now - voice_after <= VOICE_WAIT_SECONDS { return }
    SayPrompt()
}

SayPrompt :: () { Say(CuePath("peekaboo")) }

ResetMotion :: () {
    for i: cast(s32)0..HIDE_MAX_PLACES - 1 { reveal_at[i] = -10.0; looked_at[i] = -10.0 }
    note_at = -10.0
    completed_at = -1.0
    input_guard = true
    round_serial = (round_serial + 1) % 10000
    focus_place = 0
}

// The friends hide again in the next scene, keeping every count.
StartRound :: (automatic: bool = false) {
    if !automatic { Hush() }
    game = HideSeekNext(game, Seed())
    ResetMotion()
    unused Save()
    // The scene changes promptly, while the last answer finishes speaking
    // before this round's prompt.
    if automatic { prompt_pending = true } else { SayPrompt() }
}

Icon :: (shape: string, x: s32, y: s32, edge: s32, color: u32) {
    SvgIcon(retro.session, SvgIconProps.{.bounds = RetroRect(x, y, edge, edge), .shape = shape, .color = ColorFromPacked(color)})
}

Shadow :: (cx: s32, ground: s32, width: s32) {
    BookBox(cx - width / 2, ground - width / 14, width, width / 7, 0x6f8a5a2e, 0, cast(float32)width / 14.0)
}

// How far a reveal has gone, eased so friends settle softly.
Progress :: (at: float64, seconds: float64) -> float32 {
    t := (retro.now - at) / seconds
    if t <= 0.0 { return 0.0 }
    if t >= 1.0 { return 1.0 }
    return cast(float32)(1.0 - (1.0 - t) * (1.0 - t))
}

// A small fading side-to-side shake after looking somewhere empty.
Wiggle :: (at: float64, size: s32) -> s32 {
    t := (retro.now - at) / WIGGLE_SECONDS
    if t < 0.0 || t >= 1.0 { return 0 }
    amount := cast(s32)(cast(float64)size * 0.035 * (1.0 - t))
    return ifx cast(s32)(t * 6.0) % 2 == 0 then amount else -amount
}

// Draw the existing bitmap with its painted feet on the support. The
// transparent padding differs between animals; supports are measured at
// paws/claws in the unchanged 420px originals, rather than dangling tails.
AnimalGrounded :: (animal: s32, cx: s32, base: s32, edge: s32) {
    BookPicture(ItemPath(animal), cx - edge / 2, base - edge * hide_animal_feet[animal] / 420, edge, edge)
}

PropPath :: (kind: s32) -> string {
    names: [4]string = .["basket", "bush", "table", "tree"]
    return Cat("assets/hide_seek/props/", names[kind], ".png")
}

// The prop is always drawn whole and unchanged. A found friend stands
// behind it (in the basket, behind the bush, under the table) or sits in
// front on the tree's branch; a hiding friend is not drawn at all.
DrawPlace :: (kind: s32, cx: s32, ground: s32, size: s32, animal: s32, peek: s32, p: float32, toward: s32) {
    art := HideSeekArtLayout(kind, cx, ground, size, p, animal, toward)
    Shadow(cx, ground, size * 82 / 100)
    shown := peek == HIDE_SHOWN && animal >= 0 && animal < HIDE_ANIMALS
    if shown && art.behind { AnimalGrounded(animal, art.animal_cx, art.animal_base, art.animal_edge) }
    BookPicture(PropPath(kind), art.x, art.y, art.edge, art.edge)
    if shown && !art.behind { AnimalGrounded(animal, art.animal_cx, art.animal_base, art.animal_edge) }
}

LookPlace :: (place: s32) {
    result := HideSeekTap(*game, place)
    if result == HIDE_EMPTY {
        // Not here: the place wiggles quietly. No hint, no friend's name.
        looked_at[place] = retro.now
        note_at = retro.now; note_found = false
        return
    }
    if result != HIDE_REVEALED { return }
    reveal_at[place] = retro.now
    note_at = retro.now; note_found = true; note_kind = HideSeekKind(game, place)
    Say(CuePath(HideSeekCue(note_kind)))
    if HideSeekDone(game) && completed_at < 0.0 { completed_at = retro.now }
    unused Save()
}

ScenePath :: () -> string {
    names: [4]string = .["cottage-yard", "fenced-garden", "cozy-house", "farm-courtyard"]
    at := ifx game.scene < 0 || game.scene >= HIDE_SCENES then 0 else game.scene
    return Cat("assets/hide_seek/scenes/", names[at], ".png")
}

Scene :: (top: s32, bottom: s32) {
    margin: s32 = 12
    width := view_width - margin * 2; height := bottom - top
    if height < 40 || game.places <= 0 { return }
    BookBox(margin, top, width, height, 0xe5ead5ff, 0xdacdb5ff, 12.0)
    path := ScenePath()
    if RetroImageReady(path) {
        Image(retro.session, ImageProps.{.asset_path = path, .bounds = RetroRect(margin, top, width, height),
            .fit = ImageFit.ImageFitCover, .smooth = true, .radius = 12.0 * retro.scale})
    }
    done := HideSeekDone(game)
    // Places come back to front, so nearer props cover farther ones.
    for place: cast(s32)0..game.places - 1 {
        at := HideSeekRoundLayout(game, width, height, place)
        cx := margin + at.cx + Wiggle(looked_at[place], at.size); ground := top + at.ground
        label := Words("Hiding place", "Versteck", "Escondite")
        press := RetroTap(100 + round_serial * 4 + place, margin + at.x, top + at.y, at.width, at.height, label)
        if press.clicked && !input_guard { focus_place = place; keyboard_active = false; LookPlace(place) }
        p := ifx game.revealed[place] then Progress(reveal_at[place], REVEAL_SECONDS) else cast(float32)0.0
        DrawPlace(at.kind, cx, ground, at.size, game.animals[place], HideSeekPeek(game, place), p, at.toward)
        if game.revealed[place] && done {
            edge := at.size / 8
            Icon(Heart.Shape, cx - edge / 2, top + at.y - edge / 2, edge, 0xe4a77fff)
        }
    }
}

PromptWords :: () -> string {
    if HideSeekDone(game) { return Words("Well done! Next adventure...", "Gut gemacht! Weiter geht's...", "¡Muy bien! Otra aventura...") }
    if retro.now - note_at < NOTE_SECONDS {
        if note_found { return HideSeekPlaceWords(note_kind) }
        return Words("Not here. Keep looking!", "Hier nicht. Such weiter!", "¡Aquí no! Sigue buscando.")
    }
    return Words("Peekaboo! Who is hiding?", "Kuckuck! Wer versteckt sich da?", "¡Cucú! ¿Quién se esconde?")
}

// The card's words stay readable on a narrow phone: they wrap onto a second
// line at the usual size instead of shrinking onto one tiny line, and only
// shrink if even two lines could not hold them.
PromptText :: (x: s32, y: s32, width: s32, height: s32, text: string) {
    font: s32 = 20
    length := Count(text)
    if length > 0 && length * font * 3 > width * 10 { font = width * 10 / (length * 3) }
    if font < 12 { font = 12 }
    Text(retro.session, TextProps.{.bounds = RetroRect(x, y, width, height), .text = text,
        .font = cast(s32)(cast(float32)font * retro.scale), .align = TextAlign.TextAlignCenter,
        .vertical_align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapAuto})
}

// The prompt card: what to do and one dot for each hiding friend, filled
// once found; it never shows who hides or where. A tap says it again.
Prompt :: (y: s32, height: s32) {
    width := view_width - 32
    if width > 560 { width = 560 }
    x := (view_width - width) / 2
    text := PromptWords()
    press := RetroTap(10, x, y, width, height, text)
    BookBox(x, y, width, height, ifx press.down then cast(u32)0xf3ecdcff else cast(u32)0xfffcf3ff, 0xdacdb5ff, 12.0)
    edge := height - 16
    Icon(Volume.Shape, x + 12, y + (height - edge / 2) / 2, edge / 2, 0x2e6956ff)
    picture := x + 12 + edge / 2 + 8
    Icon(Search.Shape, picture + edge / 6, y + 8 + edge / 6, edge * 2 / 3, 0x6c9160ff)
    friends := HideSeekFriends(game)
    found := HideSeekFound(game)
    dot: s32 = 14
    dots := friends * (dot + 6)
    for i: cast(s32)0..friends - 1 {
        BookBox(x + width - 12 - dots + i * (dot + 6), y + (height - dot) / 2, dot, dot,
            ifx i < found then cast(u32)0xe4a77fff else cast(u32)0xf1e6d2ff, 0xd4b896ff, cast(float32)dot / 2.0)
    }
    left := picture + edge + 8
    PromptText(left, y, x + width - left - 16 - dots, height, text)
    if press.clicked && !input_guard { SayPrompt() }
}

Button :: (id: s32, x: s32, y: s32, width: s32, height: s32, label: string, shape: string, chosen: bool) -> bool {
    press := RetroTap(id, x, y, width, height, label)
    BookBox(x, y, width, height, ifx chosen || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
        ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
    edge := height - 26
    if edge > 4 { Icon(shape, x + (width - edge) / 2, y + 4, edge, 0x2e6956ff) }
    BookText(x + 2, y + height - 20, width - 4, 17, label, 12, TextAlign.TextAlignCenter, false)
    return press.clicked && !input_guard
}

// One action: the friends hide again in the next scene.
Controls :: (y: s32, height: s32) {
    each := view_width - 32
    if each > 190 { each = 190 }
    x := (view_width - each) / 2
    done := HideSeekDone(game)
    label := ifx done then Words("Next", "Weiter", "Otro") else Words("Hide again", "Nochmal", "Otra vez")
    if Button(23, x, y, each, height, label, ifx done then Next.Shape else Again.Shape, done) { StartRound() }
}

MoveFocus :: (step: s32) {
    if game.places <= 0 { return }
    if !keyboard_active { keyboard_active = true; return }
    focus_place = (focus_place + step + game.places * 4) % game.places
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        loaded = false
        AppIdentity("jungle.hide_seek"); AppDescribe("Hide & Seek", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx !loaded || Save() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    bounds := AppBounds()
    view_scale = bounds.width / 400.0
    if bounds.height / 700.0 < view_scale { view_scale = bounds.height / 700.0 }
    if bounds.width > bounds.height { view_scale = bounds.height / 520.0; if bounds.width / 780.0 < view_scale { view_scale = bounds.width / 780.0 } }
    if view_scale > 1.6 { view_scale = 1.6 }
    if view_scale < 0.5 { view_scale = 0.5 }
    retro = Retro.{.session = AppSession(), .x = bounds.x, .y = bounds.y, .scale = view_scale, .now = AppNow(), .key = AppKey()}
    view_width = cast(s32)(bounds.width / view_scale); view_height = cast(s32)(bounds.height / view_scale)
    BookPalette(); BookBox(0, 0, view_width, view_height, 0xfffcf3ff)
    if !loaded {
        // Any earlier level, including Peekaboo and Remember saves, loads
        // as this game with its counts; a damaged save starts fresh.
        saved_mode: s32; saved_rounds: s32; saved_remembered: s32
        if !HideSeekRead(DocumentRead(SAVE_FILE), *saved_mode, *saved_rounds, *saved_remembered) {
            saved_rounds = 0; saved_remembered = 0
        }
        game = HideSeekNew(HIDE_FIND, Seed(), saved_rounds, -1, saved_remembered)
        keyboard_active = false
        ResetMotion()
        prompt_pending = false
        loaded = true
        SayPrompt()
    }
    if retro.key == KEY_ESCAPE { Hush(); unused Save(); GameHome(); return 0 }
    input := CaptureFrameInput(retro.session)
    // A held pointer or key must release before it can look in the new
    // scene's places.
    input_guard = input.available && HideSeekInputGuard(input_guard, input.pointer.down,
        input.pointer.released, (input.keys[KEY_ENTER] & cast(u8)FrameKeyHeld) != 0)
    advanced := completed_at >= 0.0 && HideSeekAdvanceReady(game, retro.now - completed_at)
    if advanced { StartRound(true) }
    key := ifx input_guard || advanced then 0 else retro.key
    // Native repeats of a held activation must not solve the next round.
    if key == KEY_ENTER && input.available && (input.keys[KEY_ENTER] & cast(u8)FrameKeyPressed) == 0 { key = 0 }
    if key == KEY_LEFT || key == KEY_UP { MoveFocus(-1) }
    if key == KEY_RIGHT || key == KEY_DOWN { MoveFocus(1) }
    if key == 32 { SayPrompt() }
    if key == KEY_ENTER {
        if HideSeekDone(game) { StartRound() }
        else { keyboard_active = true; LookPlace(focus_place) }
    }
    SayQueued()
    controls_height: s32 = 66
    controls_y := view_height - controls_height - 12
    prompt_height: s32 = 64
    Prompt(10, prompt_height)
    Scene(10 + prompt_height + 10, controls_y - 12)
    Controls(controls_y, controls_height)
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

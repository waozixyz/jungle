// Jungle Math's four trails: what each question asks, its answer and three
// choices, and how a trail's level follows the child. No drawing here.

TRAIL_COUNT :: 0
TRAIL_STONES :: 1
TRAIL_ADD :: 2
TRAIL_TAKE :: 3
TRAILS :: 4
LEVELS :: 5
// Pictures a question can count: banana ... snail, as in assets/items.
ITEMS :: 8
STONES :: 5
CHOICES :: 3
// Right answers in a row that move a trail up, and misses that move it down.
LEVEL_UP_STREAK :: 4
LEVEL_DOWN_MISSES :: 3
// Fruit in the basket that bring a new friend.
BASKET :: 10
FRIENDS :: 8

Random :: struct {
    state: u32
}

RandomNext :: (random: *Random) -> u32 {
    value := random.state
    if value == cast(u32)0 { value = cast(u32)2463534242 }
    value = value ^ (value << 13)
    value = value ^ (value >> 17)
    value = value ^ (value << 5)
    random.state = value
    return value
}

// A whole number from low to high, both included.
RandomRange :: (random: *Random, low: s32, high: s32) -> s32 {
    if high <= low { return low }
    return low + cast(s32)(RandomNext(random) % cast(u32)(high - low + 1))
}

Question :: struct {
    trail: s32
    level: s32
    item: s32
    // Count: first. Add: first + second. Take: first - second.
    first: s32
    second: s32
    // Stepping stones: the row, the empty stone and the step between stones.
    stones: [STONES]s32
    missing: s32
    step: s32
    answer: s32
    choices: [CHOICES]s32
}

// How far a trail has come.
Skill :: struct {
    level: s32
    streak: s32
    misses: s32
}

SkillNew :: () -> Skill { return Skill.{.level = 1} }

// The largest count, sum or starting amount at each level.
CountMost :: (level: s32) -> s32 {
    most: [LEVELS]s32 = .[5, 8, 10, 15, 20]
    return most[Clamp(level, 1, LEVELS) - 1]
}

CountLeast :: (level: s32) -> s32 {
    least: [LEVELS]s32 = .[1, 3, 4, 7, 10]
    return least[Clamp(level, 1, LEVELS) - 1]
}

SumMost :: (level: s32) -> s32 {
    most: [LEVELS]s32 = .[5, 7, 10, 15, 20]
    return most[Clamp(level, 1, LEVELS) - 1]
}

Clamp :: (value: s32, low: s32, high: s32) -> s32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

Stones :: (question: *Question, random: *Random) {
    level := question.level
    step: s32 = 1
    start: s32 = 1
    if level == 1 { start = RandomRange(random, 1, 5) }
    if level == 2 { start = RandomRange(random, 1, 15) }
    // Counting back down: the row starts high and falls by one.
    if level == 3 { step = -1; start = RandomRange(random, 6, 20) }
    if level == 4 { step = 2; start = 2 * RandomRange(random, 0, 7) }
    if level == 5 {
        step = ifx RandomRange(random, 0, 1) == 0 then 5 else 10
        start = step * RandomRange(random, 0, 5)
    }
    for index: cast(s32)0..STONES - 1 { question.stones[index] = start + step * index }
    question.step = step
    // The first level always leaves the last stone empty: "what comes next?".
    question.missing = ifx level == 1 then STONES - 1 else RandomRange(random, 1, STONES - 1)
    question.answer = question.stones[question.missing]
}

// One question on a trail, never the same as `previous`.
Ask :: (trail: s32, level: s32, random: *Random, previous: *Question) -> Question {
    question: Question
    attempt: s32 = 0
    while true {
        question = Question.{.trail = trail, .level = Clamp(level, 1, LEVELS), .item = RandomRange(random, 0, ITEMS - 1)}
        if trail == TRAIL_COUNT {
            question.first = RandomRange(random, CountLeast(question.level), CountMost(question.level))
            question.answer = question.first
        } else if trail == TRAIL_STONES {
            Stones(*question, random)
        } else if trail == TRAIL_ADD {
            total := RandomRange(random, 2, SumMost(question.level))
            // Later levels keep the second group small enough to count on.
            most_second := ifx question.level >= 4 then 5 else total - 1
            question.second = RandomRange(random, 1, Clamp(most_second, 1, total - 1))
            question.first = total - question.second
            question.answer = total
        } else {
            question.first = RandomRange(random, 2, SumMost(question.level))
            // The first level always leaves something behind.
            most_taken := ifx question.level == 1 then question.first - 1 else question.first
            question.second = RandomRange(random, 1, Clamp(most_taken, 1, 9))
            question.answer = question.first - question.second
        }
        attempt += 1
        same := question.first == previous.first && question.second == previous.second &&
        question.answer == previous.answer && question.trail == previous.trail
        if !same || attempt > 8 { break }
    }
    Choose(*question, random)
    return question
}

// The answer and two near misses, in a random order.
Choose :: (question: *Question, random: *Random) {
    // Rows that count by twos, fives or tens miss by a whole step.
    nearby: s32 = 1
    if question.trail == TRAIL_STONES && question.step > 1 { nearby = question.step }
    options: [6]s32 = .[question.answer + nearby, question.answer - nearby, question.answer + 2 * nearby,
    question.answer - 2 * nearby, question.answer + 1, question.answer - 1]
    question.choices[0] = question.answer
    count: s32 = 1
    // Start somewhere in the list, so the miss above is not always first.
    offset := RandomRange(random, 0, 5)
    for index: cast(s32)0..5 {
        option := options[(index + offset) % 6]
        // Counting and adding never answer zero, so zero is no choice there.
        least: s32 = ifx question.trail == TRAIL_COUNT || question.trail == TRAIL_ADD then 1 else 0
        if count >= CHOICES || option < least { continue }
        taken := false
        for chosen: cast(s32)0..count - 1 {
            if question.choices[chosen] == option { taken = true }
        }
        if !taken { question.choices[count] = option; count += 1 }
    }
    // Shuffle.
    index: s32 = CHOICES - 1
    while index > 0 {
        other := RandomRange(random, 0, index)
        swap := question.choices[index]
        question.choices[index] = question.choices[other]
        question.choices[other] = swap
        index -= 1
    }
}

// A first-try right answer. Returns true when the trail moved up a level.
SkillRight :: (skill: *Skill) -> bool {
    skill.misses = 0
    skill.streak += 1
    if skill.streak < LEVEL_UP_STREAK || skill.level >= LEVELS { return false }
    skill.level += 1
    skill.streak = 0
    return true
}

// A wrong answer, counted once per question. Returns true when the trail
// moved down a level.
SkillMiss :: (skill: *Skill) -> bool {
    skill.streak = 0
    skill.misses += 1
    if skill.misses < LEVEL_DOWN_MISSES || skill.level <= 1 { return false }
    skill.level -= 1
    skill.misses = 0
    return true
}

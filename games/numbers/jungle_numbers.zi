#import, file "../../retro/language.zi";
// 123 Book opens directly on numerals one to twenty and watercolor animal counts.
#import "app_context"
#import "app_protocol"
#import "geometry"
#import "number_text"
#import "std/format"
#import "text_align"
#import "text_buffer"
#import "swipe"
#import "swipe_props"
#import, file "numbers_ladder.zi";
#import, file "numbers_progress.zi";
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "../../retro/book_theme.zi";
#import, file "../../host/jungle_text.zi";

FONT :: "assets/jungle-book/font.png"
SOUNDS :: "assets/numbers/sounds/"
NUMBER_COUNT :: 20
word_en: [20]string = .["One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten",
    "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen", "Twenty"];
word_de: [20]string = .["Eins", "Zwei", "Drei", "Vier", "Fünf", "Sechs", "Sieben", "Acht", "Neun", "Zehn",
    "Elf", "Zwölf", "Dreizehn", "Vierzehn", "Fünfzehn", "Sechzehn", "Siebzehn", "Achtzehn", "Neunzehn", "Zwanzig"];
word_es: [20]string = .["Uno", "Dos", "Tres", "Cuatro", "Cinco", "Seis", "Siete", "Ocho", "Nueve", "Diez",
    "Once", "Doce", "Trece", "Catorce", "Quince", "Dieciséis", "Diecisiete", "Dieciocho", "Diecinueve", "Veinte"];
// Every counted thing is one of the book's watercolor animals.
items: [12]string = .[
    "assets/jungle-book/counting/tiger.png",
    "assets/jungle-book/counting/frog.png",
    "assets/jungle-book/counting/butterfly.png",
    "assets/jungle-book/counting/ladybug.png",
    "assets/jungle-book/counting/duck.png",
    "assets/jungle-book/counting/hen.png",
    "assets/jungle-book/counting/cat.png",
    "assets/jungle-book/counting/dog.png",
    "assets/jungle-book/counting/pig.png",
    "assets/jungle-book/counting/cow.png",
    "assets/jungle-book/counting/rabbit.png",
    "assets/jungle-book/counting/monkey.png",
];

numbers_width: s32;
numbers_height: s32;
numbers_padding: s32;
numbers_gap: s32;
learn_number: s32;
learn_item: s32;
ladder_loaded: bool;
voice_pending: bool;
autoplay: bool;
repeat_sequence: bool;
sequence_speed: s32 = 1;
number_started: float64;
voice_idle_started: float64;
sequence_paused_at: float64;
swipe_tracking: bool;
swipe_start: Vector2;
swipe_started: float64;
NumberWord :: (number: s32) -> string {
    if language == 1 { return word_de[number - 1] }
    if language == 2 { return word_es[number - 1] }
    return word_en[number - 1]
}

NumberVoice :: (number: s32) -> string {
    return Cat(SOUNDS, LanguageCode(), "/", NumberText(number), ".wav")
}

Sound :: (name: string) { GameSound(Cat(SOUNDS, name, ".wav")) }

OpenNumber :: (number: s32) {
    learn_number = number
    learn_item = cast(s32)(RandomNext() % 12)
    voice_pending = true
    number_started = retro.now
    voice_idle_started = 0.0
}

ToggleAutoplay :: () {
    autoplay = !autoplay
    if !autoplay {
        sequence_paused_at = retro.now
        unused AppService("jungle.voice-control", "pause")
    } else if AppService("jungle.voice-state", "") == "paused" {
        unused AppService("jungle.voice-control", "resume")
        number_started += retro.now - sequence_paused_at
        voice_idle_started = 0.0
    } else { OpenNumber(ifx learn_number == NUMBER_COUNT then 1 else learn_number) }
}

AdvanceSequence :: () {
    if !autoplay || voice_pending || swipe_tracking { return }
    state := AppService("jungle.voice-state", "")
    if state == "loading" || state == "playing" { voice_idle_started = 0.0; return }
    if voice_idle_started == 0.0 { voice_idle_started = retro.now }
    duration: float64 = ifx sequence_speed == 0 then 6.0 else ifx sequence_speed == 1 then 4.0 else 2.0
    quiet: float64 = ifx sequence_speed == 0 then 2.5 else ifx sequence_speed == 1 then 1.5 else 0.5
    if retro.now - number_started < duration || retro.now - voice_idle_started < quiet { return }
    if learn_number == NUMBER_COUNT {
        if repeat_sequence { OpenNumber(1) } else { autoplay = false }
    } else { OpenNumber(learn_number + 1) }
}

ResponsiveNumbers :: (bounds: Rectangle) {
    numbers_width = cast(s32)bounds.width
    numbers_height = cast(s32)bounds.height
    fit := bounds.width / 320.0
    if bounds.height / 200.0 < fit { fit = bounds.height / 200.0 }
    numbers_padding = cast(s32)(14.0 * fit) + 12
    if numbers_padding < 24 { numbers_padding = 24 }
    numbers_gap = ifx numbers_width < 600 then 12 else 20
    retro.x = bounds.x
    retro.y = bounds.y
    retro.scale = 1.0
    BookPaperSized(numbers_width, numbers_height)
}

TouchButton :: (id: s32, x: s32, y: s32, width: s32, height: s32, text: string, selected: bool = false) -> bool {
    press := RetroTap(id, x, y, width, height, text)
    BookBox(x, y, width, height, ifx selected || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
        ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 8.0)
    font: s32 = 18
    while font > 10 && cast(s32)Tr(text).count * font * 3 / 5 > width - 12 { font -= 1 }
    BookText(x + 6, y, width - 12, height, text, font)
    return press.clicked
}

// count things in a framed box, packed like Animal Counting's rows.
DrawThings :: (item: s32, count: s32, x: s32, y: s32, width: s32, height: s32) {
    BookBox(x, y, width, height, 0xf7f1e3ff, 0xdacdb5ff, 10.0)
    columns: s32 = 5
    if count < 5 { columns = count }
    if columns < 1 { columns = 1 }
    rows := (count + columns - 1) / columns
    size := (width - numbers_gap * 2) / columns
    fit := (height - numbers_gap * 2) / rows
    if fit < size { size = fit }
    if size > 96 { size = 96 }
    if size < 12 { size = 12 }
    inside_x := x + (width - columns * size) / 2
    inside_y := y + (height - rows * size) / 2
    for at: cast(s32)0..count - 1 {
        thing := cast(s32)at
        BookPicture(items[item], inside_x + (thing % columns) * size + 2, inside_y + (thing / columns) * size + 2,
            size - 4, size - 4)
    }
}

// Wrap the complete range into balanced rows, keeping two-digit numbers legible.
StripMetrics :: (width: s32) -> (columns: s32, button: s32, used: s32) {
    columns := (width + 4) / 36
    if columns > NUMBER_COUNT { columns = NUMBER_COUNT }
    if columns < 1 { columns = 1 }
    rows := (NUMBER_COUNT + columns - 1) / columns
    columns = (NUMBER_COUNT + rows - 1) / rows
    button := (width - (columns - 1) * 4) / columns
    if button > 44 { button = 44 }
    return columns, button, rows * (button + 4) + 2
}

NumberStrip :: (x: s32, y: s32, width: s32) -> s32 {
    columns, button, used := StripMetrics(width)
    left := x + (width - columns * (button + 4) + 4) / 2
    for number: cast(s32)1..NUMBER_COUNT {
        at := number - 1
        bx := left + (at % columns) * (button + 4)
        by := y + (at / columns) * (button + 4)
        press := RetroTap(100 + at, bx, by, button, button, NumberText(number))
        selected := number == learn_number
        BookBox(bx, by, button, button, ifx selected || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
            ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
        BookText(bx, by, button, button, NumberText(number), button / 2)
        if press.clicked { OpenNumber(number) }
    }
    return used
}

StripUsed :: (width: s32) -> s32 {
    _, _, used := StripMetrics(width)
    return used
}

PageInput :: (bottom: s32) {
    touch := RetroTap(50, numbers_padding, numbers_padding,
        numbers_width - numbers_padding * 2, bottom - numbers_padding, "Hear number", true)
    if touch.down && !swipe_tracking {
        swipe_start = Vector2.{touch.x, touch.y}
        swipe_started = retro.now
        swipe_tracking = true
    }
    moved := false
    if touch.released && swipe_tracking {
        delta := Vector2.{touch.x - swipe_start.x, touch.y - swipe_start.y}
        moved = SwipeMaxDistanceFor(delta) >= 8.0
        gesture := SwipeReleaseStateFor(delta, cast(u32)SwipeDirection.SwipeHorizontal,
            1.25, 40.0, retro.now - swipe_started, 0.0, moved)
        if gesture.direction == SwipeDirection.SwipeLeft { OpenNumber(learn_number % NUMBER_COUNT + 1) }
        if gesture.direction == SwipeDirection.SwipeRight { OpenNumber((learn_number + NUMBER_COUNT - 2) % NUMBER_COUNT + 1) }
        swipe_tracking = false
    }
    if !touch.down && !touch.released { swipe_tracking = false }
    if touch.clicked && !moved { voice_pending = true }
}

LearnView :: () {
    landscape := numbers_width >= numbers_height
    width := numbers_width - numbers_padding * 2
    strip_top: s32 = numbers_height - numbers_padding - StripUsed(width) + 6
    NumberStrip(numbers_padding, strip_top, width)
    control: s32 = ifx numbers_height < 400 then 32 else 40
    transport_y := strip_top - numbers_gap - control
    button := (width - numbers_gap) / 2
    if TouchButton(41, numbers_padding, transport_y, button, control, ifx autoplay then "Pause" else "Play", autoplay) { ToggleAutoplay() }
    if TouchButton(43, numbers_padding + button + numbers_gap, transport_y, button, control,
        ifx repeat_sequence then "Repeat on" else "Repeat off", repeat_sequence) {
        repeat_sequence = !repeat_sequence
        unused DocumentWrite("repeat.txt", ifx repeat_sequence then "on" else "off")
    }
    content_bottom: s32 = transport_y - 12
    if landscape {
        panel: s32 = (width - numbers_gap) / 2
        content_height: s32 = content_bottom - numbers_padding
        big: s32 = panel * 2 / 3
        if big > content_height * 3 / 4 { big = content_height * 3 / 4 }
        if big < 40 { big = 40 }
        label_height: s32 = 34
        numeral_height := content_height - label_height
        BookText(numbers_padding, numbers_padding, panel, numeral_height, NumberText(learn_number), big)
        BookText(numbers_padding, numbers_padding + numeral_height, panel, label_height, NumberWord(learn_number), 24, TextAlign.TextAlignCenter, false)
        BookBox(numbers_width / 2 - 1, numbers_padding, 2, content_height, 0xe5d9c3ff)
        picture_x: s32 = numbers_width / 2 + numbers_gap / 2
        DrawThings(learn_item, learn_number, picture_x, numbers_padding, panel, content_height)
    } else {
        big: s32 = numbers_width / 3
        if big > 90 { big = 90 }
        if big < 36 { big = 36 }
        BookText(numbers_padding, numbers_padding, width / 2, big + 16, NumberText(learn_number), big)
        BookText(numbers_padding + width / 2, numbers_padding + (big + 16 - 40) / 2, width / 2, 40, NumberWord(learn_number), 24, TextAlign.TextAlignCenter, false)
        picture_height: s32 = content_bottom - numbers_padding - big - 12
        DrawThings(learn_item, learn_number, numbers_padding, numbers_padding + big + 16, width, picture_height)
    }
    PageInput(content_bottom)
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        ladder_loaded = false
        learn_number = 1
        learn_item = 0
        voice_pending = false
        autoplay = true; sequence_speed = 1
        swipe_tracking = false
        AppIdentity("jungle.numbers")
        AppDescribe("123 Book", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx !ladder_loaded || NumbersSave() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    now := AppNow()
    RetroBegin(AppSession(), AppBounds(), FONT, now, AppKey(), BLACK)
    ResponsiveNumbers(AppBounds())
    if !ladder_loaded {
        NumbersLoad()
        random_state = cast(u32)(cast(u64)(now * 1000.0) & cast(u64)0x7fffffff) | cast(u32)1
        OpenNumber(1)
        repeat_sequence = DocumentRead("repeat.txt") != "off"
        ladder_loaded = true
    }
    key := retro.key
    if key == 10001 { sequence_speed = (sequence_speed + 1) % 3 }
    if key == KEY_ESCAPE { GameHome(); return 0 }
    typed: s32 = -1
    if key >= 49 && key <= 57 { typed = key - 48 }
    if key == 48 { typed = 10 }
    if key == KEY_RIGHT { OpenNumber(learn_number % NUMBER_COUNT + 1) }
    if key == KEY_LEFT { OpenNumber((learn_number + NUMBER_COUNT - 2) % NUMBER_COUNT + 1) }
    if typed >= 1 { OpenNumber(typed) }
    if key == 32 { ToggleAutoplay() }
    if key == KEY_ENTER { voice_pending = true }
    AdvanceSequence()
    LearnView()
    if voice_pending {
        number_started = retro.now; voice_idle_started = 0.0
        unused AppService("jungle.voice", NumberVoice(learn_number))
        voice_pending = false
    }
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

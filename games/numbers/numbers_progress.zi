// Preserve the number ladder in the game's own save folder.
#import "app_context"
#import, file "numbers_ladder.zi";
#import, file "../../host/jungle_text.zi";

NumbersSave :: () -> bool {
    return DocumentWrite("progress.txt", Cat("numbers ", NumberText(level), " ", NumberText(count),
        " ", NumberText(right_run), " ", NumberText(miss_run), "\n"))
}

NumbersLoad :: () {
    text := DocumentRead("progress.txt")
    if text.count < 8 || text[:8] != "numbers " { return }
    at: s64 = 8
    values: [4]s32
    for field: cast(s32)0..3 {
        values[field] = ReadWhole(text, *at)
        if values[field] < 0 { return }
        if field < 3 && (at >= text.count || text[at] != #char " ") { return }
        at += 1
    }
    if values[0] < 1 || values[0] > MAX_LEVEL { return }
    level = values[0]
    count = values[1]
    right_run = ifx values[2] < RIGHT_TO_MOVE then values[2] else 0
    miss_run = ifx values[3] < MISS_TO_MOVE then values[3] else 0
}

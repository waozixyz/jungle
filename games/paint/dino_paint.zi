// Choices are separate from pictures and Undo: returning to a stencil never
// changes the scene or artwork already saved in a picture.
CHOICES :: "choices.txt"
ChoicesSave :: () {
    values: [9]u8 = .[PAINT_CODES[(dino + 1) % 64], PAINT_CODES[stencil_category], PAINT_CODES[stencil_anchor],
        PAINT_CODES[size], PAINT_CODES[ifx placement_flip then 1 else 0], PAINT_CODES[scene_category],
        PAINT_CODES[scene_page], PAINT_CODES[last_scene + 1], PAINT_CODES[(dino + 1) / 64]]
    if dino + 1 >= 64 { unused DocumentWrite(CHOICES, Join(PAINT_CHOICES_V3, TextView(values[:]))) }
    else { unused DocumentWrite(CHOICES, Join(PAINT_CHOICES_V2, TextView(values[:8]))) }
}

ChoicesLoad :: () {
    dino = -1; stencil_category = 0; stencil_anchor = 0; size = 2
    placement_flip = false; scene_category = 0; scene_page = 0; last_scene = -1
    saved := DocumentRead(CHOICES)
    version := PaintChoicesVersion(saved)
    if version == 0 { return }
    header := PAINT_CHOICES_V2.count
    values: [8]s32
    for at: cast(s32)0..7 { values[at] = PaintIndex(saved[header + at]); if values[at] < 0 { return } }
    values[0] = PaintChoicesStencil(saved)
    if values[0] < 0 { return }
    if values[1] >= PAINT_STENCIL_CATEGORY_COUNT { return }
    // A version 1 page becomes the anchor of its first item.
    anchor := PaintChoicesAnchor(version, values[2], paint_stencil_category_counts[values[1]])
    if values[0] > PAINT_STENCIL_COUNT || anchor < 0 || values[3] < 1 || values[3] > 4 ||
        values[4] > 1 || values[5] >= PAINT_SCENE_TAB_COUNT ||
        values[6] >= (SceneCategoryCount(values[5]) + 5) / 6 || values[7] > PAINT_SCENE_COUNT { return }
    dino = values[0] - 1; stencil_category = values[1]; stencil_anchor = anchor; size = values[3]
    placement_flip = values[4] == 1; scene_category = values[5]; scene_page = values[6]; last_scene = values[7] - 1
}

PAINT_SCENE_TAB_COUNT :: PAINT_SCENE_CATEGORY_COUNT + 1

SceneCategoryCount :: (index: s32) -> s32 {
    if index == PAINT_SCENE_CATEGORY_COUNT { return 1 }
    if index < 0 || index >= PAINT_SCENE_CATEGORY_COUNT { return 0 }
    return paint_scene_category_counts[index]
}

SceneCategoryLabel :: (index: s32) -> string {
    if index == PAINT_SCENE_CATEGORY_COUNT {
        return Tr("Blank page")
    }
    return PaintSceneCategoryLabel(index)
}

PictureHasPage :: () -> bool {
    return scene != -1
}

PencilLabel :: () -> string {
    code := LanguageCode()
    if code == "de" { return "Stift" }
    if code == "es" { return "Lápiz" }
    return "Pencil"
}

GalleryReadDocument :: (name: string, status: *s32) -> string {
    bytes := DocumentRead(name)
    status.* = DocumentStatus()
    return bytes
}

Join :: (a: string, b: string = "", c: string = "") -> string {
    text: Vec(u8)
    parts: [3]string = .[a, b, c]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Sound :: (name: string) { GameSound(Join(SOUNDS, name, ".wav")) }

SlotFile :: (index: s32) -> string {
    digits: [24]u8
    return Join("slot-", FormatInteger(cast(s64)index, digits[:]), ".txt")
}

Keep :: (name: string, bytes: []u8) {
    count := ifx name.count < bytes.count then name.count else bytes.count - 1
    for at: cast(s64)0..count - 1 { bytes[at] = name[at] }
    bytes[count] = 0
}

// Persist an edit on the following frame so decoding/erasing and encoding
// a large picture never share one VM frame. APP_SAVE still flushes on exit.
working_save_pending: bool;
WorkingPictureKeep :: () { working_save_pending = true }

// One frame of bookkeeping keeps the submitted page, but neither serializes it
// in the same frame as an edit nor accepts a new edit while its save settles.
working_bookkeeping: bool;

// The working picture, then its undo history, which names that exact
// picture: if only the picture is written, the history no longer matches it
// and is dropped on reading, so no step can be undone twice.
WorkingPictureSave :: () -> bool {
    if !initialized || working_history_start || history_loading { return true }
    working := PictureText()
    if !DocumentWrite(WORKING, working) { return false }
    gallery_saved := scene == -1 || GalleryStoreSave(*gallery_store, working)
    if HistoryBoundTo(working) { return gallery_saved }
    // Built in place, so its storage is released after writing.
    text: Vec(u8)
    HistoryAppend(*text, working)
    if !DocumentWrite(WORKING_HISTORY, TextView(VecSlice(text, 0, text.count))) { return false }
    HistorySaved(working)
    return gallery_saved
}

// The working picture and, when it still belongs to it, its undo history.
working_history_start: bool;
working_loaded: string;
WORKING_CANVAS_IDLE :: 0
WORKING_CANVAS_WAIT :: 1
WORKING_CANVAS_MAKE :: 2
working_canvas_state: s32 = WORKING_CANVAS_IDLE;

WorkingPictureLoad :: () {
    HistoryClear()
    working_loaded = ""
    working := DocumentRead(WORKING)
    // Its history is read and matched to it on the next frame.
    if PictureLoad(working) { working_loaded = OwnedText(working); working_history_start = true }
}

Notice :: (text: string) { status = text; status_until = retro.now + 3.0 }

StoreSlot :: (index: s32) -> bool {
    if !PictureHasPage() { Notice("Choose a scene first"); return false }
    if !DocumentWrite(SlotFile(index), PictureText()) { Notice("Could not save"); return false }
    slot = index
    slot_previews_ready[index] = false
    Notice("Picture and story saved")
    WorkingPictureKeep()
    return true
}

LoadSlot :: (index: s32) -> bool {
    if !PictureLoad(DocumentRead(SlotFile(index))) { Notice("Empty or damaged save"); return false }
    GalleryStoreDetach(*gallery_store)
    slot = index
    placing = false
    erasing = false
    PictureViewReset()
    HistoryClear()
    story_row = 0
    story_column = 0
    dirty = true
    WorkingPictureKeep()
    Notice("Picture and story loaded")
    return true
}

Undo :: () {
    if !HistoryUndo() { return }
    dirty = true
    WorkingPictureKeep()
    Sound("undo")
}

OpenScene :: (index: s32) {
    scene = index
    last_scene = ifx index == BLANK_SCENE then -1 else index
    ChoicesSave()
    unused SceneOpen(index)
    PictureViewReset()
    placing = false
    erasing = false
    HistoryClear()
    dirty = true
    view = ifx index == BLANK_SCENE then MAIN else PICK_DINO
    ClearStory()
    story_row = 0
    story_column = 0
    slot = -1
    WorkingPictureKeep()
    Sound("open")
}

MakeCanvas :: () {
    if !dirty { return }
    // A line being drawn shows as page pixels until it is finished.
    if !pencil_dragging {
        reply := AppService("jungle.paint-ops", CanvasVectorOps())
        if reply != "same" { ink_page_stale = true; ink_tile_stale = true }
    }
    made := GameCanvasService("jungle.paint-colors", CanvasText())
    if made != "" {
        // Keep the last complete picture beneath its replacement while the
        // browser installs the new image in its drawing surface.
        {
            previous := TextUntilNul(canvas_name[:])
            if previous != "" && RetroImageReady(previous) { Keep(previous, canvas_shown_name[:]) }
        }
        Keep(made, canvas_name[:])
        dirty = false
    }
}

// The picture's zoom and its vector ink. Both ink images are drawn from the
// host's outlines at the size they are shown: the whole page at its fitted
// size, and, zoomed in, a tile of the visible part once the view settles.
PICTURE_ZOOM_MAXIMUM :: 8.0
INK_SETTLE_SECONDS :: 0.12
// Extra tile pixels on each side, so a small pan keeps a sharp picture.
INK_MARGIN :: 64.0
INK_TILE_PIXELS :: 1920000.0
ZOOM_CONTROL_SIZE :: 44

picture_view: ViewTransform;
picture_view_ready: bool;
picture_view_changed_at: float64;
// Pinching holds off every drawing gesture until the fingers lift.
view_block: bool;
view_panning: bool;
view_pan_active: bool;
view_pan_last: Vector2;
pencil_started_at: float64;
paint_density: float32 = 1.0;

ink_page_name: [128]u8;
ink_page_stale: bool = true;
ink_page_width: s32;
ink_page_height: s32;
ink_tile_name: [128]u8;
ink_tile_stale: bool = true;
ink_tile_width: s32;
ink_tile_height: s32;
ink_tile_page: Rectangle;
ink_tile_zoom: float32;
ink_tile_view_x: float32;
ink_tile_view_y: float32;

CanvasScreen :: () -> Rectangle {
    return RetroRect(canvas_x, canvas_y, canvas_w, canvas_h)
}

PointerInCanvas :: (x: float32, y: float32) -> bool {
    area := CanvasScreen()
    return x >= area.x && y >= area.y && x < area.x + area.width && y < area.y + area.height
}

PictureViewReset :: () {
    if picture_view_ready { ViewReset(*picture_view) }
    picture_view_changed_at = 0.0
    ink_tile_stale = true
}

// One number of the host's touch reply, in thousandths.
TouchNumber :: (text: string, at: *s64) -> float32 {
    while at.* < text.count && text[at.*] == #char " " { at.* += 1 }
    negative := at.* < text.count && text[at.*] == #char "-"
    if negative { at.* += 1 }
    value: s64 = 0
    while at.* < text.count && text[at.*] >= #char "0" && text[at.*] <= #char "9" {
        value = value * 10 + cast(s64)(text[at.*] - #char "0")
        at.* += 1
    }
    return cast(float32)(ifx negative then -value else value) / 1000.0
}

// Stops whatever one finger had begun; a brief pencil mark was a pinch's first
// finger, not a line.
PictureGesturesCancel :: () {
    canvas_can_fill = false
    if placing { placement_gesture = 0; dragging = false }
    if rotation_drag { rotation_drag = false; rotation_degrees = 0.0 }
    if pencil_dragging {
        pencil_dragging = false
        if retro.now - pencil_started_at < 0.25 { unused HistoryUndo() }
        else { WorkingPictureKeep() }
        dirty = true
    }
}

ZoomControlRect :: (index: s32) -> Rectangle {
    area := CanvasScreen()
    return Rectangle.{area.x + area.width - cast(float32)((index + 1) * (ZOOM_CONTROL_SIZE + 6)), area.y + 6.0,
        cast(float32)ZOOM_CONTROL_SIZE, cast(float32)ZOOM_CONTROL_SIZE}
}

// Fit shows whenever the picture is zoomed; zoom in and out with the Zoom tool.
ZoomControlShown :: (index: s32) -> bool {
    return ifx index == 0 then !ViewIsFit(picture_view) else view_panning
}

ZoomControlAt :: (x: float32, y: float32) -> bool {
    for index: cast(s32)0..2 {
        rect := ZoomControlRect(index)
        if ZoomControlShown(index) && x >= rect.x && y >= rect.y && x < rect.x + rect.width && y < rect.y + rect.height { return true }
    }
    return false
}

// The pointer as the picture's gestures may use it.
PaintPointer :: () -> PointerFrame {
    pointer := SamplePointer()
    if view_block || view_pan_active || view_panning {
        pointer.pressed = false; pointer.down = false; pointer.released = false
    } else if pointer.pressed && ZoomControlAt(pointer.x, pointer.y) { pointer.pressed = false }
    return pointer
}

// Reads this frame's fingers, wheel and pan, before the picture's gestures.
PictureViewFrame :: () {
    viewport := CanvasScreen()
    if !picture_view_ready {
        picture_view = ViewFit(viewport, cast(float32)CANVAS_WIDTH, cast(float32)CANVAS_HEIGHT, PICTURE_ZOOM_MAXIMUM)
        picture_view_ready = true
    } else { ViewSetViewport(*picture_view, viewport) }
    zoom := picture_view.zoom; page_x := picture_view.page_x; page_y := picture_view.page_y
    reply := AppService("jungle.touches", "")
    at: s64 = 0
    count := cast(s32)(TouchNumber(reply, *at) * 1000.0 + 0.5)
    first := Vector2.{TouchNumber(reply, *at), TouchNumber(reply, *at)}
    second := Vector2.{TouchNumber(reply, *at), TouchNumber(reply, *at)}
    wheel := TouchNumber(reply, *at)
    density := TouchNumber(reply, *at)
    if density > 0.0 { paint_density = density }
    pointer := SamplePointer()
    if count >= 2 {
        if picture_view.pinching { ViewPinchUpdate(*picture_view, first, second) }
        else if PointerInCanvas((first.x + second.x) / 2.0, (first.y + second.y) / 2.0) {
            PictureGesturesCancel()
            view_pan_active = false
            view_block = true
            ViewPinchBegin(*picture_view, first, second)
        }
    } else if picture_view.pinching { ViewPinchEnd(*picture_view) }
    if view_block && count == 0 && !pointer.down { view_block = false }
    if wheel != 0.0 && !view_block && PointerInCanvas(pointer.x, pointer.y) {
        ViewZoomAt(*picture_view, Vector2.{pointer.x, pointer.y}, ViewWheelFactor(wheel))
    }
    secondary := GameSecondaryDown()
    if view_pan_active {
        if secondary || (view_panning && pointer.down) {
            ViewPanBy(*picture_view, pointer.x - view_pan_last.x, pointer.y - view_pan_last.y)
            view_pan_last = Vector2.{pointer.x, pointer.y}
        } else { view_pan_active = false }
    } else if !view_block && (secondary || (view_panning && pointer.pressed)) && PointerInCanvas(pointer.x, pointer.y) &&
        !ZoomControlAt(pointer.x, pointer.y) && !(placing && pointer.y >= retro.y + cast(float32)(canvas_y + canvas_h - 48)) {
        PictureGesturesCancel()
        view_pan_active = true
        view_pan_last = Vector2.{pointer.x, pointer.y}
    }
    if picture_view.zoom != zoom || picture_view.page_x != page_x || picture_view.page_y != page_y {
        picture_view_changed_at = retro.now
    }
}

InkRequest :: (w: s32, h: s32, page: Rectangle, scale_x: float32, scale_y: float32) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "% % % % % %", w, h, PaintVectorUnits(page.x), PaintVectorUnits(page.y),
        PaintVectorUnits(scale_x), PaintVectorUnits(scale_y))
    return BuilderFinish(text)
}

// Keeps the ink images matching the outlines and the size they are shown at.
PictureInkRefresh :: () {
    density := paint_density
    width := CeilInteger(cast(float32)canvas_w * density)
    height := CeilInteger(cast(float32)canvas_h * density)
    if cast(float32)width * cast(float32)height > INK_TILE_PIXELS {
        density = cast(float32)FloorInteger(density * 8.0) * 0.125
        if density < 1.0 { density = 1.0 }
        width = CeilInteger(cast(float32)canvas_w * density)
        height = CeilInteger(cast(float32)canvas_h * density)
    }
    settled := retro.now - picture_view_changed_at >= INK_SETTLE_SECONDS && !picture_view.pinching && !view_pan_active
    if ink_page_stale || width != ink_page_width || height != ink_page_height {
        name := GameCanvasService("jungle.paint-ink", InkRequest(width, height,
            Rectangle.{0.0, 0.0, cast(float32)CANVAS_WIDTH, cast(float32)CANVAS_HEIGHT},
            cast(float32)width / cast(float32)CANVAS_WIDTH, cast(float32)height / cast(float32)CANVAS_HEIGHT))
        if name != "" {
            Keep(name, ink_page_name[:])
            ink_page_stale = false; ink_page_width = width; ink_page_height = height
        }
    }
    if ViewIsFit(picture_view) || !settled { return }
    if !ink_tile_stale && ink_tile_zoom == picture_view.zoom && ink_tile_view_x == picture_view.page_x && ink_tile_view_y == picture_view.page_y { return }
    scale_x := cast(float32)width * picture_view.zoom / cast(float32)CANVAS_WIDTH
    scale_y := cast(float32)height * picture_view.zoom / cast(float32)CANVAS_HEIGHT
    visible := ViewVisiblePage(picture_view)
    // Whole margins keep the tile's pixels on the screen's.
    left := cast(float32)FloorInteger(visible.x * scale_x); if left > INK_MARGIN { left = INK_MARGIN }
    top := cast(float32)FloorInteger(visible.y * scale_y); if top > INK_MARGIN { top = INK_MARGIN }
    right := (cast(float32)CANVAS_WIDTH - visible.x - visible.width) * scale_x; if right > INK_MARGIN { right = INK_MARGIN }
    bottom := (cast(float32)CANVAS_HEIGHT - visible.y - visible.height) * scale_y; if bottom > INK_MARGIN { bottom = INK_MARGIN }
    w := CeilInteger(visible.width * scale_x + left + cast(float32)FloorInteger(right))
    h := CeilInteger(visible.height * scale_y + top + cast(float32)FloorInteger(bottom))
    if cast(float32)w * cast(float32)h > INK_TILE_PIXELS {
        left = 0.0; top = 0.0
        w = CeilInteger(visible.width * scale_x); h = CeilInteger(visible.height * scale_y)
    }
    page := Rectangle.{visible.x - left / scale_x, visible.y - top / scale_y, cast(float32)w / scale_x, cast(float32)h / scale_y}
    name := GameCanvasService("jungle.paint-tile", InkRequest(w, h, page, scale_x, scale_y))
    if name != "" {
        Keep(name, ink_tile_name[:])
        ink_tile_stale = false; ink_tile_width = w; ink_tile_height = h; ink_tile_page = page
        ink_tile_zoom = picture_view.zoom; ink_tile_view_x = picture_view.page_x; ink_tile_view_y = picture_view.page_y
    }
}

// Draws the visible part of a picture that holds the given page rectangle.
PicturePart :: (path: string, width: s32, height: s32, page: Rectangle) {
    shown := RetroImageShown(path)
    if shown == "" { return }
    visible := ViewVisiblePage(picture_view)
    across := cast(float32)width / page.width
    down := cast(float32)height / page.height
    Image(retro.session, ImageProps.{.asset_path = shown, .bounds = CanvasScreen(), .fit = ImageFit.ImageFitStretch, .smooth = true,
        .source = Rectangle.{(visible.x - page.x) * across, (visible.y - page.y) * down, visible.width * across, visible.height * down}})
}

WHOLE_PAGE :: Rectangle.{0.0, 0.0, 960.0, 720.0}

PictureInkDraw :: () {
    visible := ViewVisiblePage(picture_view)
    tile := TextUntilNul(ink_tile_name[:])
    if !ViewIsFit(picture_view) && !ink_tile_stale && tile != "" && RetroImageReady(tile) &&
        visible.x >= ink_tile_page.x && visible.y >= ink_tile_page.y &&
        visible.x + visible.width <= ink_tile_page.x + ink_tile_page.width + 0.01 &&
        visible.y + visible.height <= ink_tile_page.y + ink_tile_page.height + 0.01 {
        PicturePart(tile, ink_tile_width, ink_tile_height, ink_tile_page)
    } else {
        page := TextUntilNul(ink_page_name[:])
        if page != "" { PicturePart(page, ink_page_width, ink_page_height, WHOLE_PAGE) }
    }
}

// Fit, zoom in and zoom out over the picture's corner.
ZoomControls :: () {
    for index: cast(s32)0..2 {
        if !ZoomControlShown(index) { continue }
        rect := ZoomControlRect(index)
        label := ifx index == 0 then "Fit picture" else ifx index == 1 then "Zoom in" else "Zoom out"
        press := RetroTap(70 + index, cast(s32)(rect.x - retro.x), cast(s32)(rect.y - retro.y), ZOOM_CONTROL_SIZE, ZOOM_CONTROL_SIZE, label)
        Fill(rect, ifx press.down then cast(u32)0xdcebdcff else cast(u32)0xfffcf3f0, 8.0)
        SvgIcon(retro.session, SvgIconProps.{.bounds = Rectangle.{rect.x + 10.0, rect.y + 10.0, 24.0, 24.0},
            .shape = ifx index == 0 then FitIcon.Shape else ifx index == 1 then ZoomInIcon.Shape else ZoomOutIcon.Shape,
            .color = ColorFromPacked(0x3e332aff)})
        if press.clicked {
            area := CanvasScreen()
            center := Vector2.{area.x + area.width / 2.0, area.y + area.height / 2.0}
            if index == 0 { ViewReset(*picture_view) }
            else { ViewZoomAt(*picture_view, center, ifx index == 1 then 1.5 else 1.0 / 1.5) }
            picture_view_changed_at = retro.now
            canvas_can_fill = false
            Sound("click")
        }
    }
}

// The main screen is laid out in window pixels: on a wide window the
// tools stand beside the picture, or in four rows below a portrait picture. The picture keeps its 4:3 shape.
canvas_x: s32;
canvas_y: s32;
canvas_w: s32 = 1;
canvas_h: s32 = 1;
tool_x: [TOOL_COUNT]s32;
tool_y: [TOOL_COUNT]s32;
tool_w: s32;
tool_h: s32;

Clamp :: (value: s32, low: s32, high: s32) -> s32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

LayoutMain :: () {
    bounds := AppBounds()
    retro.x = bounds.x
    retro.y = bounds.y
    retro.scale = 1.0
    width := cast(s32)bounds.width
    height := cast(s32)bounds.height
    shortest := ifx width < height then width else height
    pad := Clamp(shortest / 40, 6, 20)
    gap := Clamp(shortest / 80, 4, 10)
    if height > width {
        tool_w = (width - pad * 2 - gap * 2) / 3
        tool_h = Clamp(tool_w * 3 / 4, 44, 110)
        canvas_w = width - pad * 2
        canvas_h = canvas_w * 3 / 4
        rows := cast(s32)((TOOL_COUNT + 2) / 3)
        room := height - pad * 3 - gap * (rows - 1) - tool_h * rows
        if canvas_h > room { canvas_h = room; canvas_w = canvas_h * 4 / 3 }
        canvas_x = (width - canvas_w) / 2
        canvas_y = pad
        below := canvas_y + canvas_h + pad
        top := below + (height - pad - below - tool_h * rows - gap * (rows - 1)) / 2
        for index: cast(s32)0..TOOL_COUNT - 1 {
            tool_x[index] = pad + (index % 3) * (tool_w + gap)
            tool_y[index] = top + (index / 3) * (tool_h + gap)
        }
    } else {
        // A short landscape phone needs two columns to keep taps generous.
        columns: s32 = ifx height < 560 then 2 else 1
        rows: s32 = (TOOL_COUNT + columns - 1) / columns
        width_parts: s32 = ifx columns == 2 then 8 else 5
        tool_h = (height - pad * 2 - gap * (rows - 1)) / rows
        tool_w = Clamp(tool_h * 5 / 2, 64, width / width_parts)
        rail_w := tool_w * columns + gap * (columns - 1)
        room_w := width - pad * 3 - rail_w
        room_h := height - pad * 2
        canvas_w = room_w
        canvas_h = canvas_w * 3 / 4
        if canvas_h > room_h { canvas_h = room_h; canvas_w = canvas_h * 4 / 3 }
        left := (width - rail_w - pad - canvas_w) / 2
        canvas_x = left + rail_w + pad
        canvas_y = pad + (room_h - canvas_h) / 2
        for index: cast(s32)0..TOOL_COUNT - 1 {
            tool_x[index] = left + (index % columns) * (tool_w + gap)
            tool_y[index] = canvas_y + (canvas_h - tool_h * rows - gap * (rows - 1)) / 2 + (index / columns) * (tool_h + gap)
        }
    }
    if canvas_w < 1 { canvas_w = 1 }
    if canvas_h < 1 { canvas_h = 1 }
}

ToolShape :: (index: s32) -> string {
    if index == 0 { return PictureIcon.Shape }
    if index == 1 { return BucketIcon.Shape }
    if index == 2 { return BookIcon.Shape }
    if index == 3 { return EraserIcon.Shape }
    if index == 4 { return PictureIcon.Shape }
    if index == 5 { return PrintIcon.Shape }
    if index == 6 { return ifx placing then MirrorIcon.Shape else UndoIcon.Shape }
    if index == 8 { return RotateIcon.Shape }
    if index == 9 { return PencilIcon.Shape }
    if index == TOOL_ZOOM { return HandIcon.Shape }
    return NewIcon.Shape
}

// A rounded tool with its icon above its name.
ToolButton :: (id: s32, x: s32, y: s32, w: s32, h: s32, shape: string, label: string, chosen: bool) -> bool {
    press := RetroTap(id, x, y, w, h, label)
    BookBox(x, y, w, h, ifx chosen || press.down then cast(u32)0xdcebdcff else cast(u32)0xfffcf3ff,
        ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, cast(float32)(h / 6))
    label_h := h * 3 / 10
    icon := Clamp(h - label_h - h / 4, 8, 96)
    if icon > w * 3 / 5 { icon = w * 3 / 5 }
    SvgIcon(retro.session, SvgIconProps.{.bounds = RetroRect(x + (w - icon) / 2, y + (h - label_h - icon) / 2, icon, icon),
        .shape = shape, .color = ColorFromPacked(ifx chosen then cast(u32)0x2e6956ff else cast(u32)0x3e332aff)})
    BookText(x + 2, y + h - label_h - h / 12, w - 4, label_h, label, label_h * 4 / 5)
    return press.clicked
}

// The window rectangle of a part of the picture, in picture pixels.
PictureRect :: (x: s32, y: s32, w: s32, h: s32) -> Rectangle {
    return ViewPageRect(picture_view, Rectangle.{cast(float32)x, cast(float32)y, cast(float32)w, cast(float32)h})
}

PictureX :: (x: float32) -> s32 {
    return cast(s32)ViewScreenToPage(picture_view, Vector2.{x, 0.0}).x
}

PictureY :: (y: float32) -> s32 {
    return cast(s32)ViewScreenToPage(picture_view, Vector2.{0.0, y}).y
}

Fill :: (area: Rectangle, color: u32, radius: float32 = 0.0) {
    unused Box(retro.session, BoxProps.{.bounds = area, .fill = ColorFromPacked(color), .radius = radius})
}

// The dinosaur waiting to be placed: its picture in a tinted box with a
// dashed green edge, round handles at the corners and a move badge, so it
// reads as something to pick up and drag.
PlacementBox :: (area: Rectangle, flip: bool) {
    Fill(area, 0x2e69562a)
    unused flip
    edge := Clamp(cast(s32)(area.width / 60.0), 2, 4)
    thick := cast(float32)edge
    dash := thick * 5.0
    left := area.x
    right := area.x + area.width - thick
    top := area.y
    bottom := area.y + area.height - thick
    at: float32 = 0.0
    while at < area.width {
        long := ifx at + dash > area.width then area.width - at else dash
        Fill(Rectangle.{left + at, top, long, thick}, 0x2e6956ff)
        Fill(Rectangle.{left + at, bottom, long, thick}, 0x2e6956ff)
        at += dash * 1.6
    }
    at = 0.0
    while at < area.height {
        long := ifx at + dash > area.height then area.height - at else dash
        Fill(Rectangle.{left, top + at, thick, long}, 0x2e6956ff)
        Fill(Rectangle.{right, top + at, thick, long}, 0x2e6956ff)
        at += dash * 1.6
    }
    handle := thick * 4.0
    corners: [4]Vector2 = .[Vector2.{left, top}, Vector2.{right + thick, top}, Vector2.{left, bottom + thick}, Vector2.{right + thick, bottom + thick}]
    for corner: corners {
        unused Box(retro.session, BoxProps.{.bounds = Rectangle.{corner.x - handle / 2.0, corner.y - handle / 2.0, handle, handle},
            .fill = ColorFromPacked(0xfffcf3ff), .border = ColorFromPacked(0x2e6956ff), .radius = handle / 2.0})
    }
    badge := area.width / 4.0
    if area.height / 4.0 < badge { badge = area.height / 4.0 }
    if badge > 64.0 { badge = 64.0 }
    if badge >= 18.0 {
        center := Rectangle.{area.x + (area.width - badge) / 2.0, area.y + (area.height - badge) / 2.0, badge, badge}
        Fill(center, 0x2e6956e6, badge / 2.0)
        inset := badge / 5.0
        SvgIcon(retro.session, SvgIconProps.{.bounds = Rectangle.{center.x + inset, center.y + inset, badge - inset * 2.0, badge - inset * 2.0},
            .shape = MoveIcon.Shape, .color = ColorFromPacked(0xfffcf3ff)})
    }
}

placement_width: s32;
placement_degrees: float32;
placement_gesture: s32;
placement_start_width: s32;
placement_start_angle: float32;
placement_pointer_angle: float32;
placement_start_center: Vector2;
placement_resize_anchor: Vector2;
placement_resize_moving_start: Vector2;
placement_start_height: s32;
placement_canvas_w: s32;
placement_canvas_h: s32;

PlacementBegin :: () {
    placing = true; dragging = false; placement_gesture = 0
    placement_degrees = 0.0; placement_width = DinoWidth(dino, size)
    placement_x = CANVAS_WIDTH / 2; placement_y = CANVAS_HEIGHT / 2
    canvas_can_fill = false; rotating = false; SelectionClear()
    placement_canvas_w = 0; placement_canvas_h = 0
}

PlacementControl :: (id: s32, x: s32, y: s32, width: s32, label: string) -> bool {
    press := RetroTap(id, x, y, width, 44, label)
    BookBox(x, y, width, 44, ifx press.down then cast(u32)0xdcebdcff else cast(u32)0xfffcf3ff, 0x2e6956ff, 8.0)
    BookText(x + 4, y, width - 8, 44, label, 18)
    return press.clicked
}

PlacementView :: (chosen_tool: s32) {
    pointer := PaintPointer()
    if placement_canvas_w != canvas_w || placement_canvas_h != canvas_h {
        placement_gesture = 0; dragging = false
        placement_canvas_w = canvas_w; placement_canvas_h = canvas_h
    }
    if retro.key == KEY_ESCAPE {
        placing = false; dragging = false; placement_gesture = 0; canvas_can_fill = false
        return
    }
    plan := CanvasPlacement(dino, placement_x, placement_y, placement_width, placement_degrees, placement_flip)
    area := PictureRect(plan.x, plan.y, plan.w, plan.h)
    center := Vector2.{area.x + area.width / 2.0, area.y + area.height / 2.0}
    source_width := DinoWidth(dino, DINO_SIZES); source_height := DinoHeight(dino, DINO_SIZES)
    hw := cast(float32)source_width * plan.scale * ViewScale(picture_view).x / 2.0
    hh := cast(float32)source_height * plan.scale * ViewScale(picture_view).y / 2.0
    handle := SelectionPoint(0.0, -hh - 30.0, center, plan.degrees)
    handle.x = cast(float32)Clamp(cast(s32)(handle.x - retro.x), canvas_x + 22, canvas_x + canvas_w - 22) + retro.x
    handle.y = cast(float32)Clamp(cast(s32)(handle.y - retro.y), canvas_y + 22, canvas_y + canvas_h - 74) + retro.y
    corners: [4]Vector2
    corners[0] = SelectionPoint(-hw, -hh, center, plan.degrees)
    corners[1] = SelectionPoint(hw, -hh, center, plan.degrees)
    corners[2] = SelectionPoint(hw, hh, center, plan.degrees)
    corners[3] = SelectionPoint(-hw, hh, center, plan.degrees)
    button_y := canvas_y + canvas_h - 48
    button_w := Clamp((canvas_w - 18) / 2, 44, 140)
    button_x := canvas_x + (canvas_w - button_w * 2 - 6) / 2
    // Ignore the button strip when starting a canvas gesture.
    if !working_bookkeeping && chosen_tool < 0 && pointer.pressed && pointer.y < retro.y + cast(float32)button_y && PointerInCanvas(pointer.x, pointer.y) {
        dx := pointer.x - handle.x; dy := pointer.y - handle.y
        if dx * dx + dy * dy <= 22.0 * 22.0 {
            placement_gesture = 2
            placement_start_angle = placement_degrees
            placement_pointer_angle = cast(float32)(Atan2(cast(float64)(pointer.y - center.y), cast(float64)(pointer.x - center.x)) * 57.29577951308232)
        } else {
            corner_at := -1
            position := Vector2.{pointer.x, pointer.y}
            for at: cast(s32)0..3 {
                if PaintResizeHit(corners[at], position) { corner_at = at; break }
            }
            if corner_at >= 0 {
                placement_gesture = 3
                placement_start_center = center
                placement_resize_anchor = corners[(corner_at + 2) % 4]
                placement_resize_moving_start = corners[corner_at]
                placement_start_width = FloorInteger(cast(float32)source_width * plan.scale + 0.5)
                placement_start_height = FloorInteger(cast(float32)source_height * plan.scale + 0.5)
            } else if pointer.x >= area.x && pointer.x < area.x + area.width && pointer.y >= area.y && pointer.y < area.y + area.height {
                placement_gesture = 1; dragging = true
                grab_x = PictureX(pointer.x) - placement_x; grab_y = PictureY(pointer.y) - placement_y
            }
        }
    }
    if placement_gesture == 1 {
        placement_x = PictureX(pointer.x) - grab_x; placement_y = PictureY(pointer.y) - grab_y
    } else if placement_gesture == 2 {
        angle := cast(float32)(Atan2(cast(float64)(pointer.y - center.y), cast(float64)(pointer.x - center.x)) * 57.29577951308232)
        placement_degrees = placement_start_angle + angle - placement_pointer_angle
    } else if placement_gesture == 3 {
        maximum := PlacementMaximumWidth(source_width, source_height, placement_degrees)
        minimum := ifx maximum < 48 then maximum else 48
        resized := PaintResizeAtCorner(placement_start_center, placement_resize_anchor, placement_resize_moving_start,
            Vector2.{pointer.x, pointer.y},
            placement_start_width, placement_start_height, minimum, maximum)
        if resized.valid {
            placement_width = resized.width
            placement_x = PictureX(resized.center.x)
            placement_y = PictureY(resized.center.y)
        }
    }
    if pointer.released {
        placement_gesture = 0; dragging = false
        // Preserve the v1 size choice using the nearest of its four presets.
        closest: s32 = CANVAS_WIDTH
        for at: cast(s32)1..DINO_SIZES {
            delta := DinoWidth(dino, at) - placement_width
            if delta < 0 { delta = -delta }
            if delta < closest { closest = delta; size = at }
        }
        ChoicesSave()
    }
    plan = CanvasPlacement(dino, placement_x, placement_y, placement_width, placement_degrees, placement_flip)
    placement_x = plan.x + plan.w / 2; placement_y = plan.y + plan.h / 2
    area = PictureRect(plan.x, plan.y, plan.w, plan.h)
    center = Vector2.{area.x + area.width / 2.0, area.y + area.height / 2.0}
    hw = cast(float32)source_width * plan.scale * ViewScale(picture_view).x / 2.0
    hh = cast(float32)source_height * plan.scale * ViewScale(picture_view).y / 2.0
    corners[0] = SelectionPoint(-hw, -hh, center, plan.degrees)
    corners[1] = SelectionPoint(hw, -hh, center, plan.degrees)
    corners[2] = SelectionPoint(hw, hh, center, plan.degrees)
    corners[3] = SelectionPoint(-hw, hh, center, plan.degrees)
    quad := corners
    if placement_flip { quad[0] = corners[1]; quad[1] = corners[0]; quad[2] = corners[3]; quad[3] = corners[2] }
    number := FormatInteger(dino + 1, digits_a[:])
    Image(retro.session, ImageProps.{.asset_path = Join(ART, Join("dino", number, "-preview.png")),
        .bounds = CanvasScreen(), .mesh = ImageMesh.{.columns = 2, .rows = 2, .points = quad[:]}})
    SelectionLine(corners[0], corners[1]); SelectionLine(corners[1], corners[3])
    SelectionLine(corners[3], corners[2]); SelectionLine(corners[2], corners[0])
    SelectionLine(SelectionPoint(0.0, -hh, center, plan.degrees), handle)
    unused RetroTap(604, cast(s32)(handle.x - retro.x) - 22, cast(s32)(handle.y - retro.y) - 22, 44, 44, "Rotate stencil", true)
    Fill(Rectangle.{handle.x - 22.0, handle.y - 22.0, 44.0, 44.0}, 0x2e6956ff, 22.0)
    SvgIcon(retro.session, SvgIconProps.{.bounds = Rectangle.{handle.x - 12.0, handle.y - 12.0, 24.0, 24.0}, .shape = RotateIcon.Shape, .color = ColorFromPacked(0xfffcf3ff)})
    for at: cast(s32)0..3 {
        corner := corners[at]
        // While zoomed, a corner far outside the picture has nothing to show.
        view := CanvasScreen()
        if corner.x < view.x - 22.0 || corner.y < view.y - 22.0 || corner.x > view.x + view.width + 22.0 || corner.y > view.y + view.height + 22.0 { continue }
        Fill(Rectangle.{corner.x - 22.0, corner.y - 22.0, 44.0, 44.0}, 0x2e6956ff, 4.0)
        Fill(Rectangle.{corner.x - 19.0, corner.y - 19.0, 38.0, 38.0}, 0xfffcf3ff, 2.0)
    }
    if PlacementControl(602, button_x, button_y, button_w, "Cancel") {
        placing = false; dragging = false; placement_gesture = 0; canvas_can_fill = false; return
    }
    if PlacementControl(603, button_x + button_w + 6, button_y, button_w, "Place") && !working_bookkeeping {
        if !CanvasPlacementPrepare(plan) { Notice("Picture is full. Erase an object first"); return }
        HistoryPush()
        if CanvasPlacementCommit(plan) {
            placing = false; dragging = false; placement_gesture = 0; dirty = true; canvas_can_fill = false
            WorkingPictureKeep(); Sound("fill")
        }
    }
}

SelectionClear :: () {
    selected_object = -1; rotation_drag = false; rotation_degrees = 0.0; selection_degrees = 0.0
    selection_below = ""; selection_image = ""; selection_above = ""
}

// Cache three ordinary images once, keeping the selected object between its
// original neighbours even while it turns. No raster work happens on moves.
SelectionImage :: (w: s32, h: s32, pixels: []u8) -> string {
    request: Vec(u8)
    BuilderPrint(*request, "% %\n", w, h)
    PictureRunsAppend(*request, pixels)
    name := AppService("jungle.paint-preview", BuilderFinish(request))
    if name.count < 8 || name[:7] != "canvas-" { return "" }
    #if #defined(PLATFORM_WEB) {
        return AppAssetPath(name)
    }
    return name
}

SelectionSplit :: (id: s32, above: bool) -> string {
    for at: cast(s32)0..CANVAS_PIXELS - 1 { rotate_pixels[at] = ifx above then cast(u8)TRANSPARENT else base[at] }
    passed := false
    for at: cast(s32)0..layer_count - 1 {
        other := layer_order[at]
        if other == id { passed = true; continue }
        if passed != above { continue }
        object := *layers[other]
        for y: cast(s32)0..object.h - 1 {
            for x: cast(s32)0..object.w - 1 {
                pixel := object.pixels[y * object.w + x]
                if pixel != cast(u8)TRANSPARENT { rotate_pixels[(object.y + y) * CANVAS_WIDTH + object.x + x] = pixel }
            }
        }
    }
    return SelectionImage(CANVAS_WIDTH, CANVAS_HEIGHT, rotate_pixels[:])
}

SelectionChoose :: (id: s32) {
    SelectionClear()
    if id < 0 { return }
    selected_object = id
    selection_bounds = CanvasObjectBounds(id)
    selection_source_bounds = selection_bounds
    object := *layers[id]
    selection_source = object.*
    for at: cast(s32)0..object.w * object.h - 1 { selection_pixels[at] = object.pixels[at] }
    selection_source.pixels = selection_pixels[:object.w * object.h]
    selection_image = SelectionImage(object.w, object.h, object.pixels)
    selection_below = SelectionSplit(id, false)
    selection_above = SelectionSplit(id, true)
}

SelectionPoint :: (dx: float32, dy: float32, center: Vector2, degrees: float32) -> Vector2 {
    sine := SineDegrees(degrees); cosine := CosineDegrees(degrees)
    return Vector2.{center.x + dx * cosine - dy * sine, center.y + dx * sine + dy * cosine}
}

// A line of the selection, kept inside the picture.
SelectionLine :: (start: Vector2, end: Vector2) {
    area := CanvasScreen()
    low: float32 = 0.0; high: float32 = 1.0
    dx := end.x - start.x; dy := end.y - start.y
    limits: [4]float32 = .[-dx, dx, -dy, dy]
    room: [4]float32 = .[start.x - area.x, area.x + area.width - start.x, start.y - area.y, area.y + area.height - start.y]
    for side: cast(s32)0..3 {
        if limits[side] == 0.0 {
            if room[side] < 0.0 { return }
        } else {
            at := room[side] / limits[side]
            if limits[side] < 0.0 { if at > low { low = at } }
            else if at < high { high = at }
        }
    }
    if low > high { return }
    SelectionLineDraw(Vector2.{start.x + dx * low, start.y + dy * low}, Vector2.{start.x + dx * high, start.y + dy * high})
}

SelectionLineDraw :: (start: Vector2, end: Vector2) {
    unused Line(retro.session, LineProps.{.start = start, .end = end, .thickness = 2.0, .color = ColorFromPacked(0x2e6956ff)})
}

// Keep the above-centre dot reachable when the object touches the page top.
SelectionHandle :: (area: Rectangle) -> Vector2 {
    top := area.y - 24.0
    canvas := CanvasScreen()
    if top < canvas.y + 12.0 { top = canvas.y + 12.0 }
    if top > canvas.y + canvas.height - 12.0 { top = canvas.y + canvas.height - 12.0 }
    middle := area.x + area.width / 2.0
    if middle < canvas.x + 12.0 { middle = canvas.x + 12.0 }
    if middle > canvas.x + canvas.width - 12.0 { middle = canvas.x + canvas.width - 12.0 }
    return Vector2.{middle, top}
}

SelectionView :: (chosen_tool: s32) {
    pointer := PaintPointer()
    if chosen_tool >= 0 || retro.key == KEY_ESCAPE { rotation_drag = false; rotation_degrees = 0.0; return }
    if selected_object >= 0 && layers[selected_object].pixels.count == 0 { SelectionClear() }
    if rotation_drag && (rotation_width != canvas_w || rotation_height != canvas_h) { rotation_drag = false; rotation_degrees = 0.0 }
    if !working_bookkeeping && pointer.pressed && !rotation_drag {
        grabbed := false
        if selected_object >= 0 {
            area := PictureRect(selection_bounds.x, selection_bounds.y, selection_bounds.w, selection_bounds.h)
            handle := SelectionHandle(area)
            dx := pointer.x - handle.x; dy := pointer.y - handle.y
            if dx * dx + dy * dy <= 22.0 * 22.0 && selection_image != "" && selection_below != "" && selection_above != "" {
                rotation_drag = true; grabbed = true
                rotation_width = canvas_w; rotation_height = canvas_h
                rotation_start = cast(float32)(Atan2(cast(float64)(pointer.y - area.y - area.height / 2.0),
                    cast(float64)(pointer.x - area.x - area.width / 2.0)) * 57.29577951308232)
            }
        }
        if !grabbed {
            x := PictureX(pointer.x); y := PictureY(pointer.y)
            if PointerInCanvas(pointer.x, pointer.y) &&
                x >= 0 && y >= 0 && x < CANVAS_WIDTH && y < CANVAS_HEIGHT { SelectionChoose(CanvasObjectAt(x, y)) }
        }
    }
    if selected_object < 0 { return }
    extent := selection_bounds
    area := PictureRect(extent.x, extent.y, extent.w, extent.h)
    center := Vector2.{area.x + area.width / 2.0, area.y + area.height / 2.0}
    if rotation_drag {
        dx := pointer.x - center.x; dy := pointer.y - center.y
        if dx * dx + dy * dy > 16.0 {
            angle := cast(float32)(Atan2(cast(float64)dy, cast(float64)dx) * 57.29577951308232)
            rotation_degrees = angle - rotation_start
        }
        if pointer.released {
            prepared := CanvasRotationPrepareFrom(selected_object, selection_degrees + rotation_degrees, selection_source_bounds, selection_source)
            if prepared.valid && prepared.changed {
                HistoryPush()
                if CanvasRotationCommit(prepared) { dirty = true; WorkingPictureKeep(); Sound("click") }
                selection_degrees += rotation_degrees
                selection_degrees -= cast(float32)FloorInteger((selection_degrees + 180.0) / 360.0) * 360.0
                selection_bounds = CanvasObjectBounds(selected_object)
                rotation_drag = false; rotation_degrees = 0.0
            } else { rotation_drag = false; rotation_degrees = 0.0 }
        } else if !pointer.down { rotation_drag = false; rotation_degrees = 0.0 }
    }
    extent = selection_bounds
    area = PictureRect(extent.x, extent.y, extent.w, extent.h)
    center = Vector2.{area.x + area.width / 2.0, area.y + area.height / 2.0}
    degrees := ifx rotation_drag then selection_degrees + rotation_degrees else 0.0
    plan := CanvasRotation(selected_object, degrees, selection_source_bounds)
    scale := ifx rotation_drag && plan.valid then plan.scale else 1.0
    if rotation_drag && plan.valid {
        preview := PictureRect(plan.x, plan.y, plan.w, plan.h)
        center = Vector2.{preview.x + preview.width / 2.0, preview.y + preview.height / 2.0}
        PicturePart(selection_below, CANVAS_WIDTH, CANVAS_HEIGHT, WHOLE_PAGE)
        object := *selection_source
        across := ViewScale(picture_view).x * scale
        down := ViewScale(picture_view).y * scale
        left := -(cast(float32)(selection_source_bounds.x - object.x) + cast(float32)selection_source_bounds.w / 2.0) * across
        top := -(cast(float32)(selection_source_bounds.y - object.y) + cast(float32)selection_source_bounds.h / 2.0) * down
        right := left + cast(float32)object.w * across
        bottom := top + cast(float32)object.h * down
        quad: [4]Vector2 = .[SelectionPoint(left, top, center, degrees), SelectionPoint(right, top, center, degrees),
            SelectionPoint(left, bottom, center, degrees), SelectionPoint(right, bottom, center, degrees)]
        Image(retro.session, ImageProps.{.asset_path = selection_image, .bounds = CanvasScreen(),
            .mesh = ImageMesh.{.columns = 2, .rows = 2, .points = quad[:]}})
        PicturePart(selection_above, CANVAS_WIDTH, CANVAS_HEIGHT, WHOLE_PAGE)
    }
    if rotation_drag { area = PictureRect(selection_source_bounds.x, selection_source_bounds.y, selection_source_bounds.w, selection_source_bounds.h) }
    half_w := area.width * scale / 2.0; half_h := area.height * scale / 2.0
    corners: [4]Vector2 = .[SelectionPoint(-half_w, -half_h, center, degrees), SelectionPoint(half_w, -half_h, center, degrees),
        SelectionPoint(half_w, half_h, center, degrees), SelectionPoint(-half_w, half_h, center, degrees)]
    for at: cast(s32)0..3 { SelectionLine(corners[at], corners[(at + 1) % 4]) }
    top := SelectionPoint(0.0, -half_h, center, degrees)
    handle := ifx rotation_drag then SelectionPoint(0.0, -half_h - 24.0, center, degrees) else SelectionHandle(area)
    SelectionLine(top, handle)
    unused Circle(retro.session, CircleProps.{.center = handle, .radius = 9.0, .fill = ColorFromPacked(0x2e6956ff)})
    unused Circle(retro.session, CircleProps.{.center = handle, .radius = 5.0, .fill = ColorFromPacked(0xfffcf3ff)})
}

// A short message across the bottom of the picture.
PictureNote :: (text: string) {
    note_h := Clamp(canvas_h / 10, 18, 44)
    BookBox(canvas_x + canvas_w / 8, canvas_y + canvas_h - note_h - note_h / 3, canvas_w * 3 / 4, note_h,
        0xfffcf3f0, 0xdacdb5ff, cast(float32)(note_h / 2))
    BookText(canvas_x + canvas_w / 8 + 4, canvas_y + canvas_h - note_h - note_h / 3, canvas_w * 3 / 4 - 8, note_h,
        text, note_h * 11 / 20)
}

MainView :: () {
    LayoutMain()
    PictureViewFrame()
    bounds := AppBounds()
    BookBox(0, 0, cast(s32)bounds.width, cast(s32)bounds.height, 0xe3ece4ff)
    chosen_tool: s32 = -1
    for index: cast(s32)0..TOOL_COUNT - 1 {
        mirror := placing && index == 6
        label := ifx mirror then "Mirror" else ifx index == 9 then PencilLabel() else button_names[index]
        pressed := ToolButton(20 + index, tool_x[index], tool_y[index], tool_w, tool_h, ToolShape(index), label,
            (mirror && placement_flip) || (index == 3 && erasing) || (index == 8 && rotating) || (index == 9 && penciling) || (index == TOOL_ZOOM && view_panning))
        if pressed && !working_bookkeeping { chosen_tool = index }
    }
    // The chosen crayon, as a dot on the Color tool.
    dot := Clamp(tool_h / 4, 8, 24)
    BookBox(tool_x[1] + tool_w - dot - tool_h / 10, tool_y[1] + tool_h / 10, dot, dot,
        paint_colors[16 + crayon], 0x3e332aff, cast(float32)(dot / 2))
    if PictureHasPage() && (!working_bookkeeping || working_canvas_state == WORKING_CANVAS_MAKE) {
        MakeCanvas()
        if !dirty { PictureInkRefresh() }
    }
    frame := Clamp(canvas_w / 120, 3, 8)
    BookBox(canvas_x - frame, canvas_y - frame, canvas_w + frame * 2, canvas_h + frame * 2,
        0xfffcf3ff, 0x704d36ff, cast(float32)(frame * 2))
    name := TextUntilNul(canvas_name[:])
    shown := TextUntilNul(canvas_shown_name[:])
    if PictureHasPage() && shown != "" {
        PicturePart(shown, CANVAS_WIDTH, CANVAS_HEIGHT, WHOLE_PAGE)
    }
    if PictureHasPage() && name != "" && name != shown {
        PicturePart(name, CANVAS_WIDTH, CANVAS_HEIGHT, WHOLE_PAGE)
    }
    if PictureHasPage() { PictureInkDraw() }
    if !PictureHasPage() || (name == "" && shown == "") { BookBox(canvas_x, canvas_y, canvas_w, canvas_h, 0xffffffff) }
    press := RetroTap(40, canvas_x, canvas_y, canvas_w, canvas_h, "Picture", true)
    x := PictureX(press.x)
    y := PictureY(press.y)
    fine := ViewScreenToPage(picture_view, Vector2.{press.x, press.y})
    if placing {
        PlacementView(chosen_tool)
        if retro.key == KEY_ESCAPE { return }
    } else if rotating {
        canvas_can_fill = false
        SelectionView(chosen_tool)
    } else {
        pointer := PaintPointer()
        if !working_bookkeeping && chosen_tool < 0 && pointer.pressed && !penciling { canvas_can_fill = true }
        if penciling {
            canvas_can_fill = false
            inside := PointerInCanvas(pointer.x, pointer.y)
            if !working_bookkeeping && !pencil_dragging && pointer.pressed && inside {
                if CanvasPencilCanStroke() {
                    HistoryPush()
                    pencil_dragging = CanvasPencilBeginAt(CanvasPencilPointAt(fine.x, fine.y))
                    if pencil_dragging { dirty = true; pencil_started_at = retro.now }
                }
            } else if pencil_dragging {
                if pointer.down && inside && CanvasPencilMoveAt(CanvasPencilPointAt(fine.x, fine.y)) { dirty = true }
                if pointer.released || !pointer.down {
                    if CanvasPencilStrokeEnd() { WorkingPictureKeep(); Sound("click") }
                    pencil_dragging = false
                    dirty = true
                }
            }
        } else if !working_bookkeeping && chosen_tool < 0 && press.clicked && canvas_can_fill {
            canvas_can_fill = false
            if erasing {
                if CanvasObjectAt(x, y) >= 0 {
                    HistoryPush()
                    if CanvasEraseObject(x, y) {
                        dirty = true
                        WorkingPictureKeep()
                        Sound("clear")
                    }
                }
                return
            }
            fill := 16 + crayon
            if PictureHasPage() && CanvasColorAt(x, y) > INK && CanvasColorAt(x, y) != fill {
                HistoryPush()
                if CanvasFill(x, y, fill) > 0 {
                    dirty = true
                    WorkingPictureKeep()
                    Sound("fill")
                }
            }
        }
    }
    ZoomControls()
    if chosen_tool == TOOL_ZOOM {
        view_panning = !view_panning
        view_pan_active = false
        canvas_can_fill = false
        Sound("click")
        if !placing {
            erasing = false; rotating = false; penciling = false; pencil_dragging = false
            SelectionClear()
        }
        return
    }
    if chosen_tool >= 0 {
        if chosen_tool != 6 { view_panning = false; view_pan_active = false }
        mirror := placing && chosen_tool == 6
        if mirror { placement_flip = !placement_flip; ChoicesSave(); Sound("click"); return }
        if placing { Notice("Place the stencil first"); return }
        placing = false
        dragging = false
        SelectionClear()
        Sound("click")
        if chosen_tool != 8 { rotating = false }
        if chosen_tool != 9 { penciling = false; pencil_dragging = false }
        if chosen_tool == 0 || chosen_tool == 1 || chosen_tool == 7 || chosen_tool == 8 { erasing = false }
        if chosen_tool == 0 { view = ifx PictureHasPage() then PICK_DINO else PICK_SCENE }
        if chosen_tool == 1 { view = PICK_COLOR }
        if chosen_tool == 2 { view = STORY }
        if chosen_tool == 3 { erasing = !erasing; canvas_can_fill = false }
        if chosen_tool == 4 {
            GalleryPreviewsClear()
            gallery_page = ifx gallery_store.gallery.selected >= 0 then gallery_store.gallery.selected / 6 else 0
            view = GALLERY
        }
        if chosen_tool == 5 { view = PRINT_VIEW }
        if chosen_tool == 6 { Undo() }
        if chosen_tool == 7 { view = CONFIRM_ERASE }
        if chosen_tool == 8 { rotating = !rotating; canvas_can_fill = false }
        if chosen_tool == 9 { penciling = !penciling; canvas_can_fill = false }
        return
    }
    if retro.key == KEY_ESCAPE { SelectionClear(); WorkingPictureKeep(); GameHome() }
    if rotating && selected_object < 0 { PictureNote("Tap an object to select") }
    if rotating && selected_object >= 0 && !rotation_drag { PictureNote("Drag the dot to rotate") }
    if erasing { PictureNote("Tap an object to erase") }
    if retro.now < status_until { PictureNote(status) }
}

DialogBack :: (title: string, wide: bool = false) {
    BookPaper()
    if wide { BookBox(4, 4, 312, 192, 0xfffcf3ff, 0x704d36ff, 5.0) }
    BookText(20, 11, 280, 17, title, 13)
}

CancelButton :: () -> bool {
    // The shared title-bar Back arrow reaches dialogs as Escape.
    if retro.key == KEY_ESCAPE {
        Sound("click")
        view = MAIN
        dirty = true
        return true
    }
    return false
}


#import "tree"
#import "scroll_widget"
#import "scroll_props"

stencil_picker_scroll: s32;
stencil_picker_page_scroll: s32;

StencilPickerButton :: (id: s32, x: s32, y: s32, width: s32, label: string, chosen: bool = false) -> bool {
    press := RetroTap(id, x, y, width, 44, label)
    BookBox(x, y, width, 44, ifx chosen || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
        ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
    BookText(x + 6, y, width - 12, 44, label, 18)
    return press.clicked
}

#import "text_measure"
#import "text_props"
#import "text_align"
#import "text_widget"

// Each tile label is measured with the host's fonts once per width and
// language: it shrinks toward the minimum size, then wraps onto two lines.
stencil_label_language: s32 = -1;
stencil_label_available: [PAINT_STENCIL_COUNT]s32;
stencil_label_fonts: [PAINT_STENCIL_COUNT]s32;
stencil_label_heights: [PAINT_STENCIL_COUNT]s32;

StencilLabelFit :: (index: s32, available: s32) {
    if stencil_label_language != language {
        for at: cast(s32)0..PAINT_STENCIL_COUNT - 1 { stencil_label_available[at] = 0 }
        stencil_label_language = language
    }
    if stencil_label_available[index] == available { return }
    props := TextProps.{.bounds = RetroRect(0, 0, available, 24), .text = PaintStencilShortLabel(index),
        .font = STENCIL_LABEL_FONT, .wrap = TextWrap.TextWrapNone}
    font := StencilLabelFont(TextWidth(retro.session, props), available)
    props.font = font
    width := TextWidth(retro.session, props)
    while font > STENCIL_LABEL_MINIMUM && width > available {
        font -= 1; props.font = font; width = TextWidth(retro.session, props)
    }
    height: s32 = 24
    if width > available {
        props.wrap = TextWrap.TextWrapAuto
        height = TextHeight(retro.session, props)
        if height < 24 { height = 24 }
    }
    stencil_label_available[index] = available
    stencil_label_fonts[index] = ifx width > available then -font else font
    stencil_label_heights[index] = height
}

StencilPickerContent :: (l: StencilPickerLayout) {
    BookPaperSized(l.width, l.height)
    BookText(l.padding, l.top, l.width - l.padding * 2, 30, "Choose a stencil", 20)
    for category: cast(s32)0..3 {
        if StencilPickerButton(500 + category,
            l.padding + (category % l.tab_columns) * (l.tab_width + l.gap),
            l.tab_y + (category / l.tab_columns) * (44 + l.gap), l.tab_width,
            PaintStencilCategoryLabel(category), stencil_category == category) {
            stencil_category = category; stencil_anchor = 0; stencil_picker_scroll = 0; ChoicesSave(); return
        }
    }
    saved_y := retro.y
    if l.scroll {
        scrolled := Scroll(retro.session, ScrollProps.{.key = cast(u64)590,
            .bounds = RetroRect(l.padding, l.grid_y, l.width - l.padding * 2, l.grid_height),
            .scale = 1.0, .content_height = l.content_height,
            .scroll_offset = stencil_picker_scroll, .keep_scrollbar = true})
        if !scrolled.opened { unused CancelButton(); return }
        stencil_picker_scroll = scrolled.scroll_offset
        retro.y -= cast(float32)stencil_picker_scroll
    } else { stencil_picker_scroll = 0 }
    count := paint_stencil_category_counts[stencil_category]
    first := StencilPageFirst(stencil_anchor, l.capacity, count)
    for offset: cast(s32)0..l.capacity - 1 {
        if first + offset >= count { break }
        index := paint_stencil_order[paint_stencil_category_starts[stencil_category] + first + offset]
        x := l.padding + (offset % l.columns) * (l.card_width + l.gap)
        y := l.grid_y + (offset / l.columns) * (l.card_height + l.gap)
        press := RetroTap(80 + index, x, y, l.card_width, l.card_height, PaintStencilLabel(index))
        chosen := index == dino
        BookBox(x, y, l.card_width, l.card_height,
            ifx press.down || chosen then cast(u32)0xdcebdcff else cast(u32)0xf7f1e3ff,
            ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
        number := FormatInteger(index + 1, digits_a[:])
        StencilLabelFit(index, l.card_width - 12)
        label_height := stencil_label_heights[index]
        image_height := l.card_height - 10 - label_height
        fit := cast(float32)(l.card_width - 16) / cast(float32)DinoWidth(index, DINO_SIZES)
        if cast(float32)image_height / cast(float32)DinoHeight(index, DINO_SIZES) < fit {
            fit = cast(float32)image_height / cast(float32)DinoHeight(index, DINO_SIZES)
        }
        dw := cast(s32)(cast(float32)DinoWidth(index, DINO_SIZES) * fit)
        dh := cast(s32)(cast(float32)DinoHeight(index, DINO_SIZES) * fit)
        RetroSprite(Join(ART, Join("dino", number, "-preview.png")),
            x + (l.card_width - dw) / 2, y + 5 + (image_height - dh) / 2, dw, dh, -1, true)
        font := stencil_label_fonts[index]
        Text(retro.session, TextProps.{.bounds = RetroRect(x + 6, y + l.card_height - 4 - label_height,
            l.card_width - 12, label_height), .text = PaintStencilShortLabel(index),
            .font = ifx font < 0 then -font else font, .align = TextAlign.TextAlignCenter,
            .vertical_align = TextAlign.TextAlignCenter,
            .wrap = ifx font < 0 then TextWrap.TextWrapAuto else TextWrap.TextWrapNone})
        if press.clicked {
            dino = index; stencil_anchor = first + offset
            ChoicesSave(); Sound("click"); PlacementBegin(); view = MAIN; break
        }
    }
    retro.y = saved_y
    if l.scroll { unused End(retro.session) }
    if view == MAIN { return }
    pages := StencilPageCount(l.capacity, count)
    page := first / l.capacity
    if page > 0 && StencilPickerButton(196, l.padding, l.footer_y, l.footer_width, "Previous") {
        stencil_anchor = StencilPagePrevious(stencil_anchor, l.capacity, count)
        stencil_picker_scroll = 0; ChoicesSave(); return
    }
    if page < pages - 1 && StencilPickerButton(197, l.width - l.padding - l.footer_width, l.footer_y, l.footer_width, "Next") {
        stencil_anchor = StencilPageNext(stencil_anchor, l.capacity, count)
        stencil_picker_scroll = 0; ChoicesSave(); return
    }
    page_digits: [24]u8
    number := FormatInteger(page + 1, digits_a[:])
    BookText((l.width - l.footer_width) / 2, l.footer_y, l.footer_width, 44,
        Join(number, " / ", FormatInteger(pages, page_digits[:])), 18)
    unused CancelButton()
}


scene_picker_scroll: s32;
scene_picker_page_scroll: s32;

ScenePickerContent :: (l: ScenePickerLayout) {
    BookPaperSized(l.width, l.height)
    BookText(l.padding, l.top, l.width - l.padding * 2, 30, "Choose a scene", 20)
    for category: cast(s32)0..PAINT_SCENE_TAB_COUNT - 1 {
        if StencilPickerButton(520 + category, l.padding + (category % l.tab_columns) * (l.tab_width + l.gap),
            l.tab_y + (category / l.tab_columns) * (44 + l.gap), l.tab_width, SceneCategoryLabel(category),
            scene_category == category) {
            if scene_category != category {
                scene_category = category; scene_page = 0; scene_picker_scroll = 0; ChoicesSave()
            }
            return
        }
    }
    grid_height := l.footer_y - l.gap - l.grid_y
    scroll_grid := l.card_height < 80
    saved_y := retro.y
    if scroll_grid {
        l.card_height = 80
        scrolled := Scroll(retro.session, ScrollProps.{.key = cast(u64)592,
            .bounds = RetroRect(l.padding, l.grid_y, l.width - l.padding * 2, grid_height),
            .scale = 1.0, .content_height = l.rows * (l.card_height + l.gap) - l.gap,
            .scroll_offset = scene_picker_scroll, .keep_scrollbar = true})
        if !scrolled.opened { unused CancelButton(); return }
        scene_picker_scroll = scrolled.scroll_offset
        retro.y -= cast(float32)scene_picker_scroll
    } else { scene_picker_scroll = 0 }
    for offset: cast(s32)0..5 {
        if scene_category == PAINT_SCENE_CATEGORY_COUNT {
            if offset > 0 { continue }
            x := l.padding
            y := l.grid_y
            press := RetroTap(69, x, y, l.card_width, l.card_height, SceneCategoryLabel(scene_category))
            BookBox(x, y, l.card_width, l.card_height,
                ifx press.down then cast(u32)0xdcebdcff else cast(u32)0xfffcf3ff,
                ifx press.down then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
            icon := ifx l.card_width < l.card_height then l.card_width * 2 / 5 else l.card_height * 2 / 5
            if icon > 96 { icon = 96 }
            SvgIcon(retro.session, SvgIconProps.{.bounds = RetroRect(x + (l.card_width - icon) / 2,
                y + (l.card_height - 34 - icon) / 2, icon, icon), .shape = PencilIcon.Shape,
                .color = ColorFromPacked(0x3e332aff)})
            BookText(x + 6, y + l.card_height - 28, l.card_width - 12, 24, SceneCategoryLabel(scene_category), 18)
            if press.clicked { OpenScene(BLANK_SCENE); break }
            continue
        }
        index := PaintSceneAt(scene_category, scene_page * 6 + offset)
        if index < 0 { continue }
        x := l.padding + (offset % l.columns) * (l.card_width + l.gap)
        y := l.grid_y + (offset / l.columns) * (l.card_height + l.gap)
        press := RetroTap(60 + offset, x, y, l.card_width, l.card_height, PaintSceneLabel(index))
        BookBox(x, y, l.card_width, l.card_height,
            ifx press.down || index == last_scene then cast(u32)0xdcebdcff else cast(u32)0xf7f1e3ff,
            ifx index == last_scene then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
        number := FormatInteger(index + 1, digits_a[:])
        image_height := l.card_height - 34
        dw := l.card_width - 16
        dh := dw * 3 / 4
        if dh > image_height { dh = image_height; dw = dh * 4 / 3 }
        RetroSprite(Join(ART, Join("scene", number, "-thumb.jpg")),
            x + (l.card_width - dw) / 2, y + 5 + (image_height - dh) / 2, dw, dh, -1, true)
        BookText(x + 6, y + l.card_height - 28, l.card_width - 12, 24, PaintSceneLabel(index), 18)
        if press.clicked { OpenScene(index); break }
    }
    retro.y = saved_y
    if scroll_grid { unused End(retro.session) }
    if view != PICK_SCENE { return }
    pages := (SceneCategoryCount(scene_category) + 5) / 6
    if scene_page > 0 && StencilPickerButton(196, l.padding, l.footer_y, l.footer_width, "Previous") {
        scene_page -= 1; scene_picker_scroll = 0; ChoicesSave(); Sound("click"); return
    }
    if scene_page < pages - 1 && StencilPickerButton(197, l.width - l.padding - l.footer_width, l.footer_y, l.footer_width, "Next") {
        scene_page += 1; scene_picker_scroll = 0; ChoicesSave(); Sound("click"); return
    }
    page_digits: [24]u8
    number := FormatInteger(scene_page + 1, digits_a[:])
    BookText(l.padding + l.footer_width + l.gap, l.footer_y, l.footer_width, 44,
        Join(number, " / ", FormatInteger(pages, page_digits[:])), 18)
    if CancelButton() && scene < 0 && history_count == 0 { GameHome() }
}

ScenePicker :: () {
    bounds := AppBounds()
    retro.x = bounds.x; retro.y = bounds.y; retro.scale = 1.0
    width := cast(s32)bounds.width
    height := cast(s32)bounds.height
    if height < 300 {
        BookPaperSized(width, height)
        scrolled := Scroll(retro.session, ScrollProps.{.key = cast(u64)593,
            .bounds = RetroRect(0, 0, width, height), .scale = 1.0,
            .content_height = 500, .scroll_offset = scene_picker_page_scroll, .keep_scrollbar = true})
        scene_picker_page_scroll = scrolled.scroll_offset
        if scrolled.opened {
            retro.y -= cast(float32)scene_picker_page_scroll
            ScenePickerContent(ScenePickerBounds(width, 500, PAINT_SCENE_TAB_COUNT))
            retro.y = bounds.y
            unused End(retro.session)
        }
    } else {
        scene_picker_page_scroll = 0
        ScenePickerContent(ScenePickerBounds(width, height, PAINT_SCENE_TAB_COUNT))
    }
}

DinoPicker :: () {
    bounds := AppBounds()
    retro.x = bounds.x; retro.y = bounds.y; retro.scale = 1.0
    width := cast(s32)bounds.width
    height := cast(s32)bounds.height
    // At unusually short heights even fixed tabs and footer need scrolling.
    // Keep full-sized controls rather than shrinking their touch targets.
    if height < 300 {
        BookPaperSized(width, height)
        scrolled := Scroll(retro.session, ScrollProps.{.key = cast(u64)591,
            .bounds = RetroRect(0, 0, width, height), .scale = 1.0,
            .content_height = 500, .scroll_offset = stencil_picker_page_scroll, .keep_scrollbar = true})
        stencil_picker_page_scroll = scrolled.scroll_offset
        if scrolled.opened {
            retro.y -= cast(float32)stencil_picker_page_scroll
            StencilPickerContent(StencilPickerBounds(width, 500))
            retro.y = bounds.y
            unused End(retro.session)
        }
    } else {
        stencil_picker_page_scroll = 0
        StencilPickerContent(StencilPickerBounds(width, height))
    }
}

SizePicker :: () {
    DialogBack(Join(Tr("Size: "), PaintStencilShortLabel(dino)))
    number := FormatInteger(dino + 1, digits_a[:])
    for index: cast(s32)0..3 {
        x: s32 = 24 + index * 70
        y: s32 = 40
        press := RetroTap(110 + index, x, y, 64, 120, size_names[index])
        BookBox(x, y, 64, 120, ifx press.down || size == index + 1 then cast(u32)0xdcebdcff else cast(u32)0xf7f1e3ff, 0xdacdb5ff, 4.0)
        fit: float32 = 54.0 / cast(float32)DinoWidth(dino, DINO_SIZES)
        if 94.0 / cast(float32)DinoHeight(dino, DINO_SIZES) < fit { fit = 94.0 / cast(float32)DinoHeight(dino, DINO_SIZES) }
        dw := cast(s32)(cast(float32)DinoWidth(dino, DINO_SIZES) * fit * cast(float32)(index + 1) / 4.0)
        dh := cast(s32)(cast(float32)DinoHeight(dino, DINO_SIZES) * fit * cast(float32)(index + 1) / 4.0)
        RetroSprite(Join(ART, Join("dino", number, "-preview.png")),
            x + (64 - dw) / 2, y + 4 + (96 - dh) / 2, dw, dh, -1, true)
        BookText(x + 2, y + 103, 60, 17, size_names[index], 11)
        if press.clicked {
            size = index + 1
            placing = true
            canvas_can_fill = false
            ChoicesSave()
            placement_x = 0
            placement_y = 0
            dragging = false
            Sound("click")
            view = MAIN
            return
        }
    }
    if CancelButton() { view = PICK_DINO }
}

ColorPicker :: () {
    DialogBack("Choose a color")
    for index: cast(s32)0..CRAYON_COUNT - 1 {
        color := crayon_order[index]
        x := 20 + (index % 7) * 41
        y := 31 + (index / 7) * 23
        press := RetroTap(130 + index, x, y, 37, 18, "Color")
        chosen := color == 16 + crayon
        if chosen { BookBox(x - 2, y - 2, 41, 22, 0x2e6956ff, 0x2e6956ff, 5.0) }
        BookBox(x, y, 37, 18, paint_colors[color], ifx chosen then cast(u32)0xfffcf3ff else cast(u32)0x8a7a66ff, 4.0)
        if press.clicked {
            crayon = color - 16
            Sound("click")
            view = MAIN
            return
        }
    }
    pointer := SamplePointer()
    x := RetroPointX(pointer.x)
    y := RetroPointY(pointer.y)
    inside := x >= 18 && x < 305 && y >= 29 && y < 166
    // A title-bar click is handled once through Escape on the next frame.
    if pointer.released && !inside && y >= 0 { view = MAIN }
    unused CancelButton()
}

StoryView :: () {
    AppKeyboard(true)
    DialogBack("Write your story", true)
    for row: cast(s32)0..STORY_LINES - 1 {
        BookBox(6, 28 + row * 18, STORY_COLUMNS * 8 + 4, 17, 0xf3ecdcff, 0xdacdb5ff, 2.0)
        text := LatinText(TextUntilNul(story[row][:]))
        if text.count > 0 { RetroText(8, 29 + row * 18, text, BLACK, 1, false) }
        press := RetroTap(220 + row, 8, 28 + row * 18, STORY_COLUMNS * 8, 17, "Story line")
        if press.clicked {
            story_row = row
            story_column = (RetroPointX(press.x) - 8) / 8
            if story_column < 0 { story_column = 0 }
            if story_column >= STORY_COLUMNS { story_column = STORY_COLUMNS - 1 }
        }
    }
    RetroFill(8 + story_column * 8, 29 + story_row * 18, 8, 16, ifx cast(s64)(retro.now * 2.0) % 2 == 0 then BLACK else LIGHT_GRAY)
    key := retro.key
    input := AppFieldInput()
    position := story_row * STORY_COLUMNS + story_column
    if key == KEY_LEFT && position > 0 { position -= 1 }
    if key == KEY_RIGHT && position < STORY_LINES * STORY_COLUMNS - 1 { position += 1 }
    if key == KEY_UP && position >= STORY_COLUMNS { position -= STORY_COLUMNS }
    if key == KEY_DOWN && position < (STORY_LINES - 1) * STORY_COLUMNS { position += STORY_COLUMNS }
    if key == 268 { position = story_row * STORY_COLUMNS }
    if key == 269 { position = story_row * STORY_COLUMNS + STORY_COLUMNS - 1 }
    story_row = position / STORY_COLUMNS
    story_column = position % STORY_COLUMNS
    if key == KEY_BACKSPACE || key == 261 {
        if key == KEY_BACKSPACE && position > 0 { position -= 1 }
        for at: position..STORY_LINES * STORY_COLUMNS - 2 {
            story[at / STORY_COLUMNS][at % STORY_COLUMNS] = story[(at + 1) / STORY_COLUMNS][(at + 1) % STORY_COLUMNS]
        }
        story[STORY_LINES - 1][STORY_COLUMNS - 1] = 0
        story_row = position / STORY_COLUMNS
        story_column = position % STORY_COLUMNS
    }
    input_at: s32 = 0
    while input_at < cast(s32)input.text.count {
        decoded := Decode(input.text, input_at)
        input_at = decoded.after
        if !decoded.valid || decoded.value < cast(u32)32 || decoded.value > cast(u32)255 ||
            (decoded.value >= cast(u32)127 && decoded.value < cast(u32)160) { continue }
        byte := cast(u8)decoded.value
        for column: cast(s32)0..story_column - 1 {
            if story[story_row][column] == 0 { story[story_row][column] = #char " " }
        }
        story[story_row][story_column] = byte
        if position < STORY_LINES * STORY_COLUMNS - 1 { position += 1 }
        else { view = MAIN }
        story_row = position / STORY_COLUMNS
        story_column = position % STORY_COLUMNS
    }
    done := BookButton(145, 234, 173, 64, 14, "Done")
    if done || key == KEY_ENTER || key == KEY_ESCAPE || view == MAIN {
        AppKeyboard(false)
        view = MAIN
        WorkingPictureKeep()
    }
}

// A face icon on a round disk in the middle of area. Kryon keeps icons
// sharp up to 96 window pixels, so the disk is sized to the icon.
FaceIcon :: (shape: string, area: Rectangle, fill: u32, border: u32) {
    edge := ifx area.width < area.height then area.width * 0.75 else area.height * 0.75
    if edge > 96.0 { edge = 96.0 }
    disk := edge * 1.35
    unused Box(retro.session, BoxProps.{.bounds = Rectangle.{area.x + (area.width - disk) / 2.0, area.y + (area.height - disk) / 2.0, disk, disk},
        .fill = ColorFromPacked(fill), .border = ColorFromPacked(border), .radius = disk / 2.0})
    SvgIcon(retro.session, SvgIconProps.{.bounds = Rectangle.{area.x + (area.width - edge) / 2.0, area.y + (area.height - edge) / 2.0, edge, edge},
        .shape = shape, .color = ColorFromPacked(0x3e332aff)})
}

ConfirmView :: () {
    DialogBack("Erase this picture?")
    // Happy: a yellow face with a smile. Sad: a blue face with a frown.
    FaceIcon(HappyIcon.Shape, RetroRect(44, 50, 72, 74), 0xf1d681ff, 0xd6b763ff)
    BookText(40, 132, 80, 20, "Yes", 13)
    FaceIcon(SadIcon.Shape, RetroRect(204, 50, 72, 74), 0xbdd3ddff, 0x8cabbaff)
    BookText(200, 132, 80, 20, "No", 13)
    yes := RetroTap(150, 40, 50, 80, 120, "Yes").clicked
    if yes {
        if !GalleryStoreStartNew(*gallery_store) { Notice("Could not save gallery"); return }
        rotating = false
        HistoryPush()
        CanvasBlank()
        PictureViewReset()
        scene = -1
        ClearStory()
        dirty = true
        WorkingPictureKeep()
        Sound("clear")
        view = PICK_SCENE
        return
    }
    no := RetroTap(151, 200, 50, 80, 120, "No").clicked
    if no || (retro.key == KEY_ESCAPE) {
        view = MAIN
        Sound("click")
    }
}

// Each saved slot shows a small copy of its picture, made once and again
// after that slot is saved.
slot_previews: [SLOT_COUNT][32]u8;
slot_previews_ready: [SLOT_COUNT]bool;
slot_preview_created: bool;

SlotPreview :: (index: s32, saved: string) -> string {
    if !slot_previews_ready[index] && !slot_preview_created {
        slot_preview_created = true
        slot_previews_ready[index] = true
        slot_previews[index][0] = 0
        // Both current formats start with the flattened display runs.
        pixels := PICTURE_HEADER.count + 3 + cast(s64)PICTURE_STORY
        if PictureValid(saved) {
            nothing: []u8
            used := PictureRunsScan(saved[pixels:], nothing, CANVAS_PIXELS)
            made := GameCanvas(Join(PICTURE_RUNS, saved[pixels:pixels + used]))
            if made != "" { Keep(made, slot_previews[index][:]) }
        }
    }
    return TextUntilNul(slot_previews[index][:])
}

GalleryPreviewsClear :: () {
    for index: cast(s32)0..SLOT_COUNT - 1 { slot_previews_ready[index] = false; slot_previews[index][0] = 0 }
}

GalleryView :: () {
    DialogBack("Gallery")
    slot_preview_created = false
    if BookButton(540, 20, 29, 176, 18, "Save a copy") {
        if PictureHasPage() && GalleryStoreSave(*gallery_store, PictureText(), true) {
            gallery_page = gallery_store.gallery.selected / 6
            GalleryPreviewsClear()
            Notice("Picture and story saved")
        } else { Notice("Could not save gallery") }
    }
    if BookButton(541, 210, 29, 86, 18, "Slots") { GalleryPreviewsClear(); saving = true; view = SAVE_LOAD; return }
    if !gallery_store.ready { BookCentered(92, "Could not read gallery", RED) }
    else if gallery_store.gallery.count == 0 { BookCentered(92, "Your pictures appear here", BLACK) }
    else {
        for offset: cast(s32)0..5 {
            index := gallery_page * 6 + offset
            if index >= gallery_store.gallery.count { continue }
            x := 20 + (offset % 3) * 94
            y := 51 + (offset / 3) * 60
            number := FormatInteger(index + 1, digits_a[:])
            label := Join(Tr("Picture"), " ", number)
            press := RetroTap(550 + offset, x, y, 90, 56, label)
            BookBox(x, y, 90, 56, 0xf7f1e3ff,
                ifx index == gallery_store.gallery.selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
            saved := ifx !slot_previews_ready[offset] && !slot_preview_created then GalleryStoreRead(*gallery_store, index) else ""
            preview := SlotPreview(offset, saved)
            if preview != "" { RetroSprite(preview, x + 21, y + 2, 48, 36, -1, true) }
            BookText(x + 2, y + 39, 86, 14, label, 10)
            if press.clicked {
                picture := GalleryStoreRead(*gallery_store, index)
                if PictureLoad(picture) {
                    if !GalleryStoreSelect(*gallery_store, index, picture) { GalleryStoreDetach(*gallery_store); Notice("Could not save gallery") }
                    placing = false; dragging = false; erasing = false; rotating = false
                    PictureViewReset()
                    HistoryClear(); story_row = 0; story_column = 0; dirty = true
                    WorkingPictureKeep(); Sound("open"); view = MAIN
                } else { Notice("Empty or damaged save") }
                return
            }
        }
        pages := (gallery_store.gallery.count + 5) / 6
        if gallery_page > 0 && BookButton(196, 20, 173, 78, 14, "Previous") { gallery_page -= 1; GalleryPreviewsClear() }
        if gallery_page < pages - 1 && BookButton(197, 106, 173, 78, 14, "Next") { gallery_page += 1; GalleryPreviewsClear() }
        page_digits: [24]u8
        number := FormatInteger(gallery_page + 1, digits_a[:])
        BookText(220, 173, 76, 14, Join(number, " / ", FormatInteger(pages, page_digits[:])), 10)
    }
    if retro.now < status_until { BookLabel(20, 190, status, RED) }
    unused CancelButton()
}

SaveLoadView :: () {
    // Validate and render at most one saved preview per VM frame.
    slot_preview_created = false
    DialogBack(ifx saving then "Save picture and story" else "Load picture and story")
    if BookButton(200, 20, 28, 128, 20, "Save", saving) { saving = true }
    if BookButton(201, 168, 28, 128, 20, "Load", !saving) { saving = false }
    for index: cast(s32)0..SLOT_COUNT - 1 {
        x := 20 + (index % 3) * 96
        y := 56 + (index / 3) * 54
        saved := DocumentRead(SlotFile(index))
        label := ifx saved.count > 0 then "Saved" else "Empty"
        press := RetroTap(160 + index, x, y, 88, 52, label)
        BookBox(x, y, 88, 52, 0xf7f1e3ff, ifx index == slot then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
        preview := ifx saved.count > 0 then SlotPreview(index, saved) else ""
        if preview != "" {
            BookBox(x + 15, y + 4, 58, 44, 0xffffffff, 0xdacdb5ff, 2.0)
            RetroSprite(preview, x + 16, y + 5, 56, 42, -1, true)
        } else {
            BookLabel(x + (88 - RetroTextWidth(label)) / 2, y + 18, label, BLACK)
            BookLabel(x + 18, y + 36, "Slot", DARK_GRAY)
        }
        if press.clicked {
            if saving {
                if saved.count > 0 { pending_slot = index; view = OVERWRITE }
                else if StoreSlot(index) { view = MAIN }
            } else {
                if LoadSlot(index) { view = MAIN; Sound("open") }
            }
            return
        }
    }
    if retro.now < status_until { BookLabel(12, 164, status, RED) }
    unused CancelButton()
}

OverwriteView :: () {
    DialogBack("Replace this saved picture?")
    BookCentered(56, "Its picture and story", BLACK)
    BookCentered(80, "will be replaced.", BLACK)
    if BookButton(202, 24, 120, 128, 28, "Replace") {
        if pending_slot >= 0 && StoreSlot(pending_slot) { view = MAIN }
    }
    if BookButton(203, 168, 120, 128, 28, "Cancel") || retro.key == KEY_ESCAPE {
        view = SAVE_LOAD
    }
}

PrintView :: () {
    DialogBack("Picture and story")
    BookCentered(38, "Save a PNG, story and", BLACK)
    BookCentered(58, "printable color picture", BLACK)
    if BookButton(204, 28, 90, 264, 28, "Export files") {
        reply := AppService("jungle.export", Join(CanvasText(), StoryText()))
        Notice(ifx reply == "exported" then "Files saved in game exports" else "Could not export")
    }
    if BookButton(205, 28, 126, 264, 28, "Print") {
        reply := AppService("jungle.print", Join(CanvasText(), StoryText()))
        Notice(ifx reply == "printed" then "Sent to printer" else
            ifx reply == "exported" then "No printer; files saved" else "Could not print")
    }
    if retro.now < status_until { BookCentered(160, status, BLACK) }
    unused CancelButton()
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        initialized = false
        working_history_start = false
        working_save_pending = false
        working_bookkeeping = false
        working_canvas_state = WORKING_CANVAS_IDLE
        history_loading = false
        erasing = false
        rotating = false
        penciling = false
        pencil_dragging = false
        SelectionClear()
        view = MAIN
        placing = false
        dragging = false
        penciling = false
        pencil_dragging = false
        HistoryClear()
        scene = -1
        crayon = 14
        dino = -1
        canvas_name[0] = 0
        canvas_shown_name[0] = 0
        ink_page_name[0] = 0
        ink_tile_name[0] = 0
        ink_page_stale = true
        ink_tile_stale = true
        picture_view_ready = false
        view_block = false
        view_panning = false
        view_pan_active = false
        dirty = true
        ClearStory()
        AppIdentity("jungle.paint")
        AppDescribe("Coloring Book", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx WorkingPictureSave() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    working_bookkeeping = false
    history_begin := false
    if (working_history_start || history_loading) && AppKey() == KEY_ESCAPE { GameHome() }
    if working_save_pending && initialized && !working_history_start && !history_loading {
        working_save_pending = false
        working_bookkeeping = true
        unused WorkingPictureSave()
    }
    if initialized && working_history_start {
        working_bookkeeping = true
        if working_canvas_state == WORKING_CANVAS_WAIT {
            working_canvas_state = WORKING_CANVAS_MAKE
        } else if working_canvas_state == WORKING_CANVAS_MAKE {
            working_canvas_state = WORKING_CANVAS_IDLE
            working_history_start = false
            HistoryLoadBegin(DocumentRead(WORKING_HISTORY), working_loaded)
            working_loaded = ""
            history_begin = true
        }
    }
    if history_loading && !history_begin { HistoryLoadStep(); working_bookkeeping = true }
    else if history_loading { working_bookkeeping = true }
    if !initialized {
        CanvasBlank()
        WorkingPictureLoad()
        ChoicesLoad()
        GalleryStoreInit(*gallery_store, GalleryReadDocument, DocumentWrite)
        if !GalleryStoreLoad(*gallery_store, working_loaded) { Notice("Could not read gallery") }
        working_bookkeeping = true
        if working_history_start { working_canvas_state = WORKING_CANVAS_WAIT }
        if scene < 0 { view = PICK_SCENE }
        initialized = true
    }
    RetroBegin(AppSession(), AppBounds(), FONT, AppNow(), AppKey(), BLACK)
    BookPalette()
    if view == MAIN { MainView() }
    else if view == PICK_SCENE { ScenePicker() }
    else if view == PICK_DINO { DinoPicker() }
    else if view == PICK_SIZE { SizePicker() }
    else if view == PICK_COLOR { ColorPicker() }
    else if view == STORY { StoryView() }
    else if view == CONFIRM_ERASE { ConfirmView() }
    else if view == GALLERY { GalleryView() }
    else if view == SAVE_LOAD { SaveLoadView() }
    else if view == OVERWRITE { OverwriteView() }
    else if view == PRINT_VIEW { PrintView() }
    working_bookkeeping = false
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

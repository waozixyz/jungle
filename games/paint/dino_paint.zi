PictureIcon :: #import "mingcute/mingcute_regular_pic";
BucketIcon :: #import "mingcute/mingcute_regular_paint";
PencilIcon :: #import "mingcute/mingcute_regular_pencil";
NewIcon :: #import "mingcute/mingcute_regular_file_new";
EraserIcon :: #import "mingcute/mingcute_regular_eraser";
PrintIcon :: #import "mingcute/mingcute_regular_print";
UndoIcon :: #import "mingcute/mingcute_regular_back_2";
MirrorIcon :: #import "mingcute/mingcute_regular_flip_horizontal";
MoveIcon :: #import "mingcute/mingcute_regular_move";
HappyIcon :: #import "mingcute/mingcute_regular_happy";
SadIcon :: #import "mingcute/mingcute_regular_sad";
RotateIcon :: #import "mingcute/mingcute_regular_refresh_2";

FONT :: "assets/dino-paint/font.png"
SOUNDS :: "assets/dino-paint/sounds/"
ART :: "assets/dino-paint/art/"

MAIN :: 0
PICK_SCENE :: 1
PICK_DINO :: 2
PICK_SIZE :: 3
PICK_COLOR :: 4
STORY :: 5
CONFIRM_ERASE :: 6
SAVE_LOAD :: 8
OVERWRITE :: 9
PRINT_VIEW :: 10
GALLERY :: 11
TOOL_COUNT :: 9

SLOT_COUNT :: 6
WORKING :: "working.txt"
WORKING_HISTORY :: "working-undo.txt"

button_names: [9]string = .["Image", "Color", "Story", "Erase", "Gallery", "Print", "Undo", "New picture", "Rotate"];
size_names: [4]string = .["Small", "Medium", "Large", "Huge"];

view: s32 = MAIN;
dino: s32 = -1;
size: s32 = 2;
placing: bool;
erasing: bool;
rotating: bool;
placement_flip: bool;
placement_x: s32;
placement_y: s32;
dragging: bool;
canvas_can_fill: bool;
grab_x: s32;
grab_y: s32;
dino_page: s32;
scene_page: s32;
stencil_category: s32;
scene_category: s32;
last_scene: s32 = -1;
gallery_store: GalleryStore;
gallery_page: s32;
story_row: s32;
story_column: s32;
canvas_name: [32]u8;
canvas_shown_name: [32]u8;
digits_a: [24]u8;
dirty: bool = true;
slot: s32 = -1;
pending_slot: s32 = -1;
saving: bool = true;
status: string;
status_until: float64;
initialized: bool;

// Choices are separate from pictures and Undo: returning to a stencil never
// changes the scene or artwork already saved in a picture.
CHOICES :: "choices.txt"
CHOICES_HEADER :: "JUNGLE PAINT CHOICES 1\n"
ChoicesSave :: () {
    values: [8]u8 = .[PAINT_CODES[dino + 1], PAINT_CODES[stencil_category], PAINT_CODES[dino_page],
        PAINT_CODES[size], PAINT_CODES[ifx placement_flip then 1 else 0], PAINT_CODES[scene_category],
        PAINT_CODES[scene_page], PAINT_CODES[last_scene + 1]]
    unused DocumentWrite(CHOICES, Join(CHOICES_HEADER, TextView(values[:])))
}

ChoicesLoad :: () {
    dino = -1; stencil_category = 0; dino_page = 0; size = 2
    placement_flip = false; scene_category = 0; scene_page = 0; last_scene = -1
    saved := DocumentRead(CHOICES)
    if saved.count != CHOICES_HEADER.count + 8 || saved[:CHOICES_HEADER.count] != CHOICES_HEADER { return }
    values: [8]s32
    for at: cast(s32)0..7 { values[at] = PaintIndex(saved[CHOICES_HEADER.count + at]); if values[at] < 0 { return } }
    if values[0] > PAINT_STENCIL_COUNT || values[1] >= PAINT_STENCIL_CATEGORY_COUNT ||
        values[2] >= (paint_stencil_category_counts[values[1]] + 5) / 6 || values[3] < 1 || values[3] > 4 ||
        values[4] > 1 || values[5] >= PAINT_SCENE_CATEGORY_COUNT ||
        values[6] >= (paint_scene_category_counts[values[5]] + 5) / 6 || values[7] > PAINT_SCENE_COUNT { return }
    dino = values[0] - 1; stencil_category = values[1]; dino_page = values[2]; size = values[3]
    placement_flip = values[4] == 1; scene_category = values[5]; scene_page = values[6]; last_scene = values[7] - 1
}

GalleryReadDocument :: (name: string, status: *s32) -> string {
    bytes := DocumentRead(name)
    status.* = DocumentStatus()
    return bytes
}

Join :: (a: string, b: string = "", c: string = "") -> string {
    text: Vec(u8)
    parts: [3]string = .[a, b, c]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Sound :: (name: string) { GameSound(Join(SOUNDS, name, ".wav")) }

SlotFile :: (index: s32) -> string {
    digits: [24]u8
    return Join("slot-", FormatInteger(cast(s64)index, digits[:]), ".txt")
}

Keep :: (name: string, bytes: []u8) {
    count := ifx name.count < bytes.count then name.count else bytes.count - 1
    for at: cast(s64)0..count - 1 { bytes[at] = name[at] }
    bytes[count] = 0
}

// Persist an edit on the following frame so decoding/erasing and encoding
// a large picture never share one VM frame. APP_SAVE still flushes on exit.
working_save_pending: bool;
WorkingPictureKeep :: () { working_save_pending = true }

// One frame of bookkeeping keeps the submitted page, but neither serializes it
// in the same frame as an edit nor accepts a new edit while its save settles.
working_bookkeeping: bool;

// The working picture, then its undo history, which names that exact
// picture: if only the picture is written, the history no longer matches it
// and is dropped on reading, so no step can be undone twice.
WorkingPictureSave :: () -> bool {
    if !initialized || working_history_start || history_loading { return true }
    working := PictureText()
    if !DocumentWrite(WORKING, working) { return false }
    gallery_saved := scene < 0 || GalleryStoreSave(*gallery_store, working)
    if HistoryBoundTo(working) { return gallery_saved }
    // Built in place, so its storage is released after writing.
    text: Vec(u8)
    HistoryAppend(*text, working)
    if !DocumentWrite(WORKING_HISTORY, TextView(VecSlice(text, 0, text.count))) { return false }
    HistorySaved(working)
    return gallery_saved
}

// The working picture and, when it still belongs to it, its undo history.
working_history_start: bool;
working_loaded: string;
WORKING_CANVAS_IDLE :: 0
WORKING_CANVAS_WAIT :: 1
WORKING_CANVAS_MAKE :: 2
working_canvas_state: s32 = WORKING_CANVAS_IDLE;

WorkingPictureLoad :: () {
    HistoryClear()
    working_loaded = ""
    working := DocumentRead(WORKING)
    // Its history is read and matched to it on the next frame.
    if PictureLoad(working) { working_loaded = OwnedText(working); working_history_start = true }
}

Notice :: (text: string) { status = text; status_until = retro.now + 3.0 }

StoreSlot :: (index: s32) -> bool {
    if scene < 0 { Notice("Choose a scene first"); return false }
    if !DocumentWrite(SlotFile(index), PictureText()) { Notice("Could not save"); return false }
    slot = index
    slot_previews_ready[index] = false
    Notice("Picture and story saved")
    WorkingPictureKeep()
    return true
}

LoadSlot :: (index: s32) -> bool {
    if !PictureLoad(DocumentRead(SlotFile(index))) { Notice("Empty or damaged save"); return false }
    GalleryStoreDetach(*gallery_store)
    slot = index
    placing = false
    erasing = false
    HistoryClear()
    story_row = 0
    story_column = 0
    dirty = true
    WorkingPictureKeep()
    Notice("Picture and story loaded")
    return true
}

Undo :: () {
    if !HistoryUndo() { return }
    dirty = true
    WorkingPictureKeep()
    Sound("undo")
}

OpenScene :: (index: s32) {
    scene = index
    last_scene = index
    ChoicesSave()
    unused SceneOpen(index)
    placing = false
    erasing = false
    HistoryClear()
    dirty = true
    view = PICK_DINO
    ClearStory()
    story_row = 0
    story_column = 0
    slot = -1
    WorkingPictureKeep()
    Sound("open")
}

MakeCanvas :: () {
    if !dirty { return }
    made := GameCanvas(CanvasText())
    if made != "" {
        // Keep the last complete picture beneath its replacement while the
        // browser installs the new image in its drawing surface.
        {
            previous := TextUntilNul(canvas_name[:])
            if previous != "" && RetroImageReady(previous) { Keep(previous, canvas_shown_name[:]) }
        }
        Keep(made, canvas_name[:])
        dirty = false
    }
}

// The main screen is laid out in window pixels: on a wide window the nine
// tools stand beside the picture, or in three rows below a portrait picture. The picture keeps its 4:3 shape.
canvas_x: s32;
canvas_y: s32;
canvas_w: s32 = 1;
canvas_h: s32 = 1;
tool_x: [TOOL_COUNT]s32;
tool_y: [TOOL_COUNT]s32;
tool_w: s32;
tool_h: s32;

Clamp :: (value: s32, low: s32, high: s32) -> s32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

LayoutMain :: () {
    bounds := AppBounds()
    retro.x = bounds.x
    retro.y = bounds.y
    retro.scale = 1.0
    width := cast(s32)bounds.width
    height := cast(s32)bounds.height
    shortest := ifx width < height then width else height
    pad := Clamp(shortest / 40, 6, 20)
    gap := Clamp(shortest / 80, 4, 10)
    if height > width {
        tool_w = (width - pad * 2 - gap * 2) / 3
        tool_h = Clamp(tool_w * 3 / 4, 44, 110)
        canvas_w = width - pad * 2
        canvas_h = canvas_w * 3 / 4
        room := height - pad * 3 - gap * 2 - tool_h * 3
        if canvas_h > room { canvas_h = room; canvas_w = canvas_h * 4 / 3 }
        canvas_x = (width - canvas_w) / 2
        canvas_y = pad
        below := canvas_y + canvas_h + pad
        top := below + (height - pad - below - tool_h * 3 - gap * 2) / 2
        for index: cast(s32)0..TOOL_COUNT - 1 {
            tool_x[index] = pad + (index % 3) * (tool_w + gap)
            tool_y[index] = top + (index / 3) * (tool_h + gap)
        }
    } else {
        // A short landscape phone needs two columns to keep taps generous.
        columns: s32 = ifx height < 440 then 2 else 1
        rows: s32 = ifx columns == 2 then 5 else TOOL_COUNT
        width_parts: s32 = ifx columns == 2 then 8 else 5
        tool_h = (height - pad * 2 - gap * (rows - 1)) / rows
        tool_w = Clamp(tool_h * 5 / 2, 64, width / width_parts)
        rail_w := tool_w * columns + gap * (columns - 1)
        room_w := width - pad * 3 - rail_w
        room_h := height - pad * 2
        canvas_w = room_w
        canvas_h = canvas_w * 3 / 4
        if canvas_h > room_h { canvas_h = room_h; canvas_w = canvas_h * 4 / 3 }
        left := (width - rail_w - pad - canvas_w) / 2
        canvas_x = left + rail_w + pad
        canvas_y = pad + (room_h - canvas_h) / 2
        for index: cast(s32)0..TOOL_COUNT - 1 {
            tool_x[index] = left + (index % columns) * (tool_w + gap)
            tool_y[index] = canvas_y + (canvas_h - tool_h * rows - gap * (rows - 1)) / 2 + (index / columns) * (tool_h + gap)
        }
    }
    if canvas_w < 1 { canvas_w = 1 }
    if canvas_h < 1 { canvas_h = 1 }
}

ToolShape :: (index: s32) -> string {
    if index == 0 { return PictureIcon.Shape }
    if index == 1 { return BucketIcon.Shape }
    if index == 2 { return PencilIcon.Shape }
    if index == 3 { return EraserIcon.Shape }
    if index == 4 { return PictureIcon.Shape }
    if index == 5 { return PrintIcon.Shape }
    if index == 6 { return ifx placing then MirrorIcon.Shape else UndoIcon.Shape }
    if index == 8 { return RotateIcon.Shape }
    return NewIcon.Shape
}

// A rounded tool with its icon above its name.
ToolButton :: (id: s32, x: s32, y: s32, w: s32, h: s32, shape: string, label: string, chosen: bool) -> bool {
    press := RetroTap(id, x, y, w, h, label)
    BookBox(x, y, w, h, ifx chosen || press.down then cast(u32)0xdcebdcff else cast(u32)0xfffcf3ff,
        ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, cast(float32)(h / 6))
    label_h := h * 3 / 10
    icon := Clamp(h - label_h - h / 4, 8, 96)
    if icon > w * 3 / 5 { icon = w * 3 / 5 }
    SvgIcon(retro.session, SvgIconProps.{.bounds = RetroRect(x + (w - icon) / 2, y + (h - label_h - icon) / 2, icon, icon),
        .shape = shape, .color = ColorFromPacked(ifx chosen then cast(u32)0x2e6956ff else cast(u32)0x3e332aff)})
    BookText(x + 2, y + h - label_h - h / 12, w - 4, label_h, label, label_h * 4 / 5)
    return press.clicked
}

// The window rectangle of a part of the picture, in picture pixels.
PictureRect :: (x: s32, y: s32, w: s32, h: s32) -> Rectangle {
    across := cast(float32)canvas_w / cast(float32)CANVAS_WIDTH
    down := cast(float32)canvas_h / cast(float32)CANVAS_HEIGHT
    return Rectangle.{retro.x + cast(float32)canvas_x + cast(float32)x * across,
        retro.y + cast(float32)canvas_y + cast(float32)y * down,
        cast(float32)w * across, cast(float32)h * down}
}

PictureX :: (x: float32) -> s32 {
    return cast(s32)((x - retro.x - cast(float32)canvas_x) * cast(float32)CANVAS_WIDTH / cast(float32)canvas_w)
}

PictureY :: (y: float32) -> s32 {
    return cast(s32)((y - retro.y - cast(float32)canvas_y) * cast(float32)CANVAS_HEIGHT / cast(float32)canvas_h)
}

Fill :: (area: Rectangle, color: u32, radius: float32 = 0.0) {
    unused Box(retro.session, BoxProps.{.bounds = area, .fill = ColorFromPacked(color), .radius = radius})
}

// The dinosaur waiting to be placed: its picture in a tinted box with a
// dashed green edge, round handles at the corners and a move badge, so it
// reads as something to pick up and drag.
PlacementBox :: (area: Rectangle, flip: bool) {
    Fill(area, 0x2e69562a)
    unused flip
    edge := Clamp(cast(s32)(area.width / 60.0), 2, 4)
    thick := cast(float32)edge
    dash := thick * 5.0
    left := area.x
    right := area.x + area.width - thick
    top := area.y
    bottom := area.y + area.height - thick
    at: float32 = 0.0
    while at < area.width {
        long := ifx at + dash > area.width then area.width - at else dash
        Fill(Rectangle.{left + at, top, long, thick}, 0x2e6956ff)
        Fill(Rectangle.{left + at, bottom, long, thick}, 0x2e6956ff)
        at += dash * 1.6
    }
    at = 0.0
    while at < area.height {
        long := ifx at + dash > area.height then area.height - at else dash
        Fill(Rectangle.{left, top + at, thick, long}, 0x2e6956ff)
        Fill(Rectangle.{right, top + at, thick, long}, 0x2e6956ff)
        at += dash * 1.6
    }
    handle := thick * 4.0
    corners: [4]Vector2 = .[Vector2.{left, top}, Vector2.{right + thick, top}, Vector2.{left, bottom + thick}, Vector2.{right + thick, bottom + thick}]
    for corner: corners {
        unused Box(retro.session, BoxProps.{.bounds = Rectangle.{corner.x - handle / 2.0, corner.y - handle / 2.0, handle, handle},
            .fill = ColorFromPacked(0xfffcf3ff), .border = ColorFromPacked(0x2e6956ff), .radius = handle / 2.0})
    }
    badge := area.width / 4.0
    if area.height / 4.0 < badge { badge = area.height / 4.0 }
    if badge > 64.0 { badge = 64.0 }
    if badge >= 18.0 {
        center := Rectangle.{area.x + (area.width - badge) / 2.0, area.y + (area.height - badge) / 2.0, badge, badge}
        Fill(center, 0x2e6956e6, badge / 2.0)
        inset := badge / 5.0
        SvgIcon(retro.session, SvgIconProps.{.bounds = Rectangle.{center.x + inset, center.y + inset, badge - inset * 2.0, badge - inset * 2.0},
            .shape = MoveIcon.Shape, .color = ColorFromPacked(0xfffcf3ff)})
    }
}

// A short message across the bottom of the picture.
PictureNote :: (text: string) {
    note_h := Clamp(canvas_h / 10, 18, 44)
    BookBox(canvas_x + canvas_w / 8, canvas_y + canvas_h - note_h - note_h / 3, canvas_w * 3 / 4, note_h,
        0xfffcf3f0, 0xdacdb5ff, cast(float32)(note_h / 2))
    BookText(canvas_x + canvas_w / 8 + 4, canvas_y + canvas_h - note_h - note_h / 3, canvas_w * 3 / 4 - 8, note_h,
        text, note_h * 11 / 20)
}

MainView :: () {
    LayoutMain()
    bounds := AppBounds()
    BookBox(0, 0, cast(s32)bounds.width, cast(s32)bounds.height, 0xe3ece4ff)
    chosen_tool: s32 = -1
    for index: cast(s32)0..TOOL_COUNT - 1 {
        mirror := placing && index == 6
        label := ifx mirror then "Mirror" else button_names[index]
        pressed := ToolButton(20 + index, tool_x[index], tool_y[index], tool_w, tool_h, ToolShape(index), label, (mirror && placement_flip) || (index == 3 && erasing) || (index == 8 && rotating))
        if pressed && !working_bookkeeping { chosen_tool = index }
    }
    // The chosen crayon, as a dot on the Color tool.
    dot := Clamp(tool_h / 4, 8, 24)
    BookBox(tool_x[1] + tool_w - dot - tool_h / 10, tool_y[1] + tool_h / 10, dot, dot,
        paint_colors[16 + crayon], 0x3e332aff, cast(float32)(dot / 2))
    if scene >= 0 && (!working_bookkeeping || working_canvas_state == WORKING_CANVAS_MAKE) { MakeCanvas() }
    frame := Clamp(canvas_w / 120, 3, 8)
    BookBox(canvas_x - frame, canvas_y - frame, canvas_w + frame * 2, canvas_h + frame * 2,
        0xfffcf3ff, 0x704d36ff, cast(float32)(frame * 2))
    name := TextUntilNul(canvas_name[:])
    shown := TextUntilNul(canvas_shown_name[:])
    if scene >= 0 && shown != "" {
        RetroSprite(shown, canvas_x, canvas_y, canvas_w, canvas_h, -1, true)
    }
    if scene >= 0 && name != "" && name != shown {
        RetroSprite(name, canvas_x, canvas_y, canvas_w, canvas_h, -1, true)
    }
    if scene < 0 || (name == "" && shown == "") { BookBox(canvas_x, canvas_y, canvas_w, canvas_h, 0xffffffff) }
    press := RetroTap(40, canvas_x, canvas_y, canvas_w, canvas_h, "Picture", true)
    x := PictureX(press.x)
    y := PictureY(press.y)
    if placing {
        // A retained box starts in the upper left. Grab anywhere inside it,
        // drag within the paper, then release to replace the artwork below.
        w := DinoWidth(dino, size)
        h := DinoHeight(dino, size)
        pointer := SamplePointer()
        x = PictureX(pointer.x)
        y = PictureY(pointer.y)
        if !working_bookkeeping && chosen_tool < 0 && pointer.pressed && x >= placement_x && x < placement_x + w &&
        y >= placement_y && y < placement_y + h {
            dragging = true
            grab_x = x - placement_x
            grab_y = y - placement_y
        }
        if dragging {
            placement_x = Clamp(x - grab_x, 0, CANVAS_WIDTH - w)
            placement_y = Clamp(y - grab_y, 0, CANVAS_HEIGHT - h)
        }
        flip := placement_flip || GameSecondaryDown()
        PlacementBox(PictureRect(placement_x, placement_y, w, h), flip)
        if !dragging { PictureNote("Drag the stencil, then let go") }
        if !working_bookkeeping && chosen_tool < 0 && pointer.released && dragging {
            if !CanvasCanStamp(dino, size, placement_x, placement_y) {
                dragging = false
                Notice("Picture is full. Erase an object first")
                return
            }
            HistoryPush()
            CanvasStampDino(dino, size, placement_x, placement_y, flip)
            placing = false
            dragging = false
            dirty = true
            WorkingPictureKeep()
            Sound("fill")
        }
    } else {
        if !working_bookkeeping && chosen_tool < 0 && SamplePointer().pressed { canvas_can_fill = true }
        if !working_bookkeeping && chosen_tool < 0 && press.clicked && canvas_can_fill {
            canvas_can_fill = false
            if rotating {
                if CanvasObjectAt(x, y) >= 0 {
                    HistoryPush()
                    if CanvasRotateObject(x, y) { dirty = true; WorkingPictureKeep(); Sound("click") }
                }
                return
            }
            if erasing {
                if CanvasObjectAt(x, y) >= 0 {
                    HistoryPush()
                    if CanvasEraseObject(x, y) {
                        dirty = true
                        WorkingPictureKeep()
                        Sound("clear")
                    }
                }
                return
            }
            fill := 16 + crayon
            if scene >= 0 && CanvasColorAt(x, y) > INK && CanvasColorAt(x, y) != fill {
            HistoryPush()
            if CanvasFill(x, y, fill) > 0 {
                dirty = true
                WorkingPictureKeep()
                Sound("fill")
            }
        }
    }
    }
    if chosen_tool >= 0 {
        mirror := placing && chosen_tool == 6
        if mirror { placement_flip = !placement_flip; ChoicesSave(); Sound("click"); return }
        if chosen_tool == 8 && placing { Notice("Place the stencil first"); return }
        placing = false
        dragging = false
        Sound("click")
        if chosen_tool != 8 { rotating = false }
        if chosen_tool == 0 || chosen_tool == 1 || chosen_tool == 7 || chosen_tool == 8 { erasing = false }
        if chosen_tool == 0 { view = ifx scene < 0 then PICK_SCENE else PICK_DINO }
        if chosen_tool == 1 { view = PICK_COLOR }
        if chosen_tool == 2 { view = STORY }
        if chosen_tool == 3 { erasing = !erasing; canvas_can_fill = false }
        if chosen_tool == 4 {
            GalleryPreviewsClear()
            gallery_page = ifx gallery_store.gallery.selected >= 0 then gallery_store.gallery.selected / 6 else 0
            view = GALLERY
        }
        if chosen_tool == 5 { view = PRINT_VIEW }
        if chosen_tool == 6 { Undo() }
        if chosen_tool == 7 { view = CONFIRM_ERASE }
        if chosen_tool == 8 { rotating = !rotating; canvas_can_fill = false }
        return
    }
    if retro.key == KEY_ESCAPE { WorkingPictureKeep(); GameHome() }
    if rotating { PictureNote("Tap an object to rotate") }
    if erasing { PictureNote("Tap an object to erase") }
    if retro.now < status_until { PictureNote(status) }
}

DialogBack :: (title: string, wide: bool = false) {
    BookPaper()
    if wide { BookBox(4, 4, 312, 192, 0xfffcf3ff, 0x704d36ff, 5.0) }
    BookText(20, 11, 280, 17, title, 13)
}

CancelButton :: () -> bool {
    // The shared title-bar Back arrow reaches dialogs as Escape.
    if retro.key == KEY_ESCAPE {
        Sound("click")
        view = MAIN
        dirty = true
        return true
    }
    return false
}

ScenePicker :: () {
    DialogBack("Choose a scene")
    for category: cast(s32)0..PAINT_SCENE_CATEGORY_COUNT - 1 {
        if BookButton(520 + category, 20 + category * 95, 30, 90, 17, PaintSceneCategoryLabel(category), scene_category == category) {
            scene_category = category; scene_page = 0; ChoicesSave(); return
        }
    }
    count := paint_scene_category_counts[scene_category]
    for offset: cast(s32)0..5 {
        index := PaintSceneAt(scene_category, scene_page * 6 + offset)
        if index < 0 { continue }
        x := 20 + (offset % 3) * 94
        y := 51 + (offset / 3) * 60
        press := RetroTap(60 + offset, x, y, 90, 56, PaintSceneLabel(index))
        BookBox(x, y, 90, 56, ifx press.down || index == last_scene then cast(u32)0xdcebdcff else cast(u32)0xf7f1e3ff, 0xdacdb5ff, 4.0)
        number := FormatInteger(index + 1, digits_a[:])
        RetroSprite(Join(ART, Join("scene", Join(number, "-thumb.jpg"))), x + 21, y + 2, 48, 36, -1, true)
        BookText(x + 2, y + 39, 86, 14, PaintSceneLabel(index), 9)
        if press.clicked { OpenScene(index); return }
    }
    pages := (count + 5) / 6
    if scene_page > 0 && BookButton(196, 20, 173, 62, 14, "Previous") { scene_page -= 1; ChoicesSave(); Sound("click") }
    if scene_page < pages - 1 && BookButton(197, 150, 173, 62, 14, "Next") { scene_page += 1; ChoicesSave(); Sound("click") }
    page_digits: [24]u8
    number := FormatInteger(scene_page + 1, digits_a[:])
    BookText(85, 173, 62, 14, Join(number, " / ", FormatInteger(pages, page_digits[:])), 10)
    if CancelButton() && scene < 0 && history_count == 0 { GameHome() }
}

#import "tree"
#import "scroll_widget"
#import "scroll_props"

stencil_picker_scroll: s32;
stencil_picker_page_scroll: s32;

// Six slots are intentional: persisted v1 page choices survive every resize.
StencilPickerLayout :: struct {
    width: s32; height: s32; padding: s32; gap: s32
    columns: s32; rows: s32; tab_columns: s32
    tab_y: s32; tab_width: s32; grid_y: s32
    card_width: s32; card_height: s32; footer_y: s32; footer_width: s32
}

StencilPickerBounds :: (width: s32, height: s32) -> StencilPickerLayout {
    l: StencilPickerLayout
    l.width = width; l.height = height
    l.padding = ifx height < 440 then 8 else 16
    l.gap = ifx height < 440 then 6 else 10
    l.columns = ifx width < 600 then 2 else 3
    l.rows = 6 / l.columns
    l.tab_columns = ifx width < 600 then 2 else 4
    l.tab_y = l.padding + 30 + l.gap
    l.tab_width = (width - l.padding * 2 - l.gap * (l.tab_columns - 1)) / l.tab_columns
    l.grid_y = l.tab_y + (4 / l.tab_columns) * (44 + l.gap)
    l.footer_y = height - l.padding - 44
    l.footer_width = (width - l.padding * 2 - l.gap * 2) / 3
    l.card_width = (width - l.padding * 2 - l.gap * (l.columns - 1)) / l.columns
    l.card_height = (l.footer_y - l.gap - l.grid_y - l.gap * (l.rows - 1)) / l.rows
    return l
}

StencilPickerButton :: (id: s32, x: s32, y: s32, width: s32, label: string, chosen: bool = false) -> bool {
    press := RetroTap(id, x, y, width, 44, label)
    BookBox(x, y, width, 44, ifx chosen || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
        ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
    BookText(x + 6, y, width - 12, 44, label, 18)
    return press.clicked
}

StencilPickerContent :: (l: StencilPickerLayout) {
    BookPaperSized(l.width, l.height)
    BookText(l.padding, l.padding, l.width - l.padding * 2, 30, "Choose a stencil", 20)
    for category: cast(s32)0..3 {
        if StencilPickerButton(500 + category,
            l.padding + (category % l.tab_columns) * (l.tab_width + l.gap),
            l.tab_y + (category / l.tab_columns) * (44 + l.gap), l.tab_width,
            PaintStencilCategoryLabel(category), stencil_category == category) {
            stencil_category = category; dino_page = 0; stencil_picker_scroll = 0; ChoicesSave(); return
        }
    }
    grid_height := l.footer_y - l.gap - l.grid_y
    scroll_grid := l.card_height < 80
    saved_y := retro.y
    if scroll_grid {
        l.card_height = 80
        scrolled := Scroll(retro.session, ScrollProps.{.key = cast(u64)590,
            .bounds = RetroRect(l.padding, l.grid_y, l.width - l.padding * 2, grid_height),
            .scale = 1.0, .content_height = l.rows * (l.card_height + l.gap) - l.gap,
            .scroll_offset = stencil_picker_scroll, .keep_scrollbar = true})
        if !scrolled.opened { unused CancelButton(); return }
        stencil_picker_scroll = scrolled.scroll_offset
        retro.y -= cast(float32)stencil_picker_scroll
    } else { stencil_picker_scroll = 0 }
    first := paint_stencil_category_starts[stencil_category] + dino_page * 6
    for offset: cast(s32)0..5 {
        at := first + offset
        if at >= paint_stencil_category_starts[stencil_category] + paint_stencil_category_counts[stencil_category] { continue }
        index := paint_stencil_order[at]
        x := l.padding + (offset % l.columns) * (l.card_width + l.gap)
        y := l.grid_y + (offset / l.columns) * (l.card_height + l.gap)
        press := RetroTap(80 + index, x, y, l.card_width, l.card_height, PaintStencilLabel(index))
        chosen := index == dino
        BookBox(x, y, l.card_width, l.card_height,
            ifx press.down || chosen then cast(u32)0xdcebdcff else cast(u32)0xf7f1e3ff,
            ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 6.0)
        number := FormatInteger(index + 1, digits_a[:])
        image_height := l.card_height - 34
        fit := cast(float32)(l.card_width - 16) / cast(float32)DinoWidth(index, DINO_SIZES)
        if cast(float32)image_height / cast(float32)DinoHeight(index, DINO_SIZES) < fit {
            fit = cast(float32)image_height / cast(float32)DinoHeight(index, DINO_SIZES)
        }
        dw := cast(s32)(cast(float32)DinoWidth(index, DINO_SIZES) * fit)
        dh := cast(s32)(cast(float32)DinoHeight(index, DINO_SIZES) * fit)
        RetroSprite(Join(ART, Join("dino", number, "-preview.png")),
            x + (l.card_width - dw) / 2, y + 5 + (image_height - dh) / 2, dw, dh, -1, true)
        BookText(x + 6, y + l.card_height - 28, l.card_width - 12, 24, PaintStencilShortLabel(index), 18)
        if press.clicked {
            dino = index; ChoicesSave(); Sound("click"); view = PICK_SIZE; break
        }
    }
    retro.y = saved_y
    if scroll_grid { unused End(retro.session) }
    if view == PICK_SIZE { return }
    pages := (paint_stencil_category_counts[stencil_category] + 5) / 6
    if dino_page > 0 && StencilPickerButton(196, l.padding, l.footer_y, l.footer_width, "Previous") {
        dino_page -= 1; stencil_picker_scroll = 0; ChoicesSave(); return
    }
    if dino_page < pages - 1 && StencilPickerButton(197, l.width - l.padding - l.footer_width, l.footer_y, l.footer_width, "Next") {
        dino_page += 1; stencil_picker_scroll = 0; ChoicesSave(); return
    }
    page_digits: [24]u8
    number := FormatInteger(dino_page + 1, digits_a[:])
    BookText(l.padding + l.footer_width + l.gap, l.footer_y, l.footer_width, 44,
        Join(number, " / ", FormatInteger(pages, page_digits[:])), 18)
    unused CancelButton()
}

DinoPicker :: () {
    bounds := AppBounds()
    retro.x = bounds.x; retro.y = bounds.y; retro.scale = 1.0
    width := cast(s32)bounds.width
    height := cast(s32)bounds.height
    // At unusually short heights even fixed tabs and footer need scrolling.
    // Keep full-sized controls rather than shrinking their touch targets.
    if height < 300 {
        BookPaperSized(width, height)
        scrolled := Scroll(retro.session, ScrollProps.{.key = cast(u64)591,
            .bounds = RetroRect(0, 0, width, height), .scale = 1.0,
            .content_height = 500, .scroll_offset = stencil_picker_page_scroll, .keep_scrollbar = true})
        stencil_picker_page_scroll = scrolled.scroll_offset
        if scrolled.opened {
            retro.y -= cast(float32)stencil_picker_page_scroll
            StencilPickerContent(StencilPickerBounds(width, 500))
            retro.y = bounds.y
            unused End(retro.session)
        }
    } else {
        stencil_picker_page_scroll = 0
        StencilPickerContent(StencilPickerBounds(width, height))
    }
}

SizePicker :: () {
    DialogBack(Join(Tr("Size: "), PaintStencilShortLabel(dino)))
    number := FormatInteger(dino + 1, digits_a[:])
    for index: cast(s32)0..3 {
        x: s32 = 24 + index * 70
        y: s32 = 40
        press := RetroTap(110 + index, x, y, 64, 120, size_names[index])
        BookBox(x, y, 64, 120, ifx press.down || size == index + 1 then cast(u32)0xdcebdcff else cast(u32)0xf7f1e3ff, 0xdacdb5ff, 4.0)
        fit: float32 = 54.0 / cast(float32)DinoWidth(dino, DINO_SIZES)
        if 94.0 / cast(float32)DinoHeight(dino, DINO_SIZES) < fit { fit = 94.0 / cast(float32)DinoHeight(dino, DINO_SIZES) }
        dw := cast(s32)(cast(float32)DinoWidth(dino, DINO_SIZES) * fit * cast(float32)(index + 1) / 4.0)
        dh := cast(s32)(cast(float32)DinoHeight(dino, DINO_SIZES) * fit * cast(float32)(index + 1) / 4.0)
        RetroSprite(Join(ART, Join("dino", number, "-preview.png")),
            x + (64 - dw) / 2, y + 4 + (96 - dh) / 2, dw, dh, -1, true)
        BookText(x + 2, y + 103, 60, 17, size_names[index], 11)
        if press.clicked {
            size = index + 1
            placing = true
            canvas_can_fill = false
            ChoicesSave()
            placement_x = 0
            placement_y = 0
            dragging = false
            Sound("click")
            view = MAIN
            return
        }
    }
    if CancelButton() { view = PICK_DINO }
}

ColorPicker :: () {
    DialogBack("Choose a color")
    for index: cast(s32)0..CRAYON_COUNT - 1 {
        color := crayon_order[index]
        x := 20 + (index % 7) * 41
        y := 31 + (index / 7) * 23
        press := RetroTap(130 + index, x, y, 37, 18, "Color")
        chosen := color == 16 + crayon
        if chosen { BookBox(x - 2, y - 2, 41, 22, 0x2e6956ff, 0x2e6956ff, 5.0) }
        BookBox(x, y, 37, 18, paint_colors[color], ifx chosen then cast(u32)0xfffcf3ff else cast(u32)0x8a7a66ff, 4.0)
        if press.clicked {
            crayon = color - 16
            Sound("click")
            view = MAIN
            return
        }
    }
    pointer := SamplePointer()
    x := RetroPointX(pointer.x)
    y := RetroPointY(pointer.y)
    inside := x >= 18 && x < 305 && y >= 29 && y < 166
    // A title-bar click is handled once through Escape on the next frame.
    if pointer.released && !inside && y >= 0 { view = MAIN }
    unused CancelButton()
}

StoryView :: () {
    AppKeyboard(true)
    DialogBack("Write your story", true)
    for row: cast(s32)0..STORY_LINES - 1 {
        BookBox(6, 28 + row * 18, STORY_COLUMNS * 8 + 4, 17, 0xf3ecdcff, 0xdacdb5ff, 2.0)
        text := LatinText(TextUntilNul(story[row][:]))
        if text.count > 0 { RetroText(8, 29 + row * 18, text, BLACK, 1, false) }
        press := RetroTap(220 + row, 8, 28 + row * 18, STORY_COLUMNS * 8, 17, "Story line")
        if press.clicked {
            story_row = row
            story_column = (RetroPointX(press.x) - 8) / 8
            if story_column < 0 { story_column = 0 }
            if story_column >= STORY_COLUMNS { story_column = STORY_COLUMNS - 1 }
        }
    }
    RetroFill(8 + story_column * 8, 29 + story_row * 18, 8, 16, ifx cast(s64)(retro.now * 2.0) % 2 == 0 then BLACK else LIGHT_GRAY)
    key := retro.key
    input := AppFieldInput()
    position := story_row * STORY_COLUMNS + story_column
    if key == KEY_LEFT && position > 0 { position -= 1 }
    if key == KEY_RIGHT && position < STORY_LINES * STORY_COLUMNS - 1 { position += 1 }
    if key == KEY_UP && position >= STORY_COLUMNS { position -= STORY_COLUMNS }
    if key == KEY_DOWN && position < (STORY_LINES - 1) * STORY_COLUMNS { position += STORY_COLUMNS }
    if key == 268 { position = story_row * STORY_COLUMNS }
    if key == 269 { position = story_row * STORY_COLUMNS + STORY_COLUMNS - 1 }
    story_row = position / STORY_COLUMNS
    story_column = position % STORY_COLUMNS
    if key == KEY_BACKSPACE || key == 261 {
        if key == KEY_BACKSPACE && position > 0 { position -= 1 }
        for at: position..STORY_LINES * STORY_COLUMNS - 2 {
            story[at / STORY_COLUMNS][at % STORY_COLUMNS] = story[(at + 1) / STORY_COLUMNS][(at + 1) % STORY_COLUMNS]
        }
        story[STORY_LINES - 1][STORY_COLUMNS - 1] = 0
        story_row = position / STORY_COLUMNS
        story_column = position % STORY_COLUMNS
    }
    input_at: s32 = 0
    while input_at < cast(s32)input.text.count {
        decoded := Decode(input.text, input_at)
        input_at = decoded.after
        if !decoded.valid || decoded.value < cast(u32)32 || decoded.value > cast(u32)255 ||
            (decoded.value >= cast(u32)127 && decoded.value < cast(u32)160) { continue }
        byte := cast(u8)decoded.value
        for column: cast(s32)0..story_column - 1 {
            if story[story_row][column] == 0 { story[story_row][column] = #char " " }
        }
        story[story_row][story_column] = byte
        if position < STORY_LINES * STORY_COLUMNS - 1 { position += 1 }
        else { view = MAIN }
        story_row = position / STORY_COLUMNS
        story_column = position % STORY_COLUMNS
    }
    done := BookButton(145, 234, 173, 64, 14, "Done")
    if done || key == KEY_ENTER || key == KEY_ESCAPE || view == MAIN {
        AppKeyboard(false)
        view = MAIN
        WorkingPictureKeep()
    }
}

// A face icon on a round disk in the middle of area. Kryon keeps icons
// sharp up to 96 window pixels, so the disk is sized to the icon.
FaceIcon :: (shape: string, area: Rectangle, fill: u32, border: u32) {
    edge := ifx area.width < area.height then area.width * 0.75 else area.height * 0.75
    if edge > 96.0 { edge = 96.0 }
    disk := edge * 1.35
    unused Box(retro.session, BoxProps.{.bounds = Rectangle.{area.x + (area.width - disk) / 2.0, area.y + (area.height - disk) / 2.0, disk, disk},
        .fill = ColorFromPacked(fill), .border = ColorFromPacked(border), .radius = disk / 2.0})
    SvgIcon(retro.session, SvgIconProps.{.bounds = Rectangle.{area.x + (area.width - edge) / 2.0, area.y + (area.height - edge) / 2.0, edge, edge},
        .shape = shape, .color = ColorFromPacked(0x3e332aff)})
}

ConfirmView :: () {
    DialogBack("Erase this picture?")
    // Happy: a yellow face with a smile. Sad: a blue face with a frown.
    FaceIcon(HappyIcon.Shape, RetroRect(44, 50, 72, 74), 0xf1d681ff, 0xd6b763ff)
    BookText(40, 132, 80, 20, "Yes", 13)
    FaceIcon(SadIcon.Shape, RetroRect(204, 50, 72, 74), 0xbdd3ddff, 0x8cabbaff)
    BookText(200, 132, 80, 20, "No", 13)
    yes := RetroTap(150, 40, 50, 80, 120, "Yes").clicked
    if yes {
        if !GalleryStoreStartNew(*gallery_store) { Notice("Could not save gallery"); return }
        rotating = false
        HistoryPush()
        CanvasBlank()
        scene = -1
        ClearStory()
        dirty = true
        WorkingPictureKeep()
        Sound("clear")
        view = PICK_SCENE
        return
    }
    no := RetroTap(151, 200, 50, 80, 120, "No").clicked
    if no || (retro.key == KEY_ESCAPE) {
        view = MAIN
        Sound("click")
    }
}

// Each saved slot shows a small copy of its picture, made once and again
// after that slot is saved.
slot_previews: [SLOT_COUNT][32]u8;
slot_previews_ready: [SLOT_COUNT]bool;
slot_preview_created: bool;

SlotPreview :: (index: s32, saved: string) -> string {
    if !slot_previews_ready[index] && !slot_preview_created {
        slot_preview_created = true
        slot_previews_ready[index] = true
        slot_previews[index][0] = 0
        // Both current formats start with the flattened display runs.
        pixels := PICTURE_HEADER.count + 3 + cast(s64)PICTURE_STORY
        if PictureValid(saved) {
            nothing: []u8
            used := PictureRunsScan(saved[pixels:], nothing, CANVAS_PIXELS)
            made := GameCanvas(Join(PICTURE_RUNS, saved[pixels:pixels + used]))
            if made != "" { Keep(made, slot_previews[index][:]) }
        }
    }
    return TextUntilNul(slot_previews[index][:])
}

GalleryPreviewsClear :: () {
    for index: cast(s32)0..SLOT_COUNT - 1 { slot_previews_ready[index] = false; slot_previews[index][0] = 0 }
}

GalleryView :: () {
    DialogBack("Gallery")
    slot_preview_created = false
    if BookButton(540, 20, 29, 176, 18, "Save a copy") {
        if scene >= 0 && GalleryStoreSave(*gallery_store, PictureText(), true) {
            gallery_page = gallery_store.gallery.selected / 6
            GalleryPreviewsClear()
            Notice("Picture and story saved")
        } else { Notice("Could not save gallery") }
    }
    if BookButton(541, 210, 29, 86, 18, "Slots") { GalleryPreviewsClear(); saving = true; view = SAVE_LOAD; return }
    if !gallery_store.ready { BookCentered(92, "Could not read gallery", RED) }
    else if gallery_store.gallery.count == 0 { BookCentered(92, "Your pictures appear here", BLACK) }
    else {
        for offset: cast(s32)0..5 {
            index := gallery_page * 6 + offset
            if index >= gallery_store.gallery.count { continue }
            x := 20 + (offset % 3) * 94
            y := 51 + (offset / 3) * 60
            number := FormatInteger(index + 1, digits_a[:])
            label := Join(Tr("Picture"), " ", number)
            press := RetroTap(550 + offset, x, y, 90, 56, label)
            BookBox(x, y, 90, 56, 0xf7f1e3ff,
                ifx index == gallery_store.gallery.selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
            saved := ifx !slot_previews_ready[offset] && !slot_preview_created then GalleryStoreRead(*gallery_store, index) else ""
            preview := SlotPreview(offset, saved)
            if preview != "" { RetroSprite(preview, x + 21, y + 2, 48, 36, -1, true) }
            BookText(x + 2, y + 39, 86, 14, label, 10)
            if press.clicked {
                picture := GalleryStoreRead(*gallery_store, index)
                if PictureLoad(picture) {
                    if !GalleryStoreSelect(*gallery_store, index, picture) { GalleryStoreDetach(*gallery_store); Notice("Could not save gallery") }
                    placing = false; dragging = false; erasing = false; rotating = false
                    HistoryClear(); story_row = 0; story_column = 0; dirty = true
                    WorkingPictureKeep(); Sound("open"); view = MAIN
                } else { Notice("Empty or damaged save") }
                return
            }
        }
        pages := (gallery_store.gallery.count + 5) / 6
        if gallery_page > 0 && BookButton(196, 20, 173, 78, 14, "Previous") { gallery_page -= 1; GalleryPreviewsClear() }
        if gallery_page < pages - 1 && BookButton(197, 106, 173, 78, 14, "Next") { gallery_page += 1; GalleryPreviewsClear() }
        page_digits: [24]u8
        number := FormatInteger(gallery_page + 1, digits_a[:])
        BookText(220, 173, 76, 14, Join(number, " / ", FormatInteger(pages, page_digits[:])), 10)
    }
    if retro.now < status_until { BookLabel(20, 190, status, RED) }
    unused CancelButton()
}

SaveLoadView :: () {
    // Validate and render at most one saved preview per VM frame.
    slot_preview_created = false
    DialogBack(ifx saving then "Save picture and story" else "Load picture and story")
    if BookButton(200, 20, 28, 128, 20, "Save", saving) { saving = true }
    if BookButton(201, 168, 28, 128, 20, "Load", !saving) { saving = false }
    for index: cast(s32)0..SLOT_COUNT - 1 {
        x := 20 + (index % 3) * 96
        y := 56 + (index / 3) * 54
        saved := DocumentRead(SlotFile(index))
        label := ifx saved.count > 0 then "Saved" else "Empty"
        press := RetroTap(160 + index, x, y, 88, 52, label)
        BookBox(x, y, 88, 52, 0xf7f1e3ff, ifx index == slot then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
        preview := ifx saved.count > 0 then SlotPreview(index, saved) else ""
        if preview != "" {
            BookBox(x + 15, y + 4, 58, 44, 0xffffffff, 0xdacdb5ff, 2.0)
            RetroSprite(preview, x + 16, y + 5, 56, 42, -1, true)
        } else {
            BookLabel(x + (88 - RetroTextWidth(label)) / 2, y + 18, label, BLACK)
            BookLabel(x + 18, y + 36, "Slot", DARK_GRAY)
        }
        if press.clicked {
            if saving {
                if saved.count > 0 { pending_slot = index; view = OVERWRITE }
                else if StoreSlot(index) { view = MAIN }
            } else {
                if LoadSlot(index) { view = MAIN; Sound("open") }
            }
            return
        }
    }
    if retro.now < status_until { BookLabel(12, 164, status, RED) }
    unused CancelButton()
}

OverwriteView :: () {
    DialogBack("Replace this saved picture?")
    BookCentered(56, "Its picture and story", BLACK)
    BookCentered(80, "will be replaced.", BLACK)
    if BookButton(202, 24, 120, 128, 28, "Replace") {
        if pending_slot >= 0 && StoreSlot(pending_slot) { view = MAIN }
    }
    if BookButton(203, 168, 120, 128, 28, "Cancel") || retro.key == KEY_ESCAPE {
        view = SAVE_LOAD
    }
}

PrintView :: () {
    DialogBack("Picture and story")
    BookCentered(38, "Save a PNG, story and", BLACK)
    BookCentered(58, "printable color picture", BLACK)
    if BookButton(204, 28, 90, 264, 28, "Export files") {
        reply := AppService("jungle.export", Join(CanvasText(), StoryText()))
        Notice(ifx reply == "exported" then "Files saved in game exports" else "Could not export")
    }
    if BookButton(205, 28, 126, 264, 28, "Print") {
        reply := AppService("jungle.print", Join(CanvasText(), StoryText()))
        Notice(ifx reply == "printed" then "Sent to printer" else
            ifx reply == "exported" then "No printer; files saved" else "Could not print")
    }
    if retro.now < status_until { BookCentered(160, status, BLACK) }
    unused CancelButton()
}

GameMain :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        initialized = false
        working_history_start = false
        working_save_pending = false
        working_bookkeeping = false
        working_canvas_state = WORKING_CANVAS_IDLE
        history_loading = false
        erasing = false
        rotating = false
        view = MAIN
        placing = false
        dragging = false
        HistoryClear()
        scene = -1
        crayon = 14
        dino = -1
        canvas_name[0] = 0
        canvas_shown_name[0] = 0
        dirty = true
        ClearStory()
        AppIdentity("jungle.paint")
        AppDescribe("Coloring Book", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx WorkingPictureSave() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    GameLanguage()
    working_bookkeeping = false
    history_begin := false
    if (working_history_start || history_loading) && AppKey() == KEY_ESCAPE { GameHome() }
    if working_save_pending && initialized && !working_history_start && !history_loading {
        working_save_pending = false
        working_bookkeeping = true
        unused WorkingPictureSave()
    }
    if initialized && working_history_start {
        working_bookkeeping = true
        if working_canvas_state == WORKING_CANVAS_WAIT {
            working_canvas_state = WORKING_CANVAS_MAKE
        } else if working_canvas_state == WORKING_CANVAS_MAKE {
            working_canvas_state = WORKING_CANVAS_IDLE
            working_history_start = false
            HistoryLoadBegin(DocumentRead(WORKING_HISTORY), working_loaded)
            working_loaded = ""
            history_begin = true
        }
    }
    if history_loading && !history_begin { HistoryLoadStep(); working_bookkeeping = true }
    else if history_loading { working_bookkeeping = true }
    if !initialized {
        CanvasBlank()
        WorkingPictureLoad()
        ChoicesLoad()
        GalleryStoreInit(*gallery_store, GalleryReadDocument, DocumentWrite)
        if !GalleryStoreLoad(*gallery_store, working_loaded) { Notice("Could not read gallery") }
        working_bookkeeping = true
        if working_history_start { working_canvas_state = WORKING_CANVAS_WAIT }
        if scene < 0 { view = PICK_SCENE }
        initialized = true
    }
    RetroBegin(AppSession(), AppBounds(), FONT, AppNow(), AppKey(), BLACK)
    BookPalette()
    if view == MAIN { MainView() }
    else if view == PICK_SCENE { ScenePicker() }
    else if view == PICK_DINO { DinoPicker() }
    else if view == PICK_SIZE { SizePicker() }
    else if view == PICK_COLOR { ColorPicker() }
    else if view == STORY { StoryView() }
    else if view == CONFIRM_ERASE { ConfirmView() }
    else if view == GALLERY { GalleryView() }
    else if view == SAVE_LOAD { SaveLoadView() }
    else if view == OVERWRITE { OverwriteView() }
    else if view == PRINT_VIEW { PrintView() }
    working_bookkeeping = false
    return 0
}

#if !#defined(PLATFORM_WEB) {
    #program_export
    main :: () -> s32 { return GameMain() }
}

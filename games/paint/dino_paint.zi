// Dino Colors: a 1:1 play-alike of Bert's Dinosaurs. Pick one of six
// scenes, place any of twelve dinosaurs in four sizes (right-click mirrors),
// fill regions with thirty crayon colors, write an eight-line story, and
// keep the whole picture in one of six slots.
#import "app_context"
#import "app_protocol"
#import "geometry"
#import "number_text"
#import "text_buffer"
#import, file "../../retro/retro.zi";
#import, file "../../retro/game.zi";
#import, file "paint_canvas.zi";
#import, file "paint_pages.zi";
#import, file "paint_document.zi";
#import "pointer_input"

FONT :: "assets/dino-paint/font.png"
SOUNDS :: "assets/dino-paint/sounds/"
ART :: "assets/dino-paint/art/"

MAIN :: 0
PICK_SCENE :: 1
PICK_DINO :: 2
PICK_SIZE :: 3
PICK_COLOR :: 4
STORY :: 5
CONFIRM_ERASE :: 6
CONFIRM_STOP :: 7
SAVE_LOAD :: 8
OVERWRITE :: 9
PRINT_VIEW :: 10

CANVAS_X :: 68
CANVAS_Y :: 10
PANEL_WIDTH :: 64
SLOT_COUNT :: 6
UNDO_STEPS :: 8

scene_names: [6]string = .["PICTURE 1", "PICTURE 2", "PICTURE 3", "PICTURE 4", "PICTURE 5", "PICTURE 6"];
dino_names: [12]string = .["TYRANNOSAURUS", "STEGOSAURUS", "TRICERATOPS", "ANATOSAURUS", "BRACHIOSAURUS", "DIPLODOCUS", "PARASAUROLOPHUS", "DEINONYCHUS", "PROTOCERATOPS", "PTERANODON", "STRACOSAURUS", "CORYTHOSAURUS"];
dino_short: [12]string = .["T-REX", "STEGO", "TRIKE", "DUCKBILL", "BRACHIO", "DIPLO", "PARA", "RAPTOR", "PROTO", "PTERANODON", "STRACO", "CORY"];
button_names: [8]string = .["IMAGE", "COLOR", "STORY", "ERASE", "SAVE", "PRINT", "UNDO", "STOP"];
size_names: [4]string = .["SMALL", "MEDIUM", "LARGE", "HUGE"];

view: s32 = MAIN;
dino: s32 = -1;
size: s32 = 2;
flip: bool;
placing: bool;
dino_page: s32;
story_row: s32;
story_column: s32;
canvas_name: [32]u8;
digits_a: [24]u8;
dirty: bool = true;
undo_canvas: [UNDO_STEPS][CANVAS_PIXELS]u8;
undo_lines: [UNDO_STEPS][CANVAS_PIXELS]bool;
undo_stories: [UNDO_STEPS][STORY_LINES][STORY_COLUMNS + 1]u8;
undo_scenes: [UNDO_STEPS]s32;
undo_count: s32;
undo_next: s32;
slot: s32 = -1;
pending_slot: s32 = -1;
saving: bool = true;
status: string;
status_until: float64;
initialized: bool;
voice_mode: s32;

Join :: (a: string, b: string = "", c: string = "") -> string {
    text: Vec(u8)
    parts: [3]string = .[a, b, c]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Sound :: (name: string) { if voice_mode == 0 { GameSound(Join(SOUNDS, name, ".wav")) } }

Voice :: (which: s32) {
    if voice_mode == 1 { return }
    digits: [24]u8
    GameSound(Join(SOUNDS, "voice-", Join(FormatInteger(cast(s64)which + 1, digits[:]), ".wav")))
}

SlotFile :: (index: s32) -> string {
    digits: [24]u8
    return Join("slot-", FormatInteger(cast(s64)index, digits[:]), ".txt")
}

Keep :: (name: string, bytes: []u8) {
    count := ifx name.count < bytes.count then name.count else bytes.count - 1
    for at: cast(s64)0..count - 1 { bytes[at] = name[at] }
    bytes[count] = 0
}

SaveSlot :: () -> bool {
    if !initialized { return true }
    return DocumentWrite("working.txt", PictureText())
}

Notice :: (text: string) { status = text; status_until = retro.now + 3.0 }

StoreSlot :: (index: s32) -> bool {
    if scene < 0 { Notice("CHOOSE A SCENE FIRST"); return false }
    if !DocumentWrite(SlotFile(index), PictureText()) { Notice("COULD NOT SAVE"); return false }
    slot = index
    Notice("PICTURE AND STORY SAVED")
    unused SaveSlot()
    return true
}

LoadSlot :: (index: s32) -> bool {
    if !PictureLoad(DocumentRead(SlotFile(index))) { Notice("EMPTY OR DAMAGED SAVE"); return false }
    slot = index
    placing = false
    undo_count = 0
    undo_next = 0
    story_row = 0
    story_column = 0
    dirty = true
    unused SaveSlot()
    Notice("PICTURE AND STORY LOADED")
    return true
}

PushUndo :: () {
    undo_scenes[undo_next] = scene
    for row: cast(s32)0..STORY_LINES - 1 {
        for column: cast(s32)0..STORY_COLUMNS { undo_stories[undo_next][row][column] = story[row][column] }
    }
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        undo_canvas[undo_next][at] = canvas[at]
        undo_lines[undo_next][at] = lines[at]
    }
    undo_next = (undo_next + 1) % UNDO_STEPS
    if undo_count < UNDO_STEPS { undo_count += 1 }
}

Undo :: () {
    if undo_count == 0 { return }
    undo_next = (undo_next + UNDO_STEPS - 1) % UNDO_STEPS
    undo_count -= 1
    scene = undo_scenes[undo_next]
    for row: cast(s32)0..STORY_LINES - 1 {
        for column: cast(s32)0..STORY_COLUMNS { story[row][column] = undo_stories[undo_next][row][column] }
    }
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        canvas[at] = undo_canvas[undo_next][at]
        lines[at] = undo_lines[undo_next][at]
    }
    dirty = true
    unused SaveSlot()
    Sound("undo")
}

OpenScene :: (index: s32, saved: string) {
    scene = index
    unused SceneOpen(index, saved)
    placing = false
    undo_count = 0
    dirty = true
    view = PICK_DINO
    ClearStory()
    story_row = 0
    story_column = 0
    slot = -1
    unused SaveSlot()
    Sound("open")
}

MakeCanvas :: () {
    if !dirty { return }
    made := GameCanvas(CanvasText())
    if made != "" {
        Keep(made, canvas_name[:])
        dirty = false
    }
}

// The green command rail with Bert's eight buttons, then the picture.
MainView :: () {
    RetroFill(0, 0, PANEL_WIDTH, SCREEN_HEIGHT, GREEN)
    for index: cast(s32)0..7 {
        if RetroButton(20 + index, 2, 4 + index * 24, 60, 22, button_names[index]) {
            Sound("click")
            if index == 0 { view = ifx scene < 0 then PICK_SCENE else PICK_DINO }
            if index == 1 { view = PICK_COLOR }
            if index == 2 { view = STORY }
            if index == 3 { view = CONFIRM_ERASE }
            if index == 4 { view = SAVE_LOAD; saving = true }
            if index == 5 { view = PRINT_VIEW }
            if index == 6 { Undo() }
            if index == 7 { view = CONFIRM_STOP }
            return
        }
    }
    if scene >= 0 { MakeCanvas() }
    RetroFill(CANVAS_X - 2, CANVAS_Y - 2, CANVAS_WIDTH + 4, CANVAS_HEIGHT + 4, BLACK)
    name := TextUntilNul(canvas_name[:])
    if scene >= 0 && name != "" {
        RetroSprite(name, CANVAS_X, CANVAS_Y, CANVAS_WIDTH, CANVAS_HEIGHT)
    } else {
        RetroFill(CANVAS_X, CANVAS_Y, CANVAS_WIDTH, CANVAS_HEIGHT, WHITE)
    }
    press := RetroTap(40, CANVAS_X, CANVAS_Y, CANVAS_WIDTH, CANVAS_HEIGHT, "Picture", true)
    x := RetroPointX(press.x) - CANVAS_X
    y := RetroPointY(press.y) - CANVAS_Y
    if placing {
        // The outline of the dinosaur follows the pointer until it is set.
        w := DINO_WIDTH[dino] * DinoScale(dino, size) / 100
        h := DINO_HEIGHT[dino] * DinoScale(dino, size) / 100
        pointer := SamplePointer()
        x = RetroPointX(pointer.x) - CANVAS_X
        y = RetroPointY(pointer.y) - CANVAS_Y
        RetroFrame(CANVAS_X + x, CANVAS_Y + y, w, h, LIGHT_GREEN)
        if press.released && x >= 0 && y >= 0 && x + w <= CANVAS_WIDTH && y + h <= CANVAS_HEIGHT {
            PushUndo()
            CanvasStampDino(dino, size, x, y, flip)
            placing = false
            dirty = true
            unused SaveSlot()
            Sound("fill")
        }
        if press.right_clicked { flip = !flip }
    } else if press.clicked {
        fill := 16 + crayon
        if scene >= 0 && CanvasColorAt(x, y) >= 0 && CanvasColorAt(x, y) != fill {
            PushUndo()
            if CanvasFill(x, y, fill) > 0 {
                dirty = true
                unused SaveSlot()
                Sound("fill")
            }
        }
    }
    if retro.key == KEY_ESCAPE { view = CONFIRM_STOP }
    if retro.now < status_until {
        RetroFill(0, 182, SCREEN_WIDTH, 18, BLACK)
        RetroCentered(183, status, WHITE)
    }
}

DialogBack :: (title: string) {
    RetroFill(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, BLACK)
    RetroFill(4, 4, SCREEN_WIDTH - 8, SCREEN_HEIGHT - 8, WHITE)
    RetroFrame(4, 4, SCREEN_WIDTH - 8, SCREEN_HEIGHT - 8, BLACK)
    RetroText(12, 8, title, BLACK)
}

CancelButton :: () -> bool {
    pressed := RetroButton(19, 244, 180, 68, 16, "STOP")
    if pressed || (retro.key == KEY_ESCAPE) {
        Sound("click")
        view = MAIN
        return true
    }
    return false
}

ScenePicker :: () {
    DialogBack("SELECT A PICTURE")
    for index: cast(s32)0..SCENE_COUNT - 1 {
        x := 12 + (index % 3) * 104
        y := 30 + (index / 3) * 74
        press := RetroTap(60 + index, x, y, 96, 70, scene_names[index])
        if press.down { RetroFrame(x, y, 96, 70, LIGHT_GREEN) }
        RetroFill(x + 2, y + 2, 92, 62, WHITE)
        number := FormatInteger(index + 1, digits_a[:])
        RetroSprite(Join(ART, Join("scene", Join(number, "-thumb.png"))), x + 7, y + 3, 78, 48)
        RetroText(x + (96 - RetroTextWidth(scene_names[index])) / 2, y + 55, scene_names[index], BLACK)
        if press.clicked {
            OpenScene(index, "")
            return
        }
    }
    unused CancelButton()
}

DinoPicker :: () {
    DialogBack("SELECT A DINOSAUR")
    first := dino_page * 6
    for offset: cast(s32)0..5 {
        index := first + offset
        if index >= DINO_COUNT { continue }
        x := 12 + (offset % 3) * 104
        y := 30 + (offset / 3) * 74
        press := RetroTap(80 + index, x, y, 96, 70, dino_names[index])
        if press.down { RetroFrame(x, y, 96, 70, LIGHT_GREEN) }
        RetroFill(x + 2, y + 2, 92, 62, WHITE)
        number := FormatInteger(index + 1, digits_a[:])
        fit: float32 = 68.0 / cast(float32)DINO_WIDTH[index]
        if 46.0 / cast(float32)DINO_HEIGHT[index] < fit { fit = 46.0 / cast(float32)DINO_HEIGHT[index] }
        dw := cast(s32)(cast(float32)DINO_WIDTH[index] * fit)
        dh := cast(s32)(cast(float32)DINO_HEIGHT[index] * fit)
        RetroSprite(Join(ART, Join("dino", Join(number, "-thumb.png"))),
            x + (96 - dw) / 2, y + 3 + (48 - dh) / 2, dw, dh, BLACK)
        name := dino_short[index]
        RetroText(x + (96 - RetroTextWidth(name)) / 2, y + 56, name, BLACK)
        if press.clicked {
            dino = index
            Sound("click")
            Voice(index)
            view = PICK_SIZE
            return
        }
    }
    up := RetroButton(96, 12, 176, 60, 20, "UP")
    down := RetroButton(97, 84, 176, 60, 20, "DOWN")
    voice_label := ifx voice_mode == 0 then "VOICE ON" else ifx voice_mode == 1 then "SILENT" else "VOICE"
    if RetroButton(98, 156, 176, 80, 20, voice_label) {
        voice_mode = (voice_mode + 1) % 3
        digits: [24]u8
        unused DocumentWrite("voice.txt", FormatInteger(cast(s64)voice_mode, digits[:]))
    }
    if up && (dino_page > 0) { dino_page -= 1 }
    if down && (dino_page < 1) { dino_page += 1 }
    unused CancelButton()
}

SizePicker :: () {
    DialogBack(Join("SIZE OF ", dino_short[dino]))
    number := FormatInteger(dino + 1, digits_a[:])
    for index: cast(s32)0..3 {
        x: s32 = 12 + index * 78
        y: s32 = 40
        press := RetroTap(110 + index, x, y, 72, 120, size_names[index])
        if press.down { RetroFrame(x, y, 72, 120, LIGHT_GREEN) }
        RetroFill(x + 2, y + 2, 68, 100, WHITE)
        fit: float32 = 60.0 / cast(float32)DINO_WIDTH[dino]
        if 94.0 / cast(float32)DINO_HEIGHT[dino] < fit { fit = 94.0 / cast(float32)DINO_HEIGHT[dino] }
        dw := cast(s32)(cast(float32)DINO_WIDTH[dino] * fit * cast(float32)(index + 1) / 4.0)
        dh := cast(s32)(cast(float32)DINO_HEIGHT[dino] * fit * cast(float32)(index + 1) / 4.0)
        suffix_digits: [24]u8
        suffix := FormatInteger(index + 1, suffix_digits[:])
        RetroSprite(Join(ART, Join("dino", Join(number, Join("-preview", Join(suffix, ".png"))))),
            x + (72 - dw) / 2, y + 4 + (96 - dh) / 2, dw, dh, BLACK)
        RetroText(x + (72 - RetroTextWidth(size_names[index])) / 2, y + 104, size_names[index], BLACK)
        if press.clicked {
            size = index + 1
            flip = false
            placing = true
            Sound("click")
            view = MAIN
            return
        }
    }
    if CancelButton() { view = PICK_DINO }
}

ColorPicker :: () {
    DialogBack("PICK A COLOR")
    for index: cast(s32)0..29 {
        x := 20 + (index % 6) * 48
        y := 30 + (index / 6) * 24
        press := RetroTap(130 + index, x, y, 44, 20, "Color")
        suffix := FormatInteger(index + 1, digits_a[:])
        RetroSprite(Join("assets/dino-paint/crayons/", suffix, ".png"), x, y, 44, 20)
        RetroFrame(x, y, 44, 20, ifx index == crayon then BLACK else DARK_GRAY)
        if press.clicked {
            crayon = index
            Sound("click")
            view = MAIN
            return
        }
    }
    RetroText(20, 176, "CLICK OUTSIDE TO CANCEL", BLACK)
    outside := RetroTap(190, 0, 0, SCREEN_WIDTH, 24, "Outside")
    if outside.clicked { view = MAIN }
    unused CancelButton()
}

StoryView :: () {
    DialogBack("WRITE YOUR STORY")
    for row: cast(s32)0..STORY_LINES - 1 {
        RetroFill(6, 28 + row * 18, STORY_COLUMNS * 8 + 4, 17, LIGHT_GRAY)
        text := TextUntilNul(story[row][:])
        if text.count > 0 { RetroText(8, 29 + row * 18, text, BLACK) }
        press := RetroTap(220 + row, 8, 28 + row * 18, STORY_COLUMNS * 8, 17, "Story line")
        if press.clicked {
            story_row = row
            story_column = (RetroPointX(press.x) - 8) / 8
            if story_column < 0 { story_column = 0 }
            if story_column >= STORY_COLUMNS { story_column = STORY_COLUMNS - 1 }
        }
    }
    RetroFill(8 + story_column * 8, 29 + story_row * 18, 8, 16, ifx cast(s64)(retro.now * 2.0) % 2 == 0 then BLACK else LIGHT_GRAY)
    key := retro.key
    input := AppFieldInput()
    position := story_row * STORY_COLUMNS + story_column
    if key == KEY_LEFT && position > 0 { position -= 1 }
    if key == KEY_RIGHT && position < STORY_LINES * STORY_COLUMNS - 1 { position += 1 }
    if key == KEY_UP && position >= STORY_COLUMNS { position -= STORY_COLUMNS }
    if key == KEY_DOWN && position < (STORY_LINES - 1) * STORY_COLUMNS { position += STORY_COLUMNS }
    if key == 268 { position = story_row * STORY_COLUMNS }
    if key == 269 { position = story_row * STORY_COLUMNS + STORY_COLUMNS - 1 }
    story_row = position / STORY_COLUMNS
    story_column = position % STORY_COLUMNS
    if key == KEY_BACKSPACE || key == 261 {
        if key == KEY_BACKSPACE && position > 0 { position -= 1 }
        for at: position..STORY_LINES * STORY_COLUMNS - 2 {
            story[at / STORY_COLUMNS][at % STORY_COLUMNS] = story[(at + 1) / STORY_COLUMNS][(at + 1) % STORY_COLUMNS]
        }
        story[STORY_LINES - 1][STORY_COLUMNS - 1] = 0
        story_row = position / STORY_COLUMNS
        story_column = position % STORY_COLUMNS
    }
    for byte: input.text {
        if byte < 32 || byte > 126 { continue }
        for column: cast(s32)0..story_column - 1 {
            if story[story_row][column] == 0 { story[story_row][column] = #char " " }
        }
        story[story_row][story_column] = byte
        if position < STORY_LINES * STORY_COLUMNS - 1 { position += 1 }
        else { view = MAIN }
        story_row = position / STORY_COLUMNS
        story_column = position % STORY_COLUMNS
    }
    done := RetroButton(145, 244, 180, 68, 16, "DONE")
    if done || key == KEY_ENTER || key == KEY_ESCAPE || view == MAIN {
        view = MAIN
        unused SaveSlot()
    }
}

ConfirmView :: (erasing: bool) {
    DialogBack(ifx erasing then "ERASE - YES OR NO" else "STOP - YES OR NO")
    // Happy: yellow with a wide smile. Sad: blue with a frown.
    RetroFill(44, 54, 72, 66, YELLOW)
    RetroFill(52, 50, 56, 8, YELLOW)
    RetroFill(52, 116, 56, 8, YELLOW)
    RetroFrame(44, 54, 72, 66, BLACK)
    RetroFill(62, 76, 8, 10, BLACK)
    RetroFill(90, 76, 8, 10, BLACK)
    RetroFill(56, 94, 6, 6, BLACK)
    RetroFill(98, 94, 6, 6, BLACK)
    RetroFill(62, 98, 36, 6, BLACK)
    RetroText(44, 138, "HAPPY = YES", BLACK)
    RetroFill(204, 54, 72, 66, LIGHT_BLUE)
    RetroFill(212, 50, 56, 8, LIGHT_BLUE)
    RetroFill(212, 116, 56, 8, LIGHT_BLUE)
    RetroFrame(204, 54, 72, 66, BLACK)
    RetroFill(222, 76, 8, 10, BLACK)
    RetroFill(250, 76, 8, 10, BLACK)
    RetroFill(226, 100, 28, 6, BLACK)
    RetroFill(216, 94, 6, 6, BLACK)
    RetroFill(258, 94, 6, 6, BLACK)
    RetroText(196, 138, "SAD = NO", BLACK)
    yes := RetroTap(150, 40, 50, 80, 120, "Yes").clicked
    if yes {
        if erasing {
            PushUndo()
            for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)PAPER; lines[at] = false }
            scene = -1
            ClearStory()
            dirty = true
            unused SaveSlot()
            Sound("clear")
            view = MAIN
        } else { GameHome() }
        return
    }
    no := RetroTap(151, 200, 50, 80, 120, "No").clicked
    if no || (retro.key == KEY_ESCAPE) {
        view = MAIN
        Sound("click")
    }
}

SaveLoadView :: () {
    DialogBack(ifx saving then "SAVE PICTURE + STORY" else "LOAD PICTURE + STORY")
    if RetroButton(200, 20, 28, 128, 20, "SAVE", saving) { saving = true }
    if RetroButton(201, 168, 28, 128, 20, "LOAD", !saving) { saving = false }
    for index: cast(s32)0..SLOT_COUNT - 1 {
        x := 20 + (index % 3) * 96
        y := 56 + (index / 3) * 54
        saved := DocumentRead(SlotFile(index))
        label := ifx saved.count > 0 then "FULL" else "EMPTY"
        press := RetroTap(160 + index, x, y, 88, 52, label)
        RetroFrame(x, y, 88, 52, ifx index == slot then BLACK else DARK_GRAY)
        RetroText(x + (88 - RetroTextWidth(label)) / 2, y + 18, label, BLACK)
        RetroText(x + 18, y + 36, "SLOT", DARK_GRAY)
        if press.clicked {
            if saving {
                if saved.count > 0 { pending_slot = index; view = OVERWRITE }
                else if StoreSlot(index) { view = MAIN }
            } else {
                if LoadSlot(index) { view = MAIN; Sound("open") }
            }
            return
        }
    }
    if retro.now < status_until { RetroText(12, 164, status, RED) }
    unused CancelButton()
}

OverwriteView :: () {
    DialogBack("REPLACE THIS SAVED PICTURE?")
    RetroCentered(56, "ITS PICTURE AND STORY", BLACK)
    RetroCentered(80, "WILL BE REPLACED.", BLACK)
    if RetroButton(202, 24, 120, 128, 28, "REPLACE") {
        if pending_slot >= 0 && StoreSlot(pending_slot) { view = MAIN }
    }
    if RetroButton(203, 168, 120, 128, 28, "CANCEL") || retro.key == KEY_ESCAPE {
        view = SAVE_LOAD
    }
}

PrintView :: () {
    DialogBack("PICTURE AND STORY")
    RetroCentered(38, "SAVE A PNG, STORY AND", BLACK)
    RetroCentered(58, "PRINTABLE COLOR PICTURE", BLACK)
    if RetroButton(204, 28, 90, 264, 28, "EXPORT FILES") {
        reply := AppService("jungle.export", Join(CanvasText(), StoryText()))
        Notice(ifx reply == "exported" then "FILES SAVED IN GAME EXPORTS" else "COULD NOT EXPORT")
    }
    if RetroButton(205, 28, 126, 264, 28, "PRINT") {
        reply := AppService("jungle.print", Join(CanvasText(), StoryText()))
        Notice(ifx reply == "printed" then "SENT TO PRINTER" else
            ifx reply == "exported" then "NO PRINTER; FILES SAVED" else "COULD NOT PRINT")
    }
    if retro.now < status_until { RetroCentered(160, status, BLACK) }
    unused CancelButton()
}

#program_export
main :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        AppIdentity("jungle.paint")
        AppDescribe("Dino Colors", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return ifx SaveSlot() then 0 else 1 }
    if mode != APP_FRAME { return 0 }
    if !initialized {
        for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)PAPER; lines[at] = false }
        unused PictureLoad(DocumentRead("working.txt"))
        setting := DocumentRead("voice.txt")
        if setting == "1" { voice_mode = 1 }
        if setting == "2" { voice_mode = 2 }
        initialized = true
    }
    RetroBegin(AppSession(), AppBounds(), FONT, AppNow(), AppKey(), BLACK)
    if view == MAIN { MainView() }
    else if view == PICK_SCENE { ScenePicker() }
    else if view == PICK_DINO { DinoPicker() }
    else if view == PICK_SIZE { SizePicker() }
    else if view == PICK_COLOR { ColorPicker() }
    else if view == STORY { StoryView() }
    else if view == CONFIRM_ERASE { ConfirmView(true) }
    else if view == CONFIRM_STOP { ConfirmView(false) }
    else if view == SAVE_LOAD { SaveLoadView() }
    else if view == OVERWRITE { OverwriteView() }
    else if view == PRINT_VIEW { PrintView() }
    return 0
}

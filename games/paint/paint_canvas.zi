// The picture: a wide or tall page of crayon colors over black lines.
// Lines are stamped from a scene and any dinosaurs placed on it; the paint
// bucket fills up to those lines. A pixel is a line exactly when it is INK:
// crayons start at 16, so no fill ever paints INK.
#import, file "paint_pages.zi";
#import "std/vec"
#import, file "paint_palette.zi";
#import, file "paint_picture.zi";
#import "geometry"
#import "std/math"

INK :: 0
PAPER :: 15
BLANK_SCENE :: SCENE_COUNT + 0
// Saved pictures reserve code 26 for the original blank page forever. New
// scene codes skip it, while in-memory scene indices remain contiguous.
SAVED_BLANK_SCENE :: 26

PaintSceneCode :: (index: s32) -> s32 {
    if index == BLANK_SCENE { return SAVED_BLANK_SCENE }
    return ifx index >= SAVED_BLANK_SCENE then index + 1 else index
}

PaintSceneFromCode :: (code: s32) -> s32 {
    if code == SAVED_BLANK_SCENE { return BLANK_SCENE }
    return ifx code > SAVED_BLANK_SCENE then code - 1 else code
}

// The working picture's page; a scene has a composed version for each.
canvas_page: PaintPage = .{width = 960, height = 720};
canvas: [CANVAS_PIXELS]u8;
stamp: [CANVAS_PIXELS]bool;
stamp_body: [CANVAS_PIXELS]bool;
fill_stack: [CANVAS_PIXELS]s32;

// Objects keep their own paint; 255 is transparent, never a crayon. The
// composite and owner map are cached, and change only on edits. Two full
// canvases of object pixels allow dozens of small objects without unbounded
// mobile memory or documents (even worst-case runs fit below 16 MiB).
LAYER_LIMIT :: 32
LAYER_PIXELS :: CANVAS_PIXELS * 2
TRANSPARENT :: 255
// How a stencil's vector art lies on the page: x' = a x + c y + e, y' = b x + d y + f,
// in the page space of its Huge mask (see tools/paint_vectors.py).
PaintMatrix :: struct { a: float32; b: float32; c: float32; d: float32; e: float32; f: float32; }
// art is the stencil's number from 1. Objects saved before vector outlines have
// 0, and keep their page pixels as their lines.
PaintLayer :: struct { x: s32; y: s32; w: s32; h: s32; start: s32; pixels: []u8; art: s32; matrix: PaintMatrix; }
PENCIL_SCALE :: 8
PENCIL_WIDTH :: 4
PENCIL_WIDTH_UNITS :: PENCIL_WIDTH * PENCIL_SCALE
PENCIL_STROKE_LIMIT :: 128
PENCIL_POINT_LIMIT :: 8192
PencilPoint :: struct { x: s32; y: s32; }
PencilStroke :: struct { first: s32; count: s32; width: s32; }
layers: [LAYER_LIMIT]PaintLayer;
layer_order: [LAYER_LIMIT]s32;
layer_count: s32;
layer_pixels: s32;
layer_storage: [2][CANVAS_PIXELS]u8;
base: [CANVAS_PIXELS]u8;
owner: [CANVAS_PIXELS]u8;
rotate_pixels: [CANVAS_PIXELS]u8;
pencil_points: [PENCIL_POINT_LIMIT]PencilPoint;
pencil_strokes: [PENCIL_STROKE_LIMIT]PencilStroke;
pencil_point_count: s32;
pencil_stroke_count: s32;

CanvasLayersClear :: () {
    for at: cast(s32)0..LAYER_LIMIT - 1 { layers[at] = PaintLayer.{} }
    layer_count = 0
    layer_pixels = 0
}

CanvasBlank :: () {
    CanvasLayersClear()
    CanvasPencilClear()
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)PAPER }
}

// Overlay only the intersecting rectangle, retaining real transparency.
CanvasOverlay :: (id: s32, left: s32, top: s32, right: s32, bottom: s32) {
    object := *layers[id]
    x0 := ifx left > object.x then left else object.x
    y0 := ifx top > object.y then top else object.y
    x1 := ifx right < object.x + object.w then right else object.x + object.w
    y1 := ifx bottom < object.y + object.h then bottom else object.y + object.h
    for y: y0..y1 - 1 {
        for x: x0..x1 - 1 {
            pixel := object.pixels[(y - object.y) * object.w + x - object.x]
            if pixel == cast(u8)TRANSPARENT { continue }
            at := y * canvas_page.width + x
            canvas[at] = pixel
            owner[at] = cast(u8)(id + 1)
        }
    }
}

CanvasObjectAt :: (x: s32, y: s32) -> s32 {
    if layer_count == 0 || x < 0 || y < 0 || x >= canvas_page.width || y >= canvas_page.height { return -1 }
    return cast(s32)owner[y * canvas_page.width + x] - 1
}

// Preparing a rotation never changes the document. The editor can push one
// Undo record only after it knows a release will actually change pixels.
PaintRotation :: struct { id: s32; x: s32; y: s32; w: s32; h: s32; start: s32; scale: float32; degrees: float32; valid: bool; changed: bool; matrix: PaintMatrix; }
PaintExtent :: struct { x: s32; y: s32; w: s32; h: s32; }

CanvasObjectBounds :: (id: s32) -> PaintExtent {
    result: PaintExtent
    if id < 0 || id >= LAYER_LIMIT || layers[id].pixels.count == 0 { return result }
    object := *layers[id]
    left := object.w; top := object.h; right: s32 = 0; bottom: s32 = 0
    for y: cast(s32)0..object.h - 1 {
        for x: cast(s32)0..object.w - 1 {
            if object.pixels[y * object.w + x] == cast(u8)TRANSPARENT { continue }
            if x < left { left = x }; if y < top { top = y }
            if x + 1 > right { right = x + 1 }; if y + 1 > bottom { bottom = y + 1 }
        }
    }
    if right <= left || bottom <= top { return result }
    return PaintExtent.{object.x + left, object.y + top, right - left, bottom - top}
}

CanvasRotation :: (id: s32, degrees: float32, extent: PaintExtent) -> PaintRotation {
    result: PaintRotation
    if id < 0 || id >= LAYER_LIMIT || layers[id].pixels.count == 0 || !Finite32(degrees) { return result }
    degrees -= cast(float32)FloorInteger((degrees + 180.0) / 360.0) * 360.0
    if extent.w <= 0 || extent.h <= 0 { return result }
    sine := SineDegrees(degrees); cosine := CosineDegrees(degrees)
    across := ifx cosine < 0.0 then -cosine else cosine
    down := ifx sine < 0.0 then -sine else sine
    wide := across * cast(float32)extent.w + down * cast(float32)extent.h
    high := down * cast(float32)extent.w + across * cast(float32)extent.h
    scale: float32 = 1.0
    if wide > cast(float32)canvas_page.width { scale = cast(float32)canvas_page.width / wide }
    if high * scale > cast(float32)canvas_page.height { scale = cast(float32)canvas_page.height / high }
    w := ifx scale < 1.0 then FloorInteger(wide * scale + 0.0001) else CeilInteger(wide - 0.0001)
    h := ifx scale < 1.0 then FloorInteger(high * scale + 0.0001) else CeilInteger(high - 0.0001)
    if w < 1 { w = 1 }; if h < 1 { h = 1 }
    if w > canvas_page.width { w = canvas_page.width }; if h > canvas_page.height { h = canvas_page.height }
    left := extent.x + extent.w / 2 - w / 2
    top := extent.y + extent.h / 2 - h / 2
    if left < 0 { left = 0 }
    if top < 0 { top = 0 }
    if left + w > canvas_page.width { left = canvas_page.width - w }
    if top + h > canvas_page.height { top = canvas_page.height - h }
    result = PaintRotation.{.id = id, .x = left, .y = top, .w = w, .h = h, .scale = scale, .degrees = degrees,
        .start = CanvasLayerSpace(w * h, id)}
    result.valid = result.start >= 0
    return result
}

CanvasRotationPrepare :: (id: s32, degrees: float32) -> PaintRotation {
    extent := CanvasObjectBounds(id)
    source: PaintLayer
    if id >= 0 && id < LAYER_LIMIT { source = layers[id] }
    return CanvasRotationPrepareFrom(id, degrees, extent, source)
}

// An editor may retain the initial source for successive handle gestures.
// Resampling that source avoids degrading paint on each small adjustment.
CanvasRotationPrepareFrom :: (id: s32, degrees: float32, extent: PaintExtent, source: PaintLayer) -> PaintRotation {
    result := CanvasRotation(id, degrees, extent)
    if !result.valid { return result }
    object := *layers[id]
    if result.degrees == 0.0 {
        result.x = source.x; result.y = source.y; result.w = source.w; result.h = source.h
        result.start = CanvasLayerSpace(source.w * source.h, id)
        result.valid = result.start >= 0
    }
    w := result.w; h := result.h
    sine := SineDegrees(result.degrees); cosine := CosineDegrees(result.degrees)
    result.matrix = ifx result.degrees == 0.0 then source.matrix else PaintMatrixRotated(source.matrix,
        Vector2.{cast(float32)extent.x + cast(float32)extent.w / 2.0, cast(float32)extent.y + cast(float32)extent.h / 2.0},
        Vector2.{cast(float32)result.x + cast(float32)w / 2.0, cast(float32)result.y + cast(float32)h / 2.0},
        result.scale, result.degrees)
    // Inverse sampling preserves indexed colors and transparent cut-outs;
    // uncovered corners are transparent, never paper or background paint.
    for py: cast(s32)0..h - 1 {
        for px: cast(s32)0..w - 1 {
            dx := (cast(float32)px + 0.5 - cast(float32)w / 2.0) / result.scale
            dy := (cast(float32)py + 0.5 - cast(float32)h / 2.0) / result.scale
            sx := extent.x - source.x + FloorInteger(cosine * dx + sine * dy + cast(float32)extent.w / 2.0 + 0.00001)
            sy := extent.y - source.y + FloorInteger(-sine * dx + cosine * dy + cast(float32)extent.h / 2.0 + 0.00001)
            pixel := cast(u8)TRANSPARENT
            if result.degrees == 0.0 { pixel = source.pixels[py * w + px] }
            else if sx >= 0 && sy >= 0 && sx < source.w && sy < source.h { pixel = source.pixels[sy * source.w + sx] }
            rotate_pixels[py * w + px] = pixel
        }
    }
    result.changed = result.x != object.x || result.y != object.y || w != object.w || h != object.h
    if !result.changed {
        for at: cast(s32)0..w * h - 1 { if rotate_pixels[at] != object.pixels[at] { result.changed = true; break } }
    }
    return result
}

CanvasRotationCommit :: (rotation: PaintRotation) -> bool {
    if !rotation.valid || !rotation.changed { return false }
    object := *layers[rotation.id]
    w := rotation.w; h := rotation.h
    layer_pixels += w * h - object.w * object.h
    object.x = rotation.x; object.y = rotation.y; object.w = w; object.h = h; object.start = rotation.start
    object.matrix = rotation.matrix
    offset := object.start % CANVAS_PIXELS
    object.pixels = layer_storage[object.start / CANVAS_PIXELS][offset:offset + w * h]
    for at: cast(s32)0..w * h - 1 { object.pixels[at] = rotate_pixels[at] }
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = base[at]; owner[at] = 0 }
    for at: cast(s32)0..layer_count - 1 { CanvasOverlay(layer_order[at], 0, 0, canvas_page.width, canvas_page.height) }
    CanvasPencilRenderAll()
    return true
}

CanvasRotateObject :: (x: s32, y: s32, degrees: float32) -> bool {
    return CanvasRotationCommit(CanvasRotationPrepare(CanvasObjectAt(x, y), degrees))
}

CanvasEraseObject :: (x: s32, y: s32) -> bool {
    id := CanvasObjectAt(x, y)
    if id < 0 { return false }
    object := layers[id]
    left := object.x; top := object.y
    right := left + object.w; bottom := top + object.h
    layer_pixels -= object.w * object.h
    order: s32 = 0
    while layer_order[order] != id { order += 1 }
    for at: order..layer_count - 2 { layer_order[at] = layer_order[at + 1] }
    layer_count -= 1
    layers[id] = PaintLayer.{}
    for py: top..bottom - 1 {
        for px: left..right - 1 {
            at := py * canvas_page.width + px
            canvas[at] = base[at]
            owner[at] = 0
        }
    }
    for at: cast(s32)0..layer_count - 1 { CanvasOverlay(layer_order[at], left, top, right, bottom) }
    CanvasPencilRenderAll()
    return true
}

// Find a free contiguous interval in the fixed arena. Refuse a fragmented
// arena gracefully rather than evicting or flattening an existing object.
CanvasLayerSpace :: (pixels: s32, ignore: s32 = -1) -> s32 {
    for bank: cast(s32)0..1 {
        start := bank * CANVAS_PIXELS
        changed := true
        while changed {
            changed = false
            for at: cast(s32)0..layer_count - 1 {
                if layer_order[at] == ignore { continue }
                object := *layers[layer_order[at]]
                end := object.start + object.w * object.h
                if start < end && start + pixels > object.start { start = end; changed = true }
            }
            if start + pixels > (bank + 1) * CANVAS_PIXELS { break }
        }
        if start + pixels <= (bank + 1) * CANVAS_PIXELS { return start }
    }
    return -1
}

CanvasCanStamp :: (dino: s32, size: s32, x: s32, y: s32) -> bool {
    if dino < 0 || dino >= DINO_COUNT || size < 1 || size > DINO_SIZES || layer_count >= LAYER_LIMIT { return false }
    w := DinoWidth(dino, size); h := DinoHeight(dino, size)
    if x < 0 || y < 0 || x + w > canvas_page.width || y + h > canvas_page.height { return false }
    return CanvasLayerSpace(w * h) >= 0
}

CanvasPaintPixel :: (at: s32, color: u8) {
    canvas[at] = color
    if layer_count == 0 { return }
    id := cast(s32)owner[at] - 1
    if id < 0 { base[at] = color; return }
    object := *layers[id]
    object.pixels[(at / canvas_page.width - object.y) * object.w + at % canvas_page.width - object.x] = color
}

// Masks in paint_pages.zi's order: the wide scenes, the tall scenes, then
// ink and body for each dinosaur size.
InkMask :: (dino: s32, size: s32) -> s32 { return SCENE_COUNT + (dino * DINO_SIZES + size - 1) * 2 }
SceneMask :: (scene: s32, page: PaintPage) -> s32 {
    return ifx PageIsTall(page) then InkMask(DINO_COUNT, 1) + scene else scene
}

DinoWidth :: (dino: s32, size: s32) -> s32 { return DINO_WIDTH[dino * DINO_SIZES + size - 1] }
DinoHeight :: (dino: s32, size: s32) -> s32 { return DINO_HEIGHT[dino * DINO_SIZES + size - 1] }

// Reads a mask's alternating paper and ink runs into mask[0..count). A run
// and its digits may continue from one chunk into the next.
ReadMask :: (index: s32, mask: []bool, count: s32) -> bool {
    at: s32 = 0
    ink := false
    length: s32 = 0
    shift: s32 = 0
    for chunk: MASK_START[index]..MASK_START[index + 1] - 1 {
        for byte: MaskChunk(chunk) {
            digit := RunDigit(byte)
            if digit < 0 { return false }
            length = length | ((digit & 31) << shift)
            shift += 5
            if digit >= 32 { continue }
            if at + length > count { return false }
            if length > 0 { for offset: cast(s32)0..length - 1 { mask[at + offset] = ink } }
            at += length
            ink = !ink
            length = 0
            shift = 0
        }
    }
    return at == count
}

// Starts a new picture: the scene's lines for that page on white paper.
SceneOpen :: (scene: s32, page: PaintPage = WIDE_PAGE) -> bool {
    if scene == BLANK_SCENE {
        canvas_page = page
        CanvasBlank()
        return true
    }
    if scene < 0 || scene >= SCENE_COUNT { return false }
    if !ReadMask(SceneMask(scene, page), stamp[:], CANVAS_PIXELS) { return false }
    canvas_page = page
    CanvasBlank()
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)(ifx stamp[at] then INK else PAPER) }
    return true
}

// Stamps a dinosaur at x,y in one of its four sizes; flip mirrors it. Its
// white body replaces the lines and colors beneath it, and scenery outside
// its outline stays.
CanvasStampDino :: (dino: s32, size: s32, x: s32, y: s32, flip: bool) {
    if !CanvasCanStamp(dino, size, x, y) { return }
    w := DinoWidth(dino, size)
    h := DinoHeight(dino, size)
    if !ReadMask(InkMask(dino, size), stamp[:], w * h) ||
    !ReadMask(InkMask(dino, size) + 1, stamp_body[:], w * h) { return }
    if layer_count == 0 {
        for at: cast(s32)0..CANVAS_PIXELS - 1 { base[at] = canvas[at]; owner[at] = 0 }
    }
    id: s32 = 0
    while layers[id].pixels.count != 0 { id += 1 }
    object := *layers[id]
    object.x = x; object.y = y; object.w = w; object.h = h
    huge_w := cast(float32)DinoWidth(dino, DINO_SIZES); huge_h := cast(float32)DinoHeight(dino, DINO_SIZES)
    object.art = dino + 1
    object.matrix = PaintMatrix.{cast(float32)w / huge_w, 0.0, 0.0, cast(float32)h / huge_h, cast(float32)x, cast(float32)y}
    if flip { object.matrix.a = -object.matrix.a; object.matrix.e += cast(float32)w }
    object.start = CanvasLayerSpace(w * h)
    object.pixels = layer_storage[object.start / CANVAS_PIXELS][object.start % CANVAS_PIXELS:object.start % CANVAS_PIXELS + w * h]
    for ty: cast(s32)0..h - 1 {
        for tx: cast(s32)0..w - 1 {
            source := ty * w + (ifx flip then w - 1 - tx else tx)
            pixel := cast(u8)(ifx stamp[source] then INK else ifx stamp_body[source] then PAPER else TRANSPARENT)
            object.pixels[ty * w + tx] = pixel
            if pixel != cast(u8)TRANSPARENT {
                at := (y + ty) * canvas_page.width + x + tx
                canvas[at] = pixel
                owner[at] = cast(u8)(id + 1)
            }
        }
    }
    layer_order[layer_count] = id
    layer_count += 1
    layer_pixels += w * h
}

// Where a stencil's art lies when its center is at center, as the masks are sampled.
PaintMatrixPlaced :: (center: Vector2, width: float32, height: float32, scale: float32, degrees: float32, flip: bool) -> PaintMatrix {
    sine := SineDegrees(degrees); cosine := CosineDegrees(degrees)
    a := scale * cosine; b := scale * sine; c := -scale * sine; d := scale * cosine
    result := PaintMatrix.{a, b, c, d, center.x - a * width / 2.0 - c * height / 2.0, center.y - b * width / 2.0 - d * height / 2.0}
    if flip {
        result.e += result.a * width; result.f += result.b * width
        result.a = -result.a; result.b = -result.b
    }
    return result
}

// The art after turning and scaling its page about from_center onto to_center.
PaintMatrixRotated :: (source: PaintMatrix, from_center: Vector2, to_center: Vector2, scale: float32, degrees: float32) -> PaintMatrix {
    sine := SineDegrees(degrees); cosine := CosineDegrees(degrees)
    ra := scale * cosine; rb := scale * sine; rc := -scale * sine; rd := scale * cosine
    ex := source.e - from_center.x; ey := source.f - from_center.y
    return PaintMatrix.{ra * source.a + rc * source.b, rb * source.a + rd * source.b,
        ra * source.c + rc * source.d, rb * source.c + rd * source.d,
        ra * ex + rc * ey + to_center.x, rb * ex + rd * ey + to_center.y}
}

PlacementClamp :: (value: s32, low: s32, high: s32) -> s32 {
    if value < low { return low }; if value > high { return high }; return value
}

PAINT_RESIZE_HANDLE_SIZE :: 44

PaintResizePlan :: struct { center: Vector2; width: s32; height: s32; scale: float32; valid: bool; }

PaintResizeHit :: (corner: Vector2, pointer: Vector2) -> bool {
    dx := pointer.x - corner.x; dy := pointer.y - corner.y
    limit := cast(float32)PAINT_RESIZE_HANDLE_SIZE / 2.0
    return (ifx dx < 0.0 then -dx else dx) <= limit && (ifx dy < 0.0 then -dy else dy) <= limit
}

PlacementMaximumWidth :: (source_width: s32, source_height: s32, degrees: float32) -> s32 {
    if source_width <= 0 || source_height <= 0 || !Finite32(degrees) { return 0 }
    sine := SineDegrees(degrees); cosine := CosineDegrees(degrees)
    across := ifx cosine < 0.0 then -cosine else cosine
    down := ifx sine < 0.0 then -sine else sine
    wide := across * cast(float32)source_width + down * cast(float32)source_height
    high := down * cast(float32)source_width + across * cast(float32)source_height
    by_width := cast(float32)canvas_page.width * cast(float32)source_width / wide
    by_height := cast(float32)canvas_page.height * cast(float32)source_height / high
    fit := ifx by_width < by_height then by_width else by_height
    return PlacementClamp(FloorInteger(fit + 0.5), 1, canvas_page.width)
}

PaintResizeAtCorner :: (start_center: Vector2, anchor: Vector2, moving_start: Vector2, pointer: Vector2,
    start_width: s32, start_height: s32, minimum_width: s32, maximum_width: s32) -> PaintResizePlan {
    result := PaintResizePlan.{.center = start_center, .width = start_width, .height = start_height, .scale = 1.0, .valid = true}
    diagonal := Vector2.{moving_start.x - anchor.x, moving_start.y - anchor.y}
    delta := Vector2.{pointer.x - anchor.x, pointer.y - anchor.y}
    length := diagonal.x * diagonal.x + diagonal.y * diagonal.y
    if start_width <= 0 || start_height <= 0 || minimum_width < 1 || maximum_width < minimum_width || length < 1.0 {
        result.valid = false; return result
    }
    projection := (delta.x * diagonal.x + delta.y * diagonal.y) / length
    requested := FloorInteger(cast(float32)start_width * projection + 0.5)
    result.width = PlacementClamp(requested, minimum_width, maximum_width)
    result.scale = cast(float32)result.width / cast(float32)start_width
    result.height = PlacementClamp(FloorInteger(cast(float32)start_height * result.scale + 0.5), 1, canvas_page.height)
    result.center = Vector2.{anchor.x + (start_center.x - anchor.x) * result.scale,
        anchor.y + (start_center.y - anchor.y) * result.scale}
    return result
}

// New stencils stay outside the document until the explicit Place action.
PaintPlacement :: struct {
    dino: s32; x: s32; y: s32; w: s32; h: s32
    scale: float32; degrees: float32; flip: bool; start: s32; valid: bool
}

CanvasPlacement :: (dino: s32, cx: s32, cy: s32, width: s32, degrees: float32, flip: bool) -> PaintPlacement {
    result: PaintPlacement
    if dino < 0 || dino >= DINO_COUNT || width < 1 || !Finite32(degrees) { return result }
    sw := DinoWidth(dino, DINO_SIZES); sh := DinoHeight(dino, DINO_SIZES)
    degrees -= cast(float32)FloorInteger((degrees + 180.0) / 360.0) * 360.0
    sine := SineDegrees(degrees); cosine := CosineDegrees(degrees)
    a := ifx cosine < 0.0 then -cosine else cosine
    b := ifx sine < 0.0 then -sine else sine
    scale := cast(float32)width / cast(float32)sw
    wide := a * cast(float32)sw + b * cast(float32)sh
    high := b * cast(float32)sw + a * cast(float32)sh
    if wide * scale > cast(float32)canvas_page.width { scale = cast(float32)canvas_page.width / wide }
    if high * scale > cast(float32)canvas_page.height { scale = cast(float32)canvas_page.height / high }
    w := PlacementClamp(CeilInteger(wide * scale - 0.0001), 1, canvas_page.width)
    h := PlacementClamp(CeilInteger(high * scale - 0.0001), 1, canvas_page.height)
    result = PaintPlacement.{.dino = dino, .x = PlacementClamp(cx - w / 2, 0, canvas_page.width - w),
        .y = PlacementClamp(cy - h / 2, 0, canvas_page.height - h), .w = w, .h = h,
        .scale = scale, .degrees = degrees, .flip = flip, .start = CanvasLayerSpace(w * h)}
    result.valid = layer_count < LAYER_LIMIT && result.start >= 0
    return result
}

CanvasPlacementPrepare :: (plan: PaintPlacement) -> bool {
    if !plan.valid { return false }
    sw := DinoWidth(plan.dino, DINO_SIZES); sh := DinoHeight(plan.dino, DINO_SIZES)
    if !ReadMask(InkMask(plan.dino, DINO_SIZES), stamp[:], sw * sh) ||
       !ReadMask(InkMask(plan.dino, DINO_SIZES) + 1, stamp_body[:], sw * sh) { return false }
    sine := SineDegrees(plan.degrees); cosine := CosineDegrees(plan.degrees)
    for y: cast(s32)0..plan.h - 1 {
        for x: cast(s32)0..plan.w - 1 {
            dx := (cast(float32)x + 0.5 - cast(float32)plan.w / 2.0) / plan.scale
            dy := (cast(float32)y + 0.5 - cast(float32)plan.h / 2.0) / plan.scale
            sx := FloorInteger(cosine * dx + sine * dy + cast(float32)sw / 2.0 + 0.00001)
            sy := FloorInteger(-sine * dx + cosine * dy + cast(float32)sh / 2.0 + 0.00001)
            pixel := cast(u8)TRANSPARENT
            if sx >= 0 && sy >= 0 && sx < sw && sy < sh {
                if plan.flip { sx = sw - 1 - sx }
                at := sy * sw + sx
                pixel = cast(u8)(ifx stamp[at] then INK else ifx stamp_body[at] then PAPER else TRANSPARENT)
            }
            rotate_pixels[y * plan.w + x] = pixel
        }
    }
    return true
}

CanvasPlacementCommit :: (plan: PaintPlacement) -> bool {
    if !plan.valid || layer_count >= LAYER_LIMIT || CanvasLayerSpace(plan.w * plan.h) != plan.start { return false }
    if layer_count == 0 {
        for at: cast(s32)0..CANVAS_PIXELS - 1 { base[at] = canvas[at]; owner[at] = 0 }
    }
    id: s32 = 0
    while layers[id].pixels.count != 0 { id += 1 }
    object := *layers[id]
    object.x = plan.x; object.y = plan.y; object.w = plan.w; object.h = plan.h; object.start = plan.start
    object.art = plan.dino + 1
    object.matrix = PaintMatrixPlaced(Vector2.{cast(float32)plan.x + cast(float32)plan.w / 2.0, cast(float32)plan.y + cast(float32)plan.h / 2.0},
        cast(float32)DinoWidth(plan.dino, DINO_SIZES), cast(float32)DinoHeight(plan.dino, DINO_SIZES), plan.scale, plan.degrees, plan.flip)
    offset := plan.start % CANVAS_PIXELS
    object.pixels = layer_storage[plan.start / CANVAS_PIXELS][offset:offset + plan.w * plan.h]
    for at: cast(s32)0..plan.w * plan.h - 1 { object.pixels[at] = rotate_pixels[at] }
    layer_order[layer_count] = id; layer_count += 1; layer_pixels += plan.w * plan.h
    CanvasOverlay(id, plan.x, plan.y, plan.x + plan.w, plan.y + plan.h)
    CanvasPencilRenderAll()
    return true
}

CanvasPencilClear :: () {
    for at: cast(s32)0..PENCIL_STROKE_LIMIT - 1 { pencil_strokes[at] = PencilStroke.{} }
    for at: cast(s32)0..PENCIL_POINT_LIMIT - 1 { pencil_points[at] = PencilPoint.{} }
    pencil_stroke_count = 0
    pencil_point_count = 0
}

CanvasPencilCanStroke :: () -> bool {
    return pencil_stroke_count < PENCIL_STROKE_LIMIT && pencil_point_count < PENCIL_POINT_LIMIT
}

CanvasPencilInside :: (x: s32, y: s32) -> bool {
    return x >= 0 && y >= 0 && x < canvas_page.width && y < canvas_page.height
}

CanvasPencilStamp :: (x: s32, y: s32) {
    left := x - PENCIL_WIDTH / 2
    top := y - PENCIL_WIDTH / 2
    for py: top..top + PENCIL_WIDTH - 1 {
        if py < 0 || py >= canvas_page.height { continue }
        for px: left..left + PENCIL_WIDTH - 1 {
            if px < 0 || px >= canvas_page.width { continue }
            canvas[py * canvas_page.width + px] = cast(u8)INK
        }
    }
}

CanvasPencilSegment :: (start: PencilPoint, end: PencilPoint) {
    // Points may hold fractions of a pixel; the page's INK steps in whole pixels.
    x := start.x / PENCIL_SCALE; y := start.y / PENCIL_SCALE
    end_x := end.x / PENCIL_SCALE; end_y := end.y / PENCIL_SCALE
    dx := end_x - x; dy := end_y - y
    step_x: s32 = 1; if dx < 0 { step_x = -1; dx = -dx }
    step_y: s32 = 1; if dy < 0 { step_y = -1; dy = -dy }
    error := dx - dy
    while true {
        CanvasPencilStamp(x, y)
        if x == end_x && y == end_y { break }
        twice := error * 2
        if twice > -dy {
            error -= dy
            x += step_x
        }
        if twice < dx {
            error += dx
            y += step_y
        }
    }
}

CanvasPencilPoint :: (x: s32, y: s32) -> PencilPoint {
    return PencilPoint.{x * PENCIL_SCALE + PENCIL_SCALE / 2, y * PENCIL_SCALE + PENCIL_SCALE / 2}
}

// A point of a line in fractions of a page pixel, for a zoomed picture.
CanvasPencilPointAt :: (x: float32, y: float32) -> PencilPoint {
    return PencilPoint.{FloorInteger(x * cast(float32)PENCIL_SCALE), FloorInteger(y * cast(float32)PENCIL_SCALE)}
}

CanvasPencilStrokeBegin :: (x: s32, y: s32) -> bool {
    return CanvasPencilBeginAt(CanvasPencilPoint(x, y))
}

CanvasPencilBeginAt :: (point: PencilPoint) -> bool {
    x := point.x / PENCIL_SCALE; y := point.y / PENCIL_SCALE
    if !CanvasPencilCanStroke() || point.x < 0 || point.y < 0 || !CanvasPencilInside(x, y) { return false }
    pencil_points[pencil_point_count] = point
    pencil_strokes[pencil_stroke_count] = PencilStroke.{pencil_point_count, 1, PENCIL_WIDTH_UNITS}
    pencil_point_count += 1
    pencil_stroke_count += 1
    CanvasPencilStamp(x, y)
    return true
}

CanvasPencilStrokeMove :: (x: s32, y: s32) -> bool {
    return CanvasPencilMoveAt(CanvasPencilPoint(x, y))
}

CanvasPencilMoveAt :: (point: PencilPoint) -> bool {
    if point.x < 0 || point.y < 0 { return false }
    if pencil_stroke_count == 0 || pencil_point_count >= PENCIL_POINT_LIMIT || !CanvasPencilInside(point.x / PENCIL_SCALE, point.y / PENCIL_SCALE) { return false }
    stroke := pencil_strokes[pencil_stroke_count - 1]
    previous := pencil_points[stroke.first + stroke.count - 1]
    if previous.x == point.x && previous.y == point.y { return true }
    pencil_points[pencil_point_count] = point
    pencil_point_count += 1
    stroke.count += 1
    pencil_strokes[pencil_stroke_count - 1] = stroke
    CanvasPencilSegment(previous, point)
    return true
}

CanvasPencilStrokeEnd :: () -> bool {
    return pencil_stroke_count > 0
}

CanvasPencilRenderAll :: () {
    for stroke_at: cast(s32)0..pencil_stroke_count - 1 {
        stroke := *pencil_strokes[stroke_at]
        for point_at: cast(s32)0..stroke.count - 2 {
            CanvasPencilSegment(pencil_points[stroke.first + point_at], pencil_points[stroke.first + point_at + 1])
        }
        if stroke.count == 1 { CanvasPencilStamp(pencil_points[stroke.first].x / PENCIL_SCALE, pencil_points[stroke.first].y / PENCIL_SCALE) }
    }
}

// A matrix number in the display host's units; see host/paint_view.zi.
PaintVectorUnits :: (value: float32) -> s64 {
    return cast(s64)FloorInteger(value * 65536.0 + 0.5)
}

CanvasText :: () -> Text {
    return PictureRunsText(canvas[:], canvas_page)
}

CanvasColorAt :: (x: s32, y: s32) -> s32 {
    if x < 0 || y < 0 || x >= canvas_page.width || y >= canvas_page.height { return -1 }
    return cast(s32)canvas[y * canvas_page.width + x]
}

// Fills the area around x,y up to its lines. The target is never INK, so
// comparing colors alone keeps the fill inside them.
CanvasFill :: (x: s32, y: s32, color: s32) -> s32 {
    if color <= INK || color >= PAINT_COLORS { return 0 }
    if x < 0 || y < 0 || x >= canvas_page.width || y >= canvas_page.height { return 0 }
    width := canvas_page.width
    start := y * width + x
    target := canvas[start]
    paint := cast(u8)color
    if target == cast(u8)INK || target == paint { return 0 }
    changed: s32 = 0
    count: s32 = 1
    fill_stack[0] = start
    region := ifx layer_count == 0 then cast(u8)0 else owner[start]
    CanvasPaintPixel(start, paint)
    while count > 0 {
        count -= 1
        at := fill_stack[count]
        changed += 1
        column := at % width
        if column > 0 && canvas[at - 1] == target && (layer_count == 0 || owner[at - 1] == region) {
            CanvasPaintPixel(at - 1, paint); fill_stack[count] = at - 1; count += 1
        }
        if column < width - 1 && canvas[at + 1] == target && (layer_count == 0 || owner[at + 1] == region) {
            CanvasPaintPixel(at + 1, paint); fill_stack[count] = at + 1; count += 1
        }
        if at >= width && canvas[at - width] == target && (layer_count == 0 || owner[at - width] == region) {
            CanvasPaintPixel(at - width, paint); fill_stack[count] = at - width; count += 1
        }
        if at < CANVAS_PIXELS - width && canvas[at + width] == target && (layer_count == 0 || owner[at + width] == region) {
            CanvasPaintPixel(at + width, paint); fill_stack[count] = at + width; count += 1
        }
    }
    return changed
}

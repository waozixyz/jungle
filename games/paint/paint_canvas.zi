// The picture: 240 by 180 pixels of the sixteen colors over black lines.
// Lines are stamped from a scene and any dinosaurs placed on it; the paint
// bucket fills up to those lines. Bert's Dinosaurs works the same way.
#import, file "paint_pages.zi";
#import, file "paint_palette.zi";

CANVAS_PIXELS :: CANVAS_WIDTH * CANVAS_HEIGHT
INK :: 0
PAPER :: 15
MAX_STAMP_WIDTH :: 240
MAX_STAMP_HEIGHT :: 184
STAMP_PIXELS :: MAX_STAMP_WIDTH * MAX_STAMP_HEIGHT

canvas: [CANVAS_PIXELS]u8;
lines: [CANVAS_PIXELS]bool;
stamp: [STAMP_PIXELS]bool;
stamp_outside: [STAMP_PIXELS]bool;
stamp_barrier: [STAMP_PIXELS]bool;
stamp_stack: [STAMP_PIXELS]s32;
fill_stack: [CANVAS_PIXELS]s32;
canvas_text: [CANVAS_PIXELS + 6]u8;

HexValue :: (byte: u8) -> s32 {
    if byte >= #char "0" && byte <= #char "9" { return cast(s32)(byte - #char "0") }
    if byte >= #char "a" && byte <= #char "f" { return cast(s32)(byte - #char "a") + 10 }
    return 0
}

// Reads one part's hex rows into stamp[0..width*height); returns the next
// row that has not been filled yet.
ReadPart :: (part: string, width: s32, height: s32, at: s32) -> s32 {
    row := at / width
    column := at % width
    for byte: part {
        if byte == cast(u8)10 { continue }
        if row >= height { return at }
        nibble := HexValue(byte)
        for bit: cast(s32)0..3 {
            if column >= width { break }
            stamp[row * width + column] = ((nibble >> (3 - bit)) & 1) != 0
            column += 1
            at += 1
        }
        if column >= width { row += 1; column = 0 }
    }
    return at
}

ReadLines :: (scene_kind: bool, index: s32, parts: s32, width: s32, height: s32) {
    for pixel: cast(s32)0..width * height - 1 { stamp[pixel] = false }
    at: s32 = 0
    for part: cast(s32)0..parts - 1 {
        text := ifx scene_kind then SceneLines(index, part) else DinoLines(index, part)
        at = ReadPart(text, width, height, at)
    }
}

// Starts a new picture: the scene's lines, then the saved colors when
// `saved` is a whole picture, otherwise white paper.
SceneOpen :: (scene: s32, saved: string) -> bool {
    if scene < 0 || scene >= SCENE_COUNT { return false }
    whole := saved.count == cast(s64)CANVAS_PIXELS + 6 && saved[:6] == "paint\n"
    old := saved.count == cast(s64)CANVAS_PIXELS
    if saved != "" && !whole && !old { return false }
    if whole {
        for at: cast(s32)0..CANVAS_PIXELS - 1 {
            if PaintIndex(saved[at + 6]) < 0 { return false }
        }
    }
    ReadLines(true, scene, SCENE_PARTS, CANVAS_WIDTH, CANVAS_HEIGHT)
    for at: cast(s32)0..CANVAS_PIXELS - 1 { lines[at] = stamp[at] }
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        color: s32 = PAPER
        if old {
            byte := saved[cast(s64)at]
            if byte >= #char "a" && byte <= #char "p" { color = cast(s32)(byte - #char "a") }
        }
        if whole { color = PaintIndex(saved[at + 6]) }
        canvas[at] = cast(u8)(ifx lines[at] then INK else color)
    }
    return true
}

// Fit the largest dinosaur inside the picture, then take four fractions.
// A 184-pixel-tall stamp cannot be placed on our 180-pixel-tall canvas.
DinoScale :: (dino: s32, size: s32) -> s32 {
    width := DINO_WIDTH[dino]
    height := DINO_HEIGHT[dino]
    if width <= 0 || height <= 0 { return 100 }
    fit := 100 * CANVAS_HEIGHT / height
    across := 100 * CANVAS_WIDTH / width
    if across < fit { fit = across }
    return fit * size / 4
}

// Flood from the stamp's edges to distinguish its transparent background
// from the dinosaur's white body. Its body covers earlier scene lines.
StampOutside :: (width: s32, height: s32) {
    total := width * height
    for at: cast(s32)0..total - 1 {
        stamp_outside[at] = false
        stamp_barrier[at] = stamp[at]
    }
    // Raster reduction can leave a one-pixel break in a closed vector
    // outline. Close those breaks only for the body mask, leaving the
    // visible strokes unchanged.
    for at: cast(s32)0..total - 1 {
        if !stamp[at] { continue }
        for dy: cast(s32)-1..1 {
            for dx: cast(s32)-1..1 {
                x := at % width + dx
                y := at / width + dy
                if x >= 0 && x < width && y >= 0 && y < height { stamp_barrier[y * width + x] = true }
            }
        }
    }
    count: s32 = 0
    for at: cast(s32)0..total - 1 {
        if (at < width || at >= total - width || at % width == 0 || at % width == width - 1) && !stamp_barrier[at] {
            stamp_outside[at] = true
            stamp_stack[count] = at
            count += 1
        }
    }
    while count > 0 {
        count -= 1
        at := stamp_stack[count]
        next: [4]s32 = .[at - 1, at + 1, at - width, at + width]
        for side: cast(s32)0..3 {
            other := next[side]
            if other < 0 || other >= total || (side == 0 && at % width == 0) ||
            (side == 1 && at % width == width - 1) { continue }
            if !stamp_barrier[other] && !stamp_outside[other] {
                stamp_outside[other] = true
                stamp_stack[count] = other
                count += 1
            }
        }
    }
}

// Stamps a dinosaur's lines at x,y. Percent scales it; flip mirrors it.
// The lines are thickened while shrinking so small figures still hold ink.
CanvasStampDino :: (dino: s32, size: s32, x: s32, y: s32, flip: bool) {
    base_w := DINO_WIDTH[dino]
    base_h := DINO_HEIGHT[dino]
    percent := DinoScale(dino, size)
    w := base_w * percent / 100
    h := base_h * percent / 100
    if w < 1 || h < 1 { return }
    ReadLines(false, dino, DINO_PARTS, base_w, base_h)
    StampOutside(base_w, base_h)
    for ty: cast(s32)0..h - 1 {
        py := y + ty
        if py < 0 || py >= CANVAS_HEIGHT { continue }
        source_y := ty * base_h / h
        for tx: cast(s32)0..w - 1 {
            px := x + tx
            if px < 0 || px >= CANVAS_WIDTH { continue }
            sx := tx * base_w / w
            fx := ifx flip then sx else sx
            source_x := ifx flip then base_w - 1 - fx else fx
            inked := stamp[source_y * base_w + source_x]
            // When shrinking, look at the neighbouring source pixels too.
            if !inked && w < base_w {
                if source_x > 0 && stamp[source_y * base_w + source_x - 1] { inked = true }
                if source_x < base_w - 1 && stamp[source_y * base_w + source_x + 1] { inked = true }
            }
            if !inked && h < base_h {
                if source_y > 0 && stamp[(source_y - 1) * base_w + source_x] { inked = true }
                if source_y < base_h - 1 && stamp[(source_y + 1) * base_w + source_x] { inked = true }
            }
            if inked || !stamp_outside[source_y * base_w + source_x] {
                at := py * CANVAS_WIDTH + px
                lines[at] = inked
                canvas[at] = cast(u8)(ifx inked then INK else PAPER)
            }
        }
    }
}

CanvasClear :: () {
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        canvas[at] = cast(u8)(ifx lines[at] then INK else PAPER)
    }
}

CanvasText :: () -> string {
    prefix := "paint\n"
    for at: cast(s32)0..5 { canvas_text[at] = prefix[at] }
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas_text[at + 6] = PAINT_CODES[canvas[at]] }
    return TextView(canvas_text[:])
}

CanvasColorAt :: (x: s32, y: s32) -> s32 {
    if x < 0 || y < 0 || x >= CANVAS_WIDTH || y >= CANVAS_HEIGHT { return -1 }
    return cast(s32)canvas[y * CANVAS_WIDTH + x]
}

CanvasFill :: (x: s32, y: s32, color: s32) -> s32 {
    if color < 0 || color >= PAINT_COLORS { return 0 }
    if x < 0 || y < 0 || x >= CANVAS_WIDTH || y >= CANVAS_HEIGHT { return 0 }
    start := y * CANVAS_WIDTH + x
    if lines[start] { return 0 }
    target := canvas[start]
    paint := cast(u8)color
    if target == paint { return 0 }
    changed: s32 = 0
    count: s32 = 1
    fill_stack[0] = start
    canvas[start] = paint
    while count > 0 {
        count -= 1
        at := fill_stack[count]
        changed += 1
        column := at % CANVAS_WIDTH
        if column > 0 && !lines[at - 1] && canvas[at - 1] == target {
            canvas[at - 1] = paint; fill_stack[count] = at - 1; count += 1
        }
        if column < CANVAS_WIDTH - 1 && !lines[at + 1] && canvas[at + 1] == target {
            canvas[at + 1] = paint; fill_stack[count] = at + 1; count += 1
        }
        if at >= CANVAS_WIDTH && !lines[at - CANVAS_WIDTH] && canvas[at - CANVAS_WIDTH] == target {
            canvas[at - CANVAS_WIDTH] = paint; fill_stack[count] = at - CANVAS_WIDTH; count += 1
        }
        if at < CANVAS_PIXELS - CANVAS_WIDTH && !lines[at + CANVAS_WIDTH] && canvas[at + CANVAS_WIDTH] == target {
            canvas[at + CANVAS_WIDTH] = paint; fill_stack[count] = at + CANVAS_WIDTH; count += 1
        }
    }
    return changed
}

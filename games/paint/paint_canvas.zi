// The picture: 960 by 720 pixels of crayon colors over black lines.
// Lines are stamped from a scene and any dinosaurs placed on it; the paint
// bucket fills up to those lines. A pixel is a line exactly when it is INK:
// crayons start at 16, so no fill ever paints INK.
#import, file "paint_pages.zi";
#import, file "paint_palette.zi";
#import, file "paint_picture.zi";

INK :: 0
PAPER :: 15

canvas: [CANVAS_PIXELS]u8;
stamp: [CANVAS_PIXELS]bool;
stamp_body: [CANVAS_PIXELS]bool;
fill_stack: [CANVAS_PIXELS]s32;

// Masks in paint_pages.zi's order: the scenes, then ink and body for each
// dinosaur size.
SceneMask :: (scene: s32) -> s32 { return scene }
InkMask :: (dino: s32, size: s32) -> s32 { return SCENE_COUNT + (dino * DINO_SIZES + size - 1) * 2 }

DinoWidth :: (dino: s32, size: s32) -> s32 { return DINO_WIDTH[dino * DINO_SIZES + size - 1] }
DinoHeight :: (dino: s32, size: s32) -> s32 { return DINO_HEIGHT[dino * DINO_SIZES + size - 1] }

// Reads a mask's alternating paper and ink runs into mask[0..count). A run
// and its digits may continue from one chunk into the next.
ReadMask :: (index: s32, mask: []bool, count: s32) -> bool {
    at: s32 = 0
    ink := false
    length: s32 = 0
    shift: s32 = 0
    for chunk: MASK_START[index]..MASK_START[index + 1] - 1 {
        for byte: MaskChunk(chunk) {
            digit := RunDigit(byte)
            if digit < 0 { return false }
            length = length | ((digit & 31) << shift)
            shift += 5
            if digit >= 32 { continue }
            if at + length > count { return false }
            if length > 0 { for offset: cast(s32)0..length - 1 { mask[at + offset] = ink } }
            at += length
            ink = !ink
            length = 0
            shift = 0
        }
    }
    return at == count
}

// Starts a new picture: the scene's lines on white paper.
SceneOpen :: (scene: s32) -> bool {
    if scene < 0 || scene >= SCENE_COUNT { return false }
    if !ReadMask(SceneMask(scene), stamp[:], CANVAS_PIXELS) { return false }
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)(ifx stamp[at] then INK else PAPER) }
    return true
}

// Stamps a dinosaur at x,y in one of its four sizes; flip mirrors it. Its
// white body replaces the lines and colors beneath it, and scenery outside
// its outline stays.
CanvasStampDino :: (dino: s32, size: s32, x: s32, y: s32, flip: bool) {
    if dino < 0 || dino >= DINO_COUNT || size < 1 || size > DINO_SIZES { return }
    w := DinoWidth(dino, size)
    h := DinoHeight(dino, size)
    if !ReadMask(InkMask(dino, size), stamp[:], w * h) ||
    !ReadMask(InkMask(dino, size) + 1, stamp_body[:], w * h) { return }
    for ty: cast(s32)0..h - 1 {
        py := y + ty
        if py < 0 || py >= CANVAS_HEIGHT { continue }
        for tx: cast(s32)0..w - 1 {
            px := x + tx
            if px < 0 || px >= CANVAS_WIDTH { continue }
            source := ty * w + (ifx flip then w - 1 - tx else tx)
            if stamp[source] { canvas[py * CANVAS_WIDTH + px] = cast(u8)INK }
            else if stamp_body[source] { canvas[py * CANVAS_WIDTH + px] = cast(u8)PAPER }
        }
    }
}

CanvasText :: () -> string {
    return PictureRunsText(canvas[:])
}

CanvasColorAt :: (x: s32, y: s32) -> s32 {
    if x < 0 || y < 0 || x >= CANVAS_WIDTH || y >= CANVAS_HEIGHT { return -1 }
    return cast(s32)canvas[y * CANVAS_WIDTH + x]
}

// Fills the area around x,y up to its lines. The target is never INK, so
// comparing colors alone keeps the fill inside them.
CanvasFill :: (x: s32, y: s32, color: s32) -> s32 {
    if color <= INK || color >= PAINT_COLORS { return 0 }
    if x < 0 || y < 0 || x >= CANVAS_WIDTH || y >= CANVAS_HEIGHT { return 0 }
    start := y * CANVAS_WIDTH + x
    target := canvas[start]
    paint := cast(u8)color
    if target == cast(u8)INK || target == paint { return 0 }
    changed: s32 = 0
    count: s32 = 1
    fill_stack[0] = start
    canvas[start] = paint
    while count > 0 {
        count -= 1
        at := fill_stack[count]
        changed += 1
        column := at % CANVAS_WIDTH
        if column > 0 && canvas[at - 1] == target {
            canvas[at - 1] = paint; fill_stack[count] = at - 1; count += 1
        }
        if column < CANVAS_WIDTH - 1 && canvas[at + 1] == target {
            canvas[at + 1] = paint; fill_stack[count] = at + 1; count += 1
        }
        if at >= CANVAS_WIDTH && canvas[at - CANVAS_WIDTH] == target {
            canvas[at - CANVAS_WIDTH] = paint; fill_stack[count] = at - CANVAS_WIDTH; count += 1
        }
        if at < CANVAS_PIXELS - CANVAS_WIDTH && canvas[at + CANVAS_WIDTH] == target {
            canvas[at + CANVAS_WIDTH] = paint; fill_stack[count] = at + CANVAS_WIDTH; count += 1
        }
    }
    return changed
}

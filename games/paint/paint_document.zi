// Complete picture files: scene, crayon, page, story and pixels, whose INK
// pixels are the lines. Validate the entire record before changing the
// current picture. The metadata line is the scene and crayon codes, then
// PICTURE_TALL for a tall page; wide pages, and every picture saved before
// tall pages, have none.
#import "std/byte_text_linux"
#import "std/vec"
#import "std/text_buffer"
#import, file "../../retro/language.zi";
#import, file "paint_canvas.zi";
#import, file "paint_pages.zi";
#import, file "paint_palette.zi";
#import, file "paint_picture.zi";

STORY_LINES :: 8
STORY_COLUMNS :: 38
PICTURE_HEADER :: "JUNGLE PICTURE 2\n"
LAYER_HEADER :: "JUNGLE PICTURE 3\n"
PENCIL_HEADER :: "JUNGLE PENCIL 1\n"
VECTOR_HEADER :: "JUNGLE VECTOR 1\n"
// Version 1 kept 240 by 180 pixels, one letter each, then a line mask.
OLD_HEADER :: "JUNGLE PICTURE 1\n"
PICTURE_STORY :: STORY_LINES * (STORY_COLUMNS + 1)
PICTURE_TALL :: #char "T"

scene: s32 = -1;
crayon: s32 = 14;
story: [STORY_LINES][STORY_COLUMNS + 1]u8;
loaded: [CANVAS_PIXELS]u8;
old_pixels: [OLD_PIXELS]u8;

ClearStory :: () {
    for row: cast(s32)0..STORY_LINES - 1 {
        for column: cast(s32)0..STORY_COLUMNS { story[row][column] = 0 }
    }
}

StoryText :: () -> Text {
    text: Vec(u8)
    for row: cast(s32)0..STORY_LINES - 1 {
        line := LatinText(TextUntilNul(story[row][:]))
        BuilderPrint(*text, "%\n", line)
    }
    return BuilderFinish(text)
}

PictureText :: () -> Text {
    if scene < -1 || scene > BLANK_SCENE { return .{} }
    text: Vec(u8)
    tall := PageIsTall(canvas_page)
    metadata: [4]u8 = .[ifx scene < 0 then #char "-" else PAINT_CODES[PaintSceneCode(scene)], PAINT_CODES[crayon],
        ifx tall then PICTURE_TALL else cast(u8)10, cast(u8)10]
    layered := layer_count > 0 || pencil_stroke_count > 0
    BuilderPrint(*text, "%", ifx layered then LAYER_HEADER else PICTURE_HEADER)
    BuilderPrint(*text, "%", TextView(metadata[:ifx tall then 4 else 3]))
    for row: cast(s32)0..STORY_LINES - 1 {
        for column: cast(s32)0..STORY_COLUMNS - 1 {
            byte := story[row][column]
            unused VecPush(text, ifx byte == 0 then #char " " else byte)
        }
        unused VecPush(text, cast(u8)10)
    }
    PictureRunsAppend(*text, canvas[:])
    unused VecPush(text, cast(u8)10)
    if layered {
        if layer_count > 0 { PictureRunsAppend(*text, base[:]) }
        else { PictureRunsAppend(*text, canvas[:]) }
        BuilderPrint(*text, "\n%\n", layer_count)
        for at: cast(s32)0..layer_count - 1 {
            object := *layers[layer_order[at]]
            BuilderPrint(*text, "% % % % %\n", object.x, object.y, object.w, object.h, object.start)
            PictureRunsAppend(*text, object.pixels)
            unused VecPush(text, cast(u8)10)
        }
        // Pictures made before vector outlines keep their exact bytes.
        has_art := false
        for at: cast(s32)0..layer_count - 1 { if layers[layer_order[at]].art != 0 { has_art = true } }
        if has_art {
            BuilderPrint(*text, "%", VECTOR_HEADER)
            for at: cast(s32)0..layer_count - 1 {
                object := *layers[layer_order[at]]
                m := object.matrix
                BuilderPrint(*text, "% % % % % % %\n", object.art, PaintVectorUnits(m.a), PaintVectorUnits(m.b),
                    PaintVectorUnits(m.c), PaintVectorUnits(m.d), PaintVectorUnits(m.e), PaintVectorUnits(m.f))
            }
        }
    }
    if pencil_stroke_count > 0 {
        BuilderPrint(*text, "%", PENCIL_HEADER)
        BuilderPrint(*text, "%\n", pencil_stroke_count)
        for at: cast(s32)0..pencil_stroke_count - 1 {
            stroke := *pencil_strokes[at]
            BuilderPrint(*text, "% %\n", stroke.width, stroke.count)
            for point: cast(s32)0..stroke.count - 1 {
                value := pencil_points[stroke.first + point]
                BuilderPrint(*text, "% %\n", value.x, value.y)
            }
        }
    }
    return BuilderFinish(text)
}

// An old picture four times as wide and tall, each pixel a 4 by 4 block,
// so none of its colors change. Old pictures were always wide.
Enlarge :: () {
    page := WIDE_PAGE
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        x := at % page.width
        y := at / page.width
        loaded[at] = old_pixels[(y * OLD_HEIGHT / page.height) * OLD_WIDTH + x * OLD_WIDTH / page.width]
    }
}

// Where the story starts after the metadata line, or -1 when that line is
// damaged or the record is too short to hold its story and pixels.
PictureStoryAt :: (saved: string) -> s64 {
    header := PICTURE_HEADER.count
    if saved.count < header + 4 { return -1 }
    end := ifx saved[header + 2] == PICTURE_TALL then header + 3 else header + 2
    if saved[end] != cast(u8)10 || saved.count <= end + 1 + cast(s64)PICTURE_STORY { return -1 }
    return end + 1
}

// The page a whole record holds; check the record first.
PicturePage :: (saved: string) -> PaintPage {
    return ifx PictureStoryAt(saved) == cast(s64)PICTURE_HEADER.count + 4 then TALL_PAGE else WIDE_PAGE
}

// Where the record's flattened runs start; -1 when damaged.
PicturePixelsAt :: (saved: string) -> s64 {
    story := PictureStoryAt(saved)
    return ifx story < 0 then -1 else story + cast(s64)PICTURE_STORY
}

// The scene, crayon and story lines after a header; false when damaged.
StoryValid :: (saved: string, header: s64) -> bool {
    lines := PictureStoryAt(saved)
    if lines < 0 { return false }
    chosen := ifx saved[header] == #char "-" then -1 else PaintIndex(saved[header])
    color := PaintIndex(saved[header + 1])
    if (chosen < 0 && saved[header] != #char "-") || chosen > BLANK_SCENE || color < 0 || color >= PAINT_COLORS - 16 { return false }
    for row: cast(s32)0..STORY_LINES - 1 {
        start := lines + cast(s64)(row * (STORY_COLUMNS + 1))
        for column: cast(s32)0..STORY_COLUMNS - 1 {
            byte := saved[start + cast(s64)column]
            if byte < 32 || (byte >= 127 && byte < 160) { return false }
        }
        if saved[start + cast(s64)STORY_COLUMNS] != cast(u8)10 { return false }
    }
    return true
}

StoryLoad :: (saved: string, header: s64) {
    scene = ifx saved[header] == #char "-" then -1 else PaintSceneFromCode(PaintIndex(saved[header]))
    crayon = PaintIndex(saved[header + 1])
    canvas_page = PicturePage(saved)
    lines := PictureStoryAt(saved)
    ClearStory()
    for row: cast(s32)0..STORY_LINES - 1 {
        start := lines + cast(s64)(row * (STORY_COLUMNS + 1))
        last: s32 = STORY_COLUMNS - 1
        while last >= 0 && saved[start + cast(s64)last] == #char " " { last -= 1 }
        for column: cast(s32)0..last { story[row][column] = saved[start + cast(s64)column] }
    }
}

// Version 1: pixels as letters, then a mask that marks exactly the INK.
OldPixelsValid :: (saved: string, pixels: s64) -> bool {
    mask := pixels + cast(s64)OLD_PIXELS + 1
    if saved.count != mask + cast(s64)OLD_PIXELS + 1 { return false }
    for at: cast(s32)0..OLD_PIXELS - 1 {
        byte := saved[mask + cast(s64)at]
        if byte != #char "0" && byte != #char "1" { return false }
        index := PaintIndex(saved[pixels + cast(s64)at])
        if index < 0 || index == BLACK_PAINT || (byte == #char "1" && index != INK) { return false }
        // Black outside the mask was paint; it stays paint.
        old_pixels[at] = cast(u8)(ifx index == INK && byte == #char "0" then BLACK_PAINT else index)
    }
    return saved[mask - 1] == cast(u8)10 && saved[saved.count - 1] == cast(u8)10
}

PictureLoad :: (saved: string) -> bool {
    // Early versions stored only sixteen-color pixels. Import them without
    // adding another scene's lines or changing any of their colors.
    if saved.count == cast(s64)OLD_PIXELS {
        for at: cast(s32)0..OLD_PIXELS - 1 {
            byte := saved[at]
            if byte < #char "a" || byte > #char "p" { return false }
            old_pixels[at] = byte - #char "a"
        }
        Enlarge()
        CanvasLayersClear()
        canvas_page = WIDE_PAGE
        scene = 0
        crayon = 14
        ClearStory()
        for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = loaded[at] }
        return true
    }
    header := PICTURE_HEADER.count
    if saved.count > DOCUMENT_LIMIT || !StoryValid(saved, header) { return false }
    pixels := PicturePixelsAt(saved)
    if saved[:header] == LAYER_HEADER {
        if !PictureValid(saved) { return false }
        unused LayerRecord(saved, true)
        StoryLoad(saved, header)
        return true
    }
    if saved[:header] == OLD_HEADER {
        if PicturePage(saved).width != WIDE_PAGE.width || !OldPixelsValid(saved, pixels) { return false }
        Enlarge()
    } else {
        if saved[:header] != PICTURE_HEADER { return false }
        used := PictureRunsRead(saved[pixels:], loaded[:])
        if used < 0 || pixels + used + 1 != saved.count || saved[saved.count - 1] != cast(u8)10 { return false }
    }
    CanvasLayersClear()
    CanvasPencilClear()
    StoryLoad(saved, header)
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = loaded[at] }
    return true
}

// Whether saved is a whole current picture record, checked run by run
// without reading its pixels.
PictureValid :: (saved: string) -> bool {
    header := PICTURE_HEADER.count
    if saved.count > DOCUMENT_LIMIT || !StoryValid(saved, header) { return false }
    pixels := PicturePixelsAt(saved)
    if saved[:header] == LAYER_HEADER { return LayerRecord(saved, false) }
    if saved[:header] != PICTURE_HEADER { return false }
    nothing: []u8
    used := PictureRunsScan(saved[pixels:], nothing, CANVAS_PIXELS)
    return used >= 0 && pixels + used + 1 == saved.count && saved[saved.count - 1] == cast(u8)10
}

// Version 3 starts with the same flattened runs for previews/export, then
// the independent background and ordered objects. Objects are raster layers:
// no file paths, external assets or stencil IDs are trusted on load. Bounds,
// count, total pixels, palette and all delimiters are checked before commit.
LayerRecord :: (saved: string, load: bool) -> bool {
    at := PicturePixelsAt(saved)
    if at < 0 { return false }
    page := PicturePage(saved)
    nothing: []u8
    used := PictureRunsScan(saved[at:], nothing, CANVAS_PIXELS)
    if used < 0 { return false }
    at += used
    if at >= saved.count || saved[at] != cast(u8)10 { return false }
    at += 1
    base_start := at
    used = PictureRunsScan(saved[at:], nothing, CANVAS_PIXELS)
    if used < 0 { return false }
    at += used
    if at >= saved.count || saved[at] != cast(u8)10 { return false }
    at += 1
    count := HistoryNumber(saved, *at, cast(u8)10, LAYER_LIMIT)
    if count < 0 { return false }
    if load {
        CanvasLayersClear()
        CanvasPencilClear()
        canvas_page = page
        unused PictureRunsRead(saved[base_start:], base[:])
        for pixel: cast(s32)0..CANVAS_PIXELS - 1 { canvas[pixel] = base[pixel]; owner[pixel] = 0 }
    }
    total: s64 = 0
    starts: [LAYER_LIMIT]s64
    ends: [LAYER_LIMIT]s64
    for index: cast(s32)0..cast(s32)count - 1 {
        x := HistoryNumber(saved, *at, #char " ", page.width - 1)
        y := HistoryNumber(saved, *at, #char " ", page.height - 1)
        w := HistoryNumber(saved, *at, #char " ", page.width)
        h := HistoryNumber(saved, *at, #char " ", page.height)
        start := HistoryNumber(saved, *at, cast(u8)10, LAYER_PIXELS - 1)
        if x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > page.width || y + h > page.height { return false }
        if start < 0 || start % CANVAS_PIXELS + w * h > CANVAS_PIXELS { return false }
        for earlier: cast(s32)0..index - 1 {
            if start < ends[earlier] && start + w * h > starts[earlier] { return false }
        }
        starts[index] = start; ends[index] = start + w * h
        total += w * h
        if total > LAYER_PIXELS { return false }
        output: []u8
        if load {
            object := *layers[index]
            object.x = cast(s32)x; object.y = cast(s32)y
            object.w = cast(s32)w; object.h = cast(s32)h
            object.start = cast(s32)start
            object.pixels = layer_storage[start / CANVAS_PIXELS][start % CANVAS_PIXELS:start % CANVAS_PIXELS + w * h]
            output = object.pixels
        }
        used = PictureRunsScan(saved[at:], output, w * h, true)
        if used < 0 { return false }
        at += used
        if at >= saved.count || saved[at] != cast(u8)10 { return false }
        at += 1
        if load {
            layer_order[index] = index
            layer_count += 1
            layer_pixels += cast(s32)(w * h)
            CanvasOverlay(index, cast(s32)x, cast(s32)y, cast(s32)(x + w), cast(s32)(y + h))
        }
    }
    if !VectorRecord(saved, *at, load, cast(s32)count) { return false }
    if !PencilRecord(saved, *at, load, count == 0, page) { return false }
    return at == saved.count
}

// The picture's outlines, bottom to top, for host/paint_view.zi.
CanvasVectorOps :: () -> Text {
    text: Vec(u8)
    // A wide page is the default, so wide pictures keep their old operations.
    if PageIsTall(canvas_page) { BuilderPrint(*text, "D % %\n", canvas_page.width, canvas_page.height) }
    if scene >= 0 && scene < SCENE_COUNT { BuilderPrint(*text, "S %\n", scene) }
    for at: cast(s32)0..layer_count - 1 {
        object := *layers[layer_order[at]]
        if object.art > 0 {
            m := object.matrix
            BuilderPrint(*text, "O % % % % % % %\n", object.art - 1, PaintVectorUnits(m.a), PaintVectorUnits(m.b),
                PaintVectorUnits(m.c), PaintVectorUnits(m.d), PaintVectorUnits(m.e), PaintVectorUnits(m.f))
        } else {
            BuilderPrint(*text, "X % % % % ", object.x, object.y, object.w, object.h)
            PictureRunsAppend(*text, object.pixels)
            unused VecPush(text, cast(u8)10)
        }
    }
    for at: cast(s32)0..pencil_stroke_count - 1 {
        stroke := *pencil_strokes[at]
        BuilderPrint(*text, "P %", stroke.width * 16 / PENCIL_SCALE)
        for point: cast(s32)0..stroke.count - 1 {
            value := pencil_points[stroke.first + point]
            BuilderPrint(*text, " % %", value.x * 16 / PENCIL_SCALE, value.y * 16 / PENCIL_SCALE)
        }
        unused VecPush(text, cast(u8)10)
    }
    return BuilderFinish(text)
}

// Each object's vector outline, in saved order. Pictures from before vector
// outlines have no record; their objects keep their page pixels as lines.
VectorRecord :: (saved: string, at: *s64, load: bool, count: s32) -> bool {
    header := VECTOR_HEADER.count
    if at.* + header > saved.count || saved[at.*:at.* + header] != VECTOR_HEADER { return true }
    at.* += header
    for index: cast(s32)0..count - 1 {
        art := HistoryNumber(saved, at, #char " ", DINO_COUNT)
        if art < 0 { return false }
        values: [6]float32
        for field: cast(s32)0..5 {
            if !VectorNumber(saved, at, ifx field == 5 then cast(u8)10 else #char " ", *values[field]) { return false }
        }
        if load {
            object := *layers[index]
            object.art = cast(s32)art
            object.matrix = PaintMatrix.{values[0], values[1], values[2], values[3], values[4], values[5]}
        }
    }
    return true
}

// One signed matrix number, saved in 1/65536 units.
VectorNumber :: (text: string, at: *s64, end: u8, out: *float32) -> bool {
    negative := at.* < text.count && text[at.*] == #char "-"
    if negative { at.* += 1 }
    value: s64 = 0
    start := at.*
    while at.* < text.count && text[at.*] >= #char "0" && text[at.*] <= #char "9" {
        if at.* - start >= 13 { return false }
        value = value * 10 + cast(s64)(text[at.*] - #char "0")
        at.* += 1
    }
    if at.* == start || at.* >= text.count || text[at.*] != end { return false }
    at.* += 1
    out.* = cast(float32)(cast(float64)(ifx negative then -value else value) / 65536.0)
    return true
}

PencilRecord :: (saved: string, at: *s64, load: bool, required: bool, page: PaintPage) -> bool {
    if at.* == saved.count { return !required }
    header := PENCIL_HEADER.count
    if at.* + header > saved.count || saved[at.*:at.* + header] != PENCIL_HEADER { return false }
    at.* += header
    stroke_count := HistoryNumber(saved, at, cast(u8)10, PENCIL_STROKE_LIMIT)
    if stroke_count <= 0 { return false }
    if load { CanvasPencilClear() }
    used_points: s64 = 0
    for stroke_at: cast(s32)0..cast(s32)stroke_count - 1 {
        width := HistoryNumber(saved, at, #char " ", PENCIL_WIDTH_UNITS)
        count := HistoryNumber(saved, at, cast(u8)10, PENCIL_POINT_LIMIT)
        used_points += count
        if width <= 0 || width % PENCIL_SCALE != 0 || width / PENCIL_SCALE < 1 || width / PENCIL_SCALE > 16 ||
            count <= 0 || used_points > PENCIL_POINT_LIMIT { return false }
        stroke := PencilStroke.{pencil_point_count, cast(s32)count, cast(s32)width}
        for point_at: cast(s32)0..cast(s32)count - 1 {
            x := HistoryNumber(saved, at, #char " ", page.width * PENCIL_SCALE - 1)
            y := HistoryNumber(saved, at, cast(u8)10, page.height * PENCIL_SCALE - 1)
            if x < 0 || y < 0 { return false }
            if load { pencil_points[pencil_point_count] = PencilPoint.{cast(s32)x, cast(s32)y}; pencil_point_count += 1 }
        }
        if load { pencil_strokes[pencil_stroke_count] = stroke; pencil_stroke_count += 1 }
    }
    if load { CanvasPencilRenderAll() }
    return true
}

// The working picture's undo history: up to eight earlier states, kept in
// its own document beside the working picture. It names the exact working
// picture it belongs to by length and FNV-1a hash, so a history never
// reaches another picture, a slot or an older working picture. Then come
// the steps, oldest first, each its byte count and a whole picture record
// from PictureText; Undo restores the newest. Picture state added to
// PictureText, PictureValid and PictureLoad, such as object layers, is kept
// in every step as well. Steps stay in their text form, so keeping and
// checking them fits within one frame's steps.
HISTORY_HEADER :: "JUNGLE UNDO 1\n"
HISTORY_STEPS :: 8
// The most any app document may hold.
DOCUMENT_LIMIT :: 16777216

history_records: [HISTORY_STEPS]string;
history_count: s32;
history_next: s32;
// Whether the history differs from the document last written or read.
history_changed: bool = true;
history_bound: u64;
history_bound_count: s64 = -1;

HistoryClear :: () {
    for at: cast(s32)0..HISTORY_STEPS - 1 { history_records[at] = "" }
    history_count = 0
    history_next = 0
    history_changed = true
}

// Keeps the current picture as the newest step, dropping the oldest of
// eight.
HistoryPush :: () {
    record := PictureText()
    bytes := record.count + 256
    for step: cast(s32)0..history_count - 1 { bytes += history_records[(history_next - 1 - step + HISTORY_STEPS) % HISTORY_STEPS].count + 16 }
    while history_count > 0 && bytes > DOCUMENT_LIMIT {
        oldest := (history_next - history_count + HISTORY_STEPS) % HISTORY_STEPS
        bytes -= history_records[oldest].count + 16
        history_records[oldest] = ""
        history_count -= 1
    }
    history_records[history_next] = record
    history_next = (history_next + 1) % HISTORY_STEPS
    if history_count < HISTORY_STEPS { history_count += 1 }
    history_changed = true
}

// Returns the picture to its newest step, keeping the chosen crayon; false
// when none is left.
HistoryUndo :: () -> bool {
    if history_count == 0 { return false }
    at := (history_next + HISTORY_STEPS - 1) % HISTORY_STEPS
    chosen := crayon
    if !PictureLoad(history_records[at]) { return false }
    crayon = chosen
    history_records[at] = ""
    history_next = at
    history_count -= 1
    history_changed = true
    return true
}

PictureHash :: (text: string) -> u64 {
    hash: u64 = cast(u64)14695981039346656037
    for at: cast(s64)0..text.count - 1 { hash = (hash ^ cast(u64)text[at]) * cast(u64)1099511628211 }
    return hash
}

HexDigits :: (value: u64, digits: []u8) -> string {
    for at: cast(s32)0..15 {
        digits[15 - at] = PAINT_CODES[cast(s64)((value >> cast(u64)(at * 4)) & cast(u64)15)]
    }
    return TextView(digits[:16])
}

// A copy of text to keep past the next DocumentRead, whose reply a compiled
// browser host stores in the space it reuses for that read; "" when there is
// no room for it.
OwnedText :: (text: string) -> string {
    bytes: Vec(u8)
    if !BuilderAppend(bytes, text) { return "" }
    return BuilderFinish(bytes)
}

// Whether working is the picture the history was last written or read for.
HistoryBoundTo :: (working: string) -> bool {
    return !history_changed && history_bound_count == working.count && history_bound == PictureHash(working)
}

HistoryAppend :: (text: *Vec(u8), working: string) {
    digits: [16]u8
    BuilderPrint(text, "%", HISTORY_HEADER)
    BuilderPrint(text, "% %\n%\n", working.count, HexDigits(PictureHash(working), digits[:]), history_count)
    for step: cast(s32)0..history_count - 1 {
        record := history_records[(history_next - history_count + step + HISTORY_STEPS) % HISTORY_STEPS]
        BuilderPrint(text, "%\n%", record.count, record)
    }
}

HistoryText :: (working: string) -> Text {
    text: Vec(u8)
    HistoryAppend(*text, working)
    return BuilderFinish(text)
}

// Records that the history document now holds this history for working.
HistorySaved :: (working: string) {
    history_bound = PictureHash(working)
    history_bound_count = working.count
    history_changed = false
}

// A decimal number at text[at.*] up to limit, without leading zeros and
// followed by end; -1 when damaged.
HistoryNumber :: (text: string, at: *s64, end: u8, limit: s64) -> s64 {
    value: s64 = 0
    start := at.*
    while at.* < text.count && text[at.*] >= #char "0" && text[at.*] <= #char "9" {
        if at.* - start >= 9 { return -1 }
        value = value * 10 + cast(s64)(text[at.*] - #char "0")
        at.* += 1
    }
    digits := at.* - start
    if digits == 0 || (digits > 1 && text[start] == #char "0") || value > limit { return -1 }
    if at.* >= text.count || text[at.*] != end { return -1 }
    at.* += 1
    return value
}

// Replaces the history with saved when it is whole and belongs to exactly
// this working picture. Otherwise leaves the history as it was and returns
// false. The current picture is never changed.
HistoryLoad :: (saved: string, working: string) -> bool {
    header := HISTORY_HEADER.count
    if saved.count > DOCUMENT_LIMIT || saved.count < header || saved[:header] != HISTORY_HEADER { return false }
    at: s64 = header
    if HistoryNumber(saved, *at, #char " ", DOCUMENT_LIMIT) != working.count { return false }
    digits: [16]u8
    if at + 17 > saved.count || saved[at:at + 16] != HexDigits(PictureHash(working), digits[:]) ||
        saved[at + 16] != cast(u8)10 { return false }
    at += 17
    count := HistoryNumber(saved, *at, cast(u8)10, HISTORY_STEPS)
    if count < 0 { return false }
    // Check every step before keeping any of them.
    starts: [HISTORY_STEPS]s64
    ends: [HISTORY_STEPS]s64
    for step: cast(s32)0..cast(s32)count - 1 {
        size := HistoryNumber(saved, *at, cast(u8)10, DOCUMENT_LIMIT)
        if size <= 0 || at + size > saved.count || !PictureValid(saved[at:at + size]) { return false }
        starts[step] = at
        ends[step] = at + size
        at += size
    }
    if at != saved.count { return false }
    kept := OwnedText(saved)
    if kept.count != saved.count { return false }
    HistoryClear()
    for step: cast(s32)0..cast(s32)count - 1 { history_records[step] = kept[starts[step]:ends[step]] }
    history_count = cast(s32)count
    history_next = history_count % HISTORY_STEPS
    HistorySaved(working)
    return true
}

// UI restore checks one earlier record per frame. Only the fully checked
// history becomes visible; damaged records never expose partial Undo steps.
history_loading: bool;
history_pending: string;
history_pending_at: s64;
history_pending_count: s32;
history_pending_step: s32;
history_pending_hash: u64;
history_pending_size: s64;
history_pending_records: [HISTORY_STEPS]string;

HistoryLoadBegin :: (saved: string, working: string) {
    history_loading = false
    history_pending = ""
    header := HISTORY_HEADER.count
    if saved.count > DOCUMENT_LIMIT || saved.count < header || saved[:header] != HISTORY_HEADER { return }
    at: s64 = header
    if HistoryNumber(saved, *at, #char " ", DOCUMENT_LIMIT) != working.count { return }
    digits: [16]u8
    hash := PictureHash(working)
    if at + 17 > saved.count || saved[at:at + 16] != HexDigits(hash, digits[:]) || saved[at + 16] != cast(u8)10 { return }
    at += 17
    count := HistoryNumber(saved, *at, cast(u8)10, HISTORY_STEPS)
    if count < 0 { return }
    // Its records stay slices of this text after the frame's reply is gone.
    history_pending = OwnedText(saved)
    if history_pending.count != saved.count { history_pending = ""; return }
    history_pending_at = at
    history_pending_count = cast(s32)count
    history_pending_step = 0
    history_pending_hash = hash
    history_pending_size = working.count
    history_loading = true
}

HistoryLoadStep :: () {
    if !history_loading { return }
    if history_pending_step < history_pending_count {
        size := HistoryNumber(history_pending, *history_pending_at, cast(u8)10, DOCUMENT_LIMIT)
        if size <= 0 || history_pending_at + size > history_pending.count {
            history_loading = false; history_pending = ""; return
        }
        if !PictureValid(history_pending[history_pending_at:history_pending_at + size]) { history_loading = false; history_pending = ""; return }
        history_pending_records[history_pending_step] = history_pending[history_pending_at:history_pending_at + size]
        history_pending_at += size
        history_pending_step += 1
        return
    }
    if history_pending_at == history_pending.count {
        HistoryClear()
        for step: cast(s32)0..history_pending_count - 1 { history_records[step] = history_pending_records[step] }
        history_count = history_pending_count
        history_next = history_count % HISTORY_STEPS
        history_bound = history_pending_hash
        history_bound_count = history_pending_size
        history_changed = false
    }
    for step: cast(s32)0..HISTORY_STEPS - 1 { history_pending_records[step] = "" }
    history_loading = false
    history_pending = ""
}

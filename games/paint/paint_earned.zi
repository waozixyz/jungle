// Which stencils and scenes the child can choose. Defaults always show; a
// collectible shows once earned, and a toucan stencil once the toucan
// brought it. Only the pickers ask: a saved picture opens whatever the
// collection holds.
#import, file "paint_catalog.zi";
#import, file "../../retro/collection_cache.zi";
#import, file "../../host/jungle_treasure.zi";

PAINT_ITEM_STENCIL :: 0
PAINT_ITEM_SCENE :: 1

PaintItemCollectible :: (kind: s32, index: s32) -> s32 {
    if kind == PAINT_ITEM_STENCIL { return PaintStencilCollectible(index) }
    if kind == PAINT_ITEM_SCENE { return PaintSceneCollectible(index) }
    return -1
}

// The toucan's reward index that unlocks this item, or -1.
PaintItemReward :: (kind: s32, index: s32) -> s32 {
    if kind != PAINT_ITEM_STENCIL { return -1 }
    slug := PaintStencilToucan(index)
    return ifx slug == "" then -1 else ToucanRewardBySlug(slug)
}

// True only for a collectible in the collected set or a stencil the toucan
// brought, so it also means "starred".
PaintItemEarned :: (kind: s32, index: s32) -> bool {
    id := PaintItemCollectible(kind, index)
    if id >= 0 { return CollectionCacheHas(id) }
    reward := PaintItemReward(kind, index)
    return reward >= 0 && TreasureCacheHas(reward)
}

PaintItemShown :: (kind: s32, index: s32) -> bool {
    if PaintItemCollectible(kind, index) < 0 && PaintItemReward(kind, index) < 0 { return true }
    return PaintItemEarned(kind, index)
}

PaintItemAt :: (kind: s32, category: s32, offset: s32) -> s32 {
    return ifx kind == PAINT_ITEM_STENCIL then PaintStencilAt(category, offset) else PaintSceneAt(category, offset)
}

// The category's chosen-from size, then its item at that position (or -1).
PaintShownCount :: (kind: s32, category: s32) -> s32 {
    shown: s32 = 0
    at: s32 = 0
    index := PaintItemAt(kind, category, at)
    while index >= 0 {
        if PaintItemShown(kind, index) { shown += 1 }
        at += 1
        index = PaintItemAt(kind, category, at)
    }
    return shown
}

PaintShownAt :: (kind: s32, category: s32, offset: s32) -> s32 {
    if offset < 0 { return -1 }
    left := offset
    at: s32 = 0
    index := PaintItemAt(kind, category, at)
    while index >= 0 {
        if PaintItemShown(kind, index) {
            if left == 0 { return index }
            left -= 1
        }
        at += 1
        index = PaintItemAt(kind, category, at)
    }
    return -1
}

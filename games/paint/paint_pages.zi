SCENE_PARTS :: 3
DINO_PARTS :: 3

DINO_WIDTH: [12]s32 = .[240,240,240,240,209,240,126,240,240,240,240,240];
DINO_HEIGHT: [12]s32 = .[125,144,87,140,184,83,184,68,71,63,109,168];

SceneLines :: (scene: s32, part: s32) -> string {
    if scene == 0 && part == 0 { return SCENE_0_0 }
    if scene == 0 && part == 1 { return SCENE_0_1 }
    if scene == 0 && part == 2 { return SCENE_0_2 }
    if scene == 1 && part == 0 { return SCENE_1_0 }
    if scene == 1 && part == 1 { return SCENE_1_1 }
    if scene == 1 && part == 2 { return SCENE_1_2 }
    if scene == 2 && part == 0 { return SCENE_2_0 }
    if scene == 2 && part == 1 { return SCENE_2_1 }
    if scene == 2 && part == 2 { return SCENE_2_2 }
    if scene == 3 && part == 0 { return SCENE_3_0 }
    if scene == 3 && part == 1 { return SCENE_3_1 }
    if scene == 3 && part == 2 { return SCENE_3_2 }
    if scene == 4 && part == 0 { return SCENE_4_0 }
    if scene == 4 && part == 1 { return SCENE_4_1 }
    if scene == 4 && part == 2 { return SCENE_4_2 }
    if scene == 5 && part == 0 { return SCENE_5_0 }
    if scene == 5 && part == 1 { return SCENE_5_1 }
    if scene == 5 && part == 2 { return SCENE_5_2 }
    return ""
}

DinoLines :: (dino: s32, part: s32) -> string {
    if dino == 0 && part == 0 { return DINO_0_0 }
    if dino == 0 && part == 1 { return DINO_0_1 }
    if dino == 0 && part == 2 { return DINO_0_2 }
    if dino == 1 && part == 0 { return DINO_1_0 }
    if dino == 1 && part == 1 { return DINO_1_1 }
    if dino == 1 && part == 2 { return DINO_1_2 }
    if dino == 2 && part == 0 { return DINO_2_0 }
    if dino == 2 && part == 1 { return DINO_2_1 }
    if dino == 3 && part == 0 { return DINO_3_0 }
    if dino == 3 && part == 1 { return DINO_3_1 }
    if dino == 3 && part == 2 { return DINO_3_2 }
    if dino == 4 && part == 0 { return DINO_4_0 }
    if dino == 4 && part == 1 { return DINO_4_1 }
    if dino == 4 && part == 2 { return DINO_4_2 }
    if dino == 5 && part == 0 { return DINO_5_0 }
    if dino == 5 && part == 1 { return DINO_5_1 }
    if dino == 6 && part == 0 { return DINO_6_0 }
    if dino == 6 && part == 1 { return DINO_6_1 }
    if dino == 7 && part == 0 { return DINO_7_0 }
    if dino == 7 && part == 1 { return DINO_7_1 }
    if dino == 8 && part == 0 { return DINO_8_0 }

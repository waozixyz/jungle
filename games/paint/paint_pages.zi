SceneLines :: (index: s32, part: s32) -> string {
    if index == 0 && part == 0 { return SCENE_0_0 }
    if index == 0 && part == 1 { return SCENE_0_1 }
    if index == 0 && part == 2 { return SCENE_0_2 }
    if index == 1 && part == 0 { return SCENE_1_0 }
    if index == 1 && part == 1 { return SCENE_1_1 }
    if index == 1 && part == 2 { return SCENE_1_2 }
    if index == 2 && part == 0 { return SCENE_2_0 }
    if index == 2 && part == 1 { return SCENE_2_1 }
    if index == 2 && part == 2 { return SCENE_2_2 }
    if index == 3 && part == 0 { return SCENE_3_0 }
    if index == 3 && part == 1 { return SCENE_3_1 }
    if index == 3 && part == 2 { return SCENE_3_2 }
    if index == 4 && part == 0 { return SCENE_4_0 }
    if index == 4 && part == 1 { return SCENE_4_1 }
    if index == 4 && part == 2 { return SCENE_4_2 }
    if index == 5 && part == 0 { return SCENE_5_0 }
    if index == 5 && part == 1 { return SCENE_5_1 }
    if index == 5 && part == 2 { return SCENE_5_2 }
    return ""
}


PageLines :: (page: s32, part: s32) -> string {
    if page == 0 && part == 0 { return PAGE_LINES_0_0 }
    if page == 0 && part == 1 { return PAGE_LINES_0_1 }
    if page == 0 && part == 2 { return PAGE_LINES_0_2 }
    if page == 1 && part == 0 { return PAGE_LINES_1_0 }
    if page == 1 && part == 1 { return PAGE_LINES_1_1 }
    if page == 1 && part == 2 { return PAGE_LINES_1_2 }
    if page == 2 && part == 0 { return PAGE_LINES_2_0 }
    if page == 2 && part == 1 { return PAGE_LINES_2_1 }
    if page == 2 && part == 2 { return PAGE_LINES_2_2 }
    if page == 3 && part == 0 { return PAGE_LINES_3_0 }
    if page == 3 && part == 1 { return PAGE_LINES_3_1 }
    if page == 3 && part == 2 { return PAGE_LINES_3_2 }
    if page == 4 && part == 0 { return PAGE_LINES_4_0 }
    if page == 4 && part == 1 { return PAGE_LINES_4_1 }
    if page == 4 && part == 2 { return PAGE_LINES_4_2 }
    if page == 5 && part == 0 { return PAGE_LINES_5_0 }
    if page == 5 && part == 1 { return PAGE_LINES_5_1 }
    if page == 5 && part == 2 { return PAGE_LINES_5_2 }
    return ""
}

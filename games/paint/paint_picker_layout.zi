#import, file "paint_palette.zi";

// Pixel-sized scene controls live inside the scaled book's paper, not its frame.
ScenePickerLayout :: struct {
    width: s32; height: s32; padding: s32; top: s32; gap: s32
    columns: s32; rows: s32; tab_columns: s32
    tab_y: s32; tab_width: s32; grid_y: s32
    card_width: s32; card_height: s32; footer_y: s32; footer_width: s32
}

ScenePickerBounds :: (width: s32, height: s32, categories: s32 = 3) -> ScenePickerLayout {
    fit := width * 1000 / 320
    tall := height * 1000 / 200
    if tall < fit { fit = tall }
    if fit < 1000 { fit = 1000 }
    l: ScenePickerLayout
    l.width = width; l.height = height
    l.gap = ifx height < 440 then 6 else 10
    l.padding = 14 * fit / 1000 + 12
    l.top = 12 * fit / 1000 + 12
    // Wide desktop windows keep a readable, centered six-card library.
    if width - l.padding * 2 > 1040 { l.padding = (width - 1040) / 2 }
    usable := width - l.padding * 2
    l.columns = ifx usable < 600 then 2 else 3
    l.rows = 6 / l.columns
    l.tab_columns = ifx categories > 3 && usable < 560 then 2 else categories
    l.tab_y = l.top + 30 + l.gap
    l.tab_width = (usable - l.gap * (l.tab_columns - 1)) / l.tab_columns
    tab_rows := (categories + l.tab_columns - 1) / l.tab_columns
    l.grid_y = l.tab_y + tab_rows * (44 + l.gap) - l.gap
    l.footer_y = height - l.top - 44
    l.footer_width = (usable - l.gap * 2) / 3
    l.card_width = (usable - l.gap * (l.columns - 1)) / l.columns
    l.card_height = (l.footer_y - l.gap - l.grid_y - l.gap * (l.rows - 1)) / l.rows
    if l.card_height > 220 { l.card_height = 220 }
    return l
}

// The stencil gallery fits as many readable tiles as the paper holds, so its
// page is a category-relative item anchor rather than a fixed six-slot page.
StencilPickerLayout :: struct {
    width: s32; height: s32; padding: s32; top: s32; gap: s32
    columns: s32; rows: s32; capacity: s32; tab_columns: s32
    tab_y: s32; tab_width: s32; grid_y: s32; grid_height: s32
    card_width: s32; card_height: s32; content_height: s32; scroll: bool
    footer_y: s32; footer_width: s32
}

STENCIL_CARD_WIDTH :: 150
// Narrower than this, a tile cannot hold its longest one-word label at the
// minimum label size, so very narrow paper shows one column instead.
STENCIL_CARD_NARROW :: 120
STENCIL_LABEL_FONT :: 18
STENCIL_LABEL_MINIMUM :: 12
STENCIL_CARD_HEIGHT :: 120
STENCIL_CARD_SHORT :: 80
STENCIL_COLUMNS_MAX :: 8
STENCIL_ROWS_MAX :: 4

StencilPickerBounds :: (width: s32, height: s32, categories: s32 = 4) -> StencilPickerLayout {
    fit := width * 1000 / 320
    tall := height * 1000 / 200
    if tall < fit { fit = tall }
    if fit < 1000 { fit = 1000 }
    l: StencilPickerLayout
    l.width = width; l.height = height
    l.gap = ifx height < 440 then 6 else 10
    l.padding = 14 * fit / 1000 + 12
    l.top = 12 * fit / 1000 + 12
    usable := width - l.padding * 2
    l.tab_columns = ifx usable >= 560 then categories else 2
    tab_rows := (categories + l.tab_columns - 1) / l.tab_columns
    l.tab_y = l.top + 30 + l.gap
    l.tab_width = (usable - l.gap * (l.tab_columns - 1)) / l.tab_columns
    l.grid_y = l.tab_y + tab_rows * (44 + l.gap)
    l.footer_y = height - l.top - 44
    l.footer_width = (usable - l.gap * 2) / 3
    if l.footer_width > 240 { l.footer_width = 240 }
    l.grid_height = l.footer_y - l.gap - l.grid_y
    l.columns = (usable + l.gap) / (STENCIL_CARD_WIDTH + l.gap)
    if l.columns < 2 { l.columns = 2 }
    if (usable - l.gap) / 2 < STENCIL_CARD_NARROW { l.columns = 1 }
    if l.columns > STENCIL_COLUMNS_MAX { l.columns = STENCIL_COLUMNS_MAX }
    l.card_width = (usable - l.gap * (l.columns - 1)) / l.columns
    // Prefer roomy tiles; two shorter rows beat one, and below that the
    // single row scrolls inside the grid rather than shrinking its tiles.
    l.rows = (l.grid_height + l.gap) / (STENCIL_CARD_HEIGHT + l.gap)
    if l.rows < 2 { l.rows = (l.grid_height + l.gap) / (STENCIL_CARD_SHORT + l.gap) }
    if l.rows < 1 { l.rows = 1 }
    if l.rows > STENCIL_ROWS_MAX { l.rows = STENCIL_ROWS_MAX }
    l.capacity = l.columns * l.rows
    l.card_height = (l.grid_height - l.gap * (l.rows - 1)) / l.rows
    if l.card_height < STENCIL_CARD_SHORT { l.card_height = STENCIL_CARD_SHORT }
    l.content_height = l.rows * (l.card_height + l.gap) - l.gap
    l.scroll = l.content_height > l.grid_height
    return l
}

// A label measured at the full label size scales down to fit its width,
// never below the readable minimum; past that it wraps instead.
StencilLabelFont :: (measured: s32, available: s32) -> s32 {
    if measured <= available || measured < 1 { return STENCIL_LABEL_FONT }
    font := STENCIL_LABEL_FONT * available / measured
    return ifx font < STENCIL_LABEL_MINIMUM then STENCIL_LABEL_MINIMUM else font
}

// The visible page holds the anchored item at any capacity, so resizing or
// reopening keeps the chosen stencil in view.
StencilPageFirst :: (anchor: s32, capacity: s32, count: s32) -> s32 {
    if capacity < 1 || count < 1 || anchor < 0 { return 0 }
    at := ifx anchor < count then anchor else count - 1
    return at / capacity * capacity
}

StencilPageCount :: (capacity: s32, count: s32) -> s32 {
    if capacity < 1 || count < 1 { return 1 }
    return (count + capacity - 1) / capacity
}

StencilPageNext :: (anchor: s32, capacity: s32, count: s32) -> s32 {
    next := StencilPageFirst(anchor, capacity, count) + capacity
    return ifx next < count then next else anchor
}

StencilPagePrevious :: (anchor: s32, capacity: s32, count: s32) -> s32 {
    first := StencilPageFirst(anchor, capacity, count)
    return ifx first >= capacity then first - capacity else anchor
}

// Version 1 stored a six-slot page; version 2 stores the item anchor. Both
// keep the same eight digits, so stencils, sizes and scenes load unchanged.
PAINT_CHOICES_V1 :: "JUNGLE PAINT CHOICES 1\n"
PAINT_CHOICES_V2 :: "JUNGLE PAINT CHOICES 2\n"
// Version 3 adds a high digit for stencil choices beyond the first 63.
PAINT_CHOICES_V3 :: "JUNGLE PAINT CHOICES 3\n"
PAINT_CHOICES_DIGITS :: 8

PaintChoicesVersion :: (saved: string) -> s32 {
    if saved.count == PAINT_CHOICES_V3.count + PAINT_CHOICES_DIGITS + 1 &&
        saved[:PAINT_CHOICES_V3.count] == PAINT_CHOICES_V3 { return 3 }
    if saved.count != PAINT_CHOICES_V2.count + PAINT_CHOICES_DIGITS { return 0 }
    header := saved[:PAINT_CHOICES_V2.count]
    if header == PAINT_CHOICES_V2 { return 2 }
    if header == PAINT_CHOICES_V1 { return 1 }
    return 0
}

PaintChoicesStencil :: (saved: string) -> s32 {
    version := PaintChoicesVersion(saved)
    if version == 0 { return -1 }
    value := PaintIndex(saved[PAINT_CHOICES_V2.count])
    if value < 0 { return -1 }
    if version == 3 {
        high := PaintIndex(saved[PAINT_CHOICES_V3.count + PAINT_CHOICES_DIGITS])
        if high <= 0 { return -1 }
        value += high * 64
    }
    return value
}

// The saved stencil anchor for a category of count items, or -1 if invalid.
PaintChoicesAnchor :: (version: s32, value: s32, count: s32) -> s32 {
    if value < 0 || count < 1 { return -1 }
    if version == 1 { return ifx value < (count + 5) / 6 then value * 6 else -1 }
    if version == 2 || version == 3 { return ifx value < count then value else -1 }
    return -1
}

// The coloring screen: the picture and its tools. Where the tools fit beside
// or below the picture they stay in view; where they would take more than a
// third of the screen, the picture keeps that room and the tools open from a
// drawer behind one Tools button, beside which the chosen tool and crayon show.
PaintMainLayout :: struct {
    width: s32; height: s32; pad: s32; gap: s32
    canvas_x: s32; canvas_y: s32; canvas_w: s32; canvas_h: s32
    // The tools: in view, or inside the drawer when compact.
    tools: s32; columns: s32; tools_x: s32; tools_y: s32; tool_w: s32; tool_h: s32
    compact: bool
    // Compact only: the bar along the bottom (portrait) or the left edge,
    // its Tools button and status, and the drawer it opens.
    side: bool
    bar_x: s32; bar_y: s32; bar_w: s32; bar_h: s32
    toggle_x: s32; toggle_y: s32; toggle_w: s32; toggle_h: s32
    status_x: s32; status_y: s32; status_w: s32; status_h: s32
    drawer_x: s32; drawer_y: s32; drawer_w: s32; drawer_h: s32
}

PaintRect :: struct { x: s32; y: s32; w: s32; h: s32; }

// A child's finger needs at least this many pixels on a tool or bar button.
PAINT_TOUCH_MINIMUM :: 48

PaintClamp :: (value: s32, low: s32, high: s32) -> s32 {
    if value > high { value = high }
    if value < low { value = low }
    return value
}

// The largest page-shaped rectangle inside a room, centered in it.
PaintFitCanvas :: (l: *PaintMainLayout, x: s32, y: s32, w: s32, h: s32, page_w: s32, page_h: s32) {
    l.canvas_w = w
    l.canvas_h = w * page_h / page_w
    if l.canvas_h > h { l.canvas_h = h; l.canvas_w = h * page_w / page_h }
    if l.canvas_w < 1 { l.canvas_w = 1 }
    if l.canvas_h < 1 { l.canvas_h = 1 }
    l.canvas_x = x + (w - l.canvas_w) / 2
    l.canvas_y = y + (h - l.canvas_h) / 2
}

PaintMainBounds :: (width: s32, height: s32, page_w: s32, page_h: s32, tools: s32) -> PaintMainLayout {
    l: PaintMainLayout
    l.width = width; l.height = height; l.tools = tools
    shortest := ifx width < height then width else height
    l.pad = PaintClamp(shortest / 40, 6, 20)
    l.gap = PaintClamp(shortest / 80, 4, 10)
    pad := l.pad; gap := l.gap
    l.side = width >= height
    if !l.side {
        // Three columns of tools below the picture.
        l.columns = 3
        l.tool_w = (width - pad * 2 - gap * 2) / 3
        l.tool_h = PaintClamp(l.tool_w * 3 / 4, PAINT_TOUCH_MINIMUM, 110)
        rows := (tools + 2) / 3
        panel := rows * l.tool_h + (rows - 1) * gap
        if (panel + pad) * 3 <= height {
            PaintFitCanvas(*l, pad, pad, width - pad * 2, height - pad * 3 - panel, page_w, page_h)
            l.tools_x = pad
            l.tools_y = l.canvas_y + l.canvas_h + pad + (height - pad - (l.canvas_y + l.canvas_h + pad) - panel) / 2
            return l
        }
    } else {
        // A short landscape phone needs two columns to keep taps generous.
        l.columns = ifx height < 560 then 2 else 1
        rows := (tools + l.columns - 1) / l.columns
        l.tool_h = (height - pad * 2 - gap * (rows - 1)) / rows
        l.tool_w = PaintClamp(l.tool_h * 5 / 2, 64, width / (ifx l.columns == 2 then 8 else 5))
        rail := l.tool_w * l.columns + gap * (l.columns - 1)
        if l.tool_h >= PAINT_TOUCH_MINIMUM && (rail + pad) * 3 <= width {
            PaintFitCanvas(*l, 0, pad, width - pad * 3 - rail, height - pad * 2, page_w, page_h)
            left := (width - rail - pad - l.canvas_w) / 2
            l.canvas_x = left + rail + pad
            l.tools_x = left
            l.tools_y = l.canvas_y + (l.canvas_h - l.tool_h * rows - gap * (rows - 1)) / 2
            if l.tools_y < pad { l.tools_y = pad }
            return l
        }
    }
    l.compact = true
    bar := PaintClamp(shortest / 5, 64, 96)
    if l.side {
        l.bar_x = pad; l.bar_y = pad; l.bar_w = bar; l.bar_h = height - pad * 2
        l.toggle_x = l.bar_x; l.toggle_y = l.bar_y; l.toggle_w = bar; l.toggle_h = bar
        l.status_x = l.bar_x; l.status_y = l.bar_y + bar + gap; l.status_w = bar; l.status_h = bar
        PaintFitCanvas(*l, pad * 2 + bar, pad, width - pad * 3 - bar, height - pad * 2, page_w, page_h)
        // The drawer opens beside the bar, three tools across.
        l.columns = 3
        l.drawer_x = pad * 2 + bar; l.drawer_y = pad; l.drawer_h = height - pad * 2
        rows := (tools + 2) / 3
        l.tool_h = PaintClamp((l.drawer_h - pad * 2 - gap * (rows - 1)) / rows, 1, 110)
        l.tool_w = PaintClamp(l.tool_h * 2, 1, (width - l.drawer_x - pad * 3 - gap * 2) / 3)
        l.drawer_w = l.tool_w * 3 + gap * 2 + pad * 2
    } else {
        l.bar_x = pad; l.bar_y = height - pad - bar; l.bar_w = width - pad * 2; l.bar_h = bar
        l.toggle_w = PaintClamp(bar * 2, bar, l.bar_w / 2)
        l.toggle_x = l.bar_x; l.toggle_y = l.bar_y; l.toggle_h = bar
        l.status_w = bar * 2; l.status_x = l.bar_x + l.bar_w - l.status_w; l.status_y = l.bar_y; l.status_h = bar
        PaintFitCanvas(*l, pad, pad, width - pad * 2, l.bar_y - pad * 2, page_w, page_h)
        // The drawer rises from the bar, three tools across.
        l.columns = 3
        rows := (tools + 2) / 3
        l.drawer_x = 0; l.drawer_w = width
        l.tool_w = (width - pad * 2 - gap * 2) / 3
        l.tool_h = PaintClamp(l.tool_w * 3 / 4, PAINT_TOUCH_MINIMUM + 8, 110)
        l.drawer_h = rows * l.tool_h + (rows - 1) * gap + pad * 2
        l.drawer_y = l.bar_y - pad - l.drawer_h
        if l.drawer_y < 0 { l.drawer_y = 0 }
    }
    l.tools_x = l.drawer_x + pad
    l.tools_y = l.drawer_y + pad
    return l
}

// Where tool index sits, in view or inside the drawer.
PaintToolRect :: (l: PaintMainLayout, index: s32) -> PaintRect {
    return PaintRect.{l.tools_x + (index % l.columns) * (l.tool_w + l.gap),
        l.tools_y + (index / l.columns) * (l.tool_h + l.gap), l.tool_w, l.tool_h}
}

PaintRectHolds :: (r: PaintRect, x: s32, y: s32) -> bool {
    return x >= r.x && y >= r.y && x < r.x + r.w && y < r.y + r.h
}

// A new picture takes the page that shows largest on this screen, so a
// phone held upright colors a tall page.
PaintPageTall :: (width: s32, height: s32, tools: s32) -> bool {
    wide := PaintMainBounds(width, height, 960, 720, tools)
    tall := PaintMainBounds(width, height, 720, 960, tools)
    return cast(s64)tall.canvas_w * tall.canvas_h > cast(s64)wide.canvas_w * wide.canvas_h
}

// A Dino Colors picture's size and its text form, shared by the game and the
// apps that show, export and print it. The text is runs of one crayon: the
// crayon's letter from PAINT_CODES, then how many pixels in a row have it.
// Numbers are digits of five bits, lowest first, in the same 64 letters; a
// digit of 32 or more says another digit follows.
#import "std/text_buffer"
#import "std/vec"
#import, file "paint_palette.zi";

// A picture's page is wide (960 by 720) or tall (720 by 960). Both hold the
// same pixels, so every buffer fits either page.
PaintPage :: struct { width: s32; height: s32; }
WIDE_PAGE :: PaintPage.{960, 720}
TALL_PAGE :: PaintPage.{720, 960}
CANVAS_PIXELS :: 960 * 720
// Pictures painted before the vector artwork were a quarter as wide and tall.
OLD_WIDTH :: 240
OLD_HEIGHT :: 180
OLD_PIXELS :: OLD_WIDTH * OLD_HEIGHT
PICTURE_RUNS :: "paint runs\n"
PICTURE_TALL_RUNS :: "paint runs tall\n"

PageIsTall :: (page: PaintPage) -> bool { return page.height > page.width }

RunDigit :: (byte: u8) -> s32 {
    if byte >= #char "0" && byte <= #char "9" { return cast(s32)(byte - #char "0") }
    if byte >= #char "a" && byte <= #char "z" { return cast(s32)(byte - #char "a") + 10 }
    if byte >= #char "A" && byte <= #char "Z" { return cast(s32)(byte - #char "A") + 36 }
    if byte == #char "-" { return 62 }
    if byte == #char "_" { return 63 }
    return -1
}

RunNumberAppend :: (text: *Vec(u8), value: s64) {
    while value >= 32 {
        unused VecPush(text.*, PAINT_CODES[32 + (value & 31)])
        value = value >> 5
    }
    unused VecPush(text.*, PAINT_CODES[value])
}

PictureRunsAppend :: (text: *Vec(u8), pixels: []u8) {
    at: s64 = 0
    while at < pixels.count {
        color := pixels[at]
        end := at + 1
        while end < pixels.count && pixels[end] == color { end += 1 }
        unused VecPush(text.*, ifx color == cast(u8)255 then #char "~" else PAINT_CODES[color])
        RunNumberAppend(text, end - at)
        at = end
    }
}

// Fills every pixel from the runs at the start of text. Returns how many
// bytes the runs took, or -1 when they are damaged or do not fill exactly.
PictureRunsRead :: (text: string, pixels: []u8) -> s64 {
    return PictureRunsScan(text, pixels, pixels.count)
}

// Like PictureRunsRead for total pixels, but writes them only when pixels
// holds them, so checking a picture costs one step per run, not per pixel.
PictureRunsScan :: (text: string, pixels: []u8, total: s64, transparent: bool = false) -> s64 {
    at: s64 = 0
    filled: s64 = 0
    while filled < total {
        if at >= text.count { return -1 }
        color := ifx transparent && text[at] == #char "~" then 255 else PaintIndex(text[at])
        if color < 0 { return -1 }
        at += 1
        length: s64 = 0
        shift: s64 = 0
        while true {
            if at >= text.count || shift > 30 { return -1 }
            digit := RunDigit(text[at])
            if digit < 0 { return -1 }
            at += 1
            length = length | (cast(s64)(digit & 31) << shift)
            shift += 5
            if digit < 32 { break }
        }
        if length <= 0 || filled + length > total { return -1 }
        if pixels.count == total {
            for offset: cast(s64)0..length - 1 { pixels[filled + offset] = cast(u8)color }
        }
        filled += length
    }
    return at
}

// A picture as the game hands it to its app: PICTURE_RUNS for a wide page or
// PICTURE_TALL_RUNS for a tall one, then the runs.
PictureRunsHeader :: (page: PaintPage) -> string {
    return ifx PageIsTall(page) then PICTURE_TALL_RUNS else PICTURE_RUNS
}

PictureRunsText :: (pixels: []u8, page: PaintPage = WIDE_PAGE) -> Text {
    text: Vec(u8)
    BuilderPrint(*text, "%", PictureRunsHeader(page))
    PictureRunsAppend(*text, pixels)
    return BuilderFinish(text)
}

// Reads a picture from the game and its page; returns the bytes it used, or -1.
PictureFromGame :: (request: string, pixels: []u8, page: *PaintPage) -> s64 {
    header := PICTURE_RUNS.count
    page.* = WIDE_PAGE
    if request.count >= PICTURE_TALL_RUNS.count && request[:PICTURE_TALL_RUNS.count] == PICTURE_TALL_RUNS {
        header = PICTURE_TALL_RUNS.count
        page.* = TALL_PAGE
    } else if request.count < header || request[:header] != PICTURE_RUNS { return -1 }
    used := PictureRunsRead(request[header:], pixels)
    if used < 0 { return -1 }
    return header + used
}

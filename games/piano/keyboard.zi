// One fixed chromatic C3-C6 keyboard, independent of the selected song.
PIANO_LOW :: 48
PIANO_HIGH :: 84
PIANO_KEYS :: 37
PIANO_WHITE_KEYS :: 22
PIANO_BLACK_KEYS :: 15
PIANO_SHORTCUTS :: 21
piano_shortcuts: [21]s32 = .[49,50,51,52,53,54,55,56,65,87,83,69,68,70,84,71,89,72,85,74,75];
PianoShortcutCode :: (at: s32) -> s32 { return piano_shortcuts[at] }
piano_white: [22]s32 = .[48,50,52,53,55,57,59,60,62,64,65,67,69,71,72,74,76,77,79,81,83,84];
piano_black: [15]s32 = .[49,51,54,56,58,61,63,66,68,70,73,75,78,80,82];
piano_black_after: [15]s32 = .[0,1,3,4,5,7,8,10,11,12,14,15,17,18,19];

PianoWhiteIndex :: (pitch: s32) -> s32 {
    for at: cast(s32)0..PIANO_WHITE_KEYS - 1 { if piano_white[at] == pitch { return at } }
    return -1
}

PianoKeyboardPitch :: (key: s32) -> s32 {
    // Computer shortcuts always address the same middle C4-C5 octave.
    keys: [13]s32 = .[65,87,83,69,68,70,84,71,89,72,85,74,75]
    middle: [8]s32 = .[60,62,64,65,67,69,71,72]
    if key >= 49 && key <= 56 { return middle[key - 49] }
    if key >= 97 && key <= 122 { key -= 32 }
    for at: cast(s32)0..12 { if keys[at] == key { return 60 + at } }
    return -1
}

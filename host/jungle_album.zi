#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "kryon/drawing_props"
#import "kryon/tree_input"
#import "kryon/image_props"
#import "kryon/image_widget"
#import, file "../retro/retro.zi";
#import, file "../retro/language.zi";
#import, file "../retro/collectibles.zi";
// Host-owned album: visiting it never unloads or reinitializes the active game.
#import, file "jungle_collection.zi";
#import, file "jungle_awards.zi";
#import, file "jungle_text.zi";
#import, file "../retro/book_theme.zi";
AlbumIcon :: #import "mingcute/mingcute_regular_book_2";

collection_book_open: bool;
album_selected: s32 = -1;
album_page: s32;
album_images: [COLLECTIBLE_COUNT]string;
album_outlines: [COLLECTIBLE_COUNT]string;

AlbumOutlinePath :: (index: s32) -> string {
    scene := collectible_paint_kinds[index] == COLLECTIBLE_PAINT_SCENE
    return Cat("assets/dino-paint/art/", ifx scene then "scene" else "dino",
        NumberText(collectible_paint_arts[index]), ifx scene then "-thumb.avif" else "-preview.avif")
}

AlbumPicturePath :: (index: s32) -> string {
    if !collectible_color_ready[index] { return AlbumOutlinePath(index) }
    return collectible_colors[index]
}

CollectionBookOpen :: () {
    collection_book_open = true
    album_selected = -1
    album_page = 0
}

CollectionBookBack :: () {
    if album_selected >= 0 { album_selected = -1 }
    else { collection_book_open = false }
}

CollectionBookButton :: (x: s32, y: s32, compact: bool = false) -> bool {
    width := cast(s32)(ifx compact then 26 else 44)
    height := cast(s32)(ifx compact then 22 else 44)
    icon_size := cast(s32)(ifx compact then 16 else 30)
    icon_x_offset := cast(s32)(ifx compact then 5 else 7)
    icon_y_offset := cast(s32)(ifx compact then 3 else 7)
    button := RetroTap(9010, x, y, width, height, Tr("Collection Book"))
    BookBox(x, y, width, height, ifx button.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0xdacdb5ff, 4.0)
    SvgIcon(retro.session, SvgIconProps.{.bounds = RetroRect(x + icon_x_offset, y + icon_y_offset, icon_size, icon_size),
        .shape = AlbumIcon.Shape, .color = ColorFromPacked(0x2e6956ff)})
    if !compact && TreeHoveredAt(retro.session, button.node) {
        BookBox(x - 70, y + 48, 140, 28, 0xf3ecdcff, 0x2e6956ff, 4.0)
        BookText(x - 68, y + 50, 136, 24, "Collection Book", 14)
    }
    return button.clicked
}

// The book's pages hold the awards first, then the collected pictures: album
// index I below AWARD_COUNT is award I, after that collectible I - AWARD_COUNT.
ALBUM_COUNT :: AWARD_COUNT + COLLECTIBLE_COUNT
// A faint stand-in for what is still to find.
ALBUM_MISSING_TINT :: 0xd4cfc560

AlbumPicture :: (index: s32, x: s32, y: s32, width: s32, height: s32) {
    if index < AWARD_COUNT {
        Image(retro.session, ImageProps.{.asset_path = RetroImageShown(award_pictures[index]),
            .bounds = RetroRect(x, y, width, height), .fit = ImageFit.ImageFitContain, .smooth = true})
        return
    }
    item := index - AWARD_COUNT
    path := ifx album_images[item] != "" then album_images[item] else AlbumPicturePath(item)
    BookPicture(path, x, y, width, height)
}

AlbumHas :: (collection: Collection, index: s32) -> bool {
    if index < AWARD_COUNT { return awards_earned.earned[index] }
    return CollectionHas(collection, collectible_slugs[index - AWARD_COUNT])
}

AlbumMissing :: (index: s32) -> string {
    if index < AWARD_COUNT { return award_pictures[index] }
    item := index - AWARD_COUNT
    return ifx album_outlines[item] != "" then album_outlines[item] else AlbumOutlinePath(item)
}

// Award cells answer taps 9200 + I, collected pictures 9100 + their own index.
AlbumTapId :: (index: s32) -> s32 {
    return ifx index < AWARD_COUNT then 9200 + index else 9100 + index - AWARD_COUNT
}

AlbumContent :: (collection: Collection, width: s32, height: s32) {
    BookBox(0, 56, width, height - 56, 0xfffcf3ff)
    if album_selected >= 0 {
        AlbumPicture(album_selected, 16, 72, width - 32, height - 88)
        return
    }
    columns := width / 150
    if columns < 2 { columns = 2 }
    if columns > 5 { columns = 5 }
    rows := (height - 188) / 130
    if rows < 1 { rows = 1 }
    capacity := columns * rows
    pages := (ALBUM_COUNT + capacity - 1) / capacity
    if album_page >= pages { album_page = pages - 1 }
    cell_width := (width - 24) / columns
    cell_height := (height - 180) / rows
    if cell_height > 190 { cell_height = 190 }
    for slot: cast(s32)0..capacity - 1 {
        index := album_page * capacity + slot
        if index >= ALBUM_COUNT { break }
        x := 12 + slot % columns * cell_width
        y := 130 + slot / columns * cell_height
        has := AlbumHas(collection, index)
        BookBox(x, y, cell_width - 8, cell_height - 8, ifx has then cast(u32)0xf3ecdcff else cast(u32)0xf4f2ebff, 0xdacdb5ff, 8.0)
        if has {
            press := RetroTap(AlbumTapId(index), x, y, cell_width - 8, cell_height - 8, Tr("Collected picture"))
            AlbumPicture(index, x + 8, y + 8, cell_width - 24, cell_height - 24)
            if press.clicked { album_selected = index }
        } else {
            Image(retro.session, ImageProps.{.asset_path = RetroImageShown(AlbumMissing(index)),
                .bounds = RetroRect(x + 8, y + 8, cell_width - 24, cell_height - 24),
                .fit = ImageFit.ImageFitContain, .smooth = true, .tint = ALBUM_MISSING_TINT})
        }
    }
    if album_page > 0 {
        previous := RetroTap(9050, 12, height - 48, 96, 44, Tr("Previous"))
        BookBox(12, height - 48, 96, 44, 0xf3ecdcff, 0xdacdb5ff, 4.0)
        BookText(12, height - 48, 96, 44, "Previous", 16)
        if previous.clicked { album_page -= 1 }
    }
    BookText(width / 2 - 40, height - 48, 80, 44, Cat(NumberText(album_page + 1), " / ", NumberText(pages)), 16)
    if album_page + 1 < pages {
        next := RetroTap(9051, width - 108, height - 48, 96, 44, Tr("Next"))
        BookBox(width - 108, height - 48, 96, 44, 0xf3ecdcff, 0xdacdb5ff, 4.0)
        BookText(width - 108, height - 48, 96, 44, "Next", 16)
        if next.clicked { album_page += 1 }
    }
}

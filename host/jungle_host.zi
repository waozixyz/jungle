#if #defined(ANDROID_BUILD) {
    PianoAndroid :: #import "kryon/raylib_runtime";
} else {
    piano_sdl :: #system_library "SDL2";
    PianoSdlKeys :: (count: *s32) -> *u8 #foreign piano_sdl "SDL_GetKeyboardState";
    PianoSdlScan :: (key: s32) -> s32 #foreign piano_sdl "SDL_GetScancodeFromKey";
    PianoSdlFocus :: () -> *void #foreign piano_sdl "SDL_GetKeyboardFocus";
}
piano_host_held: [PIANO_SHORTCUTS + 1]u8;

// Only the active app's focused host supplies piano shortcuts.
PianoHeldKeys :: () -> string {
    #if #defined(ANDROID_BUILD) {
        focused := PianoAndroid.RaylibFocused()
        for at: cast(s32)0..PIANO_SHORTCUTS - 1 {
            piano_host_held[at] = ifx focused && PianoAndroid.RaylibKeyDown(PianoShortcutCode(at)) then cast(u8)49 else cast(u8)48
        }
    } else {
        count: s32
        state := PianoSdlKeys(*count)
        focused := PianoSdlFocus() != null
        for at: cast(s32)0..PIANO_SHORTCUTS - 1 {
            code := PianoShortcutCode(at)
            if code >= 65 && code <= 90 { code += 32 }
            scan := PianoSdlScan(code)
            piano_host_held[at] = ifx focused && state != null && scan >= 0 && scan < count && state[scan] != cast(u8)0 then cast(u8)49 else cast(u8)48
        }
    }
    piano_host_held[PIANO_SHORTCUTS] = 0
    return TextUntilNul(piano_host_held[:])
}

GAME_LIMIT :: 16
FONT :: "assets/jungle/font.png"
// Canvas pictures kept on disk: a page chooser shows six at once.
CANVAS_KEEP :: 24

games: [GAME_LIMIT]MenuGame;
game_count: s32;
chosen: s32;
playing: bool;
game: BundleApp;
data_root: string;
sound_setting: string;
speech_profile_setting: string;
language_setting: string;
home_requested: bool;
guide_sound_setting: string;
guide_seen_setting: string;
// The title bar's back arrow reaches the game as Escape on the next frame,
// so each game steps back itself and leaves from its first screen.
title_back_pending: bool;
title_speed_pending: bool;
game_secondary_down: bool;
// Input for the Coloring Book's zoom. Fingers come from the platform's frame.
game_wheel: float32;
paint_touch_count: s32;
paint_touches: [2]Vector2;
paint_density: float32 = 1.0;
paint_ink_counts: [2]s32;
PAINT_INK_KEEP :: 4
book_assets_installed: bool;
// assets/shared-assets.txt from tools/shared_assets.py: read-only folders
// installed once beside the app, and game pictures whose identical bytes are
// installed under another name.
SHARED_LIMIT :: 16
ALIAS_LIMIT :: 1024
shared_folders: [SHARED_LIMIT]string;
shared_count: s32;
alias_paths: [ALIAS_LIMIT]string;
alias_targets: [ALIAS_LIMIT]string;
alias_count: s32;
message: string;
service_reply: [64]u8;
canvas_count: s32;
canvas_pixels: [CANVAS_PIXELS]u8;

ToggleSound :: () {
    SoundMuted(!sound_muted)
    unused WriteEntireFile(sound_setting, ifx sound_muted then "off\n" else "quiet\n")
}

// games/catalog.txt: one game a line, "FILE|TITLE|ABOUT|ICON|AGE".
LoadCatalog :: () -> bool {
    text, found := ShippedRead("games/catalog.txt")
    if !found { return false }
    at: s64 = 0
    while at < text.count && game_count < GAME_LIMIT {
        end := at
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        line := text[at:end]
        at = end + 1
        fields: [5]string
        field: s32 = 0
        start: s64 = 0
        for index: cast(s64)0..line.count {
            if (index == line.count || line[index] == #char "|") && field < 5 {
                fields[field] = Cat(line[start:index])
                field += 1
                start = index + 1
            }
        }
        age_at: s64 = 0
        age := ReadWhole(fields[4], *age_at)
        if field == 5 && fields[0] != "" && age >= 0 && age_at == fields[4].count {
            game := MenuGame.{.bundle_name = fields[0], .title = fields[1], .about = fields[2],
                .icon = fields[3], .age = age}
            // Keep stable game identities; the shared menu orders them by age.
            games[game_count] = game
            game_count += 1
        }
    }
    return game_count > 0
}

AssetPathValid :: (path: string) -> bool {
    return path.count > 7 && path[:7] == "assets/" && AppFileNameValid(path)
}

SHARED_HEADER :: "#jungle-shared-assets-1"

// One "KIND|PATH|TARGET" line each after the exact format header. A later
// format changes the header together with the hosts that read it. An alias
// names an installed file directly, never another alias.
LoadSharedAssets :: () -> bool {
    shared_count = 0
    alias_count = 0
    text, found := ShippedRead("assets/shared-assets.txt")
    if !found { return false }
    defer { ShippedFree(text) }
    at: s64 = 0
    header := true
    while at < text.count {
        end := at
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        line := text[at:end]
        at = end + 1
        if header {
            if line != SHARED_HEADER { return false }
            header = false
            continue
        }
        fields: [3]string
        field: s32 = 0
        start: s64 = 0
        for index: cast(s64)0..line.count {
            if index == line.count || line[index] == #char "|" {
                if field < 3 { fields[field] = line[start:index] }
                field += 1
                start = index + 1
            }
        }
        if field != 3 { return false }
        path := fields[1]
        if fields[0] == "shared" {
            if fields[2] != "" || shared_count >= SHARED_LIMIT || path.count < 9 || path[path.count - 1] != #char "/" ||
                !AssetPathValid(path[:path.count - 1]) { return false }
            shared_folders[shared_count] = Cat(path)
            shared_count += 1
        } else if fields[0] == "alias" {
            if alias_count >= ALIAS_LIMIT || !AssetPathValid(path) || !AssetPathValid(fields[2]) || path == fields[2] ||
                SharedAlias(path) != "" { return false }
            alias_paths[alias_count] = Cat(path)
            alias_targets[alias_count] = Cat(fields[2])
            alias_count += 1
        } else { return false }
    }
    if header || shared_count == 0 { return false }
    for index: cast(s32)0..alias_count - 1 {
        if SharedAlias(alias_targets[index]) != "" { return false }
    }
    return true
}

// The installed file a game path names instead, or "".
SharedAlias :: (path: string) -> string {
    for index: cast(s32)0..alias_count - 1 {
        if alias_paths[index] == path { return alias_targets[index] }
    }
    return ""
}

SharedAsset :: (path: string) -> bool {
    if !AppFileNameValid(path) { return false }
    for index: cast(s32)0..shared_count - 1 {
        folder := shared_folders[index]
        if path.count > folder.count && path[:folder.count] == folder { return true }
    }
    return false
}

Reply :: (text: string) -> HostValue {
    count := ifx text.count < 63 then text.count else 63
    for at: cast(s64)0..count - 1 { service_reply[at] = text[at] }
    service_reply[count] = 0
    return AppLocalText(TextUntilNul(service_reply[:]))
}

// The collected stencils, loaded once from <data>/collection.txt by JungleOpen. Games reach it
// through the jungle.collect and jungle.collection services; the title screen and album use
// HostCollect and this value directly.
jungle_collection: Collection;
collection_setting: string;

// Collects SLUG: 1 the first time, 0 when it was already collected, -1 for an unknown slug.
HostCollect :: (slug: string) -> s32 {
    reply := HostCollectionService("jungle.collect", slug)
    return ifx reply == "new" then 1 else ifx reply == "had" then 0 else -1
}

HostCollectionService :: (service: string, request: string) -> string {
    reply, changed := CollectionService(*jungle_collection, service, request)
    // Written whole beside the old file, then renamed over it. A failed write keeps the item in
    // memory; the next new item writes them all.
    if changed && collection_setting != "" {
        next := Cat(collection_setting, ".new")
        saved := WriteEntireFile(next, CollectionText(jungle_collection)) && RenamePath(next, collection_setting)
        if !saved { unused RemoveFile(next) }
    }
    return reply
}

// <data>/awards.txt, written whole beside the old file and renamed over it,
// as the collection is. An unreadable or invalid file is never written over.
awards_setting: string;

HostAwardsSave :: () {
    if awards_setting == "" || !awards_earned.valid { return }
    next := Cat(awards_setting, ".new")
    saved := WriteEntireFile(next, AwardsText(awards_earned)) && RenamePath(next, awards_setting)
    if !saved { unused RemoveFile(next) }
}

// The first opening of game INDEX unlocks it: its award, a chime and the
// celebration over the game's first moments.
HostAwardUnlock :: (index: s32) {
    award := AwardForBundle(games[index].bundle_name)
    if !AwardGrant(*awards_earned, award) { return }
    HostAwardsSave()
    AwardShowBegin(*award_show, award)
    SoundPlay(ifx SoundSamples(TITLE_PAPER_CHIME) != "" then TITLE_PAPER_CHIME else "assets/jungle/sounds/select.wav")
}

GameAllows :: (context: *void, name: string) -> bool {
    return name == "jungle.voice-frames" || name == "jungle.speech-profile" || name == "jungle.collect" || name == "jungle.collection" || name == "jungle.book-start" || name == "jungle.language" || name == "jungle.voice" || name == "jungle.voice-state" || name == "jungle.voice-control" || name == "jungle.sound" || name == "jungle.home" || name == "jungle.canvas" ||
        name == "jungle.paint-preview" || name == "jungle.paint-ops" || name == "jungle.paint-colors" || name == "jungle.paint-ink" || name == "jungle.paint-tile" || name == "jungle.touches" || name == "jungle.export" || name == "jungle.print" || name == "jungle.secondary" || name == "jungle.piano-held" || BundleAppAllows(context, name)
}

// A Dino Colors picture as a PNG file in the game's folder. Older pictures
// beyond CANVAS_KEEP are removed.
WriteCanvas :: (request: string, preview: bool = false) -> string {
    data: string
    if preview { data = PaintPreviewPng(request) }
    else {
        if PictureFromGame(request, canvas_pixels[:]) != request.count { return "" }
        data = PngIndexed(CANVAS_WIDTH, CANVAS_HEIGHT, paint_colors[:], canvas_pixels[:])
    }
    return WriteCanvasPng(data)
}

WriteCanvasPng :: (data: string) -> string {
    if data == "" { return "" }
    canvas_count += 1
    name := Cat("canvas-", NumberText(canvas_count), ".png")
    if !AppFileWrite(*game.local.files, name, data) { return "" }
    if canvas_count > CANVAS_KEEP {
        old := AppFilePath(*game.local.files, Cat("canvas-", NumberText(canvas_count - CANVAS_KEEP), ".png"), false)
        if old != "" { unused RemoveFile(old) }
    }
    return name
}

// Reads a vector outline from the game's bundle.
PaintViewBundleRead :: (path: string) -> string {
    return BundleReadAsset(game.app.app.bundle, path)
}

// The picture of a kind of ink; ink's two kinds keep their own recent files.
WriteInk :: (request: string, kind: s32) -> string {
    data := PaintViewInkPng(request, PaintViewBundleRead)
    if data == "" { return "" }
    prefix := ifx kind == 0 then "canvas-ink-" else "canvas-tile-"
    paint_ink_counts[kind] += 1
    name := Cat(prefix, NumberText(paint_ink_counts[kind]), ".png")
    if !AppFileWrite(*game.local.files, name, data) { return "" }
    if paint_ink_counts[kind] > PAINT_INK_KEEP {
        old := AppFilePath(*game.local.files, Cat(prefix, NumberText(paint_ink_counts[kind] - PAINT_INK_KEEP), ".png"), false)
        if old != "" { unused RemoveFile(old) }
    }
    return name
}

// "<count> <x0> <y0> <x1> <y1> <wheel> <density>" in thousandths.
PaintTouchesReply :: () -> string {
    text: Vec(u8)
    BuilderPrint(*text, "% % % % % % %", paint_touch_count,
        cast(s64)(paint_touches[0].x * 1000.0), cast(s64)(paint_touches[0].y * 1000.0),
        cast(s64)(paint_touches[1].x * 1000.0), cast(s64)(paint_touches[1].y * 1000.0),
        cast(s64)(game_wheel * 1000.0), cast(s64)(paint_density * 1000.0))
    return BuilderFinish(text)
}

GameServices :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(function) == "AppServiceHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostValueKind.HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostValueKind.HostString) {
        service := AppArgumentText(arguments[0])
        request := AppArgumentText(arguments[1])
        if service == "jungle.voice-frames" { result.* = Reply(NumberText(cast(s32)SpeechVoiceFrames(request))); return 1 }
        if service == "jungle.speech-profile" {
            if request != "" {
                SpeechProfileSet(request)
                unused WriteEntireFile(speech_profile_setting, english_speech_profile)
            }
            result.* = Reply(english_speech_profile)
            return 1
        }
        if service == "jungle.voice-state" {
            result.* = Reply(ifx sound_paused then "paused" else ifx SoundBusy() then "playing" else "idle")
            return 1
        }
        if service == "jungle.voice-control" {
            SoundSetPaused(request == "pause")
            result.* = Reply("ok")
            return 1
        }
        if service == "jungle.collect" || service == "jungle.collection" {
            result.* = Reply(HostCollectionService(service, request))
            return 1
        }
        if service == "jungle.book-start" { result.* = Reply(title_book_requested); return 1 }
        if service == "jungle.language" {
            result.* = Reply(LanguageCode())
            return 1
        }
        if service == "jungle.voice" {
            // Narration is composed from the installed speech clips; any
            // other voice is a WAV file in the game's bundle.
            if !SoundSpeech(request) { SoundVoice(ifx request == "" then "" else BundleReadAsset(game.app.app.bundle, request)) }
            result.* = Reply("played")
            return 1
        }
        if service == "jungle.sound" {
            if request == "" { SoundStop() }
            else { SoundPlayFile(BundleReadAsset(game.app.app.bundle, request), AudioEffectGain(request)) }
            result.* = Reply("played")
            return 1
        }
        if service == "jungle.home" {
            home_requested = true
            result.* = Reply("ok")
            return 1
        }
        if service == "jungle.secondary" {
            result.* = Reply(ifx game_secondary_down then "down" else "up")
            return 1
        }
        if service == "jungle.piano-held" { result.* = Reply(PianoHeldKeys()); return 1 }
        if service == "jungle.canvas" || service == "jungle.paint-preview" {
            result.* = Reply(WriteCanvas(request, service == "jungle.paint-preview"))
            return 1
        }
        if service == "jungle.paint-ops" {
            same := PaintViewOpsSame(request)
            ok := PaintViewOpsSet(request, PaintViewBundleRead)
            result.* = Reply(ifx !ok then "failed" else ifx same then "same" else "changed")
            return 1
        }
        if service == "jungle.paint-colors" {
            data := ""
            if PictureFromGame(request, canvas_pixels[:]) == request.count { data = PaintViewColorsPng(canvas_pixels[:]) }
            result.* = Reply(WriteCanvasPng(data))
            return 1
        }
        if service == "jungle.paint-ink" || service == "jungle.paint-tile" {
            result.* = Reply(WriteInk(request, ifx service == "jungle.paint-ink" then 0 else 1))
            return 1
        }
        if service == "jungle.touches" { result.* = Reply(PaintTouchesReply()); return 1 }
        if service == "jungle.export" || service == "jungle.print" {
            result.* = Reply(ExportPicture(*game.local.files, request, service == "jungle.print"))
            return 1
        }
    }
    return BundleAppServices(context, module, function, arguments, count, result)
}

// The game's own packed files, and the canvas pictures made for it.
GameAssetAllowed :: (path: string) -> bool {
    if path.count > 11 && path[:7] == "canvas-" && path[path.count - 4:] == ".png" && AppFileNameValid(path) {
        return true
    }
    // Shared read-only pictures ship once beside the app for every game.
    if SharedAsset(path) || SharedAlias(path) != "" { return true }
    return BundleAppAssetAllowed(path)
}

// Shared pictures load from the app's installed copy; others as the bundle's.
GameAssetResolve :: (path: string) -> string {
    target := SharedAlias(path)
    if target != "" { return target }
    if SharedAsset(path) { return path }
    return BundleAppAssetResolve(path)
}

// Earlier sessions' canvas pictures are gone once a game opens.
ClearCanvases :: (folder: string) {
    cursor := OpenDirectory(folder)
    names: [64][64]u8
    found: s32 = 0
    while !cursor.failed && found < 64 {
        entry := NextDirectoryEntry(*cursor)
        if !entry.valid { break }
        name := TextView(entry.name[:entry.name_count])
        if name.count > 7 && name.count < 64 && name[:7] == "canvas-" {
            for at: cast(s64)0..name.count - 1 { names[found][at] = name[at] }
            names[found][name.count] = 0
            found += 1
        }
    }
    unused CloseDirectory(*cursor)
    for index: cast(s32)0..found - 1 { unused RemoveFile(Cat(folder, "/", TextUntilNul(names[index][:]))) }
}

// The book's pictures and narration ship beside the app once and are shared
// by every game that draws them, instead of packing them into each bundle.
SharedBookAssets :: (bundle: string) -> bool {
    return bundle == "jungle-matching.zx" || bundle == "jungle-hide-seek.zx" || bundle == "jungle-book.zx" || bundle == "jungle-abc.zx" || bundle == "jungle-numbers.zx"
}

OpenGame :: (index: s32) -> bool {
    bytes, found := ShippedRead(Cat("games/", games[index].bundle_name))
    if !found { message = "THAT GAME IS MISSING."; return false }
    defer { ShippedFree(bytes) }
    if !BundleAppOpen(*game, bytes, data_root) { message = "THAT GAME COULD NOT START."; return false }
    game.app.services = GameServices
    game.app.allows = GameAllows
    book_assets_installed = SharedBookAssets(games[index].bundle_name)
    game.extracted_assets = !book_assets_installed
    ClearCanvases(game.directory)
    if !book_assets_installed && !BundleWriteAssets(game.app.app.bundle, *game.local.files) {
        BundleAppClose(*game)
        message = "THAT GAME'S PICTURES COULD NOT LOAD."
        return false
    }
    home_requested = false
    message = ""
    playing = true
    unused ApplyTitleOrientationPolicy(false)
    return true
}

CloseGame :: () {
    SoundStop()
    BundleAppClose(*game)
    playing = false
    unused ApplyTitleOrientationPolicy(true)
}

// One frame of the open game, as BundleAppFrame, with canvas pictures
// allowed beside the game's packed files.
GameFrame :: (bounds: Rectangle, pointer: PointerFrame, secondary: SecondaryPointerFrame, key: s32,
    modifiers: s32, wheel: float32, typed: string, seconds: float64, input: FrameInputSnapshot) -> bool {
    HostAlbumPaths()
    unused ApplyTitleOrientationPolicy(false)
    if !game.ready { return false }
    game_secondary_down = secondary.down
    game_wheel = wheel
    defer { BundleAppFrameAssetsClear() }
    app := *game.app
    // A hosted game's session is separate from the platform's session. Keep
    // the same frozen observations available for the complete callback,
    // including held/released keys across automatic round transitions.
    if !FrameInputBegin(app.session, input) { return false }
    defer { FrameInputEnd(app.session) }
    TreePointerUpdate(app.session, pointer)
    TreeSecondaryPointerUpdate(app.session, secondary)
    PointerWheelSend(app.session, pointer.x, pointer.y, wheel)
    BeginScrollFrame(app.session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, wheel, seconds)
    KeyboardModifiersSend(app.session, modifiers)
    if title_back_pending && key == 0 { key = KEY_ESCAPE; title_back_pending = false }
    if title_speed_pending && key == 0 { key = ABC_SPEED_KEY; title_speed_pending = false }
    if key != 0 { KeyboardSend(app.session, key) }
    app.bounds = Rectangle.{bounds.x, bounds.y + cast(float32)GAME_BAR_HEIGHT, bounds.width, bounds.height - cast(float32)GAME_BAR_HEIGHT}
    app.scale = 1.0
    app.font = 18
    app.key = key
    app.modifiers = modifiers
    app.input = TextFieldInputFor(key, modifiers, typed)
    app.area_input = TextAreaInputFor(key, modifiers, typed)
    app.area_input.now_seconds = seconds
    if BeginFrame(app.session, cast(u64)1, bounds) != FrameStatus.FrameOk { return false }
    if collection_book_open {
        unused CursorSet(app.session, .{})
        if CollectionBookFrame(app.session, bounds, key, seconds, sound_muted, jungle_collection) { ToggleSound() }
        return EndFrame(app.session) == FrameStatus.FrameOk
    }
    bundle_drawing_app = *game
    WidgetHostBegin(app.session, GameAssetAllowed, GameAssetResolve)
    ok := AppContextRun(app, APP_FRAME)
    FrameInputEnd(app.session)
    WidgetHostEnd()
    bundle_drawing_app = null
    if !ok { TreeCancel(app.session); game.failed = true; return false }
    bar := GameTitleBar(app.session, bounds, key, seconds, games[chosen].title, sound_muted)
    if bar.collection_open { CollectionBookOpen(); SoundStop() }
    if bar.back { title_back_pending = true }
    if bar.speed_toggle { title_speed_pending = true }
    if bar.sound_toggle { ToggleSound() }
    AwardShowFrame(app.session, bounds, GAME_BAR_HEIGHT, ifx bar.collection_shown then bar.collection else AwardCornerTarget(bounds),
        !bar.collection_shown, seconds)
    return EndFrame(app.session) == FrameStatus.FrameOk
}

title_guide_playing: bool;
title_guide_muted: bool;
title_guide_seen: bool;

host_album_paths_ready: bool;

HostAlbumPaths :: () {
    if host_album_paths_ready { return }
    for index: cast(s32)0..COLLECTIBLE_COUNT - 1 {
        album_images[index] = HostAlbumAsset(AlbumPicturePath(index))
        album_outlines[index] = HostAlbumAsset(AlbumOutlinePath(index))
    }
    host_album_paths_ready = true
}

HostAlbumAsset :: (path: string) -> string {
    target := SharedAlias(path)
    return ifx target != "" then target else path
}

Menu :: (session: Session, bounds: Rectangle, key: s32) {
    HostAlbumPaths()
    unused ApplyTitleOrientationPolicy(true)
    if collection_book_open {
        if CollectionBookFrame(session, bounds, key, JungleSeconds(), sound_muted, jungle_collection) { ToggleSound() }
        return
    }
    action := JungleMenu(session, bounds, key, JungleSeconds(), FONT, games[:game_count], *chosen,
        sound_muted, title_guide_muted, title_guide_seen, message, jungle_collection, TitlePaperCollect)
    if title_guide_playing && (action.guide_stop || action.language_changed ||
        (action.guide_mute_toggle && !title_guide_muted)) {
        SoundStop()
        title_guide_playing = false
    }
    if action.guide_voice != "" {
        if !SoundSpeech(action.guide_voice) {
            wave, found := ShippedRead(action.guide_voice)
            if found { SoundVoice(wave) }
            ShippedFree(wave)
        }
        title_guide_playing = true
    }
    if action.language_changed {
        unused WriteEntireFile(language_setting, LanguageCode())
        message = ""
    }
    if action.guide_mute_toggle {
        title_guide_muted = !title_guide_muted
        unused WriteEntireFile(guide_sound_setting, ifx title_guide_muted then "off\n" else "on\n")
    }
    if action.guide_finished { unused WriteEntireFile(guide_seen_setting, "yes\n") }
    if action.sound_toggle { ToggleSound() }
    if action.navigated { SoundPlay("assets/jungle/sounds/select.wav") }
    if action.collection_open { CollectionBookOpen(); SoundStop(); title_guide_playing = false }
    if action.paper_collected {
        // The book's soft chime, or the title's own gentle sound if it is not installed.
        SoundPlay(ifx SoundSamples(TITLE_PAPER_CHIME) != "" then TITLE_PAPER_CHIME else "assets/jungle/sounds/select.wav")
    }
    if action.game >= 0 { Start(action.game) }
}

// A title scene's paper: true only the first time its line art is collected.
TitlePaperCollect :: (slug: string) -> bool { return HostCollect(slug) == 1 }

Start :: (index: s32) {
    abc_title_speed = 1; title_speed_pending = false
    if playing { return }
    chosen = index
    SoundPlay("assets/jungle/sounds/start.wav")
    if OpenGame(index) { HostAwardUnlock(index) }
}

// Jungle's first version kept Jungle Math's levels in one progress file;
// they move into the game's own folder the first time it has none.
KeepMathLevels :: (base: string) {
    folder := Cat(data_root, "/jungle.math")
    target := Cat(folder, "/progress.txt")
    if PathExists(target) { return }
    old, found := ReadEntireFile(Cat(base, "/progress.txt"))
    if !found { return }
    kept: Vec(u8)
    at: s64 = 0
    while at < old.count {
        end := at
        while end < old.count && old[end] != cast(u8)10 { end += 1 }
        if end - at > 6 && old[at:at + 6] == "skill " { BuilderPrint(*kept, "%\n", old[at:end]) }
        at = end + 1
    }
    levels := BuilderFinish(kept)
    if levels == "" { return }
    unused CreatePrivateDirectory(folder)
    unused WriteEntireFile(target, levels)
}

KeepAnimalLevels :: () {
    folder := Cat(data_root, "/jungle.animals")
    target := Cat(folder, "/progress.txt")
    if PathExists(target) { return }
    old, found := ReadEntireFile(Cat(data_root, "/jungle.math/progress.txt"))
    if !found { return }
    levels := AnimalLevels(old)
    if levels == "" { return }
    if CreatePrivateDirectory(folder) { unused WriteEntireFile(target, levels) }
}

// Opens each listed game, checks its capabilities and identity, and
// closes it again; no window opens.
Check :: () -> s32 {
    failed := false
    for index: cast(s32)0..game_count - 1 {
        bytes, found := ShippedRead(Cat("games/", games[index].bundle_name))
        // Identify and validate capabilities without opening save storage.
        // Closing an unplayed game with APP_SAVE can overwrite its progress
        // with the bundle's initial values.
        checked := found && BundleAppPrepare(*game, bytes, data_root)
        if checked {
            game.app.services = GameServices
            game.app.allows = GameAllows
            Report(Cat(games[index].bundle_name, ": ", TextFromCString(*game.app.id[0]), " runs here\n"))
            BundleAppClose(*game)
        } else {
            Report(Cat(games[index].bundle_name, ": cannot run\n"))
            failed = true
        }
    }
    return ifx failed then 1 else 0
}

// Reads the catalog and the saved settings, and moves earlier saves into
// place. checking leaves the data folder as it is.
JungleOpen :: (checking: bool) -> bool {
    if !LoadCatalog() {
        Report("jungle: games/catalog.txt lists no games\n")
        return false
    }
    if !LoadSharedAssets() {
        Report("jungle: assets/shared-assets.txt is missing or invalid\n")
        return false
    }
    if !SpeechLoadShipped() {
        Report("jungle: assets/speech.txt is missing or invalid\n")
        return false
    }
    base := DataDirectory()
    if base == "" { Report("jungle: no data folder\n"); return false }
    data_root = Cat(base, "/games")
    if checking { return true }
    unused CreateDirectory(base)
    language_setting = Cat(base, "/language.txt")
    saved_language, has_language := ReadEntireFile(language_setting)
    if has_language { LanguageSet(saved_language) }
    speech_profile_setting = Cat(base, "/speech-profile.txt")
    saved_profile, has_profile := ReadEntireFile(speech_profile_setting)
    if has_profile { SpeechProfileSet(saved_profile) }
    sound_setting = Cat(base, "/sound.txt")
    setting, setting_found := ReadEntireFile(sound_setting)
    if setting_found { SoundMuted(setting == "off\n" || setting == "off") }
    guide_sound_setting = Cat(base, "/guide-sound.txt")
    guide_setting, guide_setting_found := ReadEntireFile(guide_sound_setting)
    if guide_setting_found { title_guide_muted = guide_setting == "off\n" || guide_setting == "off" }
    guide_seen_setting = Cat(base, "/guide-seen.txt")
    guide_seen, guide_seen_found := ReadEntireFile(guide_seen_setting)
    if guide_seen_found { title_guide_seen = guide_seen == "yes\n" || guide_seen == "yes" }
    // A missing file is an empty collection. An unreadable or invalid one loads as invalid, so
    // nothing is ever written over it (see CollectionService).
    collection_setting = Cat(base, "/collection.txt")
    saved_collection, collection_found := ReadEntireFile(collection_setting)
    if collection_found { jungle_collection = CollectionParse(saved_collection) }
    else if !PathExists(collection_setting) { jungle_collection = CollectionParse("") }
    awards_setting = Cat(base, "/awards.txt")
    saved_awards, awards_found := ReadEntireFile(awards_setting)
    if awards_found { awards_earned = AwardsParse(saved_awards) }
    else if !PathExists(awards_setting) { awards_earned = AwardsParse("") }
    unused CreateDirectory(data_root)
    KeepMathLevels(base)
    KeepAnimalLevels()
    // Games opened before awards existed have their folders: their awards
    // come quietly, with no celebration.
    opened: [AWARD_COUNT]bool
    for index: cast(s32)0..AWARD_COUNT - 1 { opened[index] = PathExists(Cat(data_root, "/", award_apps[index])) }
    if AwardsMigrate(*awards_earned, opened[:]) > 0 { HostAwardsSave() }
    return true
}

MenuGame :: struct {
    bundle_name: string
    title: string
    about: string
    icon: string
    age: s32
}

MenuAction :: struct {
    game: s32
    language_changed: bool
    sound_toggle: bool
    navigated: bool
    guide_voice: string
    guide_stop: bool
    guide_finished: bool
    guide_mute_toggle: bool
    collection_open: bool
    chest_open: bool
    // A scene's hidden paper was just collected: the host plays its chime.
    paper_collected: bool
    // A world-map landmark that is not open yet was tapped: the host plays
    // the gentle "not yet" cue.
    locked_cue: bool
}

// The world map's wordless way in, among every painted scene's corner
// controls; X, Y, WIDTH and HEIGHT are retro units.
TITLE_NOT_YET_CUE :: "assets/jungle/sounds/not-yet.wav"
title_map_back: bool;

TitleMapButton :: (x: s32, y: s32, width: s32, height: s32, icon: s32) -> bool {
    button := RetroTap(7601, x, y, width, height, Tr("World map"))
    BookBox(x, y, width, height, ifx button.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3d8, 0xdacdb5ff, 4.0)
    SvgIcon(retro.session, SvgIconProps.{.bounds = RetroRect(x + (width - icon) / 2, y + (height - icon) / 2, icon, icon),
        .shape = MapIcon.Shape, .color = ColorFromPacked(0x2e6956ff)})
    return button.clicked
}

// The scene shown and what glows in it; kept while a game plays, so a
// child comes back to the same room.
title_state: TitleState;
title_exploration: Exploration;
title_fog_session: Session;
title_fog_image: Texture2D;
title_fog_pixels: [TITLE_FOG_BYTES]u8;
title_fog_mask_ready: bool;
title_fog_mask_visits: u32;
title_fog_uploaded: bool;
title_fog_image_visits: u32;

// A successfully opened activity proves its painted home was visited.
// Farm has its own map area; the other games belong to their scene's area.
TitleExplorationGame :: (title: string) {
    if title == "Farm" { unused ExplorationVisit(*title_exploration, "farm"); return }
    for hotspot: cast(s32)0..TITLE_HOTSPOT_COUNT - 1 {
        if TITLE_HOTSPOT_GAME[hotspot] != title { continue }
        for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
            if TitleOnMap(scene) { continue }
            first := TITLE_SCENE_FIRST[scene]
            if hotspot >= first && hotspot < first + TITLE_SCENE_HOTSPOTS[scene] {
                unused ExplorationVisit(*title_exploration, ExplorationSceneArea(TITLE_SCENE_NAME[scene]))
                return
            }
        }
    }
}
title_papers: TitlePapers;
TITLE_PAPER_CHIME :: "assets/jungle-book/collect.wav"
title_book_requested: string;
#import, file "jungle_game_layout.zi";
ABC_SPEED_KEY :: 10001
abc_title_speed: s32 = 1;

TitleGuideAnchor :: (state: *TitleState, view: TitleView, bounds: Rectangle, unit: float32,
    width: s32, height: s32) -> TitleGuideRect {
    if state.guide_step == 1 { return TitleGuideRect.{width / 2 - 34, height / 2 - 34, 68, 68} }
    if state.guide_step == 2 { return TitleGuideRect.{width - 40, 2, 32, 30} }
    hotspot := TitleGuideHotspot(0, state.scene)
    if hotspot < 0 { return TitleGuideRect.{width / 2 - 34, height / 2 - 34, 68, 68} }
    rect := hotspot * 4
    x := (bounds.x + view.x + cast(float32)TITLE_GLOW_RECT[rect] * view.scale - bounds.x) / unit
    y := (bounds.y + view.y + cast(float32)TITLE_GLOW_RECT[rect + 1] * view.scale - bounds.y) / unit
    picture_width := cast(float32)TITLE_GLOW_RECT[rect + 2] * view.scale / unit
    picture_height := cast(float32)TITLE_GLOW_RECT[rect + 3] * view.scale / unit
    return TitleGuideRect.{cast(s32)x, cast(s32)y, cast(s32)picture_width, cast(s32)picture_height}
}

TitleBarAction :: struct {
    back: bool
    sound_toggle: bool
    speed_toggle: bool
    collection_open: bool
    // Where the Collection Book button is, when the bar shows it: an award
    // flies into it.
    collection: CollectRect
    collection_shown: bool
}

// The same floating Back as the painted title scenes, with no reserved strip.
GameSceneBack :: (session: Session, bounds: Rectangle, key: s32, now: float64) -> bool {
    retro = Retro.{.session=session,.font="assets/jungle/font.png",.glyph_height=16,
        .x=bounds.x,.y=bounds.y,.scale=1.0,.now=now,.key=key}
    BookPalette()
    back := RetroTap(9001,6,6,44,30,Tr("Back"))
    BookBox(6,6,44,30,0xf7f1e3ee,0xdacdb5ff,4.0)
    BookText(6,6,44,30,Tr("Back"),11,TextAlign.TextAlignCenter)
    return back.clicked
}

// Back on the left, the game's name, and sound on or off on the right.
GameTitleBar :: (session: Session, bounds: Rectangle, key: s32, now: float64, title: string, sound_muted: bool) -> TitleBarAction {
    retro = Retro.{.session = session, .font = "assets/jungle/font.png", .now = now, .key = key,
        .x = bounds.x, .y = bounds.y, .scale = 1.0, .glyph_height = 16}
    action: TitleBarAction
    width := cast(s32)bounds.width
    BookPalette()
    options: [0]DropdownOption
    abc := title == "ABC Book" || title == "123 Book" || title == "Picture Book"
    bar := TitleBar(session, TitleBarProps.{.key = 9001,
        .bounds = Rectangle.{bounds.x, bounds.y, bounds.width, cast(float32)GAME_BAR_HEIGHT},
        .height = GAME_BAR_HEIGHT, .title = Tr(ifx title == "Picture Book" && title_book_requested == "sweet-porridge" then "Stories" else title), .has_leading_action = true,
        .leading_label = Tr("Back"), .trailing_width = ifx collection_book_open || treasure_chest_open then 60 else ifx abc then 205 else 110}, options[:])
    if !collection_book_open && !treasure_chest_open && title != "Farm" {
        collection_x := ifx abc then width - 200 else width - 106
        action.collection_open = CollectionBookButton(collection_x, 6)
        action.collection = CollectRect.{.x = collection_x, .y = 6, .width = 44, .height = 44}
        action.collection_shown = true
    }
    action.back = bar.clicked_leading
    sound := RetroTap(9002, width - 56, 6, 44, 44, ifx sound_muted then "Sound off · F10" else "Sound on · F10")
    BookBox(width - 56, 6, 44, 44, ifx sound.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0xdacdb5ff, 4.0)
    SvgIcon(session, SvgIconProps.{.bounds = RetroRect(width - 49, 13, 30, 30),
        .shape = ifx sound_muted then SoundOffIcon.Shape else SoundOnIcon.Shape, .color = ColorFromPacked(0x3e332aff)})
    action.sound_toggle = sound.clicked
    if abc {
        speed_label := SpeedChoiceLabel(abc_title_speed)
        speed := RetroTap(9003, width - 150, 6, 88, 44, speed_label)
        BookBox(width - 150, 6, 88, 44, ifx speed.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0x2e6956ff, 4.0)
        SvgIcon(session, SvgIconProps.{.bounds = RetroRect(width - 123, 12, 32, 32),
            .shape = SpeedChoiceIcon(abc_title_speed), .color = ColorFromPacked(0x2e6956ff)})
        if TreeHoveredAt(session, speed.node) {
            BookBox(width - 214, 54, 152, 28, 0xf3ecdcff, 0x2e6956ff, 4.0)
            BookText(width - 212, 56, 148, 24, speed_label, 13)
        }
        if speed.clicked { abc_title_speed = (abc_title_speed + 1) % 3; action.speed_toggle = true }
    }
    return action
}

// Whether PATH's full picture is decoded and drawable. Asking also starts
// loading it, so scenes a child can reach next are ready when they arrive.
TitleReady :: (path: string) -> bool {
    #if #defined(PLATFORM_WEB) {
        return RetroImageShown(path) == path
    }
    #if !#defined(PLATFORM_WEB) {
        return AssetWidth(path) > 0
    }
    return false
}

TitlePicture :: (session: Session, path: string, bounds: Rectangle, tint: u32 = 0, rotation: float32 = 0.0) {
    shown := RetroImageShown(path)
    if shown == "" { return }
    preview := ifx path.count >= 5 && path[path.count - 5:] == ".avif" then RetroImagePreview(path) else ""
    if rotation == 0.0 {
        Image(session, ImageProps.{.asset_path = shown, .preview_path = preview, .bounds = bounds,
            .fit = ImageFit.ImageFitStretch, .smooth = true, .tint = tint})
        return
    }
    // Rigid four-corner mesh keeps the whole rotated cutout inside its coverage.
    // The standard Image surface owns sampling and host rendering.
    center := Vector2.{bounds.x+bounds.width*0.5,bounds.y+bounds.height*0.5}
    camera: Camera = .{.offset=center,.target=center,.rotation=rotation,.zoom=1.0}
    corners: [4]Vector2 = .[.{bounds.x,bounds.y},.{bounds.x+bounds.width,bounds.y},
        .{bounds.x,bounds.y+bounds.height},.{bounds.x+bounds.width,bounds.y+bounds.height}]
    for at: cast(s32)0..3 { corners[at] = WorldToScreen(corners[at],camera) }
    Image(session, ImageProps.{.asset_path=shown,.preview_path=preview,
        .bounds=RotatedRectangleBounds(bounds,center,rotation),
        .mesh=ImageMesh.{.columns=2,.rows=2,.points=corners[:]},.smooth=true,.tint=tint})
}

// One calm continuous cover behind the destination silhouettes. The small
// caller-owned mask changes only on a real visit; orientation just scales the
// same painting and bitmap. Kryon owns the uploaded image and its lifetime.
TitleMapFog :: (session: Session, scene: s32, picture: Rectangle) {
    if !TitleOnMap(scene) { return }
    if title_fog_session.slot!=session.slot || title_fog_session.epoch!=session.epoch {
        BitmapImageRelease(title_fog_session,title_fog_image)
        title_fog_session=session
        title_fog_image=Texture2D.{}
        title_fog_uploaded=false
    }
    visits:=TitleFogVisits(title_exploration)
    if !title_fog_mask_ready || title_fog_mask_visits!=visits {
        title_fog_mask_ready=TitleFogMask(visits,title_fog_pixels[:])
        title_fog_mask_visits=visits
    }
    if title_fog_mask_ready && (!title_fog_uploaded || title_fog_image_visits!=visits) {
        ready:=false
        if title_fog_image.id==cast(u32)0 {
            title_fog_image=BitmapImageCreate(session,TITLE_FOG_WIDTH,TITLE_FOG_HEIGHT,title_fog_pixels[:])
            ready=title_fog_image.id!=cast(u32)0
        } else {
            ready=BitmapImageUpdate(session,title_fog_image,title_fog_pixels[:])
        }
        if ready {
            title_fog_uploaded=true
            title_fog_image_visits=visits
        }
    }
    if title_fog_uploaded && title_fog_image_visits==visits {
        Image(session,ImageProps.{.key=cast(u64)7604,.texture=title_fog_image,.bounds=picture,.smooth=true})
    } else {
        // Allocation failure keeps unknown terrain covered; the next frame
        // retries the upload with the already computed mask.
        unused Box(session,BoxProps.{.bounds=picture,.fill=Color.{242,246,242,255}})
    }
}

// Alpha-tight strips keep the frame's large transparent opening out of the
// native and Canvas fill workload. All pieces share the exact scene transform.
TitleWindowFrame :: (session: Session, scene: s32, picture: Rectangle, view: TitleView) {
    portrait := TITLE_SCENE_NAME[scene] == "window-portrait"
    if !portrait && TITLE_SCENE_NAME[scene] != "window" { return }
    path := ifx portrait then "assets/jungle/title/window-animation/portrait-frame.avif" else "assets/jungle/title/window-animation/landscape-frame.avif"
    if !TitleReady(path) { return }
    rects := ifx portrait then TITLE_FRAME_PORTRAIT[:] else TITLE_FRAME_LANDSCAPE[:]
    for i: cast(s32)0..cast(s32)(rects.count / 4) - 1 {
        at := i * 4
        x := cast(float32)rects[at]
        y := cast(float32)rects[at + 1]
        w := cast(float32)rects[at + 2]
        h := cast(float32)rects[at + 3]
        Image(session, ImageProps.{.asset_path = path,
            .bounds = Rectangle.{picture.x + x * view.scale, picture.y + y * view.scale, w * view.scale, h * view.scale},
            .source = Rectangle.{x, y, w, h}, .fit = ImageFit.ImageFitStretch, .smooth = true})
    }
}

TitleWindowSkyDepth :: (session: Session, scene: s32, picture: Rectangle, view: TitleView) {
    portrait := TITLE_SCENE_NAME[scene] == "window-portrait"
    if !portrait && TITLE_SCENE_NAME[scene] != "window" { return }
    path := ifx portrait then "assets/jungle/title/window-animation/portrait-sky-occluder.avif" else "assets/jungle/title/window-animation/landscape-sky-occluder.avif"
    if !TitleReady(path) { return }
    rects := ifx portrait then TITLE_SKY_DEPTH_PORTRAIT[:] else TITLE_SKY_DEPTH_LANDSCAPE[:]
    for i: cast(s32)0..cast(s32)(rects.count / 4) - 1 {
        at := i * 4
        x := cast(float32)rects[at]
        y := cast(float32)rects[at + 1]
        w := cast(float32)rects[at + 2]
        h := cast(float32)rects[at + 3]
        Image(session, ImageProps.{.asset_path = path,
            .bounds = Rectangle.{picture.x + x * view.scale, picture.y + y * view.scale, w * view.scale, h * view.scale},
            .source = Rectangle.{x, y, w, h}, .fit = ImageFit.ImageFitStretch, .smooth = true})
    }
}

title_flee_time: [64]float64;
title_flee_x: [64]float32;
title_flee_y: [64]float32;

// Degrees the window twig sways either way about its attached end.
TITLE_TWIG_SWAY :: 0.32

TitleAnimations :: (session: Session, scene: s32, picture: Rectangle, view: TitleView, now: float64, foreground_leaves: bool = false) {
    if TITLE_SCENE_NAME[scene] == "window" && !TitleReady("assets/jungle/title/window-animation/landscape-frame.avif") { return }
    if TITLE_SCENE_NAME[scene] == "window-portrait" && !TitleReady("assets/jungle/title/window-animation/portrait-frame.avif") { return }
    clicked_animal: s32 = -1
    clicked_x: float32 = 0.0
    clicked_y: float32 = 0.0
    for index: cast(s32)0..TITLE_ANIMATION_COUNT - 1 {
        if TITLE_ANIMATION_SCENE[index] != TITLE_SCENE_NAME[scene] { continue }
        leaf := TITLE_ANIMATION_MODE[index] == 0
        if leaf != foreground_leaves { continue }
        path := TITLE_ANIMATION_PATH[index]
        if !TitleReady(path) { continue }
        at := index * 4
        timing := index * 3
        count := TITLE_ANIMATION_SHEET[at + 1]
        phase := TitleAnimationPhase(now, TITLE_ANIMATION_TIMING[timing + 1], TITLE_ANIMATION_TIMING[timing + 2])
        frame := TitleAnimationFrame(now + TITLE_ANIMATION_TIMING[timing + 2], TITLE_ANIMATION_TIMING[timing], count)
        x := TITLE_ANIMATION_RECT[at]
        y := TITLE_ANIMATION_RECT[at + 1]
        width := TITLE_ANIMATION_RECT[at + 2]
        height := TITLE_ANIMATION_RECT[at + 3]
        mode := TITLE_ANIMATION_MODE[index]
        if mode == -2 { TitleWindowSkyDepth(session, scene, picture, view); continue }
        if mode == -3 {
            // One full-size twig sways gently about its attached end, so the
            // join with the still trunk never moves or softens.
            angle := cast(float32)(TITLE_TWIG_SWAY * Sin(phase * 6.283185307))
            twig := Rectangle.{picture.x + x * view.scale, picture.y + y * view.scale,
                width * view.scale, height * view.scale}
            pivot := Vector2.{twig.x + twig.width * TITLE_ANIMATION_PIVOT[index * 2],
                twig.y + twig.height * TITLE_ANIMATION_PIVOT[index * 2 + 1]}
            center := Vector2.{twig.x + twig.width * 0.5, twig.y + twig.height * 0.5}
            turned := WorldToScreen(pivot, Camera.{.offset = center, .target = center, .rotation = angle, .zoom = 1.0})
            twig.x += pivot.x - turned.x
            twig.y += pivot.y - turned.y
            TitlePicture(session, path, twig, 0, angle)
            continue
        }
        scene_width := cast(float32)TITLE_SCENE_WIDTH[scene]
        if mode == -1 {
            // Clouds wrap only after the whole soft sprite leaves the opening.
            x = -width + cast(float32)phase * (scene_width + width * 2.0)
        }
        if mode > 0 {
            // The toucan carrying its daily gift waits in its own poses.
            gift, gift_flee, gift_x, gift_y := ToucanRewardFrame(session, index, scene, picture, view, now,
                title_flee_time[index] > 0.0 && now - title_flee_time[index] < 2.0)
            if gift_flee { clicked_animal = index; clicked_x = gift_x; clicked_y = gift_y }
            if gift { continue }
        }
        if mode > 0 {
            phase = TitleVisitPhase(now, index)
            if title_flee_time[index] > 0.0 {
                elapsed := now - title_flee_time[index]
                if elapsed < 2.0 {
                    flight := TitleFlee(elapsed, title_flee_x[index], title_flee_y[index], scene_width)
                    x = flight.x
                    y = flight.y
                    if mode == 2 { frame = TitleAnimationFrame(now, TITLE_ANIMATION_TIMING[timing], count - 2) }
                    mode = 3
                } else {
                    if phase >= 0.0 && phase <= 1.0 { continue }
                    title_flee_time[index] = 0.0
                }
            }
            if mode != 3 && (phase < 0.0 || phase > 1.0) { continue }
            if mode == 1 {
                slot := cast(s64)(now / 47.0)
                y += cast(float32)(TitleVisitRandom(slot, index, 2) - 0.5) * 160.0
            }
        }
        if mode == 1 {
            // Hidden between visits; distinct periods and offsets keep the flock loose.
            x = -width + (scene_width + width * 2.0) * cast(float32)phase
            y += cast(float32)Sin(phase * 17.0 + cast(float64)index) * height * 0.3
            if width > 60.0 {
                progress := phase / 0.3 * 0.5
                if phase > 0.3 { progress = 0.5 }
                if phase > 0.7 { progress = 0.5 + (phase - 0.7) / 0.3 * 0.5 }
                x = -width + (scene_width + width * 2.0) * cast(float32)progress
                y += cast(float32)Sin(now * 5.0) * 8.0
            }
        } else if mode == 2 {
            if phase > 0.88 { continue }
            if phase < 0.22 {
                enter := TitleAnimationEase(phase / 0.22)
                x = -width + (x + width) * enter
                y -= (1.0 - enter) * height * 0.7
            } else if phase < 0.65 {
                frame = count - 2
                if TitleAnimationPhase(now, 5.3) > 0.96 { frame = count - 1 }
            } else {
                leave := TitleAnimationEase((phase - 0.65) / 0.23)
                x += (scene_width + width - x) * leave
                y -= leave * height
            }
            if phase < 0.22 || phase >= 0.65 {
                frame = TitleAnimationFrame(now, TITLE_ANIMATION_TIMING[timing], count - 2)
            }
        }
        animal_bounds := Rectangle.{picture.x + x * view.scale, picture.y + y * view.scale,
            width * view.scale, height * view.scale}
        if mode > 0 {
            pointer := PointerSample(session)
            // Only the opening is interactive; the opaque frame is above wildlife.
            nx := (pointer.x - picture.x) / picture.width
            ny := (pointer.y - picture.y) / picture.height
            inside := TitleWindowOpening(nx * 240.0, ny * picture.height / picture.width * 240.0, TITLE_SCENE_NAME[scene] == "window-portrait")
            if inside && TitleAnimalHit(pointer.x, pointer.y, animal_bounds) {
                unused CursorHover(session, cast(s32)CursorShape.CursorClickable)
                if pointer.pressed && title_flee_time[index] == 0.0 {
                    clicked_animal = index
                    clicked_x = x
                    clicked_y = y
                }
            }
        }
        Image(session, ImageProps.{.asset_path = path,
            .bounds = Rectangle.{picture.x + x * view.scale, picture.y + y * view.scale,
                width * view.scale, height * view.scale},
            .source = TitleAnimationSource(frame, TITLE_ANIMATION_SHEET[at], TITLE_ANIMATION_SHEET[at + 2], TITLE_ANIMATION_SHEET[at + 3]),
            .fit = ImageFit.ImageFitStretch, .smooth = true})
    }
    if clicked_animal >= 0 {
        title_flee_time[clicked_animal] = now
        title_flee_x[clicked_animal] = clicked_x
        title_flee_y[clicked_animal] = clicked_y
    }
}

// Path sign buttons own the semantic keys TITLE_SIGN_KEY_BASE + hotspot. The
// range sits far above every literal RetroTap/Press key, so a growing hotspot
// table can never reach another control's key (tests/semantic_keys_test.py).
TITLE_SIGN_KEY_BASE :: 0x51600000
TITLE_SIGN_KEY_SPAN :: 4096

// A physical wooden path sign, with lettering rendered in the active
// language. Source-pixel board bounds follow the same scene transform as
// the separate sprite, including its tiny tap animation.
TitlePathSign :: (session: Session, hotspot: s32, picture: Rectangle, view: TitleView,
    glowing: bool, blocked: bool, now: float64) {
    sprite := TitleHotspotRest(hotspot)
    if !TitleReady(sprite) { return }
    at := hotspot * 4
    lift := TitleSignLift(title_state, hotspot, now)
    wood := Rectangle.{
        picture.x + cast(float32)TITLE_GLOW_RECT[at] * view.scale,
        picture.y + (cast(float32)TITLE_GLOW_RECT[at + 1] + lift) * view.scale,
        cast(float32)TITLE_GLOW_RECT[at + 2] * view.scale,
        cast(float32)TITLE_GLOW_RECT[at + 3] * view.scale}
    turn := cast(float32)TITLE_HOTSPOT_ROTATION[hotspot] / 100.0
    TitlePicture(session, sprite, wood, 0, turn)
    if glowing {
        alpha := cast(u32)(255.0 * (0.36 + 0.12 * Sin(now * 6.283185307 / 1.8)))
        TitlePicture(session, TitleHotspotGlow(hotspot), wood, cast(u32)0xffffff00 | alpha, turn)
    }
    board := Rectangle.{
        wood.x + cast(float32)TITLE_SIGN_RECT[at] * view.scale,
        wood.y + cast(float32)TITLE_SIGN_RECT[at + 1] * view.scale,
        cast(float32)TITLE_SIGN_RECT[at + 2] * view.scale,
        cast(float32)TITLE_SIGN_RECT[at + 3] * view.scale}
    // The board's local label centre follows the same rigid transform as its pixels.
    pivot := Vector2.{wood.x+wood.width*0.5,wood.y+wood.height*0.5}
    camera: Camera = .{.offset=pivot,.target=pivot,.rotation=turn,.zoom=1.0}
    label_center := WorldToScreen(Vector2.{board.x+board.width*0.5,board.y+board.height*0.5},camera)
    board.x = label_center.x-board.width*0.5
    board.y = label_center.y-board.height*0.5
    label := Tr(TITLE_SIGN_LABEL[hotspot])
    // Lay text out at full plank size, then rotate it about the board centre.
    rotation := cast(float32)TITLE_SIGN_ROTATION[hotspot] / 100.0 + turn
    text_board := board
    font := board.height * 0.68
    if rotation == 0.0 {
        letters := Count(label)
        if letters > 0 && cast(float32)letters * font * 0.65 > text_board.width {
            font = text_board.width / (cast(float32)letters * 0.65)
        }
    } else {
        measure: TextProps = .{.bounds=text_board,.text=label,.font=cast(s32)font,.wrap=.TextWrapNone}
        width := TextWidth(session,measure)
        if width > 0 && cast(float32)width > text_board.width {
            font = font * text_board.width / cast(float32)width
        }
    }
    if font < 1.0 { font = 1.0 }
    origin := Vector2.{text_board.width*0.5,text_board.height*0.5}
    Text(session, TextProps.{.bounds = text_board, .text = label, .font = cast(s32)font,
        .rotation = rotation, .origin = origin,
        .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter,
        .wrap = TextWrap.TextWrapNone})
    if rotation != 0.0 {
        board = RotatedRectangleBounds(board,Vector2.{board.x+origin.x,board.y+origin.y},rotation)
    }
    // The semantic button covers the painted board. Raw pointer/touch
    // navigation still uses the actual sign polygon and foreground exclusion.
    pointer := PointerSample(session)
    on_board := pointer.x >= board.x && pointer.y >= board.y &&
        pointer.x < board.x + board.width && pointer.y < board.y + board.height
    physical := TitleInside(hotspot,(pointer.x-picture.x)/view.scale,(pointer.y-picture.y)/view.scale)
    covered := (blocked || !physical) && on_board
    button := Press(session, PressProps.{.key = cast(u64)(TITLE_SIGN_KEY_BASE + hotspot),
        .bounds = board, .label = label, .now = now, .disabled = covered})
    if button.clicked && !covered { TitleQueue(*title_state, hotspot, now) }
}

// Small flags in the top left corner keep their native language names for
// screen readers; the chosen one has a green frame.
TitleLanguageFlags :: () -> bool {
    changed := false
    names: [3]string = .["English", "Deutsch", "Español"]
    codes: [3]string = .["en", "de", "es"]
    for index: cast(s32)0..2 {
        x := 6 + index * 34
        y: s32 = 6
        press := RetroTap(510 + index, x, y, 30, 22, names[index])
        selected := language == index
        BookBox(x, y, 30, 22, ifx selected || press.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3d8,
            ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
        fx := x + 5
        fy := y + 5
        if index == 0 {
            RetroFill(fx, fy, 20, 12, BLUE)
            for line: cast(s32)0..11 {
                RetroFill(fx + line * 19 / 11, fy + line, 1, 1, WHITE)
                RetroFill(fx + 19 - line * 19 / 11, fy + line, 1, 1, WHITE)
            }
            RetroFill(fx + 8, fy, 4, 12, WHITE)
            RetroFill(fx, fy + 4, 20, 4, WHITE)
            RetroFill(fx + 9, fy, 2, 12, RED)
            RetroFill(fx, fy + 5, 20, 2, RED)
        } else if index == 1 {
            RetroFill(fx, fy, 20, 4, BLACK)
            RetroFill(fx, fy + 4, 20, 4, RED)
            RetroFill(fx, fy + 8, 20, 4, YELLOW)
        } else {
            RetroFill(fx, fy, 20, 12, RED)
            RetroFill(fx, fy + 3, 20, 6, YELLOW)
        }
        if press.clicked {
            LanguageSet(codes[index])
            changed = true
        }
    }
    return changed
}

// Whether every separate object layer of SCENE is decoded. Asking also
// starts loading them, so the room never appears with an object missing.
TitleObjectsReady :: (scene: s32) -> bool {
    ready := true
    first := TITLE_SCENE_OBJECT_FIRST[scene]
    for layer: first..first + TITLE_SCENE_OBJECTS[scene] - 1 {
        if !TitleReady(TITLE_OBJECT_PATH[layer]) { ready = false }
    }
    return ready
}

// SCENE's movable objects in list order over its clean room plate, each in
// its own source-pixel rect from tools/title_hotspots.json.
TitleObjects :: (session: Session, scene: s32, picture: Rectangle, view: TitleView) {
    first := TITLE_SCENE_OBJECT_FIRST[scene]
    for layer: first..first + TITLE_SCENE_OBJECTS[scene] - 1 {
        at := layer * 4
        TitlePicture(session, TITLE_OBJECT_PATH[layer], Rectangle.{
            picture.x + cast(float32)TITLE_OBJECT_RECT[at] * view.scale,
            picture.y + cast(float32)TITLE_OBJECT_RECT[at + 1] * view.scale,
            cast(float32)TITLE_OBJECT_RECT[at + 2] * view.scale,
            cast(float32)TITLE_OBJECT_RECT[at + 3] * view.scale}, 0, cast(float32)TITLE_OBJECT_ROTATION[layer] / 100.0)
    }
}

// SCENE's waiting paper, then the foreground layer that hides most of it.
TitlePaperUnder :: (session: Session, scene: s32, picture: Rectangle, view: TitleView, bounds: Rectangle,
    collection: *Collection, layered: bool, now: float64) {
    if !layered { return }
    paper := TitlePaperSpot(scene, view, bounds.width, bounds.height)
    if paper.index >= 0 && SecretPaperShown(title_papers.papers[paper.index], paper.index,
        CollectionHas(collection, collectible_slugs[paper.index])) {
        revealed := title_papers.reveal[paper.index]
        shown := TitlePaperRevealed(paper, revealed)
        SecretPaperDraw(bounds.x + shown.x, bounds.y + shown.y, shown.size,
            SecretPaperGlow(now) * (0.08 + revealed * 0.3), 1.0)
    }
    TitlePicture(session, TITLE_SCENE_FOREGROUND[scene], picture)
}

// The treehouse title screen. KEY is this frame's key; CHOICE receives the
// catalog index of a game as it opens, which MenuAction.game reports.
// COLLECTION is what the child has earned; COLLECT earns a scene's paper.
JungleMenu :: (session: Session, bounds: Rectangle, key: s32, now: float64, font: string,
    games: []MenuGame, choice: *s32, sound_muted: bool, guide_muted: bool, guide_seen: bool,
    message: string, collection: *Collection, collect: SecretPaperCollect) -> MenuAction {
    action := MenuAction.{.game = -1}
    if !title_state.started { TitleStart(*title_state) }
    // Keys, pointer and glow see which world-map landmarks the fog still hides.
    title_state.map_visits = TitleFogVisits(title_exploration)
    if guide_seen {
        TitleGuideSkip(*title_state)
        title_state.guide_finished_reported = true
    }
    // Corner controls use a unit that grows gently with the window.
    unit := (ifx bounds.width < bounds.height then bounds.width else bounds.height) / 300.0
    if unit < 1.0 { unit = 1.0 }
    if unit > 3.0 { unit = 3.0 }
    retro = Retro.{.session = session, .font = font, .now = now, .key = key,
        .x = bounds.x, .y = bounds.y, .scale = unit, .glyph_height = 16}
    BookPalette()
    width := cast(s32)(bounds.width / unit)
    height := cast(s32)(bounds.height / unit)

    TitleResolve(*title_state, bounds.width, bounds.height)
    // Only a bubble already open takes this frame's taps and keys, so the
    // Enter that opens it does not also turn its first line.
    dialogue_open := title_state.dialogue != 0
    scene_key := key
    // The map's Back button, pressed last frame, goes where the map came from.
    if title_map_back { title_map_back = false; if scene_key == 0 { scene_key = KEY_ESCAPE } }
    // Scene shortcuts are handled here. Consume the retained key so a later
    // notice cannot replay Escape from a previous return to Campus.
    if !title_state.not_implemented { unused KeyboardTake(session) }
    step := TitleKey(*title_state, scene_key)
    if key == 299 && !title_state.not_implemented { action.sound_toggle = true }
    TitleFocus(*title_state, bounds.width, bounds.height)
    view := TitleFit(bounds.width, bounds.height, title_state.pan_x, title_state.pan_y, title_state.scene)
    pointer := PointerSample(session)
    px := pointer.x - bounds.x
    py := pointer.y - bounds.y
    guide_anchor := TitleGuideAnchor(*title_state, view, bounds, unit, width, height)
    guide_place := TitleGuideLayout(width, height, guide_anchor)
    // A dismissed guide has no painted bubble and must not intercept the scene.
    guide_hover := !title_state.guide_stopped && !title_state.guide_finished_reported &&
        title_state.guide_step < TITLE_GUIDE_STEP_COUNT && px >= cast(float32)guide_place.hit.x * unit && px < cast(float32)(guide_place.hit.x + guide_place.hit.width) * unit &&
        py >= cast(float32)guide_place.hit.y * unit && py < cast(float32)(guide_place.hit.y + guide_place.hit.height) * unit
    // The flags and the sound button sit over the picture's corners.
    blocked := title_state.not_implemented || guide_hover || (px < cast(float32)(6 + 3 * 34) * unit && py < 34.0 * unit) ||
        (px > bounds.width - 112.0 && py < 56.0)
    corner := (px < cast(float32)(6 + 3 * 34) * unit && py < 34.0 * unit) || (px > bounds.width - 112.0 && py < 56.0)
    // The map button, left of the Collection Book.
    map_hit := TitleMapEntry(title_state.scene) && px >= cast(float32)(width - 96) * unit &&
        px < cast(float32)(width - 70) * unit && py < 34.0 * unit
    if map_hit { blocked = true; corner = true }
    // The treasure chest button, left of the map button.
    if px >= cast(float32)(width - 128) * unit && px < cast(float32)(width - 102) * unit && py < 34.0 * unit {
        blocked = true
        corner = true
    }
    if title_state.dialogue != 0 { blocked = true }
    // The hidden paper takes its own hover and tap before the scene sees them;
    // a drag that starts on it still pans the picture.
    paper := TitlePaperSpot(title_state.scene, view, bounds.width, bounds.height)
    paper_had := paper.index >= 0 && CollectionHas(collection, collectible_slugs[paper.index])
    paper_available := TITLE_SCENE_BACKGROUND[title_state.scene] != "" &&
        TitleReady(TITLE_SCENE_BACKGROUND[title_state.scene]) && TitleObjectsReady(title_state.scene) &&
        (TITLE_SCENE_FOREGROUND[title_state.scene] == "" || TitleReady(TITLE_SCENE_FOREGROUND[title_state.scene]))
    pointed := TitleSpotHit(title_state, TitleSourceX(view, px), TitleSourceY(view, py), now)
    if pointed >= 0 && TITLE_SIGN_LABEL[pointed] != "" {
        if !TitleReady(TitleHotspotRest(pointed)) ||
            (TITLE_SCENE_FOREGROUND[title_state.scene] != "" && !paper_available) { blocked = true }
    }
    shelf := TITLE_SCENE_NAME[TITLE_SCENE_BASE[title_state.scene]] == "bookshelf"
    // The shelf stencil hides behind the tiger cover. A book face under the
    // pointer wins, so only the stencil's visible edge reveals and collects it.
    paper_input := TitlePaperPointer(*title_papers, paper, paper_had || !paper_available || (shelf && pointed >= 0), px, py, pointer.down,
        pointer.pressed && !blocked, pointer.released && !title_state.not_implemented, now, collect)
    if paper_input.owned { blocked = true }
    action.paper_collected = paper_input.collected
    if step.game < 0 { step = TitlePointer(*title_state, view, px, py, pointer.down, pointer.pressed, pointer.released, blocked, now) }
    if step.game < 0 { step = TitleTick(*title_state, now) }
    // The pointing hand shows only where a tap here does something; the same
    // hit test decides the tap.
    if TitleCursorClickable(*title_state, pointed, blocked, paper_input.over, corner) {
        unused CursorHover(session, cast(s32)CursorShape.CursorClickable)
    }
    if title_state.locked_cue {
        title_state.locked_cue = false
        title_state.locked_at = now
        action.locked_cue = true
    }
    if guide_hover && !title_state.guide_finished_reported { title_state.guide_stopped = false }
    if step.moved { action.navigated = true }
    if step.game >= 0 {
        title := TITLE_HOTSPOT_GAME[step.game]
        title_book_requested = ifx title == "Sweet Porridge" then "sweet-porridge" else ""
        if title_book_requested != "" { title = "Picture Book" }
        for index: cast(s32)0..cast(s32)games.count - 1 {
            if games[index].title == title { action.game = index; choice.* = index }
        }
    }
    TitleResolve(*title_state, bounds.width, bounds.height)
    view = TitleFit(bounds.width, bounds.height, title_state.pan_x, title_state.pan_y, title_state.scene)

    // Cream while the first picture arrives, then the low-resolution
    // picture until the clean one is decoded.
    paper_fill: u32 = ifx TitleOnMap(title_state.scene) then cast(u32)TITLE_MAP_PAPER else cast(u32)0xe3ece4ff
    unused Box(session, BoxProps.{.bounds = bounds, .fill = ColorFromPacked(paper_fill)})
    scene := title_state.scene
    unused ExplorationVisit(*title_exploration, ExplorationSceneArea(TITLE_SCENE_NAME[scene]))
    picture := Rectangle.{bounds.x + view.x, bounds.y + view.y,
        cast(float32)TITLE_SCENE_WIDTH[scene] * view.scale, cast(float32)TITLE_SCENE_HEIGHT[scene] * view.scale}
    // A real background plate and transparent foreground share the exact
    // scene transform. Wait for both before exposing anything between them.
    layered := false
    if TITLE_SCENE_BACKGROUND[scene] != "" {
        background_ready := TitleReady(TITLE_SCENE_BACKGROUND[scene])
        foreground_ready := TITLE_SCENE_FOREGROUND[scene] == "" || TitleReady(TITLE_SCENE_FOREGROUND[scene])
        layered = background_ready && foreground_ready && TitleObjectsReady(scene)
    }
    if layered {
        TitlePicture(session, TITLE_SCENE_BACKGROUND[scene], picture)
        if TITLE_SCENE_FOREGROUND[scene] == "" {
            TitlePaperUnder(session, scene, picture, view, bounds, collection, layered, now)
        }
        TitleObjects(session, scene, picture, view)
    } else {
        if !TitleReady(TITLE_SCENE_IMAGE[scene]) { TitlePicture(session, TITLE_SCENE_LOW[scene], picture) }
        TitlePicture(session, TITLE_SCENE_IMAGE[scene], picture)
        if TITLE_SCENE_BACKGROUND[scene] == "" { TitleObjects(session, scene, picture, view) }
    }
    TitleAnimations(session, scene, picture, view, now)
    TitleWindowFrame(session, scene, picture, view)
    TitleAnimations(session, scene, picture, view, now, true)
    first := TITLE_SCENE_FIRST[scene]
    for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 {
        // Separate navigation objects sit behind the foreground tiger.
        if TitleHotspotRest(hotspot) != "" && TITLE_SIGN_LABEL[hotspot] == "" && (TITLE_SCENE_FOREGROUND[scene] == "" || layered) {
            rect := hotspot * 4
            wobble := (TitleLockedWobble(title_state, hotspot, now) + TitleHotspotMotionX(hotspot, now)) * view.scale
            TitlePicture(session, TitleHotspotRest(hotspot), Rectangle.{
                picture.x + cast(float32)TITLE_GLOW_RECT[rect] * view.scale + wobble,
                picture.y + cast(float32)TITLE_GLOW_RECT[rect + 1] * view.scale,
                cast(float32)TITLE_GLOW_RECT[rect + 2] * view.scale,
                cast(float32)TITLE_GLOW_RECT[rect + 3] * view.scale}, 0, cast(float32)TITLE_HOTSPOT_ROTATION[hotspot] / 100.0)
        }
        // Each glow and every scene one step away loads ahead of use.
        unused TitleReady(TitleHotspotGlow(hotspot))
        target := TITLE_HOTSPOT_TARGET[hotspot]
        if target >= 0 { unused TitleReady(TITLE_SCENE_LOW[ResolveTitleSceneVariant(target, bounds.width, bounds.height)]); unused TitleReady(TITLE_SCENE_IMAGE[ResolveTitleSceneVariant(target, bounds.width, bounds.height)]) }
    }
    glowing := TitleGlowing(title_state)
    if paper_input.owned || title_papers.pressed { glowing = -1 }
    // While talking, the speaker keeps his own painted colors; the bubble's
    // tail shows who speaks.
    if title_state.dialogue != 0 { glowing = -1 }
    guide := TitleGuide(*title_state, now, sound_muted || guide_muted,
        action.sound_toggle || key != 0 || (pointer.pressed && !guide_hover), language)
    guiding := guide.active
    if guiding && title_state.guide_step == 0 && title_state.pending < 0 && title_state.pressed < 0 {
        glowing = TitleGuideHotspot(0, scene)
        if glowing >= 0 && !TitleHotspotDiscovered(title_state, glowing) { glowing = -1 }
    }
    action.guide_stop = guide.stop
    action.guide_finished = guide.finished
    if guide.voice {
        action.guide_voice = TitleGuideVoicePath(guide.step, language)
    }
    // The separated tiger cover used to cover the first row's highlight. On the
    // shelf it and the stencil behind it paint before feedback instead.
    if shelf { TitlePaperUnder(session, scene, picture, view, bounds, collection, layered, now) }
    if glowing >= 0 && TITLE_SIGN_LABEL[glowing] == "" {
        // A slow, gentle pulse over exactly the item.
        wave := Sin(now * 6.283185307 / 1.8)
        alpha := cast(u32)(255.0 * (0.74 + 0.26 * wave))
        // The world map's landmarks keep their full halo; it lies around them.
        if TitleHotspotRest(glowing) != "" && !TitleOnMap(scene) { alpha = cast(u32)(cast(float32)alpha * 0.55) }
        rect := glowing * 4
        if TitleOnMap(scene) && TitleHotspotGlow(glowing) == "" {
            unused Box(session, BoxProps.{.bounds = Rectangle.{
                picture.x + cast(float32)TITLE_GLOW_RECT[rect] * view.scale,
                picture.y + cast(float32)TITLE_GLOW_RECT[rect + 1] * view.scale,
                cast(float32)TITLE_GLOW_RECT[rect + 2] * view.scale,
                cast(float32)TITLE_GLOW_RECT[rect + 3] * view.scale},
                .fill = ColorFromPacked(0xfff7cd45), .radius = 16.0 * view.scale})
        }
        TitlePicture(session, TitleHotspotGlow(glowing), Rectangle.{
            picture.x + (cast(float32)TITLE_GLOW_RECT[rect] + TitleLockedWobble(title_state, glowing, now) + TitleHotspotMotionX(glowing, now)) * view.scale,
            picture.y + cast(float32)TITLE_GLOW_RECT[rect + 1] * view.scale,
            cast(float32)TITLE_GLOW_RECT[rect + 2] * view.scale,
            cast(float32)TITLE_GLOW_RECT[rect + 3] * view.scale}, cast(u32)0xffffff00 | alpha, cast(float32)TITLE_HOTSPOT_ROTATION[glowing] / 100.0)
    }
    if TITLE_SCENE_FOREGROUND[scene] == "" || layered {
        for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 {
            if TITLE_SIGN_LABEL[hotspot] != "" {
                TitlePathSign(session, hotspot, picture, view, glowing == hotspot, blocked || title_state.not_implemented, now)
            }
        }
    }
    if TITLE_DECORATION_COUNT > 0 {
        for index: cast(s32)0..TITLE_DECORATION_COUNT - 1 {
            if TITLE_DECORATION_SCENE[index] == scene {
                at := index * 4
                TitlePicture(session, TITLE_DECORATION_PATH[index], Rectangle.{
                    picture.x + cast(float32)TITLE_DECORATION_RECT[at] * view.scale,
                    picture.y + cast(float32)TITLE_DECORATION_RECT[at + 1] * view.scale,
                    cast(float32)TITLE_DECORATION_RECT[at + 2] * view.scale,
                    cast(float32)TITLE_DECORATION_RECT[at + 3] * view.scale}, 0, cast(float32)TITLE_DECORATION_ROTATION[index] / 100.0)
            }
        }
    }
    if !shelf && TITLE_SCENE_FOREGROUND[scene] != "" { TitlePaperUnder(session, scene, picture, view, bounds, collection, layered, now) }
    // The world map's fog lies over every scene layer (landmarks, animals,
    // signs, decorations, glow) and under only the guide and corner controls.
    TitleMapFog(session, scene, picture)

    if guiding && !title_state.not_implemented {
        guide_anchor = TitleGuideAnchor(*title_state, view, bounds, unit, width, height)
        guide_place = TitleGuideLayout(width, height, guide_anchor)
        skip_x := guide_place.bubble.x + guide_place.bubble.width - 21
        skip_y := guide_place.bubble.y + 5
        guide_sound_x := guide_place.bubble.x + guide_place.bubble.width - 42
        guide_sound_y := guide_place.bubble.y + 5
        skip_label := ifx language == 1 then "Anleitung überspringen" else ifx language == 2 then "Saltar la guía" else "Skip guide"
        skip := RetroTap(712, skip_x, skip_y, 16, 16, skip_label)
        guide_sound_label := ifx language == 1 then (ifx guide_muted then "Anleitungston aus" else "Anleitungston an") else ifx language == 2 then (ifx guide_muted then "Guía sin sonido" else "Guía con sonido") else (ifx guide_muted then "Guide sound off" else "Guide sound on")
        guide_sound := RetroTap(711, guide_sound_x, guide_sound_y, 16, 16, guide_sound_label)
        skip_hit := pointer.pressed && px >= cast(float32)skip_x * unit && px < cast(float32)(skip_x + 16) * unit &&
            py >= cast(float32)skip_y * unit && py < cast(float32)(skip_y + 16) * unit
        guide_sound_hit := pointer.pressed && px >= cast(float32)guide_sound_x * unit &&
            px < cast(float32)(guide_sound_x + 16) * unit &&
            py >= cast(float32)guide_sound_y * unit && py < cast(float32)(guide_sound_y + 16) * unit
        BookBox(guide_place.bubble.x, guide_place.bubble.y, guide_place.bubble.width, guide_place.bubble.height,
            0xf7f1e3f2, 0xdacdb5ff, 8.0)
        tail_x := guide_anchor.x + guide_anchor.width / 2
        if tail_x < guide_place.bubble.x + 16 { tail_x = guide_place.bubble.x + 16 }
        if tail_x > guide_place.bubble.x + guide_place.bubble.width - 16 {
            tail_x = guide_place.bubble.x + guide_place.bubble.width - 16
        }
        tail_top := guide_anchor.y + guide_anchor.height <= guide_place.bubble.y + 4
        for offset: cast(s32)0..5 {
            tail_width := 12 - offset * 2
            tail_y := ifx tail_top then guide_place.bubble.y + 1 + offset else guide_place.bubble.y + guide_place.bubble.height - 2 - offset
            BookBox(tail_x - tail_width / 2, tail_y, tail_width, 1, 0xf7f1e3ff)
        }
        BookPicture("assets/jungle/title/guide/tiger.avif", guide_place.mascot.x, guide_place.mascot.y,
            guide_place.mascot.width, guide_place.mascot.height)
        BookText(guide_place.text.x, guide_place.text.y, guide_place.text.width, guide_place.text.height,
            TitleGuideText(guide.step, language), 10, TextAlign.TextAlignStart, false)
        BookBox(skip_x, skip_y, 16, 16, ifx skip.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3ff,
            0xbba98bff, 4.0)
        BookText(skip_x, skip_y, 16, 16, "X", 10, TextAlign.TextAlignCenter, false)
        BookBox(guide_sound_x, guide_sound_y, 16, 16,
            ifx guide_sound.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3ff, 0xbba98bff, 4.0)
        SvgIcon(session, SvgIconProps.{.bounds = RetroRect(guide_sound_x + 2, guide_sound_y + 2, 12, 12),
            .shape = ifx guide_muted then SoundOffIcon.Shape else SoundOnIcon.Shape, .color = ColorFromPacked(0x3e332aff)})
        if skip_hit || skip.clicked {
            TitleGuideSkip(*title_state)
            title_state.guide_finished_reported = true
            action.guide_stop = true
            action.guide_finished = true
        }
        if guide_sound_hit || guide_sound.clicked {
            action.guide_mute_toggle = true
            if !guide_muted { action.guide_stop = true }
        }
    }
    if title_state.dialogue != 0 {
        talk := TitleDialogueFrame(session, *title_state, view, unit, width, height, px, py,
            dialogue_open && pointer.pressed, corner, ifx dialogue_open then key else 0, sound_muted, language)
        if talk.stop { action.guide_stop = true }
        if talk.voice != "" { action.guide_voice = talk.voice }
    }
    if title_state.not_implemented {
        actions: [1]ActionModalAction = .[ActionModalAction.{.key = 9711, .label = Tr("Close")}]
        modal := ActionModal(session, ActionModalProps.{.key = 9710,
            .title = Tr("Not yet implemented"), .max_width = 420, .show_close = true,
            .close_label = Tr("Close")}, actions[:])
        if modal.action != 0 { TitleDismissNotice(*title_state) }
        return action
    }
    if shelf || TITLE_SCENE_BACK[scene] != 0 {
        back := RetroTap(7501, 6, 6, 44, 30, Tr("Back"))
        BookBox(6, 6, 44, 30, 0xf7f1e3ee, 0xdacdb5ff, 4)
        BookText(6, 6, 44, 30, Tr("Back"), 11, TextAlign.TextAlignCenter)
        if back.clicked && TitleOnMap(scene) { title_map_back = true }
        else if back.clicked { unused TitleKey(*title_state, KEY_ESCAPE); action.navigated = true }
    } else { action.language_changed = TitleLanguageFlags() }
    sound_label := ifx sound_muted then "Sound off · F10" else "Sound on · F10"
    sound := RetroTap(500, width - 32, 6, 26, 22, sound_label)
    BookBox(width - 32, 6, 26, 22, ifx sound.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3d8, 0xdacdb5ff, 4.0)
    SvgIcon(session, SvgIconProps.{.bounds = RetroRect(width - 27, 9, 16, 16),
        .shape = ifx sound_muted then SoundOffIcon.Shape else SoundOnIcon.Shape, .color = ColorFromPacked(0x3e332aff)})
    if sound.clicked { action.sound_toggle = true }
    if message != "" {
        BookBox(width / 2 - 90, height - 30, 180, 22, 0xf7f1e3e8, 0xdacdb5ff, 6.0)
        BookText(width / 2 - 86, height - 30, 172, 22, message, 10)
    }
    if TitleMapEntry(scene) && TitleMapButton(width - 96, 6, 26, 22, 16) && TitleMapOpen(*title_state, scene) {
        action.navigated = true
    }
    collection_target := RetroRect(width - 64, 6, 26, 22)
    action.collection_open = CollectionBookButton(width - 64, 6, true)
    action.chest_open = TreasureChestButton(width - 128, 6)
    retro.scale = 1.0
    TitlePaperFlights(cast(s32)collection_target.x, cast(s32)collection_target.y,
        cast(s32)collection_target.width, cast(s32)collection_target.height, now)
    // The toucan's gift card covers everything until it is tapped away.
    if ToucanRevealFrame(session, bounds, now) { action.chest_open = false; action.collection_open = false }
    return action
}

// Each collected paper's empty scene line art flies from where the paper lay
// into the Collection Book button at X, Y, among fading sparkles. Window
// pixels, drawn with retro.scale 1.
TitlePaperFlights :: (x: s32, y: s32, width: s32, height: s32, now: float64) {
    target := CollectRect.{x, y, width, height}
    for index: cast(s32)0..COLLECTIBLE_COUNT - 1 {
        paper := *title_papers.papers[index]
        SecretPaperStep(paper, now)
        if paper.state != SECRET_PAPER_FLYING { continue }
        progress := SecretPaperProgress(paper.*, now)
        place := CollectFlight(paper.start, target, progress)
        shown := RetroRect(place.x, place.y, place.width, place.height)
        SecretPaperBox(shown.x, shown.y, shown.width, shown.height, 0xfffdf8ff, 1.0 - progress * progress * 0.3, 4.0)
        path := ifx album_outlines[index] != "" then album_outlines[index] else AlbumOutlinePath(index)
        Image(retro.session, ImageProps.{.asset_path = RetroImageShown(path), .bounds = shown,
            .fit = ImageFit.ImageFitContain, .smooth = true})
        SecretPaperTwinkle(place.x + place.width / 2, place.y + place.height / 2, place.width / 2, 1.0 - progress * progress)
    }
}

// Shared by native desktop/Android and web. Back belongs to the album while open.
CollectionBookFrame :: (session: Session, bounds: Rectangle, key: s32, now: float64, muted: bool, collection: *Collection) -> bool {
    bar := GameTitleBar(session, bounds, key, now, "Collection Book", muted)
    AlbumContent(collection, cast(s32)bounds.width, cast(s32)bounds.height)
    if bar.back || key == 256 { CollectionBookBack() }
    return bar.sound_toggle || key == 299
}

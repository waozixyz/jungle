// The same title screen is drawn by the native and browser hosts: the
// treehouse and the scenes below it (host/jungle_title.zi), where every
// painted item glows under the pointer and opens a game or another scene.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/text_align"
#import "kryon/drawing_props"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "kryon/title_bar_props"
#import "kryon/dropdown_props"
#import "kryon/title_bar_widget"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "std/math"
#if !#defined(PLATFORM_WEB) {
    #import "kryon/image_raster"
}
SoundOnIcon :: #import "mingcute/mingcute_regular_volume";
SoundOffIcon :: #import "mingcute/mingcute_regular_volume_off";
#import, file "../retro/speed_choice.zi";
#import, file "../retro/retro.zi";
#import, file "../retro/book_theme.zi";
#import, file "../retro/language.zi";
#import, file "jungle_text.zi";
#import, file "jungle_album.zi";
#import, file "jungle_collection.zi";
#import, file "jungle_title.zi";
#import, file "jungle_title_data.zi";
#import, file "../retro/paper_rules.zi";
#import, file "../retro/paper_draw.zi";
#import, file "../retro/collectibles.zi";
#import, file "../retro/collect_flight.zi";

MenuGame :: struct {
    bundle_name: string
    title: string
    about: string
    icon: string
    age: s32
}

MenuAction :: struct {
    game: s32
    language_changed: bool
    sound_toggle: bool
    navigated: bool
    guide_voice: string
    guide_stop: bool
    guide_finished: bool
    guide_mute_toggle: bool
    collection_open: bool
    // A scene's hidden paper was just collected: the host plays its chime.
    paper_collected: bool
}

// The scene shown and what glows in it; kept while a game plays, so a
// child comes back to the same room.
title_state: TitleState;
title_papers: TitlePapers;
TITLE_PAPER_CHIME :: "assets/jungle-book/collect.wav"
title_book_requested: string;
GAME_BAR_HEIGHT :: 56
ABC_SPEED_KEY :: 10001
abc_title_speed: s32 = 1;

TitleGuideAnchor :: (state: *TitleState, view: TitleView, bounds: Rectangle, unit: float32,
    width: s32, height: s32) -> TitleGuideRect {
    if state.guide_step == 1 { return TitleGuideRect.{width / 2 - 34, height / 2 - 34, 68, 68} }
    if state.guide_step == 2 { return TitleGuideRect.{width - 40, 2, 32, 30} }
    hotspot := TitleGuideHotspot(0, state.scene)
    if hotspot < 0 { return TitleGuideRect.{width / 2 - 34, height / 2 - 34, 68, 68} }
    rect := hotspot * 4
    x := (bounds.x + view.x + cast(float32)TITLE_GLOW_RECT[rect] * view.scale - bounds.x) / unit
    y := (bounds.y + view.y + cast(float32)TITLE_GLOW_RECT[rect + 1] * view.scale - bounds.y) / unit
    picture_width := cast(float32)TITLE_GLOW_RECT[rect + 2] * view.scale / unit
    picture_height := cast(float32)TITLE_GLOW_RECT[rect + 3] * view.scale / unit
    return TitleGuideRect.{cast(s32)x, cast(s32)y, cast(s32)picture_width, cast(s32)picture_height}
}

TitleBarAction :: struct {
    back: bool
    sound_toggle: bool
    speed_toggle: bool
    collection_open: bool
}

// Back on the left, the game's name, and sound on or off on the right.
GameTitleBar :: (session: Session, bounds: Rectangle, key: s32, now: float64, title: string, sound_muted: bool) -> TitleBarAction {
    retro = Retro.{.session = session, .font = "assets/jungle/font.png", .now = now, .key = key,
        .x = bounds.x, .y = bounds.y, .scale = 1.0, .glyph_height = 16}
    action: TitleBarAction
    width := cast(s32)bounds.width
    BookPalette()
    options: [0]DropdownOption
    abc := title == "ABC Book" || title == "123 Book" || title == "Picture Book"
    bar := TitleBar(session, TitleBarProps.{.key = 9001,
        .bounds = Rectangle.{bounds.x, bounds.y, bounds.width, cast(float32)GAME_BAR_HEIGHT},
        .height = GAME_BAR_HEIGHT, .title = Tr(ifx title == "Picture Book" && title_book_requested == "sweet-porridge" then "Sweet Porridge" else title), .has_leading_action = true,
        .leading_label = Tr("Back"), .trailing_width = ifx collection_book_open then 60 else ifx abc then 205 else 110}, options[:])
    if !collection_book_open { action.collection_open = CollectionBookButton(ifx abc then width - 200 else width - 106, 6) }
    action.back = bar.clicked_leading
    sound := RetroTap(9002, width - 56, 6, 44, 44, ifx sound_muted then "Sound off · F10" else "Sound on · F10")
    BookBox(width - 56, 6, 44, 44, ifx sound.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0xdacdb5ff, 4.0)
    SvgIcon(session, SvgIconProps.{.bounds = RetroRect(width - 49, 13, 30, 30),
        .shape = ifx sound_muted then SoundOffIcon.Shape else SoundOnIcon.Shape, .color = ColorFromPacked(0x3e332aff)})
    action.sound_toggle = sound.clicked
    if abc {
        speed_label := SpeedChoiceLabel(abc_title_speed)
        speed := RetroTap(9003, width - 150, 6, 88, 44, speed_label)
        BookBox(width - 150, 6, 88, 44, ifx speed.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0x2e6956ff, 4.0)
        SvgIcon(session, SvgIconProps.{.bounds = RetroRect(width - 123, 12, 32, 32),
            .shape = SpeedChoiceIcon(abc_title_speed), .color = ColorFromPacked(0x2e6956ff)})
        if TreeHoveredAt(session, speed.node) {
            BookBox(width - 214, 54, 152, 28, 0xf3ecdcff, 0x2e6956ff, 4.0)
            BookText(width - 212, 56, 148, 24, speed_label, 13)
        }
        if speed.clicked { abc_title_speed = (abc_title_speed + 1) % 3; action.speed_toggle = true }
    }
    return action
}

// Whether PATH's full picture is decoded and drawable. Asking also starts
// loading it, so scenes a child can reach next are ready when they arrive.
TitleReady :: (path: string) -> bool {
    #if #defined(PLATFORM_WEB) {
        return RetroImageShown(path) == path
    }
    #if !#defined(PLATFORM_WEB) {
        return AssetWidth(path) > 0
    }
    return false
}

TitlePicture :: (session: Session, path: string, bounds: Rectangle, tint: u32 = 0) {
    shown := RetroImageShown(path)
    if shown == "" { return }
    preview := ifx path.count >= 5 && path[path.count - 5:] == ".webp" then RetroImagePreview(path) else ""
    Image(session, ImageProps.{.asset_path = shown, .preview_path = preview, .bounds = bounds,
        .fit = ImageFit.ImageFitStretch, .smooth = true, .tint = tint})
}

// Small flags in the top left corner keep their native language names for
// screen readers; the chosen one has a green frame.
TitleLanguageFlags :: () -> bool {
    changed := false
    names: [3]string = .["English", "Deutsch", "Español"]
    codes: [3]string = .["en", "de", "es"]
    for index: cast(s32)0..2 {
        x := 6 + index * 34
        y: s32 = 6
        press := RetroTap(510 + index, x, y, 30, 22, names[index])
        selected := language == index
        BookBox(x, y, 30, 22, ifx selected || press.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3d8,
            ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
        fx := x + 5
        fy := y + 5
        if index == 0 {
            RetroFill(fx, fy, 20, 12, BLUE)
            for line: cast(s32)0..11 {
                RetroFill(fx + line * 19 / 11, fy + line, 1, 1, WHITE)
                RetroFill(fx + 19 - line * 19 / 11, fy + line, 1, 1, WHITE)
            }
            RetroFill(fx + 8, fy, 4, 12, WHITE)
            RetroFill(fx, fy + 4, 20, 4, WHITE)
            RetroFill(fx + 9, fy, 2, 12, RED)
            RetroFill(fx, fy + 5, 20, 2, RED)
        } else if index == 1 {
            RetroFill(fx, fy, 20, 4, BLACK)
            RetroFill(fx, fy + 4, 20, 4, RED)
            RetroFill(fx, fy + 8, 20, 4, YELLOW)
        } else {
            RetroFill(fx, fy, 20, 12, RED)
            RetroFill(fx, fy + 3, 20, 6, YELLOW)
        }
        if press.clicked {
            LanguageSet(codes[index])
            changed = true
        }
    }
    return changed
}

// The treehouse title screen. KEY is this frame's key; CHOICE receives the
// catalog index of a game as it opens, which MenuAction.game reports.
// COLLECTION is what the child has earned; COLLECT earns a scene's paper.
JungleMenu :: (session: Session, bounds: Rectangle, key: s32, now: float64, font: string,
    games: []MenuGame, choice: *s32, sound_muted: bool, guide_muted: bool, guide_seen: bool,
    message: string, collection: Collection, collect: SecretPaperCollect) -> MenuAction {
    action := MenuAction.{.game = -1}
    if !title_state.started { TitleStart(*title_state) }
    if guide_seen {
        TitleGuideSkip(*title_state)
        title_state.guide_finished_reported = true
    }
    // Corner controls use a unit that grows gently with the window.
    unit := (ifx bounds.width < bounds.height then bounds.width else bounds.height) / 300.0
    if unit < 1.0 { unit = 1.0 }
    if unit > 3.0 { unit = 3.0 }
    retro = Retro.{.session = session, .font = font, .now = now, .key = key,
        .x = bounds.x, .y = bounds.y, .scale = unit, .glyph_height = 16}
    BookPalette()
    width := cast(s32)(bounds.width / unit)
    height := cast(s32)(bounds.height / unit)

    TitleResolve(*title_state, bounds.width, bounds.height)
    step := TitleKey(*title_state, key)
    if key == 299 { action.sound_toggle = true }
    TitleFocus(*title_state, bounds.width, bounds.height)
    view := TitleFit(bounds.width, bounds.height, title_state.pan_x, title_state.pan_y, title_state.scene)
    pointer := PointerSample(session)
    px := pointer.x - bounds.x
    py := pointer.y - bounds.y
    guide_anchor := TitleGuideAnchor(*title_state, view, bounds, unit, width, height)
    guide_place := TitleGuideLayout(width, height, guide_anchor)
    // A dismissed guide has no painted bubble and must not intercept the scene.
    guide_hover := !title_state.guide_stopped && !title_state.guide_finished_reported &&
        title_state.guide_step < TITLE_GUIDE_STEP_COUNT && px >= cast(float32)guide_place.hit.x * unit && px < cast(float32)(guide_place.hit.x + guide_place.hit.width) * unit &&
        py >= cast(float32)guide_place.hit.y * unit && py < cast(float32)(guide_place.hit.y + guide_place.hit.height) * unit
    // The flags and the sound button sit over the picture's corners.
    blocked := guide_hover || (px < cast(float32)(6 + 3 * 34) * unit && py < 34.0 * unit) ||
        (px > bounds.width - 112.0 && py < 56.0)
    // The hidden paper takes its own hover and tap before the scene sees them;
    // a drag that starts on it still pans the picture.
    paper := TitlePaperSpot(title_state.scene, view, bounds.width, bounds.height)
    paper_had := paper.index >= 0 && CollectionHas(collection, collectible_slugs[paper.index])
    paper_input := TitlePaperPointer(*title_papers, paper, paper_had, px, py, pointer.down,
        pointer.pressed && !blocked, pointer.released, now, collect)
    if paper_input.owned { blocked = true }
    action.paper_collected = paper_input.collected
    if step.game < 0 { step = TitlePointer(*title_state, view, px, py, pointer.down, pointer.pressed, pointer.released, blocked, now) }
    if step.game < 0 { step = TitleTick(*title_state, now) }
    if guide_hover && !title_state.guide_finished_reported { title_state.guide_stopped = false }
    if step.moved { action.navigated = true }
    if step.game >= 0 {
        title := TITLE_HOTSPOT_GAME[step.game]
        title_book_requested = ifx title == "Sweet Porridge" then "sweet-porridge" else ""
        if title_book_requested != "" { title = "Picture Book" }
        for index: cast(s32)0..cast(s32)games.count - 1 {
            if games[index].title == title { action.game = index; choice.* = index }
        }
    }
    TitleResolve(*title_state, bounds.width, bounds.height)
    view = TitleFit(bounds.width, bounds.height, title_state.pan_x, title_state.pan_y, title_state.scene)

    // Cream while the first picture arrives, then the low-resolution
    // picture until the clean one is decoded.
    unused Box(session, BoxProps.{.bounds = bounds, .fill = ColorFromPacked(0xe3ece4ff)})
    scene := title_state.scene
    picture := Rectangle.{bounds.x + view.x, bounds.y + view.y,
        cast(float32)TITLE_SCENE_WIDTH[scene] * view.scale, cast(float32)TITLE_SCENE_HEIGHT[scene] * view.scale}
    if !TitleReady(TITLE_SCENE_IMAGE[scene]) { TitlePicture(session, TITLE_SCENE_LOW[scene], picture) }
    TitlePicture(session, TITLE_SCENE_IMAGE[scene], picture)
    first := TITLE_SCENE_FIRST[scene]
    for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 {
        // Navigation arrows remain visible on touch screens. Their alpha
        // masks leave the painted foreground (the tiger) in front.
        if TITLE_HOTSPOT_REST[hotspot] != "" {
            rect := hotspot * 4
            TitlePicture(session, TITLE_HOTSPOT_REST[hotspot], Rectangle.{
                picture.x + cast(float32)TITLE_GLOW_RECT[rect] * view.scale,
                picture.y + cast(float32)TITLE_GLOW_RECT[rect + 1] * view.scale,
                cast(float32)TITLE_GLOW_RECT[rect + 2] * view.scale,
                cast(float32)TITLE_GLOW_RECT[rect + 3] * view.scale})
        }
        // Each glow and every scene one step away loads ahead of use.
        unused TitleReady(TITLE_HOTSPOT_GLOW[hotspot])
        target := TITLE_HOTSPOT_TARGET[hotspot]
        if target >= 0 { unused TitleReady(TITLE_SCENE_LOW[ResolveTitleSceneVariant(target, bounds.width, bounds.height)]); unused TitleReady(TITLE_SCENE_IMAGE[ResolveTitleSceneVariant(target, bounds.width, bounds.height)]) }
    }
    glowing := TitleGlowing(title_state)
    guide := TitleGuide(*title_state, now, sound_muted || guide_muted,
        action.sound_toggle || key != 0 || (pointer.pressed && !guide_hover), language)
    guiding := guide.active
    if guiding && title_state.guide_step == 0 && title_state.pending < 0 && title_state.pressed < 0 {
        glowing = TitleGuideHotspot(0, scene)
    }
    action.guide_stop = guide.stop
    action.guide_finished = guide.finished
    if guide.voice {
        action.guide_voice = TitleGuideVoicePath(guide.step, language)
    }
    if glowing >= 0 {
        // A slow, gentle pulse over exactly the item.
        wave := Sin(now * 6.283185307 / 1.8)
        alpha := cast(u32)(255.0 * (0.74 + 0.26 * wave))
        rect := glowing * 4
        TitlePicture(session, TITLE_HOTSPOT_GLOW[glowing], Rectangle.{
            picture.x + cast(float32)TITLE_GLOW_RECT[rect] * view.scale,
            picture.y + cast(float32)TITLE_GLOW_RECT[rect + 1] * view.scale,
            cast(float32)TITLE_GLOW_RECT[rect + 2] * view.scale,
            cast(float32)TITLE_GLOW_RECT[rect + 3] * view.scale}, cast(u32)0xffffff00 | alpha)
    }
    paper = TitlePaperSpot(scene, view, bounds.width, bounds.height)
    if paper.index >= 0 && SecretPaperShown(title_papers.papers[paper.index], paper.index,
        CollectionHas(collection, collectible_slugs[paper.index])) {
        SecretPaperDraw(bounds.x + paper.x, bounds.y + paper.y, paper.size, SecretPaperGlow(now), 1.0)
    }

    if guiding {
        guide_anchor = TitleGuideAnchor(*title_state, view, bounds, unit, width, height)
        guide_place = TitleGuideLayout(width, height, guide_anchor)
        skip_x := guide_place.bubble.x + guide_place.bubble.width - 21
        skip_y := guide_place.bubble.y + 5
        guide_sound_x := guide_place.bubble.x + guide_place.bubble.width - 42
        guide_sound_y := guide_place.bubble.y + 5
        skip_label := ifx language == 1 then "Anleitung überspringen" else ifx language == 2 then "Saltar la guía" else "Skip guide"
        skip := RetroTap(712, skip_x, skip_y, 16, 16, skip_label)
        guide_sound_label := ifx language == 1 then (ifx guide_muted then "Anleitungston aus" else "Anleitungston an") else ifx language == 2 then (ifx guide_muted then "Guía sin sonido" else "Guía con sonido") else (ifx guide_muted then "Guide sound off" else "Guide sound on")
        guide_sound := RetroTap(711, guide_sound_x, guide_sound_y, 16, 16, guide_sound_label)
        skip_hit := pointer.pressed && px >= cast(float32)skip_x * unit && px < cast(float32)(skip_x + 16) * unit &&
            py >= cast(float32)skip_y * unit && py < cast(float32)(skip_y + 16) * unit
        guide_sound_hit := pointer.pressed && px >= cast(float32)guide_sound_x * unit &&
            px < cast(float32)(guide_sound_x + 16) * unit &&
            py >= cast(float32)guide_sound_y * unit && py < cast(float32)(guide_sound_y + 16) * unit
        BookBox(guide_place.bubble.x, guide_place.bubble.y, guide_place.bubble.width, guide_place.bubble.height,
            0xf7f1e3f2, 0xdacdb5ff, 8.0)
        tail_x := guide_anchor.x + guide_anchor.width / 2
        if tail_x < guide_place.bubble.x + 16 { tail_x = guide_place.bubble.x + 16 }
        if tail_x > guide_place.bubble.x + guide_place.bubble.width - 16 {
            tail_x = guide_place.bubble.x + guide_place.bubble.width - 16
        }
        tail_top := guide_anchor.y + guide_anchor.height <= guide_place.bubble.y + 4
        for offset: cast(s32)0..5 {
            tail_width := 12 - offset * 2
            tail_y := ifx tail_top then guide_place.bubble.y + 1 + offset else guide_place.bubble.y + guide_place.bubble.height - 2 - offset
            BookBox(tail_x - tail_width / 2, tail_y, tail_width, 1, 0xf7f1e3ff)
        }
        BookPicture("assets/jungle/title/guide/tiger.png", guide_place.mascot.x, guide_place.mascot.y,
            guide_place.mascot.width, guide_place.mascot.height)
        BookText(guide_place.text.x, guide_place.text.y, guide_place.text.width, guide_place.text.height,
            TitleGuideText(guide.step, language), 10, TextAlign.TextAlignStart, false)
        BookBox(skip_x, skip_y, 16, 16, ifx skip.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3ff,
            0xbba98bff, 4.0)
        BookText(skip_x, skip_y, 16, 16, "X", 10, TextAlign.TextAlignCenter, false)
        BookBox(guide_sound_x, guide_sound_y, 16, 16,
            ifx guide_sound.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3ff, 0xbba98bff, 4.0)
        SvgIcon(session, SvgIconProps.{.bounds = RetroRect(guide_sound_x + 2, guide_sound_y + 2, 12, 12),
            .shape = ifx guide_muted then SoundOffIcon.Shape else SoundOnIcon.Shape, .color = ColorFromPacked(0x3e332aff)})
        if skip_hit || skip.clicked {
            TitleGuideSkip(*title_state)
            title_state.guide_finished_reported = true
            action.guide_stop = true
            action.guide_finished = true
        }
        if guide_sound_hit || guide_sound.clicked {
            action.guide_mute_toggle = true
            if !guide_muted { action.guide_stop = true }
        }
    }
    action.language_changed = TitleLanguageFlags()
    sound_label := ifx sound_muted then "Sound off · F10" else "Sound on · F10"
    sound := RetroTap(500, width - 32, 6, 26, 22, sound_label)
    BookBox(width - 32, 6, 26, 22, ifx sound.down then cast(u32)0xdcebdcf0 else cast(u32)0xf7f1e3d8, 0xdacdb5ff, 4.0)
    SvgIcon(session, SvgIconProps.{.bounds = RetroRect(width - 27, 9, 16, 16),
        .shape = ifx sound_muted then SoundOffIcon.Shape else SoundOnIcon.Shape, .color = ColorFromPacked(0x3e332aff)})
    if sound.clicked { action.sound_toggle = true }
    if message != "" {
        BookBox(width / 2 - 90, height - 30, 180, 22, 0xf7f1e3e8, 0xdacdb5ff, 6.0)
        BookText(width / 2 - 86, height - 30, 172, 22, message, 10)
    }
    retro.scale = 1.0
    action.collection_open = CollectionBookButton(cast(s32)bounds.width - 106, 6)
    TitlePaperFlights(cast(s32)bounds.width - 106, 6, now)
    return action
}

// Each collected paper's empty scene line art flies from where the paper lay
// into the Collection Book button at X, Y, among fading sparkles. Window
// pixels, drawn with retro.scale 1.
TitlePaperFlights :: (x: s32, y: s32, now: float64) {
    target := CollectRect.{x, y, 44, 44}
    for index: cast(s32)0..COLLECTIBLE_COUNT - 1 {
        paper := *title_papers.papers[index]
        SecretPaperStep(paper, now)
        if paper.state != SECRET_PAPER_FLYING { continue }
        progress := SecretPaperProgress(paper.*, now)
        place := CollectFlight(paper.start, target, progress)
        shown := RetroRect(place.x, place.y, place.width, place.height)
        SecretPaperBox(shown.x, shown.y, shown.width, shown.height, 0xfffdf8ff, 1.0 - progress * progress * 0.3, 4.0)
        path := ifx album_outlines[index] != "" then album_outlines[index] else AlbumOutlinePath(index)
        Image(retro.session, ImageProps.{.asset_path = RetroImageShown(path), .bounds = shown,
            .fit = ImageFit.ImageFitContain, .smooth = true})
        SecretPaperTwinkle(place.x + place.width / 2, place.y + place.height / 2, place.width / 2, 1.0 - progress * progress)
    }
}

// Shared by native desktop/Android and web. Back belongs to the album while open.
CollectionBookFrame :: (session: Session, bounds: Rectangle, key: s32, now: float64, muted: bool, collection: Collection) -> bool {
    bar := GameTitleBar(session, bounds, key, now, "Collection Book", muted)
    AlbumContent(collection, cast(s32)bounds.width, cast(s32)bounds.height)
    if bar.back || key == 256 { CollectionBookBack() }
    return bar.sound_toggle || key == 299
}

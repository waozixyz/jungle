// The same title screen is drawn by the native and browser hosts.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/text_align"
#import "kryon/drawing_props"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "kryon/title_bar_props"
#import "kryon/dropdown_props"
#import "kryon/title_bar_widget"
SoundOnIcon :: #import "mingcute/mingcute_regular_volume";
SoundOffIcon :: #import "mingcute/mingcute_regular_volume_off";
#import, file "../retro/retro.zi";
#import, file "../retro/book_theme.zi";
#import, file "../retro/language.zi";
#import, file "jungle_text.zi";

Game :: struct {
    bundle_name: string
    title: string
    about: string
    icon: string
    age: s32
}

MenuAction :: struct {
    game: s32
    language_changed: bool
    sound_toggle: bool
    navigated: bool
}

menu_height: s32;
menu_portrait: bool;
menu_learning: bool;
menu_lesson_choice: s32;
menu_root_choice: s32;
GAME_BAR_HEIGHT :: 56

TitleBarAction :: struct {
    back: bool
    sound_toggle: bool
}

// Back on the left, the game's name, and sound on or off on the right.
GameTitleBar :: (session: Session, bounds: Rectangle, key: s32, now: float64, title: string, sound_muted: bool) -> TitleBarAction {
    retro = Retro.{.session = session, .font = "assets/jungle/font.png", .now = now, .key = key,
        .x = bounds.x, .y = bounds.y, .scale = 1.0, .glyph_height = 16}
    action: TitleBarAction
    width := cast(s32)bounds.width
    BookPalette()
    options: [0]DropdownOption
    bar := TitleBar(session, TitleBarProps.{.key = 9001,
        .bounds = Rectangle.{bounds.x, bounds.y, bounds.width, cast(float32)GAME_BAR_HEIGHT},
        .height = GAME_BAR_HEIGHT, .title = Tr(title), .has_leading_action = true,
        .leading_label = Tr("Back"), .trailing_width = 60}, options[:])
    action.back = bar.clicked_leading
    sound := RetroTap(9002, width - 56, 6, 44, 44, ifx sound_muted then "Sound off · F10" else "Sound on · F10")
    BookBox(width - 56, 6, 44, 44, ifx sound.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0xdacdb5ff, 4.0)
    SvgIcon(session, SvgIconProps.{.bounds = RetroRect(width - 49, 13, 30, 30),
        .shape = ifx sound_muted then SoundOffIcon.Shape else SoundOnIcon.Shape, .color = ColorFromPacked(0x3e332aff)})
    action.sound_toggle = sound.clicked
    return action
}

// Flags retain their native language names on the same cream paper as the book.
LanguageFlags :: () -> bool {
    changed := false
    names: [3]string = .["English", "Deutsch", "Español"]
    codes: [3]string = .["en", "de", "es"]
    for index: cast(s32)0..2 {
        x := 22 + index * 94
        y: s32 = ifx menu_portrait then 66 else 45
        h: s32 = ifx menu_portrait then 36 else 18
        press := RetroTap(510 + index, x, y, 88, h, names[index])
        selected := language == index
        BookBox(x, y, 88, h, ifx selected then cast(u32)0xdcebdcff else cast(u32)0xf7f1e3ff,
            ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
        // Small flags drawn as pixels; labels use the book's native lettering.
        if index == 0 {
            RetroFill(x + 4, y + (h - 12) / 2, 20, 12, BLUE)
            for line: cast(s32)0..11 {
                RetroFill(x + 4 + line * 19 / 11, y + (h - 12) / 2 + line, 1, 1, WHITE)
                RetroFill(x + 23 - line * 19 / 11, y + (h - 12) / 2 + line, 1, 1, WHITE)
            }
            RetroFill(x + 12, y + (h - 12) / 2, 4, 12, WHITE)
            RetroFill(x + 4, y + (h - 12) / 2 + 4, 20, 4, WHITE)
            RetroFill(x + 13, y + (h - 12) / 2, 2, 12, RED)
            RetroFill(x + 4, y + (h - 12) / 2 + 5, 20, 2, RED)
        } else if index == 1 {
            RetroFill(x + 4, y + (h - 12) / 2, 20, 4, BLACK)
            RetroFill(x + 4, y + (h - 12) / 2 + 4, 20, 4, RED)
            RetroFill(x + 4, y + (h - 12) / 2 + 8, 20, 4, YELLOW)
        } else {
            RetroFill(x + 4, y + (h - 12) / 2, 20, 12, RED)
            RetroFill(x + 4, y + (h - 12) / 2 + 3, 20, 6, YELLOW)
        }
        BookText(x + 28, y, 56, h, names[index], 9)
        if press.clicked {
            LanguageSet(codes[index])
            changed = true
        }
    }
    return changed
}

JungleMenu :: (session: Session, bounds: Rectangle, key: s32, now: float64, font: string,
    games: []Game, choice: *s32, sound_muted: bool, message: string) -> MenuAction {
    action := MenuAction.{.game = -1}
    source_count := cast(s32)games.count
    abc: s32 = -1
    numbers: s32 = -1
    for index: cast(s32)0..source_count - 1 {
        if games[index].title == "ABC Book" { abc = index }
        if games[index].title == "123 Book" { numbers = index }
    }
    combined := abc >= 0 && numbers >= 0
    if !combined { menu_learning = false }
    order: [8]s32
    game_count: s32 = 0
    if menu_learning {
        order[0] = abc
        order[1] = numbers
        game_count = 2
    } else {
        for index: cast(s32)0..source_count - 1 {
            if combined && index == numbers { continue }
            order[game_count] = index
            game_count += 1
        }
    }
    visible_choice := ifx menu_learning then menu_lesson_choice else menu_root_choice
    if visible_choice < 0 || visible_choice >= game_count { visible_choice = 0 }
    RetroBegin(session, bounds, font, now, key, BLACK)
    retro.y = bounds.y
    menu_height = cast(s32)(bounds.height / retro.scale)
    menu_portrait = bounds.height > bounds.width
    BookPaperSized(320, menu_height)
    heading_y: s32 = ifx menu_portrait then 16 else 12
    heading_height: s32 = ifx menu_portrait then 28 else 20
    if menu_learning {
        if BookBack(600, 22, heading_y, 24, heading_height) || key == KEY_ESCAPE {
            menu_learning = false
            menu_root_choice = ifx numbers < abc then abc - 1 else abc
            choice.* = abc
            return action
        }
    }
    heading_x: s32 = ifx menu_learning then 54 else 24
    BookText(heading_x, heading_y, 296 - heading_x, heading_height,
        ifx menu_learning then "ABC + 123" else "Jungle Academy", ifx menu_portrait then 20 else 16)
    BookText(24, ifx menu_portrait then 48 else 34, 272, ifx menu_portrait then 12 else 8,
        ifx menu_learning then "Choose a book" else "Choose a little adventure", ifx menu_portrait then 8 else 7)
    action.language_changed = LanguageFlags()
    row_height: s32 = ifx menu_portrait then (menu_height - 164) / game_count else (menu_height - 95) / game_count
    if !menu_portrait && row_height > 35 { row_height = 35 }
    row_top: s32 = ifx menu_portrait then 112 else 67
    activated: s32 = -1
    for slot: cast(s32)0..game_count - 1 {
        index := order[slot]
        group := combined && !menu_learning && index == abc
        title := ifx group then "ABC + 123" else games[index].title
        about := ifx group then "Letters and numbers" else games[index].about
        y := row_top + slot * row_height
        h := row_height - 4
        press := RetroTap(100 + slot, 22, y, 276, h, title)
        if press.down { visible_choice = slot }
        selected := slot == visible_choice
        BookBox(22, y, 276, h, ifx selected then cast(u32)0xe5eee1ff else cast(u32)0xf7f1e3ff,
            ifx selected then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
        picture: s32 = ifx menu_portrait then 68 else 29
        if picture > h - 8 { picture = h - 8 }
        if picture < 1 { picture = 1 }
        image_y := y + (h - picture) / 2
        BookPicture(ifx group then "assets/jungle/covers/abc-123.png" else games[index].icon, 25, image_y, picture, picture)
        text_x := 25 + picture + 9
        if h >= 54 {
            text_y := y + (h - 42) / 2
            BookText(text_x, text_y, 259 - text_x, 26, title, 17, TextAlign.TextAlignStart)
            BookText(text_x, text_y + 28, 259 - text_x, 14, about, 10, TextAlign.TextAlignStart)
        } else {
            title_size := (h - 8) * 3 / 5
            if title_size > 17 { title_size = 17 }
            BookText(text_x, y + 4, 259 - text_x, h - 8, title, title_size, TextAlign.TextAlignStart)
        }
        badge_height: s32 = ifx h < 24 then 13 else 15
        BookBox(267, y + (h - badge_height) / 2, 24, badge_height, 0xeee4cfff, 0xd6c6a8ff, 5.0)
        BookText(267, y + (h - badge_height) / 2, 24, badge_height, Cat(NumberText(games[index].age), "+"), 9)
        if press.clicked { activated = slot }
    }
    footer: s32 = ifx menu_portrait then menu_height - 50 else menu_height - 26
    footer_height: s32 = ifx menu_portrait then 36 else 14
    BookText(24, footer + (footer_height - 10) / 2, 150, 10, ifx message != "" then message else "Arrows + Enter", 8, TextAlign.TextAlignStart)
    sound := RetroTap(500, 182, footer, 116, footer_height, ifx sound_muted then "Sound off · F10" else "Sound on · F10")
    BookBox(182, footer, 116, footer_height, ifx sound.down then cast(u32)0xdcebdcff else cast(u32)0xeee4cfff,
        0xd6c6a8ff, 4.0)
    BookText(182, footer, 116, footer_height, ifx sound_muted then "Sound off · F10" else "Sound on · F10", 8)
    if sound.clicked || key == 299 { action.sound_toggle = true }
    if key == KEY_UP || key == KEY_DOWN {
        step: s32 = ifx key == KEY_UP then game_count - 1 else 1
        visible_choice = (visible_choice + step) % game_count
        action.navigated = true
    }
    if key == KEY_ENTER { activated = visible_choice }
    if key >= 49 && key < 49 + game_count { activated = key - 49 }
    if menu_learning { menu_lesson_choice = visible_choice }
    else { menu_root_choice = visible_choice; choice.* = order[visible_choice] }
    if activated >= 0 {
        if menu_learning { menu_lesson_choice = activated }
        else { menu_root_choice = activated; choice.* = order[activated] }
        index := order[activated]
        if combined && !menu_learning && index == abc {
            menu_learning = true
            menu_lesson_choice = 0
        } else { action.game = index }
    }
    return action
}

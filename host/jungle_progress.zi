// Carry the counting ladder from Jungle Math into Animal Counting.
#import, file "jungle_text.zi";
#import "std/vec"

// Separate from activity saves: a visit is recorded only after entering a
// real place. Unknown future areas round-trip; malformed saves stay untouched.
EXPLORATION_HEADER :: "JUNGLE EXPLORED 1\n"
Exploration :: struct {
    areas: Text // Newline-terminated areas, in the order first visited.
    valid: bool
    dirty: bool
}

ExplorationAreaValid :: (area: string) -> bool {
    if area.count == 0 || area.count > 64 { return false }
    for at: cast(s64)0..area.count - 1 {
        letter := area[at]
        if (letter >= #char "a" && letter <= #char "z") ||
            (at > 0 && at + 1 < area.count && letter == #char "-") { continue }
        return false
    }
    return true
}

ExplorationHas :: (exploration: *Exploration, area: string) -> bool {
    areas := TextView(exploration.areas)
    at: s64 = 0
    while at < areas.count {
        end := at
        while end < areas.count && areas[end] != cast(u8)10 { end += 1 }
        if areas[at:end] == area { return true }
        at = end + 1
    }
    return false
}

ExplorationVisit :: (exploration: *Exploration, area: string) -> bool {
    if !ExplorationAreaValid(area) || ExplorationHas(exploration, area) { return false }
    BuilderAppend(exploration.areas.bytes, area)
    BuilderAppend(exploration.areas.bytes, "\n")
    exploration.dirty = true
    return true
}

ExplorationParse :: (text: string) -> Exploration {
    if text == "" { return Exploration.{.valid = true} }
    if text.count > 8192 || text.count < EXPLORATION_HEADER.count ||
        text[:EXPLORATION_HEADER.count] != EXPLORATION_HEADER { return Exploration.{} }
    parsed: Exploration
    at := EXPLORATION_HEADER.count
    while at < text.count {
        end := at
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        area := text[at:end]
        if !ExplorationAreaValid(area) { return Exploration.{} }
        unused ExplorationVisit(*parsed, area)
        at = end + 1
    }
    parsed.valid = true
    parsed.dirty = false
    return parsed
}

ExplorationText :: (exploration: *Exploration) -> Text {
    return Cat(EXPLORATION_HEADER, TextView(exploration.areas))
}

ExplorationSceneArea :: (name: string) -> string {
    base := name
    if base.count > 9 && base[base.count - 9:] == "-portrait" { base = base[:base.count - 9] }
    if base == "bookshelf" || base == "window" { return "treehouse" }
    if base == "map" { return "" }
    return base
}

AnimalLevels :: (text: string) -> string {
    at: s64 = 0
    while at < text.count {
        end := at
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        line := text[at:end]
        at = end + 1
        if line.count < 6 || line[:6] != "skill " { continue }
        cursor: s64 = 6
        values: [4]s32
        valid := true
        for field: cast(s32)0..3 {
            values[field] = ReadWhole(line, *cursor)
            if values[field] < 0 { valid = false }
            if field < 3 {
                if cursor >= line.count || line[cursor] != #char " " { valid = false }
                cursor += 1
            }
        }
        if cursor < line.count && line[cursor] == cast(u8)13 { cursor += 1 }
        if !valid || cursor != line.count || values[0] != 0 || values[1] < 1 || values[1] > 6 { continue }
        right := ifx values[2] < 6 then values[2] else 0
        misses := ifx values[3] < 6 then values[3] else 0
        return Cat("animal ", NumberText(values[1]), " 0 ", NumberText(right), " ", NumberText(misses), "\n")
    }
    return ""
}

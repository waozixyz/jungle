// Small text helpers shared by Jungle's screens and tools.
#import "std/number_text"
#import "std/vec"

// Joins up to nine pieces of text. The Text is freed once its caller is done reading it.
Cat :: (a: string, b: string = "", c: string = "", d: string = "", e: string = "", f: string = "", g: string = "",
    h: string = "", i: string = "") -> Text {
    // Appended one by one, never copied into a local array, so the pieces
    // stay read-only and a caller's own Text pieces are freed as well.
    text: Vec(u8)
    BuilderAppend(text, a); BuilderAppend(text, b); BuilderAppend(text, c)
    BuilderAppend(text, d); BuilderAppend(text, e); BuilderAppend(text, f)
    BuilderAppend(text, g); BuilderAppend(text, h); BuilderAppend(text, i)
    return BuilderFinish(text)
}

NumberText :: (value: s32) -> Text {
    digits: [24]u8
    return Cat(FormatInteger(cast(s64)value, digits[:]))
}

// Reads a whole number at `at`, moving past it; -1 when there is none.
ReadWhole :: (text: string, at: *s64) -> s32 {
    if at.* >= text.count || text[at.*] < #char "0" || text[at.*] > #char "9" { return -1 }
    value: s32 = 0
    while at.* < text.count && text[at.*] >= #char "0" && text[at.*] <= #char "9" && value < 100000000 {
        value = value * 10 + cast(s32)(text[at.*] - #char "0")
        at.* += 1
    }
    return value
}

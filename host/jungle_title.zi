// The treehouse title screen's scenes without drawing: where a scene picture
// sits in the window, which painted item a point falls on, and how pointer,
// touch and keys move between scenes. host/jungle_menu.zi draws it.
#import, file "jungle_title_data.zi";
#import, file "jungle_text.zi";
#import, file "../retro/collectibles.zi";
#import, file "../retro/collect_flight.zi";
#import, file "../retro/paper_rules.zi";
#import, file "../retro/collectibles.zi";
#import, file "../retro/collect_flight.zi";

// A tap on a touch screen glows this long before its item opens.
TITLE_TAP_SECONDS :: 0.25
// A press that moves further than this pans the picture instead of tapping.
TITLE_DRAG_PIXELS :: 12.0
TITLE_GUIDE_STEP_COUNT :: 3

// An explicit compiler define is the only way to expose unfinished rooms.
// Release hosts (including Android and web) default to the modal policy.
TitleTestRooms :: () -> bool {
    #if #defined(JUNGLE_TEST_ROOMS) {
        return true
    } else {
        return false
    }
}

// Source pixel (x, y) of the scene picture is window pixel
// (view.x + x * view.scale, view.y + y * view.scale).
TitleView :: struct {
    x: float32
    y: float32
    scale: float32
    // How far the picture may pan either way from centered.
    pan_x_limit: float32
    pan_y_limit: float32
}

TitleState :: struct {
    not_implemented: bool
    // 1 Farm, 2 Desert: neutral, labeled development rooms, not gameplay.
    preview_room: s32
    guide_stopped: bool
    guide_at: float64
    guide_step: s32
    guide_spoken_step: s32
    guide_finished_reported: bool
    started: bool
    scene: s32
    // The keyboard selection, the hotspot under a hovering mouse, the
    // hotspot a press began on and a tapped hotspot about to open; -1 none.
    selected: s32
    hovered: s32
    pressed: s32
    pending: s32
    pending_at: float64
    // A mouse moved with no button down, so the pointer hovers. Touch never
    // does; keys hand the glow back to the keyboard selection.
    hover_mode: bool
    seen: bool
    last_x: float32
    last_y: float32
    tracking: bool
    dragging: bool
    press_x: float32
    press_y: float32
    press_pan_x: float32
    press_pan_y: float32
    // The picture's offset from centered, in window pixels.
    pan_x: float32
    pan_y: float32
    // Center the keyboard selection when the picture overflows the window.
    focus: bool
}

TitleStep :: struct {
    // The hotspot whose game opens now, or -1.
    game: s32
    // The scene or keyboard selection changed.
    moved: bool
}

TitleDismissNotice :: (state: *TitleState) {
    state.not_implemented = false
    state.pending = -1
    state.pressed = -1
    state.tracking = false
    state.dragging = false
}

TitleDevelopmentAvailable :: (state: TitleState) -> bool {
    return TitleTestRooms() && !state.not_implemented && state.preview_room == 0 &&
        TITLE_SCENE_NAME[TITLE_SCENE_BASE[state.scene]] == "campus"
}

// Temporary development navigation while the new campus art awaits approval.
// It works with normal metadata and has no release-build entry point.
TitleDevelopmentRoom :: (state: *TitleState, room: s32) -> TitleStep {
    step := TitleStep.{.game = -1}
    if !TitleDevelopmentAvailable(state.*) || room < 0 || room > 2 { return step }
    state.guide_stopped = true
    state.pending = -1
    state.pressed = -1
    state.tracking = false
    if room == 0 {
        for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
            if TITLE_SCENE_NAME[scene] == "beach" { TitleEnter(state, scene); step.moved = true; return step }
        }
        return step
    }
    state.preview_room = room
    step.moved = true
    return step
}

TitleStart :: (state: *TitleState) {
    state.* = TitleState.{.started = true}
    state.guide_spoken_step = -1
    TitleEnter(state, 0)
}

// Shows SCENE, centered, with nothing glowing.
TitleEnter :: (state: *TitleState, scene: s32) {
    state.preview_room = 0
    state.scene = scene
    state.selected = -1
    state.hovered = -1
    state.pressed = -1
    state.pending = -1
    state.tracking = false
    state.dragging = false
    state.pan_x = 0.0
    state.pan_y = 0.0
    state.focus = false
}

// Cover-fits the picture to a window WIDTH by HEIGHT: it fills the window,
// and the overflowing side (a portrait phone's width) pans by PAN, clamped.
TitleFit :: (width: float32, height: float32, pan_x: float32, pan_y: float32, scene: s32 = 0) -> TitleView {
    across := width / cast(float32)TITLE_SCENE_WIDTH[scene]
    down := height / cast(float32)TITLE_SCENE_HEIGHT[scene]
    scale := ifx across > down then across else down
    if scale <= 0.0 { scale = 1.0 }
    picture_width := cast(float32)TITLE_SCENE_WIDTH[scene] * scale
    picture_height := cast(float32)TITLE_SCENE_HEIGHT[scene] * scale
    view := TitleView.{.scale = scale}
    view.pan_x_limit = (picture_width - width) / 2.0
    view.pan_y_limit = (picture_height - height) / 2.0
    if view.pan_x_limit < 0.0 { view.pan_x_limit = 0.0 }
    if view.pan_y_limit < 0.0 { view.pan_y_limit = 0.0 }
    view.x = (width - picture_width) / 2.0 + TitleClamp(pan_x, view.pan_x_limit)
    view.y = (height - picture_height) / 2.0 + TitleClamp(pan_y, view.pan_y_limit)
    return view
}

// Canonical destinations resolve on each frame, including after rotation.
ResolveTitleSceneVariant :: (scene: s32, viewportWidth: float32, viewportHeight: float32) -> s32 {
    base := TITLE_SCENE_BASE[scene]
    return ifx viewportHeight > viewportWidth then TITLE_SCENE_PORTRAIT[base] else base
}

TitleResolve :: (state: *TitleState, width: float32, height: float32) {
    scene := ResolveTitleSceneVariant(state.scene, width, height)
    if scene == state.scene { return }
    // Never carry a pending tap or drag across a change of composition.
    TitleEnter(state, scene)
}

TitleClamp :: (value: float32, limit: float32) -> float32 {
    if value > limit { return limit }
    if value < -limit { return -limit }
    return value
}

TitleSourceX :: (view: TitleView, x: float32) -> float32 { return (x - view.x) / view.scale }
TitleSourceY :: (view: TitleView, y: float32) -> float32 { return (y - view.y) / view.scale }

// Even-odd rule, so the art's zero-width bridges joining separate pieces
// (loose sorter shapes, a group of frogs) and holes work. Ladder hit polygons
// include the space between rungs; their separate glow art keeps its holes.
PointInPolygon :: (xs: []s32, ys: []s32, x: float32, y: float32) -> bool {
    count := cast(s32)xs.count
    if count < 3 || cast(s32)ys.count != count { return false }
    inside := false
    previous := count - 1
    for index: cast(s32)0..count - 1 {
        xi := cast(float32)xs[index]
        yi := cast(float32)ys[index]
        xj := cast(float32)xs[previous]
        yj := cast(float32)ys[previous]
        if (yi > y) != (yj > y) {
            crossing := xi + (y - yi) * (xj - xi) / (yj - yi)
            if x < crossing { inside = !inside }
        }
        previous = index
    }
    return inside
}

TitleInside :: (hotspot: s32, x: float32, y: float32) -> bool {
    chunk := TITLE_POLYGON_CHUNK[hotspot]
    first := TITLE_POLYGON_FIRST[hotspot]
    end := first + TITLE_POLYGON_COUNT[hotspot]
    if !PointInPolygon(TitlePointsX(chunk)[first:end], TitlePointsY(chunk)[first:end], x, y) { return false }
    chunk = TITLE_OCCLUSION_CHUNK[hotspot]
    first = TITLE_OCCLUSION_FIRST[hotspot]
    end = first + TITLE_OCCLUSION_COUNT[hotspot]
    return !PointInPolygon(TitlePointsX(chunk)[first:end], TitlePointsY(chunk)[first:end], x, y)
}

// The hotspot of SCENE under source pixel (x, y), or -1. Where items
// overlap, the smaller one wins, as it sits in front.
TitleHit :: (scene: s32, x: float32, y: float32) -> s32 {
    if scene < 0 || scene >= TITLE_SCENE_COUNT { return -1 }
    found: s32 = -1
    found_area: s32 = 0
    first := TITLE_SCENE_FIRST[scene]
    for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 {
        if !TitleInside(hotspot, x, y) { continue }
        area := TITLE_GLOW_RECT[hotspot * 4 + 2] * TITLE_GLOW_RECT[hotspot * 4 + 3]
        if found < 0 || area < found_area { found = hotspot; found_area = area }
    }
    return found
}

// The hotspot that glows now, or -1.
TitleGlowing :: (state: TitleState) -> s32 {
    if state.pending >= 0 { return state.pending }
    if state.pressed >= 0 && !state.dragging { return state.pressed }
    if state.hover_mode { return state.hovered }
    return state.selected
}

// Shared by physical pointer taps and the sign's accessible button. Every
// sign click pauses for the same gentle glow, even after mouse hover.
TitleQueue :: (state: *TitleState, hotspot: s32, now: float64) {
    if state.not_implemented || state.preview_room != 0 { return }
    if hotspot < 0 || hotspot >= TITLE_HOTSPOT_COUNT { return }
    if state.pending == hotspot { return }
    state.pending = hotspot
    state.pending_at = now
}

// A small nod of the whole sign (wood and lettering together), returning
// to rest before the existing tap transition opens its destination.
TitleSignLift :: (state: TitleState, hotspot: s32, now: float64) -> float32 {
    if state.pending != hotspot { return ifx state.pressed == hotspot then -1.5 else 0.0 }
    progress := cast(float32)((now - state.pending_at) / TITLE_TAP_SECONDS)
    if progress < 0.0 || progress > 1.0 { return 0.0 }
    return -12.0 * progress * (1.0 - progress)
}

// A scene hotspot changes scene; a game hotspot reports its game.
TitleActivate :: (state: *TitleState, hotspot: s32) -> TitleStep {
    step := TitleStep.{.game = -1}
    if state.not_implemented || state.preview_room != 0 { return step }
    if hotspot < 0 || hotspot >= TITLE_HOTSPOT_COUNT { return step }
    state.pending = -1
    state.pressed = -1
    label := TITLE_SIGN_LABEL[hotspot]
    if label == "Beach" || label == "Farm" || label == "Desert" {
        if !TitleTestRooms() {
            state.not_implemented = true
            state.tracking = false
            state.dragging = false
            state.hovered = -1
            return step
        }
    }
    if TITLE_HOTSPOT_PREVIEW[hotspot] != 0 {
        if TitleTestRooms() { state.preview_room = TITLE_HOTSPOT_PREVIEW[hotspot]; step.moved = true }
        return step
    }
    target := TITLE_HOTSPOT_TARGET[hotspot]
    if target >= 0 {
        TitleEnter(state, target)
        step.moved = true
    } else {
        step.game = hotspot
    }
    return step
}

// Arrows move the glow through the scene's items in reading order, Enter
// opens it, Escape climbs back up, Home returns to the treehouse and 1-9
// open an item directly.
TitleKey :: (state: *TitleState, key: s32) -> TitleStep {
    step := TitleStep.{.game = -1}
    if state.not_implemented { return step }
    if state.preview_room != 0 {
        if key == 256 { state.preview_room = 0; step.moved = true }
        return step
    }
    if key == 66 { return TitleDevelopmentRoom(state, 0) }
    if key == 70 { return TitleDevelopmentRoom(state, 1) }
    if key == 68 { return TitleDevelopmentRoom(state, 2) }
    if key == 0 { return step }
    state.guide_stopped = true
    first := TITLE_SCENE_FIRST[state.scene]
    count := TITLE_SCENE_HOTSPOTS[state.scene]
    if key == 262 || key == 264 || key == 263 || key == 265 {
        state.hover_mode = false
        forward := key == 262 || key == 264
        if state.selected < first || state.selected >= first + count {
            state.selected = ifx forward then first else first + count - 1
        } else {
            step_by: s32 = ifx forward then 1 else count - 1
            state.selected = first + (state.selected - first + step_by) % count
        }
        state.focus = true
        step.moved = true
    } else if key == 268 {
        state.hover_mode = false
        if state.scene != 0 { step.moved = true }
        TitleEnter(state, 0)
    } else if key == 256 {
        state.hover_mode = false
        parent := TITLE_SCENE_PARENT[state.scene]
        if parent >= 0 { TitleEnter(state, parent); step.moved = true }
    } else if key == 257 {
        if state.selected >= first && state.selected < first + count {
            step = TitleActivate(state, state.selected)
        }
    } else if key >= 49 && key <= 57 && key - 49 < count {
        state.hover_mode = false
        step = TitleActivate(state, first + key - 49)
    }
    return step
}

// One frame of pointer input at window point (x, y), relative to the
// window's top left. BLOCKED is true over the corner controls. A mouse
// click opens the hovered item at once; a touch tap glows first and opens
// TITLE_TAP_SECONDS later. A drag pans an overflowing picture.
TitlePointer :: (state: *TitleState, view: TitleView, x: float32, y: float32,
    down: bool, pressed: bool, released: bool, blocked: bool, now: float64) -> TitleStep {
    step := TitleStep.{.game = -1}
    if state.not_implemented || state.preview_room != 0 { return step }
    moved := state.seen && (x != state.last_x || y != state.last_y)
    state.seen = true
    state.last_x = x
    state.last_y = y
    hit: s32 = -1
    if !blocked { hit = TitleHit(state.scene, TitleSourceX(view, x), TitleSourceY(view, y)) }
    if pressed {
        state.guide_stopped = true
        state.tracking = !blocked
        state.dragging = false
        state.press_x = x
        state.press_y = y
        state.press_pan_x = TitleClamp(state.pan_x, view.pan_x_limit)
        state.press_pan_y = TitleClamp(state.pan_y, view.pan_y_limit)
        state.pressed = hit
        state.pending = -1
    }
    if state.tracking && (down || released) {
        dx := x - state.press_x
        dy := y - state.press_y
        far := dx > TITLE_DRAG_PIXELS || dx < -TITLE_DRAG_PIXELS || dy > TITLE_DRAG_PIXELS || dy < -TITLE_DRAG_PIXELS
        if !state.dragging && far && (view.pan_x_limit > 0.0 || view.pan_y_limit > 0.0) {
            state.dragging = true
            state.pressed = -1
        }
        if state.dragging {
            state.pan_x = TitleClamp(state.press_pan_x + dx, view.pan_x_limit)
            state.pan_y = TitleClamp(state.press_pan_y + dy, view.pan_y_limit)
        }
    }
    if released && state.tracking {
        tapped := state.pressed
        state.tracking = false
        state.pressed = -1
        if !state.dragging && hit >= 0 && hit == tapped {
            if state.hover_mode && TITLE_SIGN_LABEL[hit] == "" { step = TitleActivate(state, hit) }
            else { TitleQueue(state, hit, now) }
        }
        state.dragging = false
    }
    if moved && !down && !pressed && !released {
        state.hover_mode = true
        state.selected = -1
    }
    state.hovered = ifx state.hover_mode && !down then hit else -1
    return step
}

// Opens a tapped item once it has glowed for TITLE_TAP_SECONDS.
TitleTick :: (state: *TitleState, now: float64) -> TitleStep {
    if state.pending >= 0 && now - state.pending_at >= TITLE_TAP_SECONDS {
        return TitleActivate(state, state.pending)
    }
    return TitleStep.{.game = -1}
}

// Pans an overflowing picture so the keyboard selection is in view.
TitleFocus :: (state: *TitleState, width: float32, height: float32) {
    if !state.focus { return }
    state.focus = false
    if state.selected < 0 { return }
    view := TitleFit(width, height, 0.0, 0.0, state.scene)
    rect := state.selected * 4
    center_x := cast(float32)TITLE_GLOW_RECT[rect] + cast(float32)TITLE_GLOW_RECT[rect + 2] / 2.0
    center_y := cast(float32)TITLE_GLOW_RECT[rect + 1] + cast(float32)TITLE_GLOW_RECT[rect + 3] / 2.0
    state.pan_x = TitleClamp(width / 2.0 - view.x - center_x * view.scale, view.pan_x_limit)
    state.pan_y = TitleClamp(height / 2.0 - view.y - center_y * view.scale, view.pan_y_limit)
}

// A compact first-run guide. Voice requests are edges; stop is safe to repeat
// and silence never queues.
TitleGuideFrame :: struct {
    active: bool
    step: s32
    voice: bool
    stop: bool
    finished: bool
}

TitleGuideSkip :: (state: *TitleState) {
    state.guide_stopped = true
}

TitleGuideText :: (step: s32, language: s32) -> string {
    if step == 0 {
        return ifx language == 1 then "Tippe auf ein Spielzeug." else ifx language == 2 then "Toca un juguete." else "Tap a toy."
    }
    if step == 1 {
        return ifx language == 1 then "Ziehe, um mehr zu sehen." else ifx language == 2 then "Arrastra para ver más." else "Drag to see more."
    }
    return ifx language == 1 then "Tippe auf den Lautsprecher." else ifx language == 2 then "Toca el altavoz." else "Tap the speaker."
}

TitleGuideVoicePath :: (step: s32, language: s32) -> string {
    name := ifx step == 0 then "step0" else ifx step == 1 then "step1" else "step2"
    folder := ifx language == 1 then "de" else ifx language == 2 then "es" else "en"
    return Cat("assets/jungle/title/guide/", folder, "/", name, ".wav")
}

TitleGuideDuration :: (step: s32, language: s32) -> float64 {
    if step == 0 {
        return ifx language == 1 then 2.57 else ifx language == 2 then 2.22 else 2.12
    }
    if step == 1 {
        return ifx language == 1 then 3.00 else ifx language == 2 then 3.05 else 2.81
    }
    return ifx language == 1 then 2.61 else ifx language == 2 then 2.86 else 2.00
}

TitleGuideRect :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
}

TitleGuidePlace :: struct {
    hit: TitleGuideRect
    bubble: TitleGuideRect
    mascot: TitleGuideRect
    text: TitleGuideRect
}

TitleGuideLayout :: (width: s32, height: s32, anchor: TitleGuideRect) -> TitleGuidePlace {
    bubble_width := ifx width < 190 then width - 12 else ifx width < 270 then 208 else 228
    if bubble_width < 120 { bubble_width = 120 }
    x := anchor.x + anchor.width / 2 - bubble_width / 2
    if x < 6 { x = 6 }
    if x + bubble_width > width - 6 { x = width - 6 - bubble_width }
    if x < 6 { x = 6 }
    y := anchor.y + anchor.height + 8
    if y + 48 > height - 8 { y = anchor.y - 56 }
    if y < 38 { y = height - 56 }
    if y + 48 > height - 8 { y = 8 }
    bubble := TitleGuideRect.{.x = x, .y = y, .width = bubble_width, .height = 48}
    mascot := TitleGuideRect.{.x = x + 6, .y = y + 8, .width = 32, .height = 32}
    text := TitleGuideRect.{.x = x + 42, .y = y, .width = bubble_width - 78, .height = 48}
    if x >= 44 {
        mascot.x = x - 38
        text.x = x + 8
        text.width = bubble_width - 58
    }
    hit := bubble
    if mascot.x < hit.x {
        hit.width += hit.x - mascot.x
        hit.x = mascot.x
    }
    return TitleGuidePlace.{.hit = hit, .bubble = bubble, .mascot = mascot, .text = text}
}

TitleGuideHotspot :: (step: s32, scene: s32) -> s32 {
    if scene < 0 || scene >= TITLE_SCENE_COUNT || step < 0 || step > 1 { return -1 }
    first := TITLE_SCENE_FIRST[scene]
    found: s32 = 0
    for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 {
        if TITLE_HOTSPOT_GUIDE[hotspot] != 0 { continue }
        if found == step { return hotspot }
        found += 1
    }
    return -1
}

TitleGuide :: (state: *TitleState, now: float64, muted: bool, interrupted: bool, language: s32) -> TitleGuideFrame {
    if interrupted { state.guide_stopped = true }
    if state.guide_at == 0.0 { state.guide_at = now }
    age := now - state.guide_at
    duration := TitleGuideDuration(state.guide_step, language)
    while !state.guide_stopped && age >= duration {
        state.guide_step += 1
        state.guide_at += duration
        state.guide_spoken_step = -1
        age = now - state.guide_at
        duration = TitleGuideDuration(state.guide_step, language)
    }
    frame := TitleGuideFrame.{.step = state.guide_step}
    if state.guide_stopped {
        frame.stop = !state.guide_finished_reported
        frame.finished = frame.stop
        state.guide_finished_reported = true
        return frame
    }
    if state.guide_step >= TITLE_GUIDE_STEP_COUNT {
        state.guide_stopped = true
        frame.stop = true
        frame.finished = true
        state.guide_finished_reported = true
        return frame
    }
    frame.active = true
    if !muted && state.guide_spoken_step != state.guide_step {
        frame.voice = true
        state.guide_spoken_step = state.guide_step
    }
    return frame
}

// A scene's hidden paper: one small white paper lies somewhere in the
// painting until a tap collects that scene's empty line art. No text, no
// voice; host/jungle_menu.zi draws it and flies the line art away.
TitlePaperPlace :: struct {
    // The registry entry the paper holds; -1 when the scene hides none.
    index: s32
    // Its middle and edge in window pixels, from the window's top left.
    x: float32
    y: float32
    size: float32
    reveal_x: float32
}

// One paper per registry entry, and whether the pointer's press began on one, and where.
TitlePapers :: struct {
    papers: [COLLECTIBLE_COUNT]SecretPaper
    pressed: bool
    press_x: float32
    press_y: float32
    reveal: [COLLECTIBLE_COUNT]float32
    reveal_at: float64
}

TitlePaperInput :: struct {
    // The pointer is the paper's this frame, hovering it or tapping it: the
    // scene treats it as blocked, so nothing glows or opens. A press is not
    // the paper's, so a drag that starts on it still pans the picture.
    owned: bool
    // This tap collected the paper for the first time.
    collected: bool
}

// The registry entry of SCENE's paper, in either composition; -1 when none.
TitlePaperIndex :: (scene: s32) -> s32 {
    if scene < 0 || scene >= TITLE_SCENE_COUNT { return -1 }
    index := CollectibleForTitle(TITLE_SCENE_NAME[TITLE_SCENE_BASE[scene]])
    if index < 0 || collectible_how_kinds[index] != COLLECTIBLE_HOW_PAPER { return -1 }
    return index
}

// Where SCENE's paper lies for VIEW in a WIDTH by HEIGHT window. The portrait
// picture has its own spot; both pan with the picture.
TitlePaperSpot :: (scene: s32, view: TitleView, width: float32, height: float32) -> TitlePaperPlace {
    place := TitlePaperPlace.{.index = TitlePaperIndex(scene)}
    if place.index < 0 { return place }
    portrait := TITLE_SCENE_BASE[scene] != scene
    nx := ifx portrait then collectible_portrait_x[place.index] else collectible_x[place.index]
    ny := ifx portrait then collectible_portrait_y[place.index] else collectible_y[place.index]
    place.x = view.x + nx * cast(float32)TITLE_SCENE_WIDTH[scene] * view.scale
    place.y = view.y + ny * cast(float32)TITLE_SCENE_HEIGHT[scene] * view.scale
    short := ifx width < height then width else height
    place.size = cast(float32)SecretPaperSize(short, 1.0)
    if TITLE_SCENE_PAPER[scene * 4 + 2] > 0 {
        place.x = view.x + cast(float32)TITLE_SCENE_PAPER[scene * 4] * view.scale
        place.y = view.y + cast(float32)TITLE_SCENE_PAPER[scene * 4 + 1] * view.scale
        place.size = cast(float32)TITLE_SCENE_PAPER[scene * 4 + 2] * view.scale
        place.reveal_x = cast(float32)TITLE_SCENE_PAPER[scene * 4 + 3] * view.scale
    }
    return place
}

// The paper slides out from under its foreground; the foreground never moves.
TitlePaperRevealed :: (place: TitlePaperPlace, amount: float32) -> TitlePaperPlace {
    shown := place
    shown.x += place.reveal_x * amount * amount * (3.0 - 2.0 * amount)
    return shown
}

// Whether window point X, Y finds the paper at PLACE, a little past its edge.
TitlePaperHit :: (place: TitlePaperPlace, x: float32, y: float32) -> bool {
    if place.index < 0 { return false }
    // A generous touch target around the visible edge, spanning the whole
    // reveal travel, keeps hover stable as the paper slides under the pointer.
    reach := place.size * 0.55
    if reach < 22.0 { reach = 22.0 }
    return x >= place.x - reach && x <= place.x + place.reveal_x + reach &&
        y >= place.y - reach && y <= place.y + reach
}

// One frame of pointer input at window point (x, y) for the paper at PLACE,
// before TitlePointer. COLLECTED: its line art was earned before, so no paper
// lies there. A tap on the waiting paper (pressed and released on it, moving
// less than a drag) collects it through COLLECT, and its line art starts flying.
TitlePaperPointer :: (papers: *TitlePapers, place: TitlePaperPlace, collected: bool, x: float32, y: float32,
    down: bool, pressed: bool, released: bool, now: float64, collect: SecretPaperCollect) -> TitlePaperInput {
    input: TitlePaperInput
    if place.index < 0 { papers.pressed = false; return input }
    paper := *papers.papers[place.index]
    SecretPaperStep(paper, now)
    over := SecretPaperShown(paper.*, place.index, collected) && TitlePaperHit(place, x, y)
    delta := cast(float32)(now - papers.reveal_at)
    papers.reveal_at = now
    if delta < 0.0 { delta = 0.0 }
    if delta > 0.05 { delta = 0.05 }
    goal: float32 = ifx over then 1.0 else 0.0
    papers.reveal[place.index] += (goal - papers.reveal[place.index]) * delta * 12.0
    if pressed {
        papers.pressed = over
        papers.press_x = x
        papers.press_y = y
    }
    input.owned = over && !down
    if released && papers.pressed {
        papers.pressed = false
        dx := x - papers.press_x
        dy := y - papers.press_y
        still := dx <= TITLE_DRAG_PIXELS && dx >= -TITLE_DRAG_PIXELS && dy <= TITLE_DRAG_PIXELS && dy >= -TITLE_DRAG_PIXELS
        if over && still {
            input.owned = true
            // The line art unfolds out of the paper a little larger, then flies.
            edge := cast(s32)place.size
            shown := TitlePaperRevealed(place, papers.reveal[place.index])
            start := CollectRect.{cast(s32)shown.x - edge, cast(s32)shown.y - edge, edge * 2, edge * 2}
            unused SecretPaperTap(paper, place.index, collected, now, start, collect)
            input.collected = paper.state == SECRET_PAPER_FLYING
        }
    } else if !down {
        papers.pressed = false
    }
    return input
}

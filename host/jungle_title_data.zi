// Tap-through speech bubbles. Line L of dialogue D in language G (0 EN,
// 1 DE, 2 ES) is entry (TITLE_DIALOGUE_FIRST[D] + L) * 3 + G.
TITLE_DIALOGUE_COUNT :: 1
TITLE_DIALOGUE_ID: [1]string = .["desert-birds"];
TITLE_DIALOGUE_FIRST: [1]s32 = .[0];
TITLE_DIALOGUE_LINES: [1]s32 = .[4];
TITLE_DIALOGUE_TEXT: [12]string = .[
    "Hello! This is the big desert.",
    "Hallo! Das ist die große Wüste.",
    "¡Hola! Este es el gran desierto.",
    "It is very hot, and the other side is far away.",
    "Es ist sehr heiß, und die andere Seite ist weit weg.",
    "Hace mucho calor y el otro lado está muy lejos.",
    "First we need water, a sun hat and a little more learning.",
    "Zuerst brauchen wir Wasser, einen Sonnenhut und müssen noch ein bisschen lernen.",
    "Primero necesitamos agua, un sombrero para el sol y aprender un poco más.",
    "Come back when you are ready. We birds will wait for you here!",
    "Komm wieder, wenn du bereit bist. Wir Vögel warten hier auf dich!",
    "Vuelve cuando tengas todo listo. ¡Los pájaros te esperamos aquí!",
];

TitlePointsX :: (chunk: s32) -> []s32 {
    if chunk == 0 { return TITLE_POINT_X_0[:] }
    if chunk == 1 { return TITLE_POINT_X_1[:] }
    if chunk == 2 { return TITLE_POINT_X_2[:] }
    return TITLE_POINT_X_0[:0]
}

TitlePointsY :: (chunk: s32) -> []s32 {
    if chunk == 0 { return TITLE_POINT_Y_0[:] }
    if chunk == 1 { return TITLE_POINT_Y_1[:] }
    if chunk == 2 { return TITLE_POINT_Y_2[:] }
    return TITLE_POINT_Y_0[:0]
}

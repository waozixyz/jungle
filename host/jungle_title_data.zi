TitleHotspotGlow :: (index: s32) -> string {
    if index < 59 { return TITLE_HOTSPOT_GLOW_0[index - 0] }
    if index < 116 { return TITLE_HOTSPOT_GLOW_1[index - 59] }
    if index < 128 { return TITLE_HOTSPOT_GLOW_2[index - 116] }
    return ""
}

#import, file "../retro/language.zi";
// Jungle Academy: a menu of learning games for young children. Each game is its own
// .zx bundle in games/, run through Kryon's app host, with its saves in
// the user's data folder. Games may ask the app to play their sounds, to
// turn a painted canvas into a picture, and to go back to this menu.
//
//     jungle            the menu
//     jungle --check    opens every listed game and checks it can run here
#import "c_string"
#import "byte_text_linux"
#import "file"
#import "text_buffer"
#import "std/bundle_host"
#import "desktop_runtime"
#import "cairo_raster"
#import "session"
#import "geometry"
#import "text_align"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "scroll_device"
#import "key_input"
#import "text_input_props"
#import "system_clipboard"
#import "widget_host"
#import "hosted_values"
#import "app_files"
#import "app_local"
#import "app_context_host"
#import "app_protocol"
#import "bundle_app"
#import "bundle_assets"
#import "bundle_resources"
#import, file "../retro/retro.zi";
#import, file "../retro/book_theme.zi";
#import, file "platform.zi";
#import, file "sound.zi";
#import, file "canvas_png.zi";
#import, file "jungle_text.zi";
#import, file "jungle_menu.zi";
#import, file "jungle_progress.zi";
#import, file "../games/paint/paint_palette.zi";
#import, file "../games/paint/paint_picture.zi";
#import, file "printing.zi";

GAME_LIMIT :: 8
FONT :: "assets/jungle/font.png"
// Canvas pictures kept on disk: a page chooser shows six at once.
CANVAS_KEEP :: 12

jungle_sdl :: #system_library "SDL2";
Counter :: () -> u64 #foreign jungle_sdl "SDL_GetPerformanceCounter";
CounterRate :: () -> u64 #foreign jungle_sdl "SDL_GetPerformanceFrequency";
SdlStart :: (flags: u32) -> s32 #foreign jungle_sdl "SDL_InitSubSystem";
SdlRect :: struct {
    x: s32
    y: s32
    w: s32
    h: s32
}
UsableBounds :: (display: s32, area: *SdlRect) -> s32 #foreign jungle_sdl "SDL_GetDisplayUsableBounds";


games: [GAME_LIMIT]Game;
game_count: s32;
chosen: s32;
playing: bool;
game: BundleApp;
data_root: string;
sound_setting: string;
language_setting: string;
home_requested: bool;
game_secondary_down: bool;
book_assets_installed: bool;
message: string;
service_reply: [64]u8;
canvas_count: s32;
canvas_pixels: [CANVAS_PIXELS]u8;

Seconds :: () -> float64 {
    return cast(float64)Counter() / cast(float64)CounterRate()
}

ToggleSound :: () {
    SoundMuted(!sound_muted)
    unused WriteEntireFile(sound_setting, ifx sound_muted then "off\n" else "quiet\n")
}

// games/catalog.txt: one game a line, "FILE|TITLE|ABOUT|ICON|AGE".
LoadCatalog :: () -> bool {
    text, found := ReadEntireFile("games/catalog.txt")
    if !found { return false }
    at: s64 = 0
    while at < text.count && game_count < GAME_LIMIT {
        end := at
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        line := text[at:end]
        at = end + 1
        fields: [5]string
        field: s32 = 0
        start: s64 = 0
        for index: cast(s64)0..line.count {
            if (index == line.count || line[index] == #char "|") && field < 5 {
                fields[field] = Cat(line[start:index])
                field += 1
                start = index + 1
            }
        }
        age_at: s64 = 0
        age := ReadWhole(fields[4], *age_at)
        if field == 5 && fields[0] != "" && age >= 0 && age_at == fields[4].count {
            game := Game.{.bundle_name = fields[0], .title = fields[1], .about = fields[2],
                .icon = fields[3], .age = age}
            position := game_count
            while position > 0 && games[position - 1].age > game.age {
                games[position] = games[position - 1]
                position -= 1
            }
            games[position] = game
            game_count += 1
        }
    }
    return game_count > 0
}

Reply :: (text: string) -> HostValue {
    count := ifx text.count < 63 then text.count else 63
    for at: cast(s64)0..count - 1 { service_reply[at] = text[at] }
    service_reply[count] = 0
    return AppLocalText(TextUntilNul(service_reply[:]))
}

GameAllows :: (context: *void, name: string) -> bool {
    return name == "jungle.language" || name == "jungle.voice" || name == "jungle.voice-state" || name == "jungle.sound" || name == "jungle.home" || name == "jungle.canvas" ||
        name == "jungle.export" || name == "jungle.print" || name == "jungle.secondary" || BundleAppAllows(context, name)
}

// A Dino Colors picture as a PNG file in the game's folder. Older pictures
// beyond CANVAS_KEEP are removed.
WriteCanvas :: (request: string) -> string {
    if PictureFromGame(request, canvas_pixels[:]) != request.count { return "" }
    data := PngIndexed(CANVAS_WIDTH, CANVAS_HEIGHT, paint_colors[:], canvas_pixels[:])
    if data == "" { return "" }
    canvas_count += 1
    name := Cat("canvas-", NumberText(canvas_count), ".png")
    if !AppFileWrite(*game.local.files, name, data) { return "" }
    if canvas_count > CANVAS_KEEP {
        old := AppFilePath(*game.local.files, Cat("canvas-", NumberText(canvas_count - CANVAS_KEEP), ".png"), false)
        if old != "" { unused RemoveFile(old) }
    }
    return name
}

GameServices :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(function) == "AppServiceHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostValueKind.HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostValueKind.HostString) {
        service := AppArgumentText(arguments[0])
        request := AppArgumentText(arguments[1])
        if service == "jungle.voice-state" {
            result.* = Reply(ifx SoundBusy() then "playing" else "idle")
            return 1
        }
        if service == "jungle.language" {
            result.* = Reply(LanguageCode())
            return 1
        }
        if service == "jungle.voice" {
            if book_assets_installed && request.count > 26 && request[:26] == "assets/jungle-book/sounds/" && AppFileNameValid(request) {
                wave, found := ReadEntireFile(request)
                if found { SoundVoice(wave); AppFileFree(wave) }
            } else { SoundVoice(ifx request == "" then "" else BundleReadAsset(game.app.app.bundle, request)) }
            result.* = Reply("played")
            return 1
        }
        if service == "jungle.sound" {
            SoundPlayFile(BundleReadAsset(game.app.app.bundle, request))
            result.* = Reply("played")
            return 1
        }
        if service == "jungle.home" {
            home_requested = true
            result.* = Reply("ok")
            return 1
        }
        if service == "jungle.secondary" {
            result.* = Reply(ifx game_secondary_down then "down" else "up")
            return 1
        }
        if service == "jungle.canvas" {
            result.* = Reply(WriteCanvas(request))
            return 1
        }
        if service == "jungle.export" || service == "jungle.print" {
            result.* = Reply(ExportPicture(*game.local.files, request, service == "jungle.print"))
            return 1
        }
    }
    return BundleAppServices(context, module, function, arguments, count, result)
}

// The game's own packed files, and the canvas pictures made for it.
GameAssetAllowed :: (path: string) -> bool {
    if path.count > 11 && path[:7] == "canvas-" && path[path.count - 4:] == ".png" && AppFileNameValid(path) {
        return true
    }
    return BundleAppAssetAllowed(path)
}

// Earlier sessions' canvas pictures are gone once a game opens.
ClearCanvases :: (folder: string) {
    cursor := OpenDirectory(folder)
    names: [64][64]u8
    found: s32 = 0
    while !cursor.failed && found < 64 {
        entry := NextDirectoryEntry(*cursor)
        if !entry.valid { break }
        name := TextView(entry.name[:entry.name_count])
        if name.count > 7 && name.count < 64 && name[:7] == "canvas-" {
            for at: cast(s64)0..name.count - 1 { names[found][at] = name[at] }
            names[found][name.count] = 0
            found += 1
        }
    }
    unused CloseDirectory(*cursor)
    for index: cast(s32)0..found - 1 { unused RemoveFile(Cat(folder, "/", TextUntilNul(names[index][:]))) }
}

OpenGame :: (index: s32) -> bool {
    bytes, found := ReadEntireFile(Cat("games/", games[index].bundle_name))
    if !found { message = "THAT GAME IS MISSING."; return false }
    defer { AppFileFree(bytes) }
    if !BundleAppOpen(*game, bytes, data_root) { message = "THAT GAME COULD NOT START."; return false }
    game.app.services = GameServices
    game.app.allows = GameAllows
    book_assets_installed = games[index].bundle_name == "jungle-book.zx"
    game.extracted_assets = !book_assets_installed
    ClearCanvases(game.directory)
    if !book_assets_installed && !BundleWriteAssets(game.app.app.bundle, *game.local.files) {
        BundleAppClose(*game)
        message = "THAT GAME'S PICTURES COULD NOT LOAD."
        return false
    }
    home_requested = false
    message = ""
    playing = true
    return true
}

CloseGame :: () {
    SoundStop()
    BundleAppClose(*game)
    playing = false
}

// One frame of the open game, as BundleAppFrame, with canvas pictures
// allowed beside the game's packed files.
GameFrame :: (bounds: Rectangle, pointer: PointerFrame, secondary: SecondaryPointerFrame, key: s32,
    modifiers: s32, wheel: float32, seconds: float64) -> bool {
    if !game.ready { return false }
    game_secondary_down = secondary.down
    defer { BundleAppFrameAssetsClear() }
    app := *game.app
    TreePointerUpdate(app.session, pointer)
    TreeSecondaryPointerUpdate(app.session, secondary)
    PointerWheelSend(app.session, pointer.x, pointer.y, wheel)
    BeginScrollFrame(app.session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, wheel, seconds)
    KeyboardModifiersSend(app.session, modifiers)
    if key != 0 { KeyboardSend(app.session, key) }
    app.bounds = Rectangle.{bounds.x, bounds.y + cast(float32)GAME_BAR_HEIGHT, bounds.width, bounds.height - cast(float32)GAME_BAR_HEIGHT}
    app.scale = 1.0
    app.font = 18
    app.key = key
    app.modifiers = modifiers
    typed_bytes: [128]u8
    typed_count: s32 = 0
    while true {
        code := DesktopTypedCodepoint()
        if code == 0 { break }
        typed_count = TypedTextAppend(typed_bytes[:], typed_count, code)
    }
    typed := TextView(typed_bytes[:typed_count])
    app.input = TextFieldInputFor(key, modifiers, typed)
    app.area_input = TextAreaInputFor(key, modifiers, typed)
    app.area_input.now_seconds = seconds
    if BeginFrame(app.session, cast(u64)1, bounds) != FrameStatus.FrameOk { return false }
    bundle_drawing_app = *game
    WidgetHostBegin(app.session, GameAssetAllowed, BundleAppAssetResolve)
    ok := AppContextRun(app, APP_FRAME)
    WidgetHostEnd()
    bundle_drawing_app = null
    if !ok { TreeCancel(app.session); game.failed = true; return false }
    if GameTitleBar(app.session, bounds, key, seconds, games[chosen].title) { home_requested = true }
    return EndFrame(app.session) == FrameStatus.FrameOk
}

Menu :: (session: Session, bounds: Rectangle, key: s32) {
    action := JungleMenu(session, bounds, key, Seconds(), FONT, games[:game_count], *chosen, sound_muted, message)
    if action.language_changed {
        unused WriteEntireFile(language_setting, LanguageCode())
        message = ""
    }
    if action.sound_toggle { ToggleSound() }
    if action.navigated { SoundPlay("assets/jungle/sounds/select.wav") }
    if action.game >= 0 { Start(action.game) }
}

Start :: (index: s32) {
    if playing { return }
    chosen = index
    SoundPlay("assets/jungle/sounds/start.wav")
    unused OpenGame(index)
}

DrawMenu :: (session: Session) -> bool {
    BeginDesktopFrame()
    viewport := DesktopViewport()
    TreePointerUpdate(session, PollPointer())
    key := DesktopPressedKey()
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { return false }
    Menu(session, viewport, key)
    if EndFrame(session) != FrameStatus.FrameOk { return false }
    unused DesktopCursor(session)
    return EndDesktopFrame()
}

DrawGame :: () -> bool {
    BeginDesktopFrame()
    viewport := DesktopViewport()
    key := DesktopPressedKey()
    if key == 299 { ToggleSound(); key = 0 }
    ok := GameFrame(viewport, PollPointer(), PollSecondaryPointer(), key, DesktopModifiers(),
        DesktopWheelMove(), Seconds())
    if ok {
        unused DesktopCursor(game.app.session)
        ok = EndDesktopFrame()
    }
    return ok
}

// Jungle opens windowed at 4x by default, shrinking only when the first
// display's free area cannot fit that window; 4 when the display cannot be
// asked.
WindowZoom :: () -> s32 {
    area: SdlRect
    // SDL_INIT_VIDEO; the desktop host starts it again when it opens.
    if SdlStart(cast(u32)0x20) != 0 || UsableBounds(0, *area) != 0 { return 4 }
    zoom := area.w / SCREEN_WIDTH
    tall := (area.h - 40) / SCREEN_HEIGHT
    if tall < zoom { zoom = tall }
    if zoom > 4 { zoom = 4 }
    if zoom < 1 { return 1 }
    return zoom
}

// Jungle's first version kept Jungle Math's levels in one progress file;
// they move into the game's own folder the first time it has none.
KeepMathLevels :: (base: string) {
    folder := Cat(data_root, "/jungle.math")
    target := Cat(folder, "/progress.txt")
    if PathExists(target) { return }
    old, found := ReadEntireFile(Cat(base, "/progress.txt"))
    if !found { return }
    kept: Vec(u8)
    at: s64 = 0
    while at < old.count {
        end := at
        while end < old.count && old[end] != cast(u8)10 { end += 1 }
        if end - at > 6 && old[at:at + 6] == "skill " { BuilderPrint(*kept, "%\n", old[at:end]) }
        at = end + 1
    }
    levels := BuilderFinish(kept)
    if levels == "" { return }
    unused CreatePrivateDirectory(folder)
    unused WriteEntireFile(target, levels)
}

KeepAnimalLevels :: () {
    folder := Cat(data_root, "/jungle.animals")
    target := Cat(folder, "/progress.txt")
    if PathExists(target) { return }
    old, found := ReadEntireFile(Cat(data_root, "/jungle.math/progress.txt"))
    if !found { return }
    levels := AnimalLevels(old)
    if levels == "" { return }
    if CreatePrivateDirectory(folder) { unused WriteEntireFile(target, levels) }
}

// Opens each listed game, checks its capabilities and identity, and
// closes it again; no window opens.
Check :: () -> s32 {
    failed := false
    for index: cast(s32)0..game_count - 1 {
        bytes, found := ReadEntireFile(Cat("games/", games[index].bundle_name))
        // Identify and validate capabilities without opening save storage.
        // Closing an unplayed game with APP_SAVE can overwrite its progress
        // with the bundle's initial values.
        checked := found && BundleAppPrepare(*game, bytes, data_root)
        if checked {
            game.app.services = GameServices
            game.app.allows = GameAllows
            Report(Cat(games[index].bundle_name, ": ", TextFromCString(*game.app.id[0]), " runs here\n"))
            BundleAppClose(*game)
        } else {
            Report(Cat(games[index].bundle_name, ": cannot run\n"))
            failed = true
        }
    }
    return ifx failed then 1 else 0
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    folder := AppDirectory()
    if folder == "" || !EnterDirectory(folder) {
        Report("jungle: cannot find its assets and games folders\n")
        return 1
    }
    if !LoadCatalog() {
        Report("jungle: games/catalog.txt lists no games\n")
        return 1
    }
    base := DataDirectory()
    if base == "" { Report("jungle: no data folder\n"); return 1 }
    data_root = Cat(base, "/games")
    if argc == 2 && TextFromCString(argv[1]) == "--check" { return Check() }
    unused CreateDirectory(base)
    language_setting = Cat(base, "/language.txt")
    saved_language, has_language := ReadEntireFile(language_setting)
    if has_language { LanguageSet(saved_language) }
    sound_setting = Cat(base, "/sound.txt")
    setting, setting_found := ReadEntireFile(sound_setting)
    if setting_found { SoundMuted(setting == "off\n" || setting == "off") }
    unused CreateDirectory(data_root)
    KeepMathLevels(base)
    KeepAnimalLevels()
    zoom := WindowZoom()
    if !OpenDesktopSized(SCREEN_WIDTH * zoom, SCREEN_HEIGHT * zoom) { CloseDesktop(); return 1 }
    unused DesktopSetTitle("Jungle Academy")
    unused WindowInterceptCloseHost(true)
    session := SessionOpen()
    if !SessionValid(session) { CloseDesktop(); return 1 }
    ok := true
    while ok && PollDesktop() {
        if playing {
            if !DrawGame() {
                CloseGame()
                message = "THAT GAME STOPPED."
            } else if home_requested {
                CloseGame()
            }
        } else {
            ok = DrawMenu(session)
        }
        if WindowTakeCloseRequestHost() { break }
        if ok { PauseDesktop() }
    }
    if playing { CloseGame() }
    SessionClose(session)
    CloseDesktop()
    return ifx ok then 0 else 1
}

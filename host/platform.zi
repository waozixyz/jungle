// Where Jungle finds its pictures and keeps its saves, and error output.
// On Android the pictures, sounds and games are inside the APK.
#import "std/c_string"
#import "std/byte_text_linux"
#import "std/file"
#import "kryon/app_files"
#import "std/timer_linux"
#import, file "jungle_text.zi";
#if #defined(ANDROID_BUILD) {
    #import "kryon/app_asset"
    #import "kryon/android_jni"
    android_log :: #system_library "log";
    AndroidLogWrite :: (priority: s32, tag: *u8, message: *u8) -> s32 #foreign android_log "__android_log_write";
}

libc :: #system_library "libc";
GetEnvironment :: (key: *u8) -> *u8 #foreign libc "getenv";
ReadLink :: (name: *u8, output: *u8, limit: usize) -> isize #foreign libc "readlink";
ChangeDirectory :: (path: *u8) -> s32 #foreign libc "chdir";
WriteError :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";

EnvironmentText :: (key: string) -> string {
    name: [64]u8
    if !CopyCString(key, name[:]) { return "" }
    value := GetEnvironment(*name[0])
    return ifx value == null then "" else TextFromCString(value)
}

Report :: (message: string) {
    bytes: [1024]u8
    if !CopyCString(message, bytes[:]) { return }
    #if #defined(ANDROID_BUILD) {
        tag: [8]u8
        unused CopyCString("Jungle", tag[:])
        unused AndroidLogWrite(6, *tag[0], *bytes[0])
    } else {
        unused WriteError(2, *bytes[0], cast(usize)message.count)
    }
}

JungleSeconds :: () -> float64 {
    return cast(float64)MonotonicMilliseconds() / 1000.0
}

// A file Jungle ships: games/, assets/. Release it with ShippedFree.
ShippedRead :: (name: string) -> (text: string, ok: bool) {
    #if #defined(ANDROID_BUILD) {
        data := ReadAppAsset(name)
        return data, data.count > 0
    } else {
        text, ok := ReadEntireFile(name)
        return text, ok
    }
}

ShippedFree :: (data: string) {
    #if #defined(ANDROID_BUILD) {
        FreeAppAsset(data)
    } else {
        AppFileFree(data)
    }
}

ExecutableDirectory :: () -> string {
    name: [32]u8
    path: [4096]u8
    unused CopyCString("/proc/self/exe", name[:])
    length := ReadLink(*name[0], *path[0], cast(usize)4095)
    if length <= 0 || length >= 4095 { return "" }
    at := cast(s64)length - 1
    while at > 0 && path[at] != cast(u8)47 { at -= 1 }
    return Cat(TextFromBytes(path[:at]))
}

// The folder holding the program, its assets/ and its games/.
AppDirectory :: () -> string {
    program := ExecutableDirectory()
    if program == "" || !DirectoryExists(Cat(program, "/assets")) || !DirectoryExists(Cat(program, "/games")) { return "" }
    return program
}

EnterDirectory :: (path: string) -> bool {
    bytes: [4096]u8
    return CopyCString(path, bytes[:]) && ChangeDirectory(*bytes[0]) == 0
}

// $JUNGLE_DATA for tests, otherwise the user's data folder; on Android the
// app's private files.
DataDirectory :: () -> string {
    #if #defined(ANDROID_BUILD) {
        resolved: [4096]u8
        private := AndroidPrivateDataPath(resolved[:])
        if private == "" { return "" }
        return Cat(private, "/jungle")
    }
    exact := EnvironmentText("JUNGLE_DATA")
    if exact != "" { return exact }
    base := EnvironmentText("XDG_DATA_HOME")
    if base == "" {
        home := EnvironmentText("HOME")
        if home == "" { return "" }
        base = Cat(home, "/.local/share")
    }
    return Cat(base, "/jungle")
}

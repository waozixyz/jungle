// Private picture exports and native printer submission. The bundle supplies
// pixels and text, never a command, printer argument or destination path.
#import "std/process_capture_linux"
#import "std/text_buffer"
#import "std/utf8"
#import, file "../retro/language.zi";
#import "kryon/bundle_time"
#import "kryon/app_files"
#import, file "canvas_png.zi";
#import, file "jungle_text.zi";
#import, file "../games/paint/paint_palette.zi";
#import, file "../games/paint/paint_picture.zi";

export_number: s32;
export_pixels: [CANVAS_PIXELS]u8;

PrintPage :: (pixels: []u8, story: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "%", "%!PS-Adobe-3.0\n%%Pages: 1\n%%BoundingBox: 0 0 612 792\n")
    BuilderPrint(*text, "<< /PageSize [612 792] >> setpagedevice\n")
    BuilderPrint(*text, "/row % string def\ngsave\n66 360 translate\n480 360 scale\n", CANVAS_WIDTH * 3)
    BuilderPrint(*text, "% % 8 [% 0 0 -% 0 %]\n{currentfile row readhexstring pop} false 3 colorimage\n",
        CANVAS_WIDTH, CANVAS_HEIGHT, CANVAS_WIDTH, CANVAS_HEIGHT, CANVAS_HEIGHT)
    hex := "0123456789abcdef"
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        color := paint_colors[pixels[at]]
        for channel: cast(s32)0..2 {
            byte := cast(u8)(color >> cast(u32)(24 - channel * 8))
            unused VecPush(text, hex[cast(s32)(byte >> 4)])
            unused VecPush(text, hex[cast(s32)(byte & 15)])
        }
        if (at + 1) % CANVAS_WIDTH == 0 { unused VecPush(text, cast(u8)10) }
    }
    BuilderPrint(*text, "grestore\n/Courier findfont dup length dict begin {1 index /FID ne {def} {pop pop} ifelse} forall /Encoding ISOLatin1Encoding def currentdict end /JungleCourier exch definefont 12 scalefont setfont\n0 setgray\n")
    row: s32 = 0
    BuilderPrint(*text, "66 320 moveto (")
    story_at: s32 = 0
    while story_at < cast(s32)story.count {
        decoded := Decode(story, story_at)
        story_at = decoded.after
        byte := cast(u8)decoded.value
        if byte == cast(u8)10 {
            BuilderPrint(*text, ") show\n")
            row += 1
            if row < 8 { BuilderPrint(*text, "66 % moveto (", 320 - row * 18) }
        } else {
            if byte == #char "(" || byte == #char ")" || byte == cast(u8)92 { unused VecPush(text, cast(u8)92) }
            unused VecPush(text, byte)
        }
    }
    if row < 8 { BuilderPrint(*text, ") show\n") }
    BuilderPrint(*text, "%", "showpage\n%%EOF\n")
    return BuilderFinish(text)
}

ExportPicture :: (files: *AppFiles, request: string, printer: bool) -> string {
    length := PictureFromGame(request, export_pixels[:])
    if length < 0 || request.count > length + 8 * 77 { return "failed" }
    story := request[length:]
    rows: s32 = 0
    columns: s32 = 0
    at: s32 = 0
    while at < cast(s32)story.count {
        decoded := Decode(story, at)
        at = decoded.after
        code := decoded.value
        if !decoded.valid { return "failed" }
        if code == cast(u32)10 { rows += 1; columns = 0 }
        else {
            if code < cast(u32)32 || code > cast(u32)255 || (code >= cast(u32)127 && code < cast(u32)160) { return "failed" }
            columns += 1
        }
        if rows > 8 || columns > 38 { return "failed" }
    }
    export_number += 1
    name: Vec(u8)
    BuilderPrint(*name, "exports/picture-%-%", BundleUnixMilliseconds(), export_number)
    base := BuilderFinish(name)
    defer { AppFileFree(base) }
    png := PngIndexed(CANVAS_WIDTH, CANVAS_HEIGHT, paint_colors[:], export_pixels[:])
    if png == "" || !AppFileWrite(files, Cat(base, ".png"), png) ||
    !AppFileWrite(files, Cat(base, ".txt"), story) ||
    !AppFileWrite(files, Cat(base, ".ps"), PrintPage(export_pixels[:], story)) { return "failed" }
    if !printer { return "exported" }
    path := AppFilePath(files, Cat(base, ".ps"), false)
    defer { AppFileFree(path) }
    arguments: [4]string = .["lp", "-t", Tr("Jungle picture and story"), path]
    output: [4096]u8
    result := CaptureOutput(arguments[:], output[:])
    return ifx !result.error && !result.truncated && result.code == 0 then "printed" else "exported"
}

// One sound channel: a new sound replaces the one playing. Sounds are WAV
// files, read once, or a game's packed WAV data. Narration ships as Ogg
// Vorbis speech clips: ComposeVoice decodes the ones a narration path names
// in assets/speech.txt into the same samples before it plays. Without an
// audio device Jungle stays silent and runs on.
#import "std/byte_text_linux"
#import "std/c_string"
#import "std/file"
#import "std/vec"
#import "std/vorbis"
#import, file "audio_samples.zi";
#import, file "platform.zi";

SoundSpec :: struct {
    freq: s32
    format: u16
    channels: u8
    silence: u8
    samples: u16
    padding: u16
    size: u32
    callback: *void
    userdata: *void
}

#if #defined(ANDROID_BUILD) {
    // Android has no SDL audio: raylib's stream plays the same mono 16-bit
    // samples, which SoundPump hands it a block at a time every frame.
    sound_raylib :: #system_library "raylib";
    SoundStream :: struct {
        buffer: *void
        processor: *void
        sample_rate: u32
        sample_size: u32
        channels: u32
    }
    InitAudio :: () #foreign sound_raylib "InitAudioDevice";
    AudioReady :: () -> bool #foreign sound_raylib "IsAudioDeviceReady";
    StreamBufferSize :: (frames: s32) #foreign sound_raylib "SetAudioStreamBufferSizeDefault";
    LoadStream :: (rate: u32, bits: u32, channels: u32) -> SoundStream #foreign sound_raylib "LoadAudioStream";
    StreamValid :: (stream: SoundStream) -> bool #foreign sound_raylib "IsAudioStreamValid";
    PlayStream :: (stream: SoundStream) #foreign sound_raylib "PlayAudioStream";
    PauseStream :: (stream: SoundStream) #foreign sound_raylib "PauseAudioStream";
    ResumeStream :: (stream: SoundStream) #foreign sound_raylib "ResumeAudioStream";
    StreamProcessed :: (stream: SoundStream) -> bool #foreign sound_raylib "IsAudioStreamProcessed";
    UpdateStream :: (stream: SoundStream, data: *void, frames: s32) #foreign sound_raylib "UpdateAudioStream";
    SOUND_BLOCK :: 2048
    sound_stream: SoundStream;
    sound_queue: Vec(u8);
    sound_queue_at: s64;
    sound_block: [SOUND_BLOCK * 2]u8;

    SoundInit :: (flags: u32) -> s32 {
        unused flags
        if !AudioReady() { InitAudio() }
        return ifx AudioReady() then 0 else -1
    }
    SoundOpenDevice :: (device: *u8, capture: s32, desired: *SoundSpec, obtained: *SoundSpec,
        changes: s32) -> u32 {
        unused device; unused capture; unused desired; unused obtained; unused changes
        StreamBufferSize(SOUND_BLOCK)
        sound_stream = LoadStream(cast(u32)SOUND_RATE, cast(u32)16, cast(u32)1)
        if !StreamValid(sound_stream) { return cast(u32)0 }
        PlayStream(sound_stream)
        return cast(u32)1
    }
    SoundPause :: (device: u32, paused: s32) {
        unused device
        if paused != 0 { PauseStream(sound_stream) } else { ResumeStream(sound_stream) }
    }
    // Copies the samples, as SDL does, before returning.
    SoundQueue :: (device: u32, data: *u8, length: u32) -> s32 {
        unused device
        bytes := TextView(BytesFromPointer(data, cast(u64)length))
        for at: cast(s64)0..bytes.count - 1 {
            if !VecPush(sound_queue, bytes[at]) { return -1 }
        }
        return 0
    }
    SoundClear :: (device: u32) {
        unused device
        VecClear(sound_queue)
        sound_queue_at = 0
    }
    SoundQueued :: (device: u32) -> u32 {
        unused device
        return cast(u32)(sound_queue.count - sound_queue_at)
    }
    // Once a frame: the next queued block, or silence once it has played.
    SoundPump :: () {
        if sound_device == cast(u32)0 || sound_paused { return }
        while StreamProcessed(sound_stream) {
            for at: cast(s32)0..SOUND_BLOCK * 2 - 1 {
                if sound_queue_at < sound_queue.count {
                    sound_block[at] = sound_queue[sound_queue_at]
                    sound_queue_at += 1
                } else {
                    sound_block[at] = cast(u8)0
                }
            }
            UpdateStream(sound_stream, cast(*void)(*sound_block[0]), SOUND_BLOCK)
            if sound_queue_at >= sound_queue.count { SoundClear(sound_device) }
        }
    }
    // Speech clips are Ogg Vorbis; raylib decodes them with stb_vorbis,
    // allocating for the whole stream, so only after SpeechPreflight.
    SpeechWave :: struct {
        frames: u32
        rate: u32
        bits: u32
        channels: u32
        data: *u8
    }
    LoadSpeechWave :: (kind: *u8, data: *u8, count: s32) -> SpeechWave #foreign sound_raylib "LoadWaveFromMemory";
    UnloadSpeechWave :: (wave: SpeechWave) #foreign sound_raylib "UnloadWave";

    SpeechDecode :: (encoded: []u8, frames: s64, pcm: *Vec(u8)) -> bool {
        if encoded.count > cast(s64)2147483647 { return false }
        kind: [8]u8
        if !CopyCString(".ogg", kind[:]) { return false }
        wave := LoadSpeechWave(*kind[0], *encoded[0], cast(s32)encoded.count)
        if wave.data == null { return false }
        valid := wave.bits == cast(u32)16 && wave.channels == cast(u32)1 &&
            wave.rate == cast(u32)SOUND_RATE && cast(s64)wave.frames == frames
        if valid {
            samples := BytesFromPointer(wave.data, cast(u64)(frames * 2))
            for at: cast(s64)0..samples.count - 1 { VecPush(<<pcm, samples[at]) }
        }
        UnloadSpeechWave(wave)
        return valid
    }
} else {
    #import "std/vorbis_linux"
    // Speech clips are Ogg Vorbis, decoded by the system libvorbisfile that
    // the AppImage carries.
    SpeechDecode :: (encoded: []u8, frames: s64, pcm: *Vec(u8)) -> bool {
        audio: VorbisAudio
        if !VorbisDecode(encoded, pcm, frames, *audio) { return false }
        return audio.channels == 1 && audio.rate == SOUND_RATE && audio.frames == frames
    }

    sound_sdl :: #system_library "SDL2";
    sound_c :: #system_library "c";



    SoundInit :: (flags: u32) -> s32 #foreign sound_sdl "SDL_InitSubSystem";
    SoundOpenDevice :: (device: *u8, capture: s32, desired: *SoundSpec, obtained: *SoundSpec,
        changes: s32) -> u32 #foreign sound_sdl "SDL_OpenAudioDevice";
    SoundPause :: (device: u32, paused: s32) #foreign sound_sdl "SDL_PauseAudioDevice";
    SoundQueue :: (device: u32, data: *u8, length: u32) -> s32 #foreign sound_sdl "SDL_QueueAudio";
    SoundClear :: (device: u32) #foreign sound_sdl "SDL_ClearQueuedAudio";
    SoundQueued :: (device: u32) -> u32 #foreign sound_sdl "SDL_GetQueuedAudioSize";
    SoundPump :: () {}
}

SOUND_INIT_AUDIO :: 16
// AUDIO_S16LSB, mono, as tools/sounds.zi writes them.
SOUND_S16 :: 32784
SOUND_RATE :: 22050
SOUND_SLOTS :: 8

sound_device: u32;
sound_unavailable: bool;
sound_muted: bool;
sound_paused: bool;
sound_names: [SOUND_SLOTS]string;
sound_data: [SOUND_SLOTS]string;
sound_samples: [AUDIO_LIMIT * 2]u8;

SoundMuted :: (muted: bool) {
    sound_muted = muted
    if muted && sound_device != cast(u32)0 { SoundClear(sound_device) }
}

SoundOpen :: () -> bool {
    if sound_device != cast(u32)0 { return true }
    if sound_unavailable || SoundInit(cast(u32)SOUND_INIT_AUDIO) != 0 { sound_unavailable = true; return false }
    desired := SoundSpec.{.freq = SOUND_RATE, .format = cast(u16)SOUND_S16, .channels = cast(u8)1, .samples = cast(u16)512}
    obtained: SoundSpec
    sound_device = SoundOpenDevice(null, 0, *desired, *obtained, 0)
    if sound_device == cast(u32)0 { sound_unavailable = true; return false }
    SoundPause(sound_device, 0)
    return true
}

// The samples after a canonical 44-byte header, or "" when it is not one
// of ours.
SoundSamples :: (name: string) -> string {
    for slot: cast(s32)0..SOUND_SLOTS - 1 {
        if sound_names[slot] == name { return sound_data[slot][44:] }
    }
    text, found := ShippedRead(name)
    if !found || text.count <= 44 || text[:4] != "RIFF" || text[8:12] != "WAVE" { return "" }
    for slot: cast(s32)0..SOUND_SLOTS - 1 {
        if sound_names[slot] == "" {
            sound_names[slot] = name
            sound_data[slot] = text
            return sound_data[slot][44:]
        }
    }
    return text[44:]
}

SoundPlay :: (name: string) {
    if sound_muted || !SoundOpen() { return }
    SoundQueueSamples(SoundSamples(name))
}

// A whole WAV file held in memory, such as a game's packed sound.
SoundPlayFile :: (wave: string) {
    if sound_muted || wave.count <= 44 || wave[:4] != "RIFF" || wave[8:12] != "WAVE" || !SoundOpen() { return }
    SoundQueueSamples(wave[44:])
}

// A minute at the shipped quality stays near 400 KB even of noise; nothing
// larger reaches a decoder.
SPEECH_BYTES_LIMIT :: 524288

// Whether ENCODED declares exactly FRAMES mono frames at SOUND_RATE, at most
// a minute, in one whole Ogg Vorbis stream: read from its pages, before any
// decoder allocates for it.
SpeechPreflight :: (encoded: []u8, frames: s64) -> bool {
    if encoded.count < 1 || encoded.count > cast(s64)SPEECH_BYTES_LIMIT { return false }
    if frames < 1 || frames > cast(s64)(SOUND_RATE * 60) { return false }
    declared: VorbisAudio
    if !VorbisProbe(encoded, *declared) { return false }
    return declared.channels == 1 && declared.rate == SOUND_RATE && declared.frames == frames
}

// The samples of one shipped speech clip: Ogg Vorbis ENCODED, which must
// hold exactly FRAMES mono 16-bit frames at SOUND_RATE, at most a minute.
// PCM is replaced; false, and PCM empty, for anything else.
DecodeSpeech :: (encoded: string, frames: s64, pcm: *Vec(u8)) -> bool {
    VecClear(<<pcm)
    descriptor := cast(*TextDescriptor)(*encoded)
    bytes := BytesFromPointer(descriptor.data, cast(u64)encoded.count)
    if !SpeechPreflight(bytes, frames) { return false }
    if !SpeechDecode(bytes, frames, pcm) || pcm.count != frames * 2 {
        VecClear(<<pcm)
        return false
    }
    return true
}

SoundQueueSamples :: (samples: string) {
    if sound_muted || samples.count == 0 { return }
    buffer := sound_samples[:]
    length := AudioMix(samples, 25, buffer)
    if length == 0 { return }
    SoundClear(sound_device)
    unused SoundQueue(sound_device, *buffer[0], cast(u32)length)
}

SoundSetPaused :: (paused: bool) {
    sound_paused = paused
    if sound_device != cast(u32)0 { SoundPause(sound_device, ifx paused then 1 else 0) }
}
SoundStop :: () {
    if sound_device != cast(u32)0 { SoundClear(sound_device) }
    SoundSetPaused(false)
}
SoundBusy :: () -> bool {
    return !sound_muted && sound_device != cast(u32)0 && SoundQueued(sound_device) > cast(u32)0
}
// Narration may contain a whole word and its spelling; keep the short cue
// limit for the other games and clear the previous voice on every turn.
SoundVoice :: (wave: string) {
    SoundStop()
    if sound_muted || wave.count <= 44 || wave[:4] != "RIFF" || wave[8:12] != "WAVE" { return }
    SoundVoiceSamples(wave[44:])
}

SoundVoiceSamples :: (pcm: string) {
    if sound_muted || pcm.count == 0 || !SoundOpen() { return }
    // Heap storage is bounded by the generator's maximum; short effects keep
    // their small reusable buffer. SDL copies the samples before this returns.
    samples: Vec(u8)
    needed := pcm.count
    if needed > cast(s64)(VOICE_LIMIT * 2) { needed = cast(s64)(VOICE_LIMIT * 2) }
    for at: cast(s64)0..needed - 1 { unused VecPush(samples, cast(u8)0) }
    buffer := VecSlice(samples, 0, needed)
    length := AudioMix(pcm, 45, buffer, VOICE_LIMIT)
    if length > 0 { unused SoundQueue(sound_device, *buffer[0], cast(u32)length) }
}

// Narration PATH, composed from the speech index, as SoundVoice plays a WAV.
// False, and nothing changes, when the index has no such path.
SoundSpeech :: (path: string) -> bool {
    if SpeechVoice(path) == "" { return false }
    SoundStop()
    if sound_muted || !SoundOpen() { return true }
    pcm: Vec(u8)
    if !ComposeVoice(path, *pcm) {
        message: Vec(u8)
        BuilderAppend(message, "jungle: cannot play ")
        BuilderAppend(message, path)
        BuilderAppend(message, "\n")
        Report(BuilderFinish(message))
        return true
    }
    SoundVoiceSamples(TextView(VecSlice(pcm, 0, pcm.count)))
    return true
}

// assets/speech.txt (tools/shared_assets.py SpeechIndexText): the exact
// header line, "clip|PATH|FRAMES" lines in path order, then one
// "voice|PATH|SEGMENTS" line per narration path, in path order. A segment is
// "CLIP:START:FRAMES" of the CLIPth clip line, or "FRAMES" of silence.
SPEECH_HEADER :: "#jungle-speech-1"
SPEECH_CLIPS :: 8192
speech_index: string;
speech_voices_at: s64;
speech_clip_count: s64;
speech_clip_paths: [SPEECH_CLIPS]string;
speech_clip_frames: [SPEECH_CLIPS]s64;

// A plain decimal of at most nine digits, without sign or leading zero; -1
// for anything else.
SpeechNumber :: (text: string) -> s64 {
    if text.count < 1 || text.count > 9 || (text.count > 1 && text[0] == #char "0") { return -1 }
    value: s64 = 0
    for at: cast(s64)0..text.count - 1 {
        if text[at] < #char "0" || text[at] > #char "9" { return -1 }
        value = value * 10 + cast(s64)(text[at] - #char "0")
    }
    return value
}

// A relative assets/ path ending in SUFFIX, without empty, "." or ".." parts,
// spaces, backslashes, separators or control bytes.
SpeechPathValid :: (path: string, suffix: string) -> bool {
    if path.count <= 7 + suffix.count || path.count > 1024 || path[:7] != "assets/" ||
        path[path.count - suffix.count:] != suffix { return false }
    start: s64 = 0
    for at: cast(s64)0..path.count {
        if at == path.count || path[at] == #char "/" {
            part := path[start:at]
            if part == "" || part == "." || part == ".." { return false }
            start = at + 1
        } else if path[at] <= cast(u8)32 || path[at] == cast(u8)92 || path[at] == #char "|" || path[at] == cast(u8)127 {
            return false
        }
    }
    return true
}

// Whether LATER sorts strictly after EARLIER, byte by byte.
SpeechAfter :: (earlier: string, later: string) -> bool {
    at: s64 = 0
    while at < earlier.count && at < later.count {
        if earlier[at] != later[at] { return earlier[at] < later[at] }
        at += 1
    }
    return later.count > earlier.count
}

// The segment of SPEC at AT: its clip, or -1 for silence, its first frame
// and frame count, and where the next segment starts; next is -1 when the
// segment is malformed.
SpeechSegment :: (spec: string, at: s64) -> (clip: s64, first: s64, frames: s64, next: s64) {
    end := at
    while end < spec.count && spec[end] != #char " " { end += 1 }
    token := spec[at:end]
    fields: [3]s64
    found: s32 = 0
    from: s64 = 0
    for index: cast(s64)0..token.count {
        if index == token.count || token[index] == #char ":" {
            if found >= 3 { return -1, 0, 0, -1 }
            fields[found] = SpeechNumber(token[from:index])
            if fields[found] < 0 { return -1, 0, 0, -1 }
            found += 1
            from = index + 1
        }
    }
    if found == 1 && fields[0] > 0 { return -1, 0, fields[0], end + 1 }
    if found == 3 && fields[2] > 0 { return fields[0], fields[1], fields[2], end + 1 }
    return -1, 0, 0, -1
}

// Whether SPEC's segments are well formed, lie within their clips and
// together last at most VOICE_LIMIT frames.
SpeechSegmentsValid :: (spec: string) -> bool {
    if spec == "" { return false }
    total: s64 = 0
    at: s64 = 0
    while at < spec.count {
        clip, first, frames, next := SpeechSegment(spec, at)
        if next < 0 { return false }
        if clip >= 0 && (clip >= speech_clip_count || first + frames > speech_clip_frames[clip]) { return false }
        total += frames
        if total > cast(s64)VOICE_LIMIT { return false }
        at = next
    }
    return true
}

// Checks TEXT whole as the speech index and keeps it, unchanged, while it is
// in use; false, with no index, for anything malformed.
SpeechLoad :: (text: string) -> bool {
    speech_index = ""
    speech_clip_count = 0
    speech_voices_at = 0
    voices_at: s64 = -1
    previous := ""
    at: s64 = 0
    header := true
    while at < text.count {
        end := at
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        if end == text.count { speech_clip_count = 0; return false }
        line := text[at:end]
        line_at := at
        at = end + 1
        if header {
            if line != SPEECH_HEADER { return false }
            header = false
            continue
        }
        fields: [3]string
        field: s32 = 0
        start: s64 = 0
        for index: cast(s64)0..line.count {
            if index == line.count || line[index] == #char "|" {
                if field < 3 { fields[field] = line[start:index] }
                field += 1
                start = index + 1
            }
        }
        valid := field == 3
        path := fields[1]
        if valid && fields[0] == "clip" {
            frames := SpeechNumber(fields[2])
            valid = voices_at < 0 && speech_clip_count < cast(s64)SPEECH_CLIPS && SpeechPathValid(path, ".ogg") &&
                path.count > 14 && path[:14] == "assets/speech/" && SpeechAfter(previous, path) &&
                frames > 0 && frames <= cast(s64)VOICE_LIMIT
            if valid {
                speech_clip_paths[speech_clip_count] = path
                speech_clip_frames[speech_clip_count] = frames
                speech_clip_count += 1
            }
        } else if valid && fields[0] == "voice" {
            valid = SpeechPathValid(path, ".wav") && (voices_at < 0 || SpeechAfter(previous, path)) &&
                SpeechSegmentsValid(fields[2])
            if voices_at < 0 { voices_at = line_at }
        } else {
            valid = false
        }
        if !valid { speech_clip_count = 0; return false }
        previous = path
    }
    if header { return false }
    speech_index = text
    speech_voices_at = ifx voices_at < 0 then text.count else voices_at
    return true
}

// The installed speech index, read once; false when it is missing or invalid.
SpeechLoadShipped :: () -> bool {
    if speech_index != "" { return true }
    text, found := ShippedRead("assets/speech.txt")
    if !found { return false }
    if SpeechLoad(text) { return true }
    ShippedFree(text)
    return false
}

// The segments of narration PATH, or "".
SpeechVoice :: (path: string) -> string {
    at := speech_voices_at
    while path != "" && at < speech_index.count {
        end := at
        while speech_index[end] != cast(u8)10 { end += 1 }
        line := speech_index[at:end]
        if line.count > path.count + 7 && line[6:6 + path.count] == path && line[6 + path.count] == #char "|" {
            return line[7 + path.count:]
        }
        at = end + 1
    }
    return ""
}

// The samples of narration PATH, assembled from its speech clips and silences
// in order, at most VOICE_LIMIT frames. PCM is replaced; false, and PCM
// empty, when PATH is not in the index or a clip is missing or malformed.
ComposeVoice :: (path: string, pcm: *Vec(u8)) -> bool {
    VecClear(<<pcm)
    spec := SpeechVoice(path)
    if spec == "" { return false }
    clip_pcm: Vec(u8)
    decoded: s64 = -1
    at: s64 = 0
    while at < spec.count {
        clip, first, frames, next := SpeechSegment(spec, at)
        valid := next > 0 && pcm.count + frames * 2 <= cast(s64)(VOICE_LIMIT * 2)
        if valid && clip < 0 {
            for index: cast(s64)0..frames * 2 - 1 {
                if !VecPush(<<pcm, cast(u8)0) { valid = false; break }
            }
        } else if valid {
            if clip != decoded {
                decoded = -1
                encoded, found := ShippedRead(speech_clip_paths[clip])
                valid = found && DecodeSpeech(encoded, speech_clip_frames[clip], *clip_pcm)
                if found { ShippedFree(encoded) }
                if valid { decoded = clip }
            }
            if valid { BuilderAppend(<<pcm, TextView(VecSlice(clip_pcm, first * 2, (first + frames) * 2))) }
        }
        if !valid {
            VecClear(<<pcm)
            return false
        }
        at = next
    }
    return true
}

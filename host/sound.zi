// One sound channel: a new sound replaces the one playing. Sounds are WAV
// files, read once, or a game's packed WAV data. Without an audio device
// Jungle stays silent and runs on.
#import "std/byte_text_linux"
#import "std/file"
#import "std/vec"
#import, file "audio_samples.zi";
#import, file "platform.zi";

SoundSpec :: struct {
    freq: s32
    format: u16
    channels: u8
    silence: u8
    samples: u16
    padding: u16
    size: u32
    callback: *void
    userdata: *void
}

#if #defined(ANDROID_BUILD) {
    // Android has no SDL audio: raylib's stream plays the same mono 16-bit
    // samples, which SoundPump hands it a block at a time every frame.
    sound_raylib :: #system_library "raylib";
    SoundStream :: struct {
        buffer: *void
        processor: *void
        sample_rate: u32
        sample_size: u32
        channels: u32
    }
    InitAudio :: () #foreign sound_raylib "InitAudioDevice";
    AudioReady :: () -> bool #foreign sound_raylib "IsAudioDeviceReady";
    StreamBufferSize :: (frames: s32) #foreign sound_raylib "SetAudioStreamBufferSizeDefault";
    LoadStream :: (rate: u32, bits: u32, channels: u32) -> SoundStream #foreign sound_raylib "LoadAudioStream";
    StreamValid :: (stream: SoundStream) -> bool #foreign sound_raylib "IsAudioStreamValid";
    PlayStream :: (stream: SoundStream) #foreign sound_raylib "PlayAudioStream";
    PauseStream :: (stream: SoundStream) #foreign sound_raylib "PauseAudioStream";
    ResumeStream :: (stream: SoundStream) #foreign sound_raylib "ResumeAudioStream";
    StreamProcessed :: (stream: SoundStream) -> bool #foreign sound_raylib "IsAudioStreamProcessed";
    UpdateStream :: (stream: SoundStream, data: *void, frames: s32) #foreign sound_raylib "UpdateAudioStream";
    SOUND_BLOCK :: 2048
    sound_stream: SoundStream;
    sound_queue: Vec(u8);
    sound_queue_at: s64;
    sound_block: [SOUND_BLOCK * 2]u8;

    SoundInit :: (flags: u32) -> s32 {
        unused flags
        if !AudioReady() { InitAudio() }
        return ifx AudioReady() then 0 else -1
    }
    SoundOpenDevice :: (device: *u8, capture: s32, desired: *SoundSpec, obtained: *SoundSpec,
        changes: s32) -> u32 {
        unused device; unused capture; unused desired; unused obtained; unused changes
        StreamBufferSize(SOUND_BLOCK)
        sound_stream = LoadStream(cast(u32)SOUND_RATE, cast(u32)16, cast(u32)1)
        if !StreamValid(sound_stream) { return cast(u32)0 }
        PlayStream(sound_stream)
        return cast(u32)1
    }
    SoundPause :: (device: u32, paused: s32) {
        unused device
        if paused != 0 { PauseStream(sound_stream) } else { ResumeStream(sound_stream) }
    }
    // Copies the samples, as SDL does, before returning.
    SoundQueue :: (device: u32, data: *u8, length: u32) -> s32 {
        unused device
        bytes := TextView(BytesFromPointer(data, cast(u64)length))
        for at: cast(s64)0..bytes.count - 1 {
            if !VecPush(sound_queue, bytes[at]) { return -1 }
        }
        return 0
    }
    SoundClear :: (device: u32) {
        unused device
        VecClear(sound_queue)
        sound_queue_at = 0
    }
    SoundQueued :: (device: u32) -> u32 {
        unused device
        return cast(u32)(sound_queue.count - sound_queue_at)
    }
    // Once a frame: the next queued block, or silence once it has played.
    SoundPump :: () {
        if sound_device == cast(u32)0 || sound_paused { return }
        while StreamProcessed(sound_stream) {
            for at: cast(s32)0..SOUND_BLOCK * 2 - 1 {
                if sound_queue_at < sound_queue.count {
                    sound_block[at] = sound_queue[sound_queue_at]
                    sound_queue_at += 1
                } else {
                    sound_block[at] = cast(u8)0
                }
            }
            UpdateStream(sound_stream, cast(*void)(*sound_block[0]), SOUND_BLOCK)
            if sound_queue_at >= sound_queue.count { SoundClear(sound_device) }
        }
    }
} else {
    sound_sdl :: #system_library "SDL2";
    sound_c :: #system_library "c";



    SoundInit :: (flags: u32) -> s32 #foreign sound_sdl "SDL_InitSubSystem";
    SoundOpenDevice :: (device: *u8, capture: s32, desired: *SoundSpec, obtained: *SoundSpec,
        changes: s32) -> u32 #foreign sound_sdl "SDL_OpenAudioDevice";
    SoundPause :: (device: u32, paused: s32) #foreign sound_sdl "SDL_PauseAudioDevice";
    SoundQueue :: (device: u32, data: *u8, length: u32) -> s32 #foreign sound_sdl "SDL_QueueAudio";
    SoundClear :: (device: u32) #foreign sound_sdl "SDL_ClearQueuedAudio";
    SoundQueued :: (device: u32) -> u32 #foreign sound_sdl "SDL_GetQueuedAudioSize";
    SoundPump :: () {}
}

SOUND_INIT_AUDIO :: 16
// AUDIO_S16LSB, mono, as tools/sounds.zi writes them.
SOUND_S16 :: 32784
SOUND_RATE :: 22050
SOUND_SLOTS :: 8

sound_device: u32;
sound_unavailable: bool;
sound_muted: bool;
sound_paused: bool;
sound_names: [SOUND_SLOTS]string;
sound_data: [SOUND_SLOTS]string;
sound_samples: [AUDIO_LIMIT * 2]u8;

SoundMuted :: (muted: bool) {
    sound_muted = muted
    if muted && sound_device != cast(u32)0 { SoundClear(sound_device) }
}

SoundOpen :: () -> bool {
    if sound_device != cast(u32)0 { return true }
    if sound_unavailable || SoundInit(cast(u32)SOUND_INIT_AUDIO) != 0 { sound_unavailable = true; return false }
    desired := SoundSpec.{.freq = SOUND_RATE, .format = cast(u16)SOUND_S16, .channels = cast(u8)1, .samples = cast(u16)512}
    obtained: SoundSpec
    sound_device = SoundOpenDevice(null, 0, *desired, *obtained, 0)
    if sound_device == cast(u32)0 { sound_unavailable = true; return false }
    SoundPause(sound_device, 0)
    return true
}

// The samples after a canonical 44-byte header, or "" when it is not one
// of ours.
SoundSamples :: (name: string) -> string {
    for slot: cast(s32)0..SOUND_SLOTS - 1 {
        if sound_names[slot] == name { return sound_data[slot][44:] }
    }
    text, found := ShippedRead(name)
    if !found || text.count <= 44 || text[:4] != "RIFF" || text[8:12] != "WAVE" { return "" }
    for slot: cast(s32)0..SOUND_SLOTS - 1 {
        if sound_names[slot] == "" {
            sound_names[slot] = name
            sound_data[slot] = text
            return sound_data[slot][44:]
        }
    }
    return text[44:]
}

SoundPlay :: (name: string) {
    if sound_muted || !SoundOpen() { return }
    SoundQueueSamples(SoundSamples(name))
}

// A whole WAV file held in memory, such as a game's packed sound.
SoundPlayFile :: (wave: string) {
    if sound_muted || wave.count <= 44 || wave[:4] != "RIFF" || wave[8:12] != "WAVE" || !SoundOpen() { return }
    SoundQueueSamples(wave[44:])
}

SoundQueueSamples :: (samples: string) {
    if sound_muted || samples.count == 0 { return }
    buffer := sound_samples[:]
    length := AudioMix(samples, 25, buffer)
    if length == 0 { return }
    SoundClear(sound_device)
    unused SoundQueue(sound_device, *buffer[0], cast(u32)length)
}

// Narration may contain a whole word and its spelling; keep the short cue
// limit for the other games and clear the previous voice on every turn.
SoundSetPaused :: (paused: bool) {
    sound_paused = paused
    if sound_device != cast(u32)0 { SoundPause(sound_device, ifx paused then 1 else 0) }
}
SoundStop :: () {
    if sound_device != cast(u32)0 { SoundClear(sound_device) }
    SoundSetPaused(false)
}
SoundBusy :: () -> bool {
    return !sound_muted && sound_device != cast(u32)0 && SoundQueued(sound_device) > cast(u32)0
}
SoundVoice :: (wave: string) {
    SoundStop()
    if sound_muted || wave.count <= 44 || wave[:4] != "RIFF" || wave[8:12] != "WAVE" || !SoundOpen() { return }
    // Heap storage is bounded by the generator's maximum; short effects keep
    // their small reusable buffer. SDL copies the samples before this returns.
    samples: Vec(u8)
    needed := wave.count - 44
    if needed > cast(s64)(VOICE_LIMIT * 2) { needed = cast(s64)(VOICE_LIMIT * 2) }
    for at: cast(s64)0..needed - 1 { unused VecPush(samples, cast(u8)0) }
    buffer := VecSlice(samples, 0, needed)
    length := AudioMix(wave[44:], 45, buffer, VOICE_LIMIT)
    if length > 0 { unused SoundQueue(sound_device, *buffer[0], cast(u32)length) }
}

// Jungle's shared watercolor-book paper, native lettering and whole illustrations.
#import "kryon/geometry"
#import "kryon/text_widget"
#import "kryon/text_props"
#import "kryon/text_align"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/drawing_props"
#import "kryon/widget_palette"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
BackArrow :: #import "mingcute/mingcute_regular_arrow_left";
#import "std/utf8"
#import, file "language.zi";
#import, file "retro.zi";

BookText :: (x: s32, y: s32, width: s32, height: s32, text: string, size: s32,
    alignment: TextAlign = TextAlign.TextAlignCenter, localize: bool = true, muted: bool = false) {
    font := size
    shown := ifx localize then Tr(text) else text
    length := Count(shown)
    if length > 0 && length * font * 3 > width * 5 { font = width * 5 / (length * 3) }
    if font < 6 { font = 6 }
    Text(retro.session, TextProps.{.bounds = RetroRect(x, y, width, height), .text = shown,
        .font = cast(s32)(cast(float32)font * retro.scale),
        .align = alignment, .vertical_align = TextAlign.TextAlignCenter,
        .wrap = TextWrap.TextWrapNone, .disabled = muted})
}

BookBox :: (x: s32, y: s32, width: s32, height: s32, fill: u32, border: u32 = 0, radius: float32 = 0.0) {
    unused Box(retro.session, BoxProps.{.bounds = RetroRect(x, y, width, height),
        .fill = ColorFromPacked(fill), .border = ColorFromPacked(border), .radius = radius * retro.scale})
}

BookPicture :: (path: string, x: s32, y: s32, width: s32, height: s32) {
    if !RetroImageReady(path) { return }
    Image(retro.session, ImageProps.{.asset_path = path, .bounds = RetroRect(x, y, width, height),
        .fit = ImageFit.ImageFitContain, .smooth = true})
}

BookPalette :: () {
    unused WidgetPaletteUse(retro.session, WidgetPalette.{.background = 0xe3ece4ff,
        .base = 0xfffcf3ff, .text = 0x3e332aff, .selected = 0x2e6956ff,
        .selected_text = 0xfffcf3ff, .border = 0xbba98bff})
}

BookPaperSized :: (width: s32, height: s32) {
    fit := cast(float32)width / 320.0
    if cast(float32)height / 200.0 < fit { fit = cast(float32)height / 200.0 }
    if fit < 1.0 { fit = 1.0 }
    outer_x := cast(s32)(9.0 * fit)
    outer_y := cast(s32)(8.0 * fit)
    inner_x := cast(s32)(14.0 * fit)
    inner_y := cast(s32)(12.0 * fit)
    BookPalette()
    BookBox(0, 0, width, height, 0xe3ece4ff)
    BookBox(outer_x, outer_y, width - outer_x * 2, height - outer_y * 2, 0x704d36ff, 0x593d2dff, 8.0 * fit)
    BookBox(inner_x, inner_y, width - inner_x * 2, height - inner_y * 2, 0xfffcf3ff, 0xdacdb5ff, 5.0 * fit)
}

BookPaper :: () { BookPaperSized(320, 200) }

BookButton :: (id: s32, x: s32, y: s32, width: s32, height: s32, label: string, chosen: bool = false) -> bool {
    press := RetroTap(id, x, y, width, height, label)
    BookBox(x, y, width, height,
        ifx chosen || press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff,
        ifx chosen then cast(u32)0x2e6956ff else cast(u32)0xdacdb5ff, 4.0)
    BookText(x + 3, y, width - 6, height, label, 11)
    return press.clicked
}

BookBack :: (id: s32, x: s32, y: s32, width: s32, height: s32) -> bool {
    press := RetroTap(id, x, y, width, height, "Back")
    BookBox(x, y, width, height, ifx press.down then cast(u32)0xdcebdcff else cast(u32)0xf3ecdcff, 0xdacdb5ff, 4.0)
    edge := height * 2 / 3
    SvgIcon(retro.session, SvgIconProps.{.bounds = RetroRect(x + (width - edge) / 2, y + (height - edge) / 2, edge, edge),
        .shape = BackArrow.Shape, .color = ColorFromPacked(0x3e332aff)})
    return press.clicked
}

// Dialog labels keep existing control positions while using native typography.
BookLabel :: (x: s32, y: s32, text: string, color: s32, size: s32 = 1, localize: bool = true, width: s32 = 0) {
    span := ifx width > 0 then width else Count(ifx localize then Tr(text) else text) * 8 * size
    if span > SCREEN_WIDTH - x - 8 { span = SCREEN_WIDTH - x - 8 }
    BookText(x, y, span, 16 * size, text, 12 * size, TextAlign.TextAlignStart, localize)
}

BookCentered :: (y: s32, text: string, color: s32, size: s32 = 1) {
    BookText(22, y, 276, 16 * size, text, 12 * size)
}

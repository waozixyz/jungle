// What a Jungle game asks of the Jungle app around it.
#import "kryon/app_context"
#import, file "language.zi";
#import, file "collection_cache.zi";

// Plays one of the game's own sound files, such as
// "assets/animal-count/sounds/right.wav".
GameSound :: (path: string) {
    unused AppService("jungle.sound", path)
}

// Leaves the game for the Jungle menu once this frame is done.
GameHome :: () {
    unused AppService("jungle.home", "")
}

// Original Bert controls mirror a dinosaur while the right button is held
// as the left button releases it. A completed right-click is too late.
GameSecondaryDown :: () -> bool {
    return AppService("jungle.secondary", "") == "down"
}

// Turns a picture's text (see games/paint/paint_picture.zi) into a file the
// game can show; returns its name, or "" when the app cannot make one.
GameCanvas :: (pixels: string) -> string {
    return GameCanvasService("jungle.canvas", pixels)
}
// A host service that writes a picture and names it.
GameCanvasService :: (service: string, request: string) -> string {
    name := AppService(service, request)
    if name.count < 8 || name[:7] != "canvas-" { return "" }
    #if #defined(PLATFORM_WEB) {
        return AppAssetPath(name)
    }
    return name
}

GameLanguage :: () {
    LanguageSet(AppService("jungle.language", ""))
}

// Asks the app once for the collected set; GameCollected reads the answer.
GameCollectionRefresh :: () {
    CollectionCacheSet(AppService("jungle.collection", ""))
}

GameCollected :: (id: s32) -> bool {
    if !collection_cache_loaded { GameCollectionRefresh() }
    return CollectionCacheHas(id)
}

// True only the first time SLUG is collected. An app without the service
// answers "" and nothing is collected.
GameCollect :: (slug: string) -> bool {
    reply := AppService("jungle.collect", slug)
    if reply != "" { GameCollectionRefresh() }
    return reply == "new"
}

// What a Jungle game asks of the Jungle app around it.
#import "app_context"

// Plays one of the game's own sound files, such as
// "assets/animal-count/sounds/right.wav".
GameSound :: (path: string) {
    unused AppService("jungle.sound", path)
}

// Leaves the game for the Jungle menu once this frame is done.
GameHome :: () {
    unused AppService("jungle.home", "")
}

// Turns an indexed 240 by 180 picture into a file the game can show;
// returns its name, or ""
// when the app cannot make one.
GameCanvas :: (pixels: string) -> string {
    name := AppService("jungle.canvas", pixels)
    if name.count < 8 || name[:7] != "canvas-" { return "" }
    return name
}

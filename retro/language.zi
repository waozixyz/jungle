#import "std/format"
language: s32;
LanguageCode :: () -> string {
    if language == 1 { return "de" }
    if language == 2 { return "es" }
    return "en"
}
LanguageSet :: (code: string) {
    language = ifx code == "de" then 1 else ifx code == "es" then 2 else 0
}

Ui_en :: (at: s32) -> string {
    if at < 48 { return ui_en_0[at - 0] }
    if at < 96 { return ui_en_48[at - 48] }
    if at < 144 { return ui_en_96[at - 96] }
    if at < 192 { return ui_en_144[at - 144] }
    if at < 240 { return ui_en_192[at - 192] }
    if at < 249 { return ui_en_240[at - 240] }
    return ""
}
Ui_de :: (at: s32) -> string {
    if at < 48 { return ui_de_0[at - 0] }
    if at < 96 { return ui_de_48[at - 48] }
    if at < 144 { return ui_de_96[at - 96] }
    if at < 192 { return ui_de_144[at - 144] }
    if at < 240 { return ui_de_192[at - 192] }
    if at < 249 { return ui_de_240[at - 240] }
    return ""
}
Ui_es :: (at: s32) -> string {
    if at < 48 { return ui_es_0[at - 0] }
    if at < 96 { return ui_es_48[at - 48] }
    if at < 144 { return ui_es_96[at - 96] }
    if at < 192 { return ui_es_144[at - 144] }
    if at < 240 { return ui_es_192[at - 192] }
    if at < 249 { return ui_es_240[at - 240] }
    return ""
}
Tr :: (text: string) -> string {
    if language == 0 { return text }
    for at: cast(s32)0..UI_COUNT - 1 {
        if text == Ui_en(at) { return ifx language == 1 then Ui_de(at) else Ui_es(at) }
    }
    return text
}
// Stories retain one Latin-1 cell per character in the existing picture format.
// All UI, input, exported text and voice manifests use UTF-8.
LatinText :: (bytes: string) -> string {
    text: Vec(u8)
    for byte: bytes {
        if byte < cast(u8)128 { unused VecPush(text, byte) }
        else {
            unused VecPush(text, cast(u8)192 | (byte >> 6))
            unused VecPush(text, cast(u8)128 | (byte & cast(u8)63))
        }
    }
    return BuilderFinish(text)
}

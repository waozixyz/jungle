// Jungle's old-PC look, shared by the host and every game: a 320 by 200
// screen of fat pixels in the sixteen colors of an old color card, and
// letters 8 pixels wide and 16 tall, drawn from a font picture.
#import, file "language.zi";
#import "std/utf8"
#import "session"
#import "geometry"
#import "drawing_props"
#import "box_props"
#import "box_widget"
#import "image_props"
#import "image_widget"
#import "press_props"
#import "press_widget"

SCREEN_WIDTH :: 320
SCREEN_HEIGHT :: 200

BLACK :: 0
BLUE :: 1
GREEN :: 2
CYAN :: 3
RED :: 4
MAGENTA :: 5
BROWN :: 6
LIGHT_GRAY :: 7
DARK_GRAY :: 8
LIGHT_BLUE :: 9
LIGHT_GREEN :: 10
LIGHT_CYAN :: 11
LIGHT_RED :: 12
LIGHT_MAGENTA :: 13
YELLOW :: 14
WHITE :: 15

retro_colors: [16]u32 = .[0x000000ff, 0x0000aaff, 0x00aa00ff, 0x00aaaaff, 0xaa0000ff, 0xaa00aaff, 0xaa5500ff,
0xaaaaaaff, 0x555555ff, 0x5555ffff, 0x55ff55ff, 0x55ffffff, 0xff5555ff, 0xff55ffff, 0xffff55ff, 0xffffffff];

// Keys as the hosts report them.
KEY_ESCAPE :: 256
KEY_ENTER :: 257
KEY_BACKSPACE :: 259
KEY_RIGHT :: 262
KEY_LEFT :: 263
KEY_DOWN :: 264
KEY_UP :: 265

Retro :: struct {
    session: Session
    // Where the screen sits in the window and how many window pixels make
    // one screen pixel.
    x: float32
    y: float32
    scale: float32
    font: string
    now: float64
    key: s32
    latin_font: string
    glyph_height: s32
}

retro: Retro;

RetroColor :: (index: s32) -> Color {
    return ColorFromPacked(retro_colors[index & 15])
}

// Fits the screen in bounds at a whole number of window pixels per screen
// pixel, centered on black, and paints it in one color.
RetroBegin :: (session: Session, bounds: Rectangle, font: string, now: float64, key: s32, background: s32, glyph_height: s32 = 16, latin_font: string = "") {
    across := bounds.width / cast(float32)SCREEN_WIDTH
    down := bounds.height / cast(float32)SCREEN_HEIGHT
    fit := ifx across < down then across else down
    scale := cast(float32)cast(s32)fit
    // A window smaller than the screen still shows all of it.
    if scale < 1.0 { scale = fit }
    retro = Retro.{.session = session, .scale = scale, .font = font, .now = now, .key = key,
        .glyph_height = glyph_height, .latin_font = latin_font,
        .x = bounds.x + cast(float32)cast(s32)((bounds.width - scale * cast(float32)SCREEN_WIDTH) / 2.0),
        .y = bounds.y + cast(float32)cast(s32)((bounds.height - scale * cast(float32)SCREEN_HEIGHT) / 2.0)}
    unused Box(session, BoxProps.{.bounds = bounds, .fill = RetroColor(BLACK)})
    RetroFill(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT, background)
}

// A screen rectangle in window pixels.
RetroRect :: (x: s32, y: s32, width: s32, height: s32) -> Rectangle {
    return Rectangle.{retro.x + cast(float32)x * retro.scale, retro.y + cast(float32)y * retro.scale,
        cast(float32)width * retro.scale, cast(float32)height * retro.scale}
}

RetroFill :: (x: s32, y: s32, width: s32, height: s32, color: s32) {
    unused Box(retro.session, BoxProps.{.bounds = RetroRect(x, y, width, height), .fill = RetroColor(color)})
}

// A one-pixel outline just inside the rectangle.
RetroFrame :: (x: s32, y: s32, width: s32, height: s32, color: s32) {
    RetroFill(x, y, width, 1, color)
    RetroFill(x, y + height - 1, width, 1, color)
    RetroFill(x, y, 1, height, color)
    RetroFill(x + width - 1, y, 1, height, color)
}

// A picture stretched to width by height screen pixels. A tint paints its
// shape in one color.
RetroSprite :: (path: string, x: s32, y: s32, width: s32, height: s32, tint: s32 = -1, smooth: bool = false) {
    Image(retro.session, ImageProps.{.asset_path = path, .bounds = RetroRect(x, y, width, height),
            .fit = ImageFit.ImageFitStretch, .smooth = smooth,
            .tint = ifx tint < 0 then cast(u32)0 else retro_colors[tint & 15]})
}

RetroTextWidth :: (text: string, size: s32 = 1) -> s32 {
    return Count(Tr(text)) * 8 * size
}

// Decode UTF-8 once per glyph; the atlas includes Latin-1 accents. Fit long
// translations inside their button or the remaining screen width.
RetroText :: (x: s32, y: s32, text: string, color: s32, size: s32 = 1, localize: bool = true, width: s32 = 0) {
    shown := ifx localize then Tr(text) else text
    count := Count(shown)
    if count == 0 { return }
    available := ifx width > 0 then width else SCREEN_WIDTH - x
    advance := cast(float32)(8 * size)
    if cast(float32)(count * 8 * size) > cast(float32)available { advance = cast(float32)available / cast(float32)count }
    at: s32 = 0
    index: s32 = 0
    while at < cast(s32)shown.count {
        decoded := Decode(shown, at)
        at = decoded.after
        code := cast(s32)decoded.value
        position := index
        index += 1
        if code == 32 { continue }
        if code < 32 || code > 255 { code = 63 }
        cell := code - 32
        font := retro.font
        source_height := retro.glyph_height
        if code > 126 && retro.latin_font != "" { font = retro.latin_font; source_height = 16 }
        Image(retro.session, ImageProps.{.asset_path = font,
            .source = Rectangle.{cast(float32)((cell % 16) * 8), cast(float32)((cell / 16) * source_height), 8.0, cast(float32)source_height},
            .bounds = Rectangle.{retro.x + (cast(float32)x + cast(float32)position * advance) * retro.scale,
                retro.y + cast(float32)y * retro.scale, advance * retro.scale, cast(float32)(retro.glyph_height * size) * retro.scale},
            .fit = ImageFit.ImageFitStretch, .smooth = false, .tint = retro_colors[color & 15]})
    }
}

RetroCentered :: (y: s32, text: string, color: s32, size: s32 = 1) {
    span := RetroTextWidth(text, size)
    if span > SCREEN_WIDTH - 8 { span = SCREEN_WIDTH - 8 }
    RetroText((SCREEN_WIDTH - span) / 2, y, text, color, size, true, span)
}

// An area that answers a click or touch; it draws nothing itself. With
// capture it keeps following a drag that leaves it.
RetroTap :: (id: s32, x: s32, y: s32, width: s32, height: s32, label: string, capture: bool = false) -> PressResult {
    return Press(retro.session, PressProps.{.key = cast(u64)id, .id = id, .bounds = RetroRect(x, y, width, height),
            .label = Tr(label), .now = retro.now, .capture = capture})
}

// The screen pixel under a window point.
RetroPointX :: (x: float32) -> s32 {
    return cast(s32)((x - retro.x) / retro.scale)
}

RetroPointY :: (y: float32) -> s32 {
    return cast(s32)((y - retro.y) / retro.scale)
}

// A flat button with a black edge and its label in the middle. A chosen
// button is yellow; one held down turns dark.
RetroButton :: (id: s32, x: s32, y: s32, width: s32, height: s32, label: string, chosen: bool = false) -> bool {
    press := RetroTap(id, x, y, width, height, label)
    face: s32 = Pick(chosen, YELLOW, LIGHT_GRAY)
    ink: s32 = BLACK
    if press.down { face = DARK_GRAY; ink = WHITE }
    RetroFill(x, y, width, height, face)
    RetroFrame(x, y, width, height, BLACK)
    span := RetroTextWidth(label)
    if span > width - 4 { span = width - 4 }
    RetroText(x + (width - span) / 2, y + (height - 16) / 2, label, ink, 1, true, span)
    return press.clicked
}

// One of two colors, typed as the drawing calls take them.
Pick :: (yes: bool, chosen: s32, otherwise: s32) -> s32 {
    if yes { return chosen }
    return otherwise
}

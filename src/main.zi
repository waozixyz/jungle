// Jungle: learning games for young children, made with Ziran and Kryon.
// The home screen opens Jungle Math and Dino Colors.
#import "c_string"
#import "desktop_runtime"
#import "session"
#import "geometry"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "widget_palette"
#import, file "platform.zi";
#import, file "ui.zi";
#import, file "store.zi";
#import, file "sound.zi";
#import, file "math_screen.zi";
#import, file "dino_screen.zi";
#import, file "jungle_text.zi";

jungle_sdl :: #system_library "SDL2";
Counter :: () -> u64 #foreign jungle_sdl "SDL_GetPerformanceCounter";
CounterRate :: () -> u64 #foreign jungle_sdl "SDL_GetPerformanceFrequency";

SCREEN_HOME :: 0
SCREEN_MATH :: 1
SCREEN_DINOS :: 2

screen: s32;

Home :: () {
    unused TopBar("Jungle", false)
    if BarButton(60, 0, ifx sound_muted then "Sound off" else "Sound on", "Sound", 130.0) {
        sound_muted = !sound_muted
        jungle.muted = sound_muted
        Remember()
    }
    columns: s32 = ifx Landscape() then 2 else 1
    area := Rectangle.{40.0, TOP_BAR + 24.0, ui.width - 80.0, ui.height - TOP_BAR - 64.0}
    if Card(70, GridCell(area, 2, columns, 0, 28.0), "assets/friends/monkey.png", "Jungle Math",
        "Count, add and meet jungle friends") {
        MathOpen(ui.now)
        screen = SCREEN_MATH
    }
    if Card(80, GridCell(area, 2, columns, 1, 28.0), "assets/dinos/trex-thumb.png", "Dino Colors",
        "Color the dinosaurs") {
        DinoOpen()
        screen = SCREEN_DINOS
    }
    if jungle_save_failed {
        Words(90, Rectangle.{24.0, ui.height - 36.0, ui.width - 48.0, 28.0}, "Progress could not be saved.", 18)
    }
}

Seconds :: () -> float64 {
    return cast(float64)Counter() / cast(float64)CounterRate()
}

Draw :: (session: Session) -> bool {
    BeginDesktopFrame()
    viewport := DesktopViewport()
    ui = UiFrame.{.session = session, .width = viewport.width, .height = viewport.height, .now = Seconds(),
        .key = DesktopPressedKey()}
    TreePointerUpdate(session, PollPointer())
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { return false }
    unused WidgetPaletteUse(session, UiPalette())
    Backdrop()
    if screen == SCREEN_MATH {
        if !MathFrame() { screen = SCREEN_HOME }
    } else if screen == SCREEN_DINOS {
        if !DinoFrame() { screen = SCREEN_HOME }
    } else {
        Home()
    }
    if EndFrame(session) != FrameStatus.FrameOk { return false }
    return EndDesktopFrame()
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    folder := AppDirectory()
    if folder == "" || !EnterDirectory(folder) {
        Report("jungle: cannot find its assets folder\n")
        return 1
    }
    jungle_folder = DataDirectory()
    jungle = JungleSaveLoad(jungle_folder)
    sound_muted = jungle.muted
    if !OpenDesktopSized(1100, 780) { CloseDesktop(); return 1 }
    unused DesktopSetTitle("Jungle")
    session := SessionOpen()
    if !SessionValid(session) { CloseDesktop(); return 1 }
    ok := true
    while ok && PollDesktop() {
        ok = Draw(session)
        if ok { PauseDesktop() }
    }
    SessionClose(session)
    CloseDesktop()
    return ifx ok then 0 else 1
}

// One sound channel: a new sound replaces the one playing. Sounds are WAV
// files under assets/sounds, read once. Without an audio device Jungle stays
// silent and runs on.
#import "byte_text_linux"
#import "file"

sound_sdl :: #system_library "SDL2";
sound_c :: #system_library "c";

SoundSpec :: struct {
    freq: s32
    format: u16
    channels: u8
    silence: u8
    samples: u16
    padding: u16
    size: u32
    callback: *void
    userdata: *void
}

SoundInit :: (flags: u32) -> s32 #foreign sound_sdl "SDL_InitSubSystem";
SoundOpenDevice :: (device: *u8, capture: s32, desired: *SoundSpec, obtained: *SoundSpec,
    changes: s32) -> u32 #foreign sound_sdl "SDL_OpenAudioDevice";
SoundPause :: (device: u32, paused: s32) #foreign sound_sdl "SDL_PauseAudioDevice";
SoundQueue :: (device: u32, data: *u8, length: u32) -> s32 #foreign sound_sdl "SDL_QueueAudio";
SoundClear :: (device: u32) #foreign sound_sdl "SDL_ClearQueuedAudio";

SOUND_INIT_AUDIO :: 16
// AUDIO_S16LSB, mono, as tools/sounds.zi writes them.
SOUND_S16 :: 32784
SOUND_RATE :: 22050
SOUND_SLOTS :: 8

sound_device: u32;
sound_unavailable: bool;
sound_muted: bool;
sound_names: [SOUND_SLOTS]string;
sound_data: [SOUND_SLOTS]string;

SoundOpen :: () -> bool {
    if sound_device != cast(u32)0 { return true }
    if sound_unavailable || SoundInit(cast(u32)SOUND_INIT_AUDIO) != 0 { sound_unavailable = true; return false }
    desired := SoundSpec.{.freq = SOUND_RATE, .format = cast(u16)SOUND_S16, .channels = cast(u8)1, .samples = cast(u16)512}
    obtained: SoundSpec
    sound_device = SoundOpenDevice(null, 0, *desired, *obtained, 0)
    if sound_device == cast(u32)0 { sound_unavailable = true; return false }
    SoundPause(sound_device, 0)
    return true
}

// The samples after a canonical 44-byte header, or "" when it is not one
// of ours.
SoundSamples :: (name: string) -> string {
    for slot: cast(s32)0..SOUND_SLOTS - 1 {
        if sound_names[slot] == name { return sound_data[slot][44:] }
    }
    text, found := ReadEntireFile(name)
    if !found || text.count <= 44 || text[:4] != "RIFF" || text[8:12] != "WAVE" { return "" }
    for slot: cast(s32)0..SOUND_SLOTS - 1 {
        if sound_names[slot] == "" {
            sound_names[slot] = name
            sound_data[slot] = text
            return sound_data[slot][44:]
        }
    }
    return text[44:]
}

SoundPlay :: (name: string) {
    if sound_muted || !SoundOpen() { return }
    samples := SoundSamples(name)
    if samples.count == 0 { return }
    SoundClear(sound_device)
    descriptor := cast(*TextDescriptor)(*samples)
    unused SoundQueue(sound_device, descriptor.data, cast(u32)samples.count)
}

// Jungle's saved progress: each math trail's level, the fruit basket, the
// friends found, sound, and every coloring page's colors. One small text
// file in the data folder, replaced whole on each save.
#import "file"
#import, file "jungle_text.zi";
#import, file "lessons.zi";
#import, file "dino_pages.zi";

// Colors a region can hold; -1 is a region still white.
PALETTE :: 16

JungleSave :: struct {
    skills: [TRAILS]Skill
    fruits: s32
    friends: s32
    muted: bool
    colors: [PAGES][REGION_LIMIT]s32
}

JungleSaveNew :: () -> JungleSave {
    save: JungleSave
    for trail: cast(s32)0..TRAILS - 1 { save.skills[trail] = SkillNew() }
    for page: cast(s32)0..PAGES - 1 {
        for region: cast(s32)0..REGION_LIMIT - 1 { save.colors[page][region] = -1 }
    }
    return save
}

JungleSaveText :: (save: *JungleSave) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "jungle 1\n")
    for trail: cast(s32)0..TRAILS - 1 {
        BuilderPrint(*text, "skill % % % %\n", trail, save.skills[trail].level, save.skills[trail].streak,
            save.skills[trail].misses)
    }
    BuilderPrint(*text, "fruits %\nfriends %\nmuted %\n", save.fruits, save.friends, ifx save.muted then 1 else 0)
    for page: cast(s32)0..PAGES - 1 {
        row: [REGION_LIMIT]u8
        for region: cast(s32)0..REGION_LIMIT - 1 {
            color := save.colors[page][region]
            row[region] = ifx color < 0 || color >= PALETTE then #char "." else cast(u8)(#char "a" + color)
        }
        BuilderPrint(*text, "page % %\n", page, TextView(row[:]))
    }
    return BuilderFinish(text)
}

// Reads what JungleSaveText wrote. Unknown or damaged lines are skipped, so
// an older or newer file keeps whatever it can.
JungleSaveRead :: (text: string) -> JungleSave {
    save := JungleSaveNew()
    at: s64 = 0
    while at < text.count {
        end := at
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        line := text[at:end]
        at = end + 1
        cursor: s64 = 0
        if line.count > 6 && line[:6] == "skill " {
            cursor = 6
            trail := ReadWhole(line, *cursor); cursor += 1
            level := ReadWhole(line, *cursor); cursor += 1
            streak := ReadWhole(line, *cursor); cursor += 1
            misses := ReadWhole(line, *cursor)
            if trail >= 0 && trail < TRAILS && level >= 1 && level <= LEVELS && streak >= 0 && misses >= 0 {
                save.skills[trail] = Skill.{.level = level, .streak = Clamp(streak, 0, LEVEL_UP_STREAK - 1),
                    .misses = Clamp(misses, 0, LEVEL_DOWN_MISSES - 1)}
            }
        } else if line.count > 7 && line[:7] == "fruits " {
            cursor = 7
            save.fruits = Clamp(ReadWhole(line, *cursor), 0, BASKET - 1)
        } else if line.count > 8 && line[:8] == "friends " {
            cursor = 8
            save.friends = Clamp(ReadWhole(line, *cursor), 0, FRIENDS)
        } else if line.count > 6 && line[:6] == "muted " {
            save.muted = line[6] == #char "1"
        } else if line.count > 5 && line[:5] == "page " {
            cursor = 5
            page := ReadWhole(line, *cursor)
            cursor += 1
            if page < 0 || page >= PAGES || cursor > line.count { continue }
            row := line[cursor:]
            for region: cast(s32)0..REGION_LIMIT - 1 {
                if region >= row.count { break }
                byte := row[region]
                save.colors[page][region] = ifx byte >= #char "a" && byte < #char "a" + PALETTE then cast(s32)(byte - #char "a") else -1
            }
        }
    }
    return save
}

JungleSaveLoad :: (folder: string) -> JungleSave {
    text, found := ReadEntireFile(Cat(folder, "/progress.txt"))
    if !found { return JungleSaveNew() }
    return JungleSaveRead(text)
}

// Writes beside the old file, then replaces it, so a crash never leaves half
// a save.
JungleSaveStore :: (folder: string, save: *JungleSave) -> bool {
    unused CreateDirectory(folder)
    fresh := Cat(folder, "/progress.txt.new")
    if !WriteEntireFile(fresh, JungleSaveText(save)) { return false }
    return RenamePath(fresh, Cat(folder, "/progress.txt"))
}

// The running game's save and where it lives.
jungle: JungleSave;
jungle_folder: string;
jungle_save_failed: bool;

Remember :: () {
    jungle_save_failed = jungle_folder == "" || !JungleSaveStore(jungle_folder, *jungle)
}

// Dino Colors' pages load whole, and a tap finds the region a child sees.
#import, file "../src/dino_pages.zi";
#import, file "../src/platform.zi";
#import, file "../src/jungle_text.zi";

Expect :: (page: *DinoPage, x: float32, y: float32, region: s32) -> bool {
    found := DinoPageRegionAt(page, x, y)
    if found == region { return true }
    Report(Cat("dino test: ", page_names[page.index], " at ", NumberText(cast(s32)x), ",", NumberText(cast(s32)y),
        " found region ", NumberText(found), Cat(", expected ", NumberText(region), "\n")))
    return false
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    page: DinoPage
    for index: cast(s32)0..PAGES - 1 {
        if !DinoPageLoad(*page, index) {
            Report(Cat("dino test: page ", page_names[index], " did not load\n"))
            return 1
        }
        if !page.has_top { Report(Cat("dino test: page ", page_names[index], " has no eyes layer\n")); return 1 }
    }
    ok := true
    unused DinoPageLoad(*page, 0)
    ok = Expect(*page, 20.0, 20.0, 0) && ok
    ok = Expect(*page, 110.0, 100.0, 1) && ok
    ok = Expect(*page, 500.0, 700.0, 5) && ok
    ok = Expect(*page, 340.0, 300.0, 14) && ok
    ok = Expect(*page, 380.0, 340.0, 8) && ok
    ok = Expect(*page, 600.0, 190.0, 11) && ok
    ok = Expect(*page, 660.0, 275.0, 12) && ok
    ok = Expect(*page, 820.0, 280.0, 4) && ok
    unused DinoPageLoad(*page, 2)
    ok = Expect(*page, 510.0, 240.0, 11) && ok
    ok = Expect(*page, 820.0, 668.0, 5) && ok
    ok = Expect(*page, 100.0, 500.0, 2) && ok
    unused DinoPageLoad(*page, 5)
    ok = Expect(*page, 500.0, 450.0, 6) && ok
    ok = Expect(*page, 500.0, 250.0, 7) && ok
    ok = Expect(*page, 500.0, 530.0, 10) && ok
    if !ok { return 1 }
    Report("dino test passed\n")
    return 0
}

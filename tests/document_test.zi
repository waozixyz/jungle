#import, file "../games/paint/paint_document.zi";
#import, file "../games/paint/paint_canvas.zi";
#import, file "../games/paint/paint_pages.zi";
#import, file "../games/paint/paint_picture.zi";
#import, file "../games/paint/paint_palette.zi";
#import "std/byte_text_linux"
#import "std/c_string"
#import "std/text_buffer"
#import "std/text_buffer"
#import, file "../host/platform.zi";
#import, file "../host/jungle_text.zi";

pixels: [CANVAS_PIXELS]u8;
old: [OLD_PIXELS]u8;

// A version 1 record: 240 by 180 letters and a mask marking the lines.
VersionOne :: (black_paint: bool) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "JUNGLE PICTURE 1\n3%\n", PAINT_CODES[20:21])
    for row: cast(s32)0..STORY_LINES - 1 { BuilderPrint(*text, "%\n", "Old story                             ") }
    for at: cast(s32)0..OLD_PIXELS - 1 { unused VecPush(text, PAINT_CODES[ifx at < OLD_WIDTH then 0 else 18]) }
    unused VecPush(text, cast(u8)10)
    for at: cast(s32)0..OLD_PIXELS - 1 {
        unused VecPush(text, ifx at < OLD_WIDTH && !black_paint then #char "1" else #char "0")
    }
    unused VecPush(text, cast(u8)10)
    return BuilderFinish(text)
}

#program_export
main :: () -> s32 {
    scene = 3
    crayon = 29
    unused SceneOpen(scene)
    CanvasStampDino(2, 2, 20, 20, true)
    unused CanvasFill(2, 2, 45)
    words := "My dinosaur (and friend)!"
    for at: cast(s64)0..words.count - 1 { story[0][at] = words[at] }
    story[7][37] = #char "!"
    original := PictureText()
    for at: cast(s32)0..CANVAS_PIXELS - 1 { pixels[at] = canvas[at] }
    unused SceneOpen(0)
    scene = 0
    ClearStory()
    if !PictureLoad(original) || scene != 3 || crayon != 29 { return 1 }
    if TextUntilNul(story[0][:]) != words || story[7][37] != #char "!" { return 2 }
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        if canvas[at] != pixels[at] { return 3 }
    }
    if PictureText() != original { return 4 }
    for cut: cast(s64)0..original.count - 2 {
        // Include every structural boundary, with no quadratic full-record loop.
        if cut < 340 || cut % 4096 == 0 || cut > original.count - 5 {
            if PictureLoad(original[:cut]) || PictureText() != original { return 5 }
        }
    }
    if PictureLoad(Cat(original, "x")) || PictureText() != original { return 6 }
    bad: Vec(u8)
    BuilderPrint(*bad, "%", original)
    bad[PICTURE_HEADER.count] = #char "9"
    if PictureLoad(BuilderFinish(bad)) || scene != 3 { return 7 }
    // Black paint remains paint; it must not become an immutable outline.
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)BLACK_PAINT }
    black := PictureText()
    if !PictureLoad(black) || CanvasFill(0, 0, 44) != CANVAS_PIXELS { return 8 }
    // Old palette-only records import exactly, each pixel a 4 by 4 block.
    for at: cast(s32)0..OLD_PIXELS - 1 { old[at] = #char "p" }
    old[0] = #char "a"
    if !PictureLoad(TextView(old[:])) || canvas[0] != INK || canvas[3 * CANVAS_WIDTH + 3] != INK ||
    canvas[4] != 15 || canvas[4 * CANVAS_WIDTH] != 15 { return 9 }
    // Version 1 pictures keep their scene, crayon, story, colors and lines;
    // black outside their line mask stays paint.
    if !PictureLoad(VersionOne(false)) || scene != 3 || crayon != 20 || TextUntilNul(story[0][:]) != "Old story" { return 12 }
    if canvas[CANVAS_WIDTH * 3 + 959] != INK || canvas[CANVAS_WIDTH * 4] != 18 { return 13 }
    if !PictureLoad(VersionOne(true)) || canvas[0] != cast(u8)BLACK_PAINT || CanvasFill(0, 0, 20) != CANVAS_WIDTH * 4 { return 14 }
    upgraded := PictureText()
    if !PictureLoad(upgraded) || PictureText() != upgraded { return 15 }
    // The existing fixed-width story format preserves accented cells, while
    // text shown and exported is valid UTF-8 in every supported language.
    ClearStory()
    story[0][0] = cast(u8)252
    story[0][1] = cast(u8)223
    story[0][2] = cast(u8)241
    story[0][3] = cast(u8)225
    accented := PictureText()
    ClearStory()
    if !PictureLoad(accented) || StoryText() != "üßñá\n\n\n\n\n\n\n\n" { return 10 }
    if PictureText() != accented { return 11 }
    Report("local document test passed\n")
    return 0
}

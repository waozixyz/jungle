#import, file "../games/hide_seek/hide_seek.zi";
#import, file "../host/jungle_text.zi";
#import, file "../retro/language.zi";

// The scene's own kinds of place, back to front, different friends, all but
// one place hiding a friend, and nothing looked at, found or showing yet.
ValidRound :: (h: HideSeek) -> bool {
    if h.mode != HIDE_FIND || h.scene < 0 || h.scene >= HIDE_SCENES { return false }
    if h.places != HideSeekPlaces(h.scene) || h.places < 2 || h.places > HIDE_SLOTS { return false }
    if HideSeekFriends(h) != h.places - 1 || HideSeekFound(h) != 0 || HideSeekDone(h) { return false }
    for i: cast(s32)0..h.places - 1 {
        if h.kinds[i] != HideSeekSlotKind(h.scene, i) || h.animals[i] < 0 || h.animals[i] >= HIDE_ANIMALS { return false }
        if h.revealed[i] || h.looked[i] { return false }
        // Completely hidden: no peek, preview or picture before a look.
        if HideSeekPeek(h, i) != HIDE_NO_PEEK { return false }
        for j: cast(s32)0..i - 1 {
            if j < i && (h.kinds[j] == h.kinds[i] || h.animals[j] == h.animals[i]) { return false }
        }
    }
    for i: h.places..HIDE_MAX_PLACES - 1 { if h.hides[i] || h.revealed[i] { return false } }
    return true
}

HasKind :: (scene: s32, kind: s32) -> bool {
    for i: cast(s32)0..HideSeekPlaces(scene) - 1 { if HideSeekSlotKind(scene, i) == kind { return true } }
    return false
}

// Reveal every hiding friend.
FindAll :: (h: *HideSeek) {
    for i: cast(s32)0..h.places - 1 { if h.hides[i] { unused HideSeekTap(h, i) } }
}

#program_export
main :: () -> s32 {
    // Natural places per scene: outdoors a tree, bush and basket; the cozy
    // house a table and basket; the farm a table, bush and basket.
    if HideSeekPlaces(HIDE_COTTAGE_YARD) != 3 || HideSeekPlaces(HIDE_FENCED_GARDEN) != 3 { return 1 }
    if HideSeekPlaces(HIDE_COZY_HOUSE) != 2 || HideSeekPlaces(HIDE_FARM_COURTYARD) != 3 || HideSeekPlaces(4) != 0 || HideSeekPlaces(-1) != 0 { return 1 }
    for scene: cast(s32)0..1 {
        if !HasKind(scene, HIDE_TREE) || !HasKind(scene, HIDE_BUSH) || !HasKind(scene, HIDE_BASKET) || HasKind(scene, HIDE_TABLE) { return 1 }
    }
    if !HasKind(HIDE_COZY_HOUSE, HIDE_TABLE) || !HasKind(HIDE_COZY_HOUSE, HIDE_BASKET) || HasKind(HIDE_COZY_HOUSE, HIDE_BUSH) || HasKind(HIDE_COZY_HOUSE, HIDE_TREE) { return 1 }
    if !HasKind(HIDE_FARM_COURTYARD, HIDE_TABLE) || !HasKind(HIDE_FARM_COURTYARD, HIDE_BUSH) || !HasKind(HIDE_FARM_COURTYARD, HIDE_BASKET) || HasKind(HIDE_FARM_COURTYARD, HIDE_TREE) { return 1 }
    if HideSeekSlotKind(HIDE_COZY_HOUSE, 2) != -1 || HideSeekSlotKind(9, 0) != -1 || HideSeekSlotKind(0, -1) != -1 { return 1 }

    // Deterministic, valid rounds for every scene, earlier level and many
    // seeds; every scene, friend, empty place and mirror turns up.
    scenes: [4]s32
    animals: [12]s32
    empties: [12]s32
    mirrors: [2]s32
    unset: s32 = -1
    for mode: unset..HIDE_MODES {
        for seed: cast(s32)0..299 {
            for scene: unset..HIDE_SCENES - 1 {
                h := HideSeekNew(mode, seed * 7919 + 3, seed % 5, -1, 0, scene)
                if !ValidRound(h) || (scene >= 0 && h.scene != scene) { return 2 }
                again := HideSeekNew(mode, seed * 7919 + 3, seed % 5, -1, 0, scene)
                if again.scene != h.scene || again.mirror != h.mirror || again.places != h.places { return 3 }
                for i: cast(s32)0..h.places - 1 {
                    if again.animals[i] != h.animals[i] || again.hides[i] != h.hides[i] { return 3 }
                    if h.hides[i] { animals[h.animals[i]] += 1 } else { empties[h.scene * HIDE_SLOTS + i] += 1 }
                }
                scenes[h.scene] += 1
                mirrors[ifx h.mirror then 1 else 0] += 1
            }
        }
    }
    for s: cast(s32)0..HIDE_SCENES - 1 {
        if scenes[s] == 0 { return 4 }
        for i: cast(s32)0..HideSeekPlaces(s) - 1 { if empties[s * HIDE_SLOTS + i] == 0 { return 4 } }
    }
    for a: cast(s32)0..HIDE_ANIMALS - 1 { if animals[a] == 0 { return 5 } }
    if mirrors[0] == 0 || mirrors[1] == 0 { return 5 }
    // Bad arguments fall back to a fresh round with bounded counts.
    if HideSeekNew(-1, -5).mode != HIDE_FIND || !ValidRound(HideSeekNew(7, 2147483647)) { return 7 }
    if !ValidRound(HideSeekNew(HIDE_REMEMBER, -2147483647 - 1)) || !ValidRound(HideSeekNew(HIDE_PEEKABOO, 3, 0, -1, 0, 99)) { return 7 }
    if HideSeekNew(HIDE_FIND, 1, -3).rounds != 0 || HideSeekNew(HIDE_FIND, 1, HIDE_MAX_ROUNDS + 1).rounds != 0 { return 7 }
    if HideSeekNew(HIDE_FIND, 1, 0, -1, -4).remembered != 0 || HideSeekNew(HIDE_FIND, 1, 0, -1, HIDE_MAX_ROUNDS + 1).remembered != 0 { return 7 }
    if !ValidRound(HideSeekNew(HIDE_FIND, 5, 4, 99999)) || !ValidRound(HideSeekNew(HIDE_FIND, 5, 4, -7)) || !ValidRound(HideSeekNew(HIDE_FIND, 5, 4, 4095)) { return 7 }
    // Leaving out friends never leaves too few to hide.
    for seed: cast(s32)0..99 {
        some := HideSeekNew(HIDE_FIND, seed, 0, 0x0ff, 0, HIDE_FARM_COURTYARD)
        if !ValidRound(some) { return 7 }
        for i: cast(s32)0..some.places - 1 { if some.animals[i] < 8 { return 7 } }
    }

    // Looking: an empty place shows and says nothing, a hiding friend is
    // found and counted, and found friends can be tapped again.
    f := HideSeekNew(HIDE_FIND, 4242, 5, -1, 3, HIDE_COTTAGE_YARD)
    empty: s32 = -1
    for i: cast(s32)0..f.places - 1 { if !f.hides[i] { empty = i } }
    if empty < 0 || HideSeekFriends(f) != 2 { return 10 }
    if HideSeekTap(*f, -1) != HIDE_IGNORED || HideSeekTap(*f, f.places) != HIDE_IGNORED || HideSeekTap(*f, 3) != HIDE_IGNORED { return 11 }
    if HideSeekTap(*f, empty) != HIDE_EMPTY || !f.looked[empty] || f.revealed[empty] || f.rounds != 5 { return 12 }
    if HideSeekTap(*f, empty) != HIDE_EMPTY || HideSeekPeek(f, empty) != HIDE_NO_PEEK || HideSeekFound(f) != 0 { return 12 }
    // Looking somewhere empty never uncovers or hints at the others.
    for i: cast(s32)0..f.places - 1 { if HideSeekPeek(f, i) != HIDE_NO_PEEK { return 13 } }
    first := (empty + 1) % f.places
    second := (empty + 2) % f.places
    if HideSeekTap(*f, first) != HIDE_REVEALED || HideSeekPeek(f, first) != HIDE_SHOWN || f.rounds != 6 { return 14 }
    if HideSeekPeek(f, second) != HIDE_NO_PEEK || HideSeekDone(f) || HideSeekFound(f) != 1 { return 14 }
    if HideSeekTap(*f, first) != HIDE_AGAIN || f.rounds != 6 { return 15 }
    if HideSeekTap(*f, second) != HIDE_REVEALED || !HideSeekDone(f) || f.rounds != 7 || f.remembered != 3 { return 16 }
    // Once all are found, the empty place stays quiet.
    if HideSeekTap(*f, empty) != HIDE_IGNORED || HideSeekTap(*f, second) != HIDE_AGAIN || f.rounds != 7 { return 17 }
    // Found friends' places are answered, never their names.
    if HideSeekCue(HIDE_BASKET) != "in" || HideSeekCue(HIDE_BUSH) != "behind" || HideSeekCue(HIDE_TABLE) != "under" { return 18 }
    if HideSeekCue(HIDE_TREE) != "up" || HideSeekCue(9) != "in" || HideSeekCue(-1) != "in" { return 18 }
    if HideSeekCuePath(HideSeekCue(HIDE_TREE), "de") != "assets/hide_seek/sounds/de/up.wav" { return 18 }
    if HideSeekCuePath("peekaboo", "es") != "assets/hide_seek/sounds/es/peekaboo.wav" { return 18 }

    // The next round visits the next scene, keeps every count and brings
    // other friends.
    for seed: cast(s32)0..199 {
        next := HideSeekNext(f, seed)
        if !ValidRound(next) || next.scene != (f.scene + 1) % HIDE_SCENES || next.rounds != 7 || next.remembered != 3 { return 20 }
        for i: cast(s32)0..next.places - 1 {
            for j: cast(s32)0..f.places - 1 { if f.hides[j] && next.animals[i] == f.animals[j] { return 21 } }
        }
    }
    tour := HideSeekNew(HIDE_FIND, 77, 0, -1, 0, HIDE_COTTAGE_YARD)
    for i: cast(s32)0..7 {
        if tour.scene != i % HIDE_SCENES || !ValidRound(tour) { return 22 }
        FindAll(*tour)
        tour = HideSeekNext(tour, i + 11)
    }
    if tour.rounds != 2 + 2 + 1 + 2 + 2 + 2 + 1 + 2 { return 23 }

    // Only a completed round advances, once its gentle celebration ends.
    incomplete := HideSeekNew(HIDE_FIND, 17, 6, -1, 9, HIDE_FARM_COURTYARD)
    if HideSeekAdvanceReady(incomplete, 200.0) || HideSeekAdvance(incomplete, 80).scene != incomplete.scene { return 70 }
    if HideSeekAdvance(incomplete, 80).animals[0] != incomplete.animals[0] { return 70 }
    FindAll(*incomplete)
    if !HideSeekDone(incomplete) || HideSeekAdvanceReady(incomplete, -1.0) || HideSeekAdvanceReady(incomplete, 2.499) { return 71 }
    if !HideSeekAdvanceReady(incomplete, 2.5) || !HideSeekAdvanceReady(incomplete, 100.0) { return 71 }
    advanced := HideSeekAdvance(incomplete, 81)
    if advanced.mode != HIDE_FIND || advanced.scene != HIDE_COTTAGE_YARD || advanced.rounds != 8 || advanced.remembered != 9 { return 72 }
    if !ValidRound(advanced) || HideSeekAdvanceReady(advanced, 100.0) { return 72 }
    // A held touch or Enter stays blocked until release; a fresh one works.
    guard := HideSeekInputGuard(true, false, false, true)
    if !guard || !HideSeekInputGuard(guard, false, false, true) || HideSeekInputGuard(guard, false, false, false) { return 77 }
    guard = HideSeekInputGuard(true, true, false, false)
    if !guard || !HideSeekInputGuard(guard, false, true, false) || HideSeekInputGuard(guard, false, false, false) { return 78 }
    if HideSeekInputGuard(false, true, false, false) || HideSeekInputGuard(false, false, false, true) || HideSeekInputGuard(false, false, true, false) { return 79 }

    // Geometry for every scene at real stage sizes, mirrored or not: bounded,
    // back to front with varied depths, separate taps, and every friend in a
    // believable spot of the unchanged prop.
    widths: [6]s32 = .[376, 893, 320, 1240, 520, 700]; heights: [6]s32 = .[505, 346, 640, 420, 700, 520]
    for size_at: cast(s32)0..5 {
        width := widths[size_at]; height := heights[size_at]
        for scene: cast(s32)0..HIDE_SCENES - 1 {
            for flip: cast(s32)0..1 {
                count := HideSeekPlaces(scene)
                last_ground: s32 = -1
                for place: cast(s32)0..count - 1 {
                    at := HideSeekSceneLayout(width, height, count, place, scene, flip == 1)
                    if at.kind != HideSeekSlotKind(scene, place) || at.size <= 0 { return 75 }
                    if at.x < 0 || at.y < 0 || at.x + at.width > width || at.ground > height { return 75 }
                    if at.width <= 0 || at.height <= 0 || at.y + at.height != at.ground { return 75 }
                    if at.cx <= at.x || at.cx >= at.x + at.width { return 75 }
                    // Nearer props stand lower; no uniform grid of grounds.
                    if at.ground <= last_ground + height / 40 { return 76 }
                    last_ground = at.ground
                    for other: cast(s32)0..place - 1 {
                        b := HideSeekSceneLayout(width, height, count, other, scene, flip == 1)
                        if at.x < b.x + b.width && b.x < at.x + at.width && at.y < b.y + b.height && b.y < at.y + at.height { return 76 }
                    }
                    for animal: cast(s32)0..HIDE_ANIMALS - 1 {
                        closed := HideSeekArtLayout(at.kind, at.cx, at.ground, at.size, 0.0, animal, at.toward)
                        for frame: cast(s32)0..4 {
                            art := HideSeekArtLayout(at.kind, at.cx, at.ground, at.size, cast(float32)frame / 4.0, animal, at.toward)
                            if art.edge != closed.edge || art.x != closed.x || art.y != closed.y || art.behind != closed.behind { return 80 }
                            if art.animal_edge != closed.animal_edge || art.animal_base != closed.animal_base { return 80 }
                            if art.x < 0 || art.y + art.edge * hide_prop_tops[at.kind] / HIDE_PROP_PIXELS < 0 || art.x + art.edge > width { return 81 }
                            if art.y + art.edge * hide_prop_bases[at.kind] / HIDE_PROP_PIXELS != at.ground { return 81 }
                            // Feet stay planted, regardless of padding or tails.
                            top := art.animal_base - art.animal_edge * hide_animal_feet[animal] / 420
                            if top < 0 || top + art.animal_edge > height || art.animal_edge <= 0 { return 82 }
                            if art.animal_cx - art.animal_edge / 2 < 0 || art.animal_cx + art.animal_edge / 2 > width { return 82 }
                            if top + art.animal_edge * hide_animal_feet[animal] / 420 != art.animal_base { return 82 }
                            px := (art.animal_cx - art.x) * HIDE_PROP_PIXELS / art.edge
                            left := (art.animal_cx - art.animal_edge / 2 - art.x) * HIDE_PROP_PIXELS / art.edge
                            right := (art.animal_cx + art.animal_edge / 2 - art.x) * HIDE_PROP_PIXELS / art.edge
                            feet := (art.animal_base - art.y) * HIDE_PROP_PIXELS / art.edge
                            head := (top - art.y) * HIDE_PROP_PIXELS / art.edge
                            if at.kind == HIDE_TABLE {
                                // Between the front legs, below the cloth's
                                // hem, standing between back and front feet.
                                if !art.behind || left < 262 || right > 994 || head < 715 || feet <= 880 || feet >= 1038 { return 83 }
                            } else if at.kind == HIDE_BASKET {
                                // Inside the whole basket, rising above its
                                // back rim without a cropped front.
                                if !art.behind || left < 36 || right > 1229 || feet <= 376 || feet >= 1085 || head >= 376 { return 84 }
                                if px < 560 || px > 700 { return 84 }
                            } else if at.kind == HIDE_BUSH {
                                // Behind the bush, stepping out past its side.
                                if !art.behind || art.animal_base != at.ground || px > 300 && px < 954 { return 85 }
                                if (art.animal_cx - at.cx) * (width / 2 - at.cx) <= 0 || at.toward * (width / 2 - at.cx) < 0 { return 85 }
                            } else {
                                // Sitting in front on the low left branch.
                                if art.behind || feet < 625 || feet > 650 || px < 200 || px > 270 { return 86 }
                            }
                        }
                    }
                }
            }
        }
    }

    // Small geometry receipts let the Python real-asset pixel test use the
    // actual native layout, rather than maintaining a second implementation.
    for orientation: cast(s32)0..1 {
        at := HideSeekSceneLayout(widths[orientation], heights[orientation], 3, 0, HIDE_COTTAGE_YARD)
        for kind: cast(s32)0..HIDE_KINDS - 1 {
            for frame: cast(s32)0..4 {
                for animal: cast(s32)0..HIDE_ANIMALS - 1 {
                    art := HideSeekArtLayout(kind, at.cx, at.ground, at.size, cast(float32)frame / 4.0, animal, at.toward)
                    print("hide-art % % % % % % % % % % % %\n", widths[orientation], heights[orientation], kind, frame, animal,
                        art.x, art.y, art.edge, art.animal_cx, art.animal_base, art.animal_edge, ifx art.behind then 1 else 0)
                }
            }
        }
        for scene: cast(s32)0..HIDE_SCENES - 1 {
            for flip: cast(s32)0..1 {
                for place: cast(s32)0..HideSeekPlaces(scene) - 1 {
                    p := HideSeekSceneLayout(widths[orientation], heights[orientation], 3, place, scene, flip == 1)
                    animal := (scene * HIDE_SLOTS + place + flip * 5) % HIDE_ANIMALS
                    art := HideSeekArtLayout(p.kind, p.cx, p.ground, p.size, 1.0, animal, p.toward)
                    print("hide-place % % % % % % % % % % % % % % % % % % % % %\n", widths[orientation], heights[orientation], scene, flip, place,
                        p.kind, p.cx, p.ground, p.size, p.x, p.y, p.width, p.height, animal,
                        art.x, art.y, art.edge, art.animal_cx, art.animal_base, art.animal_edge, ifx art.behind then 1 else 0)
                }
            }
        }
    }

    // Saves keep only the counts. Earlier saves, from any of the three
    // levels, still read, and damage is refused.
    mode: s32 = -1; rounds: s32 = -1; remembered: s32 = -1
    if HideSeekText(f) != "hideseek 2 1 7 3\n" || HideSeekText(advanced) != "hideseek 2 1 8 9\n" { return 50 }
    if !HideSeekRead(HideSeekText(f), *mode, *rounds, *remembered) || mode != HIDE_FIND || rounds != 7 || remembered != 3 { return 51 }
    if !HideSeekRead("hideseek 2 2 2 9\n", *mode, *rounds, *remembered) || mode != HIDE_REMEMBER || rounds != 2 || remembered != 9 { return 51 }
    loaded := HideSeekNew(mode, 12, rounds, -1, remembered)
    if !ValidRound(loaded) || loaded.rounds != 2 || loaded.remembered != 9 || HideSeekText(loaded) != "hideseek 2 1 2 9\n" { return 51 }
    if !HideSeekRead("hideseek 1 1 6\n", *mode, *rounds, *remembered) || mode != HIDE_FIND || rounds != 6 || remembered != 0 { return 52 }
    if !HideSeekRead("hideseek 1 0 0", *mode, *rounds, *remembered) || mode != 0 || rounds != 0 { return 52 }
    if HideSeekText(HideSeekNew(mode, 3, rounds, -1, remembered)) != "hideseek 2 1 0 0\n" { return 52 }
    if !HideSeekRead("hideseek 2 0 100000 100000", *mode, *rounds, *remembered) || rounds != HIDE_MAX_ROUNDS || remembered != HIDE_MAX_ROUNDS { return 52 }
    bad: [22]string = .["", "hideseek 1 ", "hideseek 3 1 6 0\n", "hideseek 1 2 0\n", "hideseek 1 1\n", "hideseek 1 1 x\n",
        "hideseek 1 1 6 7\n", "hideseek 1 1 100001\n", "hideseek 1 -1 0\n", "hideseek 1 1 6\n\n", "matching 1 0 0 4", "hideseek 1 1  6\n",
        "hideseek 2 3 0 0\n", "hideseek 2 1 6\n", "hideseek 2 1 6 \n", "hideseek 2 1 6 -1\n", "hideseek 2 1 6 100001\n",
        "hideseek 2 1 6 9 9\n", "hideseek 2 -1 0 0\n", "hideseek 22 1 6 0\n", "hideseekX2 1 6 0\n", "hideseek 2 1 99999999999 0\n"];
    for text: bad {
        mode = 7; rounds = 7; remembered = 7
        if HideSeekRead(text, *mode, *rounds, *remembered) || mode != 7 || rounds != 7 || remembered != 7 { return 53 }
    }

    // Every word shown has its German and Spanish wording.
    language = 1
    if HideSeekPlaceWords(HIDE_BUSH) != "Hinter dem Busch!" || HideSeekPlaceWords(HIDE_TREE) != "Oben im Baum!" { return 60 }
    language = 2
    if HideSeekPlaceWords(HIDE_TABLE) != "¡Debajo de la mesa!" || HideSeekPlaceWords(HIDE_BASKET) != "¡En la cesta!" { return 61 }
    language = 0
    if HideSeekPlaceWords(HIDE_TABLE) != "Under the table!" || HideSeekKind(f, 99) != f.kinds[0] { return 62 }
    return 0
}

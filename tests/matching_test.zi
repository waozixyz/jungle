#import, file "../games/matching/matching.zi";
#import, file "../host/jungle_text.zi";
#import, file "../retro/language.zi";

// Every animal is on exactly two cards and no round repeats an animal pair.
ValidRound :: (m: Matching) -> bool {
    if m.cards != MatchingPairs(m.mode) * 2 || m.cards > MATCH_MAX_CARDS { return false }
    copies: [22]s32
    for i: cast(s32)0..m.cards - 1 {
        if m.animals[i] < 0 || m.animals[i] >= MATCH_ANIMALS || m.matched[i] { return false }
        copies[m.animals[i]] += 1
    }
    distinct: s32
    for a: cast(s32)0..MATCH_ANIMALS - 1 {
        if copies[a] != 0 && copies[a] != 2 { return false }
        if copies[a] == 2 { distinct += 1 }
    }
    return distinct == MatchingPairs(m.mode) && m.first == -1 && m.second == -1
}

// The other card holding the same animal.
Partner :: (m: Matching, card: s32) -> s32 {
    for i: cast(s32)0..m.cards - 1 { if i != card && m.animals[i] == m.animals[card] { return i } }
    return -1
}

// The first card holding a different animal.
Stranger :: (m: Matching, card: s32) -> s32 {
    for i: cast(s32)0..m.cards - 1 { if m.animals[i] != m.animals[card] && !m.matched[i] { return i } }
    return -1
}

// Finds every pair in order; returns false if any choice misbehaves.
SolveRound :: (m: *Matching) -> bool {
    for card: cast(s32)0..m.cards - 1 {
        if m.matched[card] { continue }
        if MatchingChoose(m, card) != MATCH_FIRST { return false }
        if MatchingChoose(m, Partner(m.*, card)) != MATCH_PAIR { return false }
    }
    return MatchingDone(m.*)
}

FullGrid :: (grid: MatchGrid, cards: s32) -> bool {
    return grid.columns * grid.rows >= cards && cards % grid.columns == 0 && grid.edge > 0
}

#program_export
main :: () -> s32 {
    // Shuffle invariants for every mode and many seeds, and determinism.
    for mode: cast(s32)0..MATCH_MODES - 1 {
        moved: bool
        for seed: cast(s32)0..199 {
            m := MatchingNew(mode, seed * 7919 + 3)
            if !ValidRound(m) { return 1 }
            again := MatchingNew(mode, seed * 7919 + 3)
            for i: cast(s32)0..m.cards - 1 { if again.animals[i] != m.animals[i] { return 2 } }
            if m.animals[0] != m.animals[1] { moved = true }
        }
        if !moved { return 3 }
    }
    if MatchingPairs(0) != 2 || MatchingPairs(1) != 2 || MatchingPairs(2) != 3 || MatchingPairs(3) != 4 ||
        MatchingPairs(4) != 6 || MatchingPairs(5) != 8 || MatchingPairs(6) != 10 { return 4 }
    if !ValidRound(MatchingNew(-4, -1)) || MatchingNew(-4, -1).mode != 0 { return 5 }
    if !ValidRound(MatchingNew(9, 2147483647)) || MatchingNew(9, 0).mode != 0 { return 6 }
    if MatchingNew(0, 0).rounds != 0 || MatchingNew(1, 0, -3).rounds != 0 { return 7 }
    for mode: cast(s32)0..3 { if MatchingPreviewMode(MatchingNew(mode, 3)) { return 8 } }
    for mode: cast(s32)4..MATCH_MODES - 1 { if !MatchingPreviewMode(MatchingNew(mode, 3)) { return 9 } }

    // Easy mode shows every card; memory mode only the chosen ones.
    easy := MatchingNew(0, 42)
    if MatchingHidden(easy) { return 10 }
    for i: cast(s32)0..easy.cards - 1 { if !MatchingFaceUp(easy, i) { return 11 } }
    if MatchingFaceUp(easy, -1) || MatchingFaceUp(easy, easy.cards) { return 12 }

    // Card resolution: a miss stays visible and blocks further flips.
    m := MatchingNew(3, 99)
    if !MatchingHidden(m) { return 20 }
    for i: cast(s32)0..m.cards - 1 { if MatchingFaceUp(m, i) { return 21 } }
    if MatchingChoose(*m, -1) != MATCH_IGNORED || MatchingChoose(*m, m.cards) != MATCH_IGNORED { return 22 }
    if MatchingChoose(*m, 0) != MATCH_FIRST || !MatchingFaceUp(m, 0) { return 23 }
    if MatchingChoose(*m, 0) != MATCH_IGNORED || m.first != 0 { return 24 }
    other := Stranger(m, 0)
    if MatchingChoose(*m, other) != MATCH_MISS || !MatchingResolving(m) { return 25 }
    if !MatchingFaceUp(m, 0) || !MatchingFaceUp(m, other) { return 26 }
    for i: cast(s32)0..m.cards - 1 { if MatchingChoose(*m, i) != MATCH_IGNORED { return 27 } }
    MatchingSettle(*m)
    if MatchingResolving(m) || m.first != -1 || MatchingFaceUp(m, 0) || MatchingFaceUp(m, other) { return 28 }
    MatchingSettle(*m)
    if m.first != -1 { return 29 }

    // A pair is marked and stays face up after another miss settles.
    partner := Partner(m, 0)
    if MatchingChoose(*m, 0) != MATCH_FIRST || MatchingChoose(*m, partner) != MATCH_PAIR { return 30 }
    if !m.matched[0] || !m.matched[partner] || m.first != -1 || MatchingFound(m) != 1 { return 31 }
    if MatchingChoose(*m, 0) != MATCH_IGNORED || MatchingChoose(*m, partner) != MATCH_IGNORED { return 32 }
    if MatchingPairSlot(m, 0) != MatchingPairSlot(m, partner) { return 33 }
    open := Stranger(m, 0)
    if MatchingChoose(*m, open) != MATCH_FIRST || MatchingChoose(*m, Stranger(m, open)) != MATCH_MISS { return 34 }
    MatchingSettle(*m)
    if !MatchingFaceUp(m, 0) || !MatchingFaceUp(m, partner) || MatchingFaceUp(m, open) { return 35 }
    if MatchingDone(m) { return 36 }

    // Completion counts one finished round and leaves every card face up.
    if !SolveRound(*m) || MatchingFound(m) != 4 || m.rounds != 1 { return 40 }
    for i: cast(s32)0..m.cards - 1 { if !MatchingFaceUp(m, i) || MatchingChoose(*m, i) != MATCH_IGNORED { return 41 } }
    if m.rounds != 1 { return 42 }

    // The hardest round can also be completed without any penalty state.
    hard := MatchingNew(6, 314159)
    if !ValidRound(hard) || !SolveRound(*hard) || hard.rounds != 1 || MatchingFound(hard) != 10 { return 44 }

    // Mode reset keeps finished rounds and starts a clean round.
    for mode: cast(s32)0..MATCH_MODES - 1 {
        fresh := MatchingNew(mode, 7, m.rounds)
        if !ValidRound(fresh) || fresh.rounds != 1 || fresh.mode != mode || MatchingDone(fresh) || MatchingFound(fresh) != 0 { return 50 }
    }
    // The pair slots name each pair once, in order of appearance.
    slots := MatchingNew(6, 5)
    seen: [10]s32
    for i: cast(s32)0..slots.cards - 1 {
        slot := MatchingPairSlot(slots, i)
        if slot < 0 || slot > 9 { return 51 }
        seen[slot] += 1
    }
    for i: cast(s32)0..9 { if seen[i] != 2 { return 52 } }
    if MatchingPairSlot(slots, 0) != 0 { return 53 }

    // Saves keep mode, rounds and found pairs, never a half-chosen pair or miss.
    s := MatchingNew(2, 1234, 3)
    p0 := Partner(s, 0)
    unused MatchingChoose(*s, 0); unused MatchingChoose(*s, p0)
    o := Stranger(s, 0)
    unused MatchingChoose(*s, o); unused MatchingChoose(*s, Stranger(s, o))
    loaded: Matching
    if !MatchingRead(MatchingText(s), *loaded) { return 60 }
    if loaded.mode != 2 || loaded.rounds != 3 || loaded.cards != 6 || loaded.first != -1 || loaded.second != -1 { return 61 }
    for i: cast(s32)0..5 { if loaded.animals[i] != s.animals[i] || loaded.matched[i] != s.matched[i] { return 62 } }
    if MatchingText(loaded) != MatchingText(s) { return 63 }
    if !MatchingRead("matching 1 0 0 4 3 7 7 3 0 0 0 0", *loaded) || loaded.animals[1] != 7 { return 64 }
    if !MatchingRead(MatchingText(hard), *loaded) || loaded.mode != 6 || loaded.cards != 20 { return 65 }

    // Corrupt saves are refused and leave the current round untouched.
    keep := MatchingNew(1, 77)
    before := MatchingText(keep)
    bad: [19]string = .[
        "",
        "matching 2 0 0 4 3 7 7 3 0 0 0 0",
        "matching 1 7 0 4 3 7 7 3 0 0 0 0",
        "matching 1 0 0 6 3 7 7 3 1 1 0 0 0 0 0 0",
        "matching 1 0 0 4 3 7 7 22 0 0 0 0",
        "matching 1 0 0 4 3 3 3 3 0 0 0 0",
        "matching 1 0 0 4 3 7 7 5 0 0 0 0",
        "matching 1 0 0 4 3 7 7 3 2 0 0 0",
        "matching 1 0 0 4 3 7 7 3 1 0 0 0",
        "matching 1 0 0 4 3 7 7 3 0 0 0",
        "matching 1 0 0 4 3 7 7 3 0 0 0 0 0",
        "matching 1 0 0 4 3 7 7 3 0 0 0 0 junk",
        "matching 1 0 -1 4 3 7 7 3 0 0 0 0",
        "matching 1 0 100001 4 3 7 7 3 0 0 0 0",
        "matching 1 0 0 4 3 7 x 3 0 0 0 0",
        "matching 1 0 0 4  3 7 7 3 0 0 0 0",
        "matching 1 3 0 4 3 7 7 3 0 0 0 0",
        "matching 1 0 0 8 1 1 2 2 3 3 4 4 0 0 0 0 0 0 0 0",
        "matching 1 0 0"
    ];
    for at: cast(s32)0..18 {
        if MatchingRead(bad[at], *keep) { return 70 + at }
        if MatchingText(keep) != before { return 90 }
    }

    // Grid fits every round, keeps full rows and gives landscape wide rows.
    for pairs: cast(s32)1..10 {
        n := pairs * 2
        tall := MatchingGrid(n, 360, 500, 14)
        wide := MatchingGrid(n, 960, 430, 14)
        if !FullGrid(tall, n) || !FullGrid(wide, n) { return 91 }
        if tall.columns * tall.edge + (tall.columns - 1) * 14 > 360 || tall.rows * tall.edge + (tall.rows - 1) * 14 > 500 { return 92 }
        if wide.columns * wide.edge + (wide.columns - 1) * 14 > 960 || wide.rows * wide.edge + (wide.rows - 1) * 14 > 430 { return 93 }
        if wide.columns < wide.rows { return 94 }
    }
    if MatchingGrid(0, 100, 100, 4).edge != 0 { return 95 }

    // Words follow the chosen language.
    LanguageSet("de")
    if MatchingWords("Easy", "Leicht", "Fácil") != "Leicht" { return 96 }
    LanguageSet("es")
    if MatchingWords("Easy", "Leicht", "Fácil") != "Fácil" { return 97 }
    LanguageSet("en")
    if MatchingWords("Easy", "Leicht", "Fácil") != "Easy" { return 98 }
    return 0
}

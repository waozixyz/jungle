// Dino Colors' scenes and dinosaurs: every scene opens with its lines, its
// lines hold a fill, a picture survives its text form exactly, and every
// dinosaur stamps closed ink and a white body in each size, both ways round,
// leaving the scenery outside its outline.
#import, file "../games/paint/paint_canvas.zi";
#import, file "../games/paint/paint_catalog.zi";
#import, file "../games/paint/paint_earned.zi";
#import, file "../retro/collection_cache.zi";
#import "geometry"
#import, file "../games/paint/paint_pages.zi";
#import, file "../games/paint/paint_picture.zi";
#import, file "../games/paint/paint_palette.zi";
#import, file "../host/platform.zi";
#import, file "../host/jungle_text.zi";

copy: [CANVAS_PIXELS]u8;
read_back: [CANVAS_PIXELS]u8;

PaintFail :: (name: string, message: string) -> s32 {
    Report(Cat("paint test: ", name, ": ", message, "\n"))
    return 1
}

InkCount :: () -> s32 {
    ink: s32 = 0
    for at: cast(s32)0..CANVAS_PIXELS - 1 { if canvas[at] == cast(u8)INK { ink += 1 } }
    return ink
}

Blank :: () {
    CanvasLayersClear()
    for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)PAPER }
}

PalmFillStaysInside :: (scene: s32, x: s32, y: s32, left: s32, top: s32, right: s32, bottom: s32) -> bool {
    if !SceneOpen(scene) || CanvasColorAt(x, y) != PAPER {
        Report(Cat("palm seed is not paper: ", NumberText(scene), " ", NumberText(x), ",", NumberText(y), "\n"))
        return false
    }
    if CanvasFill(x, y, 30) < 20 {
        Report(Cat("palm region too small: ", NumberText(scene), " ", NumberText(x), ",", NumberText(y), "\n"))
        return false
    }
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        if canvas[at] != 30 { continue }
        px := at % WIDE_PAGE.width
        py := at / WIDE_PAGE.width
        if px < left || px >= right || py < top || py >= bottom {
            Report(Cat("palm fill escaped: ", NumberText(scene), " ", NumberText(x), ",", NumberText(y), "\n"))
            return false
        }
    }
    return true
}

ResizeCornersPass :: () -> bool {
    center := Vector2.{100.0, 100.0}
    corners: [4]Vector2 = .[Vector2.{50.0, 75.0}, Vector2.{150.0, 75.0},
        Vector2.{150.0, 125.0}, Vector2.{50.0, 125.0}]
    for at: cast(s32)0..3 {
        if !PaintResizeHit(corners[at], Vector2.{corners[at].x + 21.0, corners[at].y - 21.0}) {
            Report(Cat("paint test: resize corner miss: ", NumberText(at + 1), "\n")); return false
        }
        anchor := corners[(at + 2) % 4]
        larger := Vector2.{anchor.x + (corners[at].x - anchor.x) * 2.0, anchor.y + (corners[at].y - anchor.y) * 2.0}
        resized := PaintResizeAtCorner(center, anchor, corners[at], larger, 100, 50, 48, 300)
        moving := Vector2.{anchor.x + (corners[at].x - anchor.x) * resized.scale,
            anchor.y + (corners[at].y - anchor.y) * resized.scale}
        opposite := Vector2.{resized.center.x * 2.0 - moving.x, resized.center.y * 2.0 - moving.y}
        if !resized.valid || resized.width != 200 || resized.height != 100 ||
           (ifx opposite.x < anchor.x - 0.01 then anchor.x - opposite.x else opposite.x - anchor.x) > 0.01 ||
           (ifx opposite.y < anchor.y - 0.01 then anchor.y - opposite.y else opposite.y - anchor.y) > 0.01 {
            Report(Cat("paint test: resize corner geometry: ", NumberText(at + 1), "\n")); return false
        }
    }
    minimum := PaintResizeAtCorner(center, corners[0], corners[2], corners[0], 100, 50, 48, 300)
    if !minimum.valid || minimum.width != 48 || minimum.height != 24 || minimum.center.x != 74.0 || minimum.center.y != 87.0 {
        Report("paint test: minimum resize is not anchored or square-cornered\n"); return false
    }
    return true
}

PencilShapeFillPass :: () -> bool {
    CanvasBlank()
    if !CanvasPencilStrokeBegin(100, 100) || !CanvasPencilStrokeMove(200, 100) ||
        !CanvasPencilStrokeMove(200, 200) || !CanvasPencilStrokeMove(100, 200) ||
        !CanvasPencilStrokeMove(100, 100) || !CanvasPencilStrokeEnd() {
        Report("paint test: pencil shape did not draw\n"); return false
    }
    if CanvasColorAt(100, 100) != INK || CanvasColorAt(150, 100) != INK ||
        CanvasColorAt(200, 150) != INK || CanvasColorAt(150, 200) != INK {
        Report("paint test: pencil boundary is not black ink\n"); return false
    }
    if CanvasFill(150, 150, 30) <= 0 {
        Report("paint test: closed pencil shape did not fill\n"); return false
    }
    for at: cast(s32)0..CANVAS_PIXELS - 1 {
        if canvas[at] != 30 { continue }
        x := at % WIDE_PAGE.width; y := at / WIDE_PAGE.width
        if x < 102 || x > 197 || y < 102 || y > 197 {
            Report("paint test: fill escaped the closed pencil shape\n"); return false
        }
    }
    return true
}

EarnedFail :: (message: string) -> bool {
    Report(Cat("paint test: earned: ", message, "\n"))
    return false
}

// Every collectible stays hidden until its own bit is set, keeps its natural
// section once earned, and defaults never change position or gain a star.
EarnedPass :: () -> bool {
    CollectionCacheSet("")
    TreasureCacheSet("")
    for index: cast(s32)0..PAINT_STENCIL_COUNT - 1 {
        // 55-65 are collectibles; from 66 on the toucan brings them.
        collectible := index >= 55 && index < 66
        hidden := index >= 55
        if (PaintStencilCollectible(index) >= 0) != collectible { return EarnedFail("stencil table") }
        if (PaintStencilToucan(index) != "") != (index >= 66) { return EarnedFail("toucan stencil table") }
        if PaintItemShown(PAINT_ITEM_STENCIL, index) == hidden { return EarnedFail("stencil shown without earning") }
        if PaintItemEarned(PAINT_ITEM_STENCIL, index) { return EarnedFail("stencil earned from nothing") }
    }
    for index: cast(s32)0..PAINT_SCENE_COUNT - 1 {
        collectible := index >= 26
        if (PaintSceneCollectible(index) >= 0) != collectible { return EarnedFail("scene table") }
        if PaintItemShown(PAINT_ITEM_SCENE, index) == collectible { return EarnedFail("scene shown without earning") }
    }
    if PaintShownCount(PAINT_ITEM_STENCIL, 1) != 11 || PaintShownCount(PAINT_ITEM_STENCIL, 3) != 17 ||
        PaintShownCount(PAINT_ITEM_SCENE, 1) != 6 { return EarnedFail("default section sizes") }
    if PaintItemShown(PAINT_ITEM_STENCIL, -1) && PaintItemEarned(PAINT_ITEM_STENCIL, -1) { return EarnedFail("bad stencil earned") }
    if PaintItemEarned(PAINT_ITEM_SCENE, PAINT_SCENE_COUNT) || PaintItemEarned(9, 0) { return EarnedFail("out of range earned") }
    if PaintShownAt(PAINT_ITEM_STENCIL, 1, 11) != -1 || PaintShownAt(PAINT_ITEM_STENCIL, 1, -1) != -1 ||
        PaintShownAt(PAINT_ITEM_STENCIL, 9, 0) != -1 { return EarnedFail("past the last shown item") }
    // Toucan is id 7 (asset 63) and treehouse is id 11 (asset 27): bits 3 of digits 1 and 2.
    CollectionCacheSet("0880")
    if !PaintItemEarned(PAINT_ITEM_STENCIL, 62) || !PaintItemEarned(PAINT_ITEM_SCENE, 26) { return EarnedFail("mask did not earn them") }
    if PaintItemEarned(PAINT_ITEM_STENCIL, 55) || PaintItemShown(PAINT_ITEM_STENCIL, 55) { return EarnedFail("another bit earned the monkey") }
    if PaintItemEarned(PAINT_ITEM_STENCIL, 0) { return EarnedFail("a default has a star") }
    if PaintShownAt(PAINT_ITEM_STENCIL, 1, 11) != 62 || PaintShownCount(PAINT_ITEM_STENCIL, 1) != 12 { return EarnedFail("toucan is not last among Animals") }
    if PaintShownAt(PAINT_ITEM_SCENE, 1, 6) != 26 || PaintShownCount(PAINT_ITEM_SCENE, 1) != 7 { return EarnedFail("treehouse is not in Places") }
    // The toucan's pineapple (reward 0) and sloth (reward 2) unlock their
    // stencils (66, 67) apart from the collection.
    TreasureCacheSet("5")
    if !PaintItemEarned(PAINT_ITEM_STENCIL, 66) || !PaintItemShown(PAINT_ITEM_STENCIL, 67) { return EarnedFail("toucan stencils not unlocked") }
    if PaintItemShown(PAINT_ITEM_STENCIL, 68) || PaintItemShown(PAINT_ITEM_STENCIL, 69) { return EarnedFail("toucan stencils unlocked early") }
    if PaintItemEarned(PAINT_ITEM_STENCIL, 55) { return EarnedFail("a toucan reward earned a collectible") }
    if PaintShownCount(PAINT_ITEM_STENCIL, 1) != 13 || PaintShownAt(PAINT_ITEM_STENCIL, 1, 12) != 67 { return EarnedFail("sloth is not last among Animals") }
    TreasureCacheSet("")
    // A damaged mask earns nothing rather than everything.
    CollectionCacheSet("xyz")
    if PaintItemEarned(PAINT_ITEM_STENCIL, 62) { return EarnedFail("damaged mask earned") }
    // A picture on an unearned scene still opens: the pickers alone hide it.
    CollectionCacheSet("")
    if !SceneOpen(26) { return EarnedFail("unearned scene does not open") }
    CollectionCacheSet("fffffffffffffff")
    TreasureCacheSet("fff")
    for index: cast(s32)55..PAINT_STENCIL_COUNT - 1 {
        if !PaintItemEarned(PAINT_ITEM_STENCIL, index) { return EarnedFail("full mask missed a stencil") }
    }
    if PaintShownCount(PAINT_ITEM_STENCIL, 1) != paint_stencil_category_counts[1] { return EarnedFail("full mask section") }
    CollectionCacheSet("")
    TreasureCacheSet("")
    return true
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    if !ResizeCornersPass() || !PencilShapeFillPass() || !EarnedPass() { return 1 }
    // Every visible swatch is distinct, selectable paint, never outline ink
    // or legacy pure black. Charcoal must remain visibly lighter than ink.
    for index: cast(s32)0..CRAYON_COUNT - 1 {
        color := crayon_order[index]
        if color < 16 || color >= PAINT_COLORS || paint_colors[color] == paint_colors[INK] {
            return PaintFail("crayons", "a selectable color hides the outlines")
        }
        for earlier: cast(s32)0..index - 1 {
            if paint_colors[color] == paint_colors[crayon_order[earlier]] {
                return PaintFail("crayons", "two visible swatches repeat a color")
            }
        }
    }
    for scene: cast(s32)0..SCENE_COUNT - 1 {
        if !SceneOpen(scene) { return PaintFail("scene", "did not open") }
        ink := InkCount()
        if ink < 20000 || ink > CANVAS_PIXELS / 3 { return PaintFail("scene", Cat("odd amount of line: ", NumberText(ink))) }
        start: s32 = 0
        while canvas[start] != cast(u8)PAPER { start += 1 }
        filled := CanvasFill(start % WIDE_PAGE.width, start / WIDE_PAGE.width, 25)
        if filled == 0 { return PaintFail("scene", "the fill painted nothing") }
        if filled > CANVAS_PIXELS - ink - 1000 { return PaintFail("scene", "the fill ran through the lines") }
        for at: cast(s32)0..CANVAS_PIXELS - 1 { copy[at] = canvas[at] }
        text := CanvasText()
        page: PaintPage
        if PictureFromGame(text, read_back[:], *page) != text.count || page.width != WIDE_PAGE.width { return PaintFail("scene", "its picture text did not read back") }
        for at: cast(s32)0..CANVAS_PIXELS - 1 {
            if read_back[at] != copy[at] { return PaintFail("scene", "its picture text changed a pixel") }
        }
    }
    // Real palm fronds and trunk sections must fill independently, without
    // coloring their neighboring leaves, foliage, sky or beach.
    if !PalmFillStaysInside(0, 30, 80, 0, 35, 156, 205) ||
       !PalmFillStaysInside(0, 90, 140, 45, 90, 145, 218) ||
       !PalmFillStaysInside(0, 250, 80, 160, 40, 350, 240) ||
       !PalmFillStaysInside(0, 225, 160, 155, 85, 265, 285) ||
       !PalmFillStaysInside(0, 95, 240, 70, 205, 125, 285) ||
       !PalmFillStaysInside(0, 800, 60, 720, 0, 915, 135) ||
       !PalmFillStaysInside(0, 284, 303, 265, 270, 300, 320) ||
       !PalmFillStaysInside(0, 290, 313, 280, 300, 300, 340) ||
       !PalmFillStaysInside(0, 350, 354, 342, 322, 365, 370) ||
       !PalmFillStaysInside(0, 863, 350, 850, 335, 875, 365) ||
       !PalmFillStaysInside(0, 275, 323, 265, 310, 290, 338) ||
       !PalmFillStaysInside(0, 362, 347, 350, 332, 375, 360) ||
       !PalmFillStaysInside(0, 804, 286, 785, 270, 848, 312) ||
       !PalmFillStaysInside(0, 865, 274, 855, 259, 914, 287) ||
       !PalmFillStaysInside(0, 820, 200, 765, 115, 875, 260) ||
       !PalmFillStaysInside(0, 885, 200, 860, 140, 920, 288) ||
       !PalmFillStaysInside(4, 250, 80, 160, 40, 360, 170) ||
       !PalmFillStaysInside(4, 65, 105, 0, 50, 165, 220) ||
       !PalmFillStaysInside(4, 105, 205, 85, 180, 135, 245) ||
       !PalmFillStaysInside(4, 100, 30, 0, 0, 165, 100) {
        return PaintFail("palm", "a leaf or trunk fill crossed its outline")
    }
    for dino: cast(s32)0..DINO_COUNT - 1 {
        huge_w := DinoWidth(dino, DINO_SIZES)
        huge_h := DinoHeight(dino, DINO_SIZES)
        if huge_w != WIDE_PAGE.width && huge_h != WIDE_PAGE.height { return PaintFail("dino", "Huge does not fill the picture") }
        for size: cast(s32)1..DINO_SIZES {
            w := DinoWidth(dino, size)
            h := DinoHeight(dino, size)
            if w > WIDE_PAGE.width || h > WIDE_PAGE.height || w < huge_w * size / 4 - 2 || h < huge_h * size / 4 - 2 {
                return PaintFail("dino", "a selectable size has the wrong shape")
            }
            Blank()
            CanvasStampDino(dino, size, 0, 0, false)
            forward := InkCount()
            body: s32 = 0
            inside: s32 = -1
            for at: cast(s32)0..w * h - 1 {
                if stamp_body[at] { body += 1 }
                if inside < 0 && stamp_body[at] && !stamp[at] && at / w > h / 3 { inside = at }
            }
            if forward < 200 { return PaintFail("dino", "stamped too little") }
            if forward > body * 3 / 4 {
                return PaintFail("dino", Cat("outline became a solid shape: ", NumberText(dino), " size ", NumberText(size)))
            }
            // Paint from inside the body must stay inside its outline.
            if inside < 0 { return PaintFail("dino", "no white inside the body") }
            if CanvasFill(inside % w, inside / w, 30) >= w * h {
                return PaintFail("dino", Cat("a fill leaked out of dinosaur ", NumberText(dino + 1), " size ", NumberText(size)))
            }
            Blank()
            CanvasStampDino(dino, size, 0, 0, true)
            if InkCount() != forward { return PaintFail("dino", "mirroring changed the ink") }
            // Put every body over an existing outline and colored picture.
            // Its white interior must erase both; transparent scenery and
            // everything outside its bounds must survive.
            for mirror: cast(s32)0..1 {
                CanvasLayersClear()
                for at: cast(s32)0..CANVAS_PIXELS - 1 { canvas[at] = cast(u8)(ifx at % 2 == 0 then INK else 17) }
                x := WIDE_PAGE.width - w
                CanvasStampDino(dino, size, x, 0, mirror == 1)
                white: s32 = 0
                preserved: s32 = 0
                for at: cast(s32)0..CANVAS_PIXELS - 1 {
                    px := at % WIDE_PAGE.width - x
                    py := at / WIDE_PAGE.width
                    old := cast(u8)(ifx at % 2 == 0 then INK else 17)
                    if px < 0 || py >= h {
                        if canvas[at] != old { return PaintFail("placement", "changed artwork outside the dinosaur bounds") }
                        continue
                    }
                    source := py * w + (ifx mirror == 1 then w - 1 - px else px)
                    if stamp[source] {
                        if canvas[at] != cast(u8)INK { return PaintFail("body", "a line is missing") }
                    } else if stamp_body[source] {
                        if canvas[at] != cast(u8)PAPER { return PaintFail("body", "old color or line showed through a dinosaur") }
                        white += 1
                    } else {
                        if canvas[at] != old { return PaintFail("body", "transparent scenery was erased") }
                        preserved += 1
                    }
                }
                if white < body / 4 { return PaintFail("body", "dinosaur lost its white interior") }
                if preserved == 0 { return PaintFail("body", "the box around a dinosaur covered everything") }
            }
        }
    }
    Report("local paint test passed\n")
    return 0
}

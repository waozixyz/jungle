// Dino Colors' scenes and dinosaurs: every scene opens, its lines hold a
// fill, a saved picture opens again exactly, and every dinosaur stamps ink
// in each size, both ways round.
#import, file "../games/paint/paint_canvas.zi";
#import, file "../games/paint/paint_pages.zi";
#import, file "../host/platform.zi";
#import, file "../host/jungle_text.zi";

PaintFail :: (name: string, message: string) -> s32 {
    Report(Cat("paint test: ", name, ": ", message, "\n"))
    return 1
}

InkCount :: () -> s32 {
    ink: s32 = 0
    for at: cast(s32)0..CANVAS_PIXELS - 1 { if lines[at] { ink += 1 } }
    return ink
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    for scene: cast(s32)0..SCENE_COUNT - 1 {
        if !SceneOpen(scene, "") { return PaintFail("scene", "did not open") }
        ink := InkCount()
        if ink < 200 || ink > 20000 { return PaintFail("scene", Cat("odd amount of line: ", NumberText(ink))) }
        if CanvasColorAt(2, 2) != PAPER { return PaintFail("scene", "the corner is not paper") }
        if CanvasFill(2, 2, 9) == 0 { return PaintFail("scene", "the fill painted nothing") }
        saved := CanvasText()
        copy: [CANVAS_PIXELS]u8
        for at: cast(s32)0..CANVAS_PIXELS - 1 { copy[at] = canvas[at] }
        if !SceneOpen(scene, saved) { return PaintFail("scene", "a saved picture did not open") }
        for at: cast(s32)0..CANVAS_PIXELS - 1 {
            if canvas[at] != copy[at] { return PaintFail("scene", "a saved picture opened differently") }
        }
    }
    for dino: cast(s32)0..DINO_COUNT - 1 {
        for size: cast(s32)1..4 {
            scale := DinoScale(dino, size)
            if DINO_WIDTH[dino] * scale / 100 > CANVAS_WIDTH ||
            DINO_HEIGHT[dino] * scale / 100 > CANVAS_HEIGHT {
                return PaintFail("dino", "a selectable size cannot fit the picture")
            }
            unused SceneOpen(0, "")
            CanvasStampDino(dino, size, 10, 10, false)
            forward := InkCount()
            if forward < 20 { return PaintFail("dino", "stamped too little") }
            if forward > 20000 { return PaintFail("dino", Cat("outline became a solid rectangle: ", NumberText(dino), " size ", NumberText(size), " ink ", NumberText(forward))) }
            unused SceneOpen(0, "")
            CanvasStampDino(dino, size, 10, 10, true)
            mirrored := InkCount()
            if mirrored < forward / 2 { return PaintFail("dino", "mirroring lost most of the ink") }
            // Put every body over an existing solid outline and colored
            // picture. Its white interior must erase both; transparent
            // scenery and everything outside its bounds must survive.
            for mirror: cast(s32)0..1 {
                for at: cast(s32)0..CANVAS_PIXELS - 1 {
                    lines[at] = at % 2 == 0
                    canvas[at] = cast(u8)(ifx lines[at] then INK else 17)
                }
                CanvasStampDino(dino, size, 0, 0, mirror == 1)
                w := DINO_WIDTH[dino] * scale / 100
                h := DINO_HEIGHT[dino] * scale / 100
                white: s32 = 0
                preserved: s32 = 0
                for at: cast(s32)0..CANVAS_PIXELS - 1 {
                    x := at % CANVAS_WIDTH
                    y := at / CANVAS_WIDTH
                    old_line := at % 2 == 0
                    old_color := cast(u8)(ifx old_line then INK else 17)
                    if x >= w || y >= h {
                        if lines[at] != old_line || canvas[at] != old_color {
                            return PaintFail("placement", "changed artwork outside the dinosaur bounds")
                        }
                    } else {
                        if canvas[at] == old_color && lines[at] == old_line { preserved += 1 }
                        sx := x * DINO_WIDTH[dino] / w
                        if mirror == 1 { sx = DINO_WIDTH[dino] - 1 - sx }
                        sy := y * DINO_HEIGHT[dino] / h
                        if stamp_body[sy * DINO_WIDTH[dino] + sx] {
                            if canvas[at] != INK && canvas[at] != PAPER {
                                return PaintFail("body", "old color showed through a dinosaur")
                            }
                            if canvas[at] == PAPER {
                                white += 1
                                if lines[at] { return PaintFail("body", "old outline survived under white body") }
                            }
                        }
                    }
                }
                if white < w * h / 15 { return PaintFail("body", "dinosaur lost its white interior") }
                if preserved < w * h / 10 { return PaintFail("body", "transparent scenery was erased") }
            }
        }
    }
    Report("paint test passed\n")
    return 0
}

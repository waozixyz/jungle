// Writes a 3 by 2 picture with the canvas PNG writer; the Makefile checks
// its size and two pixels with ImageMagick.
#import "c_string"
#import "byte_text_linux"
#import "file"
#import, file "../host/canvas_png.zi";

palette: [16]u32 = .[0x000000ff, 0x0000aaff, 0x00aa00ff, 0x00aaaaff, 0xaa0000ff, 0xaa00aaff, 0xaa5500ff,
0xaaaaaaff, 0x555555ff, 0x5555ffff, 0x55ff55ff, 0x55ffffff, 0xff5555ff, 0xff55ffff, 0xffff55ff, 0xffffffff];

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 { return 2 }
    pixels: [6]u8 = .[4, 15, 1, 0, 2, 14]
    data := PngIndexed(3, 2, palette[:], pixels[:])
    if data == "" { return 1 }
    return ifx WriteEntireFile(TextFromCString(argv[1]), data) then 0 else 1
}

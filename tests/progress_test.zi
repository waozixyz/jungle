#import, file "../host/jungle_progress.zi";
#import, file "../host/platform.zi";

#program_export
main :: () -> s32 {
    visits := ExplorationParse("")
    if !visits.valid || visits.dirty || ExplorationHas(visits, "farm") { return 20 }
    if !ExplorationVisit(*visits, "treehouse") || !visits.dirty { return 21 }
    if ExplorationVisit(*visits, "treehouse") || ExplorationVisit(*visits, "") { return 22 }
    unused ExplorationVisit(*visits, "farm")
    restored := ExplorationParse(ExplorationText(visits))
    if !restored.valid || restored.dirty || !ExplorationHas(restored, "treehouse") ||
        !ExplorationHas(restored, "farm") || ExplorationHas(restored, "port") { return 23 }
    future := ExplorationParse("JUNGLE EXPLORED 1\nfuture-island\nfarm\nfuture-island\n")
    if !future.valid || ExplorationText(future) != "JUNGLE EXPLORED 1\nfuture-island\nfarm\n" { return 24 }
    if ExplorationParse("JUNGLE EXPLORED 2\nfarm\n").valid ||
        ExplorationParse("JUNGLE EXPLORED 1\nfarm!\n").valid { return 25 }
    if ExplorationSceneArea("window-portrait") != "treehouse" || ExplorationSceneArea("bookshelf") != "treehouse" ||
        ExplorationSceneArea("map-portrait") != "" || ExplorationSceneArea("campus-portrait") != "campus" { return 26 }
    if AnimalLevels("skill 0 4 2 1\nskill 1 2 0 0\n") != "animal 4 0 2 1\n" { return 1 }
    if AnimalLevels("jungle 1\nskill 0 6 5 4\r\n") != "animal 6 0 5 4\n" { return 2 }
    if AnimalLevels("skill 0 3 6 9\n") != "animal 3 0 0 0\n" { return 3 }
    if AnimalLevels("skill 1 3 0 0\n") != "" { return 4 }
    if AnimalLevels("skill 0 7 0 0\n") != "" { return 5 }
    if AnimalLevels("skill 0 0 0 0\n") != "" { return 6 }
    if AnimalLevels("skill 0 4 2\n") != "" { return 7 }
    if AnimalLevels("skill 0 4 2 1trailing\n") != "" { return 8 }
    if AnimalLevels("skill 0 999999999999999999999 2 1\n") != "" { return 9 }
    Report("local progress test passed\n")
    return 0
}

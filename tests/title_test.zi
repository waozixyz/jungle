// The treehouse title screen's fit, hit testing and navigation, without a window.
#import, file "../host/jungle_title.zi";
#import, file "../host/jungle_title_data.zi";
#import, file "../host/platform.zi";
#import, file "../retro/paper_rules.zi";
#import, file "../retro/collectibles.zi";
#import, file "../retro/collect_flight.zi";

Near :: (a: float32, b: float32) -> bool { return a - b < 0.01 && b - a < 0.01 }

// A point whose actual scene hit resolves to HOTSPOT, searched on a grid
// over its glow picture; false when no clickable painted point exists.
OwnPoint :: (scene: s32, hotspot: s32, x: *float32, y: *float32) -> bool {
    rect := hotspot * 4
    for row: cast(s32)1..39 {
        for column: cast(s32)1..39 {
            px := cast(float32)TITLE_GLOW_RECT[rect] + cast(float32)(TITLE_GLOW_RECT[rect + 2] * column) / 40.0
            py := cast(float32)TITLE_GLOW_RECT[rect + 1] + cast(float32)(TITLE_GLOW_RECT[rect + 3] * row) / 40.0
            if !TitleInside(hotspot, px, py) { continue }
            // Resolve an actual painted point, including any foreground
            // overlap with another scene item.
            if TitleHit(scene, px, py) == hotspot { x.* = px; y.* = py; return true }
        }
    }
    return false
}

SceneNamed :: (name: string) -> s32 {
    for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 { if TITLE_SCENE_NAME[scene] == name { return scene } }
    return -1
}

HotspotNamed :: (scene: s32, id: string) -> s32 {
    first := TITLE_SCENE_FIRST[scene]
    for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 { if TITLE_HOTSPOT_ID[hotspot] == id { return hotspot } }
    return -1
}

#program_export
main :: () -> s32 {
    // Title -> game -> title changes policy once each. Resizing/rotating or
    // repeating either route never issues another request or resets state.
    if !ApplyTitleOrientationPolicy(true) || title_orientation_policy != 4 { return 101 }
    if ApplyTitleOrientationPolicy(true) { return 102 }
    if !ApplyTitleOrientationPolicy(false) || title_orientation_policy != 6 { return 103 }
    if ApplyTitleOrientationPolicy(false) { return 104 }
    if !ApplyTitleOrientationPolicy(true) || title_orientation_policy != 4 { return 105 }
    if ApplyTitleOrientationPolicy(true) { return 106 }

    // Even-odd polygons: a square, a square with a square hole, and two
    // squares joined by a zero-width bridge.
    square_x: [4]s32 = .[0, 10, 10, 0]
    square_y: [4]s32 = .[0, 0, 10, 10]
    if !PointInPolygon(square_x[:], square_y[:], 5.0, 5.0) { return 1 }
    if PointInPolygon(square_x[:], square_y[:], 11.0, 5.0) { return 2 }
    if PointInPolygon(square_x[:], square_y[:], 5.0, -1.0) { return 3 }
    hole_x: [10]s32 = .[0, 10, 10, 0, 0, 3, 3, 7, 7, 3]
    hole_y: [10]s32 = .[0, 0, 10, 10, 0, 3, 7, 7, 3, 3]
    if PointInPolygon(hole_x[:], hole_y[:], 5.0, 5.0) { return 4 }
    if !PointInPolygon(hole_x[:], hole_y[:], 1.5, 5.0) { return 5 }
    pair_x: [10]s32 = .[0, 4, 4, 10, 10, 14, 14, 10, 10, 4]
    pair_y: [10]s32 = .[0, 0, 2, 2, 0, 0, 4, 4, 2, 2]
    if !PointInPolygon(pair_x[:], pair_y[:], 2.0, 1.0) || !PointInPolygon(pair_x[:], pair_y[:], 12.0, 3.0) { return 6 }
    if PointInPolygon(pair_x[:], pair_y[:], 7.0, 3.0) { return 7 }

    // Cover fit: the source size fits exactly; a wider window fills its
    // width; a portrait window fills its height and pans sideways only.
    exact := TitleFit(cast(float32)TITLE_SOURCE_WIDTH, cast(float32)TITLE_SOURCE_HEIGHT, 50.0, 50.0)
    if !Near(exact.scale, 1.0) || !Near(exact.x, 0.0) || !Near(exact.y, 0.0) { return 10 }
    wide := TitleFit(3344.0, 941.0, 0.0, 0.0)
    if !Near(wide.scale, 2.0) || !Near(wide.x, 0.0) || !Near(wide.y, -470.5) || !Near(wide.pan_x_limit, 0.0) { return 11 }
    phone := TitleFit(400.0, 941.0, 0.0, 0.0)
    if !Near(phone.scale, 1.0) || !Near(phone.x, -636.0) || !Near(phone.pan_x_limit, 636.0) || !Near(phone.pan_y_limit, 0.0) { return 12 }
    panned := TitleFit(400.0, 941.0, 10000.0, 30.0)
    if !Near(panned.x, 0.0) || !Near(panned.y, 0.0) { return 13 }
    panned = TitleFit(400.0, 941.0, -10000.0, 0.0)
    if !Near(panned.x, 400.0 - cast(float32)TITLE_SOURCE_WIDTH) { return 14 }
    half := TitleFit(836.0, 470.5, 0.0, 0.0)
    if !Near(TitleSourceX(half, 418.0), 836.0) || !Near(TitleSourceY(half, 100.0), 200.0) { return 15 }

    // Portrait Campus keeps every mapped object visible at phone and tall sizes.
    campus_portrait := SceneNamed("campus-portrait")
    campus_widths: [3]float32 = .[420.0, 1080.0, 700.0]
    campus_heights: [3]float32 = .[900.0, 2340.0, 1100.0]
    for size: cast(s32)0..2 {
        view := TitleFit(campus_widths[size], campus_heights[size], 9999.0, 9999.0, campus_portrait)
        if view.x < 0.0 || view.y < 0.0 || view.pan_x_limit != 0.0 || view.pan_y_limit != 0.0 { return 280 }
        if view.x + 1024.0 * view.scale > campus_widths[size] + 0.01 ||
            view.y + 1536.0 * view.scale > campus_heights[size] + 0.01 { return 281 }
    }

    // Every painted item can be hit through the window mapping, and only
    // inside its own scene.
    for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
        first := TITLE_SCENE_FIRST[scene]
        // Only a look-only view (the window's outside view) has none; it has Back.
        if TITLE_SCENE_HOTSPOTS[scene] < 1 && TITLE_SCENE_BACK[scene] == 0 { return 20 }
        for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 {
            x: float32
            y: float32
            if !OwnPoint(scene, hotspot, *x, *y) { Report("no clickable point for "); Report(TITLE_HOTSPOT_ID[hotspot]); return 21 }
            if TitleHit(scene, x, y) != hotspot { return 22 }
            view := TitleFit(400.0, 941.0, 0.0, 0.0, scene)
            if TitleHit(scene, TitleSourceX(view, view.x + x * view.scale), TitleSourceY(view, view.y + y * view.scale)) != hotspot { return 23 }
            if TITLE_HOTSPOT_GUIDE[hotspot] == 0 && TITLE_HOTSPOT_NOTICE[hotspot] == 0 && (TITLE_HOTSPOT_TARGET[hotspot] >= 0) == (TITLE_HOTSPOT_GAME[hotspot] != "") { return 24 }
        }
    }
    if TitleHit(0, -5.0, -5.0) != -1 || TitleHit(TITLE_SCENE_COUNT, 10.0, 10.0) != -1 { return 25 }

    treehouse := SceneNamed("treehouse")
    bookshelf := SceneNamed("bookshelf")
    campus := SceneNamed("campus")
    if treehouse != 0 || bookshelf < 0 || campus < 0 { return 30 }
    if TITLE_SCENE_PARENT[bookshelf] != treehouse || TITLE_SCENE_PARENT[campus] != treehouse { return 31 }

    // Every waterfront route works with the actual touch delay in both
    // compositions. Rotation resolves each canonical destination, then Back
    // climbs aquarium -> beach -> campus without launching an activity.
    beach := SceneNamed("beach")
    aquarium := SceneNamed("aquarium")
    if beach < 0 || aquarium < 0 { return 120 }
    if TITLE_SCENE_PARENT[beach] != campus || TITLE_SCENE_PARENT[aquarium] != beach { return 121 }
    for portrait: cast(s32)0..1 {
        route: TitleState
        TitleStart(*route)
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        origins: [4]s32 = .[campus, beach, aquarium, beach]
        destinations: [4]s32 = .[beach, aquarium, beach, campus]
        entrances: [4]string = .["beach-path", "bunker-door", "beach-stairs", "campus-path"]
        for leg: cast(s32)0..3 {
            TitleEnter(*route, origins[leg])
            TitleResolve(*route, width, height)
            hotspot := HotspotNamed(route.scene, entrances[leg])
            x: float32
            y: float32
            if hotspot < 0 || !OwnPoint(route.scene, hotspot, *x, *y) { return 122 }
            if leg == 0 && TITLE_HOTSPOT_REST[hotspot] == "" { return 123 }
            route_view := TitleFit(width, height, 0.0, 0.0, route.scene)
            sx := route_view.x + x * route_view.scale
            sy := route_view.y + y * route_view.scale
            unused TitlePointer(*route, route_view, sx, sy, true, true, false, false, 10.0)
            unused TitlePointer(*route, route_view, sx, sy, false, false, true, false, 10.1)
            if TitleGlowing(route) != hotspot || route.pending != hotspot { return 124 }
            entered := TitleTick(*route, 10.11 + TITLE_TAP_SECONDS)
            if !entered.moved || entered.game >= 0 || route.scene != destinations[leg] { return 125 }
            TitleResolve(*route, width, height)
            if route.scene != ResolveTitleSceneVariant(destinations[leg], width, height) { return 126 }
        }
        TitleEnter(*route, aquarium)
        TitleResolve(*route, width, height)
        unused TitleKey(*route, 256)
        TitleResolve(*route, width, height)
        if TITLE_SCENE_BASE[route.scene] != beach { return 127 }
        unused TitleKey(*route, 256)
        TitleResolve(*route, width, height)
        if TITLE_SCENE_BASE[route.scene] != campus { return 128 }
    }

    // The approved portrait composition has independent coordinates and
    // resolves back to its canonical room when rotated to landscape.
    portrait_campus := ResolveTitleSceneVariant(campus, 420.0, 900.0)
    if portrait_campus == campus || TITLE_SCENE_WIDTH[portrait_campus] != 1024 { return 84 }
    if ResolveTitleSceneVariant(portrait_campus, 900.0, 420.0) != campus { return 85 }
    portrait_fit := TitleFit(1024.0, 1536.0, 0.0, 0.0, portrait_campus)
    if !Near(portrait_fit.scale, 1.0) || !Near(portrait_fit.x, 0.0) || !Near(portrait_fit.y, 0.0) { return 88 }
    rotated: TitleState
    TitleStart(*rotated)
    rotated.pending = 0
    rotated.tracking = true
    TitleResolve(*rotated, 420.0, 900.0)
    if rotated.scene == treehouse || rotated.pending >= 0 || rotated.tracking { return 89 }
    TitleResolve(*rotated, 900.0, 420.0)
    if rotated.scene != treehouse { return 90 }

    // The bookshelf ladder returns to the canonical treehouse in either orientation.
    for shelf_scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
        if TITLE_SCENE_BASE[shelf_scene] != bookshelf { continue }
        back_ladder := HotspotNamed(shelf_scene, "ladder")
        returning: TitleState
        TitleStart(*returning)
        TitleEnter(*returning, shelf_scene)
        back_step := TitleActivate(*returning, back_ladder)
        if !back_step.moved || TITLE_SCENE_BASE[returning.scene] != treehouse { return 114 }
    }

    // The round window glows under the mouse and opens the outside view in
    // either orientation; that view has only Back, which (like Escape)
    // returns to the room. The room itself is a plate plus object layers.
    window_view := SceneNamed("window")
    if window_view < 0 || TITLE_SCENE_BACK[window_view] != 1 || TITLE_SCENE_HOTSPOTS[window_view] != 0 { return 130 }
    if TITLE_SCENE_PARENT[window_view] != treehouse || TITLE_SCENE_BACK[treehouse] != 0 { return 131 }
    if TITLE_SCENE_PORTRAIT[window_view] == window_view || TITLE_SCENE_BACK[TITLE_SCENE_PORTRAIT[window_view]] != 1 { return 132 }
    if TITLE_SCENE_OBJECTS[treehouse] < 10 || TITLE_SCENE_OBJECTS[TITLE_SCENE_PORTRAIT[treehouse]] < 10 { return 133 }
    for portrait: cast(s32)0..1 {
        looking: TitleState
        TitleStart(*looking)
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        TitleResolve(*looking, width, height)
        if TITLE_SCENE_BASE[looking.scene] != treehouse || (looking.scene != treehouse) != (portrait == 1) { return 134 }
        window := HotspotNamed(looking.scene, "window")
        wx: float32
        wy: float32
        if window < 0 || TITLE_HOTSPOT_TARGET[window] != window_view || !OwnPoint(looking.scene, window, *wx, *wy) { return 135 }
        look_view := TitleFit(width, height, 0.0, 0.0, looking.scene)
        sx := look_view.x + wx * look_view.scale
        sy := look_view.y + wy * look_view.scale
        // A mouse that moves onto the window hovers it.
        unused TitlePointer(*looking, look_view, sx + 2.0, sy, false, false, false, false, 2.95)
        unused TitlePointer(*looking, look_view, sx, sy, false, false, false, false, 3.0)
        if !looking.hover_mode || TitleGlowing(looking) != window { return 136 }
        unused TitlePointer(*looking, look_view, sx, sy, true, true, false, false, 3.1)
        opened := TitlePointer(*looking, look_view, sx, sy, false, false, true, false, 3.2)
        if !opened.moved || opened.game >= 0 || TITLE_SCENE_BASE[looking.scene] != window_view { return 137 }
        TitleResolve(*looking, width, height)
        if looking.scene != ResolveTitleSceneVariant(window_view, width, height) || TITLE_SCENE_BACK[looking.scene] != 1 { return 138 }
        // Nothing to select outside: arrows, Enter and number keys stay put.
        for key: cast(s32)262..265 { if TitleKey(*looking, key).moved || looking.selected >= 0 { return 139 } }
        if TitleKey(*looking, 257).moved || TitleKey(*looking, 49).moved || TITLE_SCENE_BASE[looking.scene] != window_view { return 140 }
        if TitleHit(looking.scene, wx, wy) != -1 { return 141 }
        back := TitleKey(*looking, 256)
        TitleResolve(*looking, width, height)
        if !back.moved || TITLE_SCENE_BASE[looking.scene] != treehouse { return 142 }
    }

    // Keyboard: arrows glow items in order, Enter opens a scene or game,
    // Escape climbs back and Home returns to the treehouse.
    state: TitleState
    TitleStart(*state)
    if state.scene != treehouse || TitleGlowing(state) != -1 { return 40 }
    step := TitleKey(*state, 264)
    if !step.moved || state.selected != TITLE_SCENE_FIRST[treehouse] || TitleGlowing(state) != state.selected { return 41 }
    unused TitleKey(*state, 265)
    if state.selected != TITLE_SCENE_FIRST[treehouse] + TITLE_SCENE_HOTSPOTS[treehouse] - 1 { return 42 }
    shelf := HotspotNamed(treehouse, "bookshelf")
    for turn: cast(s32)0..TITLE_SCENE_HOTSPOTS[treehouse] - 1 { if state.selected != shelf { unused TitleKey(*state, 262) } }
    if state.selected != shelf { return 43 }
    step = TitleKey(*state, 257)
    if !step.moved || step.game >= 0 || state.scene != bookshelf || TitleGlowing(state) != -1 { return 44 }
    abc := HotspotNamed(bookshelf, "book-abc")
    step = TitleKey(*state, 49 + abc - TITLE_SCENE_FIRST[bookshelf])
    if step.game != abc || TITLE_HOTSPOT_GAME[abc] != "ABC Book" || state.scene != bookshelf { return 45 }
    step = TitleKey(*state, 256)
    if !step.moved || state.scene != treehouse { return 46 }
    step = TitleKey(*state, 256)
    if step.moved || state.scene != treehouse { return 47 }
    TitleEnter(*state, campus)
    hut := HotspotNamed(campus, "music-hut")
    if TITLE_HOTSPOT_GAME[hut] != "Music Room" { return 48 }
    piano := HotspotNamed(campus, "piano")
    if piano < 0 || TITLE_HOTSPOT_GAME[piano] != "Little Piano" { return 74 }
    for hotspot: cast(s32)0..TITLE_HOTSPOT_COUNT - 1 {
        if TITLE_HOTSPOT_ID[hotspot] == "tiger-guide" { return 82 }
    }
    unused TitleKey(*state, 262)
    if !state.guide_stopped { return 83 }
    if ResolveTitleSceneVariant(campus, 960.0, 600.0) != campus { return 75 }
    if ResolveTitleSceneVariant(campus, 400.0, 900.0) != TITLE_SCENE_PORTRAIT[campus] { return 76 }
    unused TitleKey(*state, 256)
    if state.scene != treehouse { return 77 }
    unused TitleKey(*state, 268)
    if state.scene != treehouse || state.selected != -1 { return 49 }

    // A mouse hovers, glows exactly the item under it, and opens it on click.
    view := TitleFit(cast(float32)TITLE_SOURCE_WIDTH, cast(float32)TITLE_SOURCE_HEIGHT, 0.0, 0.0)
    easel := HotspotNamed(treehouse, "easel")
    ex: float32
    ey: float32
    if easel < 0 || !OwnPoint(treehouse, easel, *ex, *ey) { return 50 }
    unused TitlePointer(*state, view, 1.0, 1.0, false, false, false, false, 1.0)
    unused TitlePointer(*state, view, ex, ey, false, false, false, false, 1.1)
    if !state.hover_mode || TitleGlowing(state) != easel { return 51 }
    unused TitlePointer(*state, view, ex, ey, false, false, false, true, 1.15)
    if TitleGlowing(state) != -1 { return 52 }
    unused TitlePointer(*state, view, ex, ey, true, true, false, false, 1.2)
    step = TitlePointer(*state, view, ex, ey, false, false, true, false, 1.3)
    if step.game != easel || TITLE_HOTSPOT_GAME[easel] != "Coloring Book" { return 53 }
    // Keys take the glow back from the mouse.
    unused TitleKey(*state, 262)
    if state.hover_mode || TitleGlowing(state) != TITLE_SCENE_FIRST[treehouse] { return 54 }

    // Touch: no hover; a tap glows its item and opens it a moment later.
    touch: TitleState
    TitleStart(*touch)
    ladder := HotspotNamed(treehouse, "ladder")
    lx: float32
    ly: float32
    if ladder < 0 || !OwnPoint(treehouse, ladder, *lx, *ly) { return 60 }
    unused TitlePointer(*touch, view, lx, ly, false, false, false, false, 2.0)
    unused TitlePointer(*touch, view, lx, ly, true, true, false, false, 2.1)
    if touch.hover_mode || TitleGlowing(touch) != ladder { return 61 }
    step = TitlePointer(*touch, view, lx, ly, false, false, true, false, 2.2)
    if step.game >= 0 || step.moved || TitleGlowing(touch) != ladder { return 62 }
    step = TitleTick(*touch, 2.3)
    if step.moved || touch.scene != treehouse { return 63 }
    step = TitleTick(*touch, 2.21 + TITLE_TAP_SECONDS)
    if !step.moved || touch.scene != campus || TitleGlowing(touch) != -1 { return 64 }
    // A tap opening a game reports it after the glow.
    frogs := HotspotNamed(campus, "frogs")
    fx: float32
    fy: float32
    if frogs < 0 || !OwnPoint(campus, frogs, *fx, *fy) { return 65 }
    unused TitlePointer(*touch, view, fx, fy, true, true, false, false, 3.0)
    unused TitlePointer(*touch, view, fx, fy, false, false, true, false, 3.05)
    step = TitleTick(*touch, 3.06 + TITLE_TAP_SECONDS)
    if step.game != frogs || TITLE_HOTSPOT_GAME[frogs] != "Animal Counting" { return 66 }
    // A quick tap pressed and released within one frame still counts.
    TitleEnter(*touch, treehouse)
    unused TitlePointer(*touch, view, lx, ly, false, true, true, false, 4.0)
    step = TitleTick(*touch, 4.01 + TITLE_TAP_SECONDS)
    if touch.scene != campus { return 67 }

    // A physical path sign always animates before travel, including mouse
    // clicks after hovering. Exercise the model before new art is selected.
    sign := HotspotNamed(campus, "beach-path")
    TitleEnter(*touch, campus)
    sign_view := TitleFit(cast(float32)TITLE_SOURCE_WIDTH, cast(float32)TITLE_SOURCE_HEIGHT, 0.0, 0.0, campus)
    sx: float32
    sy: float32
    if !OwnPoint(campus, sign, *sx, *sy) { return 270 }
    touch.hover_mode = true
    unused TitlePointer(*touch, sign_view, sx, sy, true, true, false, false, 7.0)
    step = TitlePointer(*touch, sign_view, sx, sy, false, false, true, false, 7.1)
    if step.moved || touch.scene != campus || touch.pending != sign { return 271 }
    if !Near(TitleSignLift(touch, sign, 7.1), 0.0) { return 272 }
    if !Near(TitleSignLift(touch, sign, 7.1 + TITLE_TAP_SECONDS / 2.0), -3.0) { return 273 }
    // A semantic click on the same frame must not reset the tap timer.
    TitleQueue(*touch, sign, 7.2)
    step = TitleTick(*touch, 7.1 + TITLE_TAP_SECONDS / 2.0)
    if step.moved || touch.scene != campus { return 274 }
    step = TitleTick(*touch, 7.11 + TITLE_TAP_SECONDS)
    if !step.moved || touch.scene != beach { return 275 }
    unused TitleKey(*touch, 256)
    if touch.scene != campus { return 276 }
    // The actual Desert notice freezes navigation and drops duplicate activations.
    sign = HotspotNamed(campus, "desert-path")
    if sign < 0 || TITLE_HOTSPOT_NOTICE[sign] != 2 { return 283 }
    {
        TitleEnter(*touch, campus)
        touch.pan_x = 9.0
        touch.selected = sign
        step = TitleKey(*touch, 257)
        if !touch.not_implemented || step.moved || step.game >= 0 { return 284 }
        unused TitleKey(*touch, 268)
        unused TitleKey(*touch, 256)
        unused TitleKey(*touch, 49)
        unused TitleKey(*touch, 257)
        TitleQueue(*touch, sign, 8.0)
        unused TitlePointer(*touch, sign_view, sx, sy, true, true, false, false, 8.1)
        unused TitlePointer(*touch, sign_view, sx, sy, false, false, true, false, 8.2)
        unused TitleTick(*touch, 9.0)
        if touch.scene != campus || touch.pending >= 0 || touch.tracking || touch.pan_x != 9.0 { return 285 }
        TitleDismissNotice(*touch)
        if touch.not_implemented || touch.scene != campus || touch.pan_x != 9.0 { return 286 }
        // Numeric shortcuts use the same gate.
        unused TitleKey(*touch, 49 + sign - TITLE_SCENE_FIRST[campus])
        if !touch.not_implemented { return 287 }
        TitleDismissNotice(*touch)
    }

    // Portrait: dragging pans the picture and never taps; keys center the
    // selection.
    pan: TitleState
    TitleStart(*pan)
    phone_view := TitleFit(400.0, 941.0, pan.pan_x, pan.pan_y)
    unused TitlePointer(*pan, phone_view, 200.0, 400.0, true, true, false, false, 5.0)
    unused TitlePointer(*pan, phone_view, 300.0, 402.0, true, false, false, false, 5.1)
    step = TitlePointer(*pan, phone_view, 300.0, 402.0, false, false, true, false, 5.2)
    if !Near(pan.pan_x, 100.0) || !Near(pan.pan_y, 0.0) || pan.pending >= 0 || step.game >= 0 { return 70 }
    unused TitlePointer(*pan, phone_view, 0.0, 400.0, true, true, false, false, 5.3)
    unused TitlePointer(*pan, phone_view, 2000.0, 400.0, true, false, false, false, 5.4)
    if !Near(pan.pan_x, phone_view.pan_x_limit) { return 71 }
    unused TitlePointer(*pan, phone_view, 2000.0, 400.0, false, false, true, false, 5.5)
    TitleEnter(*pan, treehouse)
    if !Near(pan.pan_x, 0.0) { return 72 }
    unused TitleKey(*pan, 262)
    TitleFocus(*pan, 400.0, 941.0)
    focused := TitleFit(400.0, 941.0, pan.pan_x, pan.pan_y)
    rect := pan.selected * 4
    center := focused.x + (cast(float32)TITLE_GLOW_RECT[rect] + cast(float32)TITLE_GLOW_RECT[rect + 2] / 2.0) * focused.scale
    if center < 0.0 || center > 400.0 { return 73 }
    // Corner controls must never start a pan, even when pressed and dragged.
    TitleEnter(*pan, treehouse)
    unused TitlePointer(*pan, phone_view, 10.0, 10.0, true, true, false, true, 6.0)
    unused TitlePointer(*pan, phone_view, 200.0, 10.0, true, false, false, false, 6.1)
    if pan.tracking || pan.pan_x != 0.0 || pan.pending >= 0 { return 78 }
    if !pan.guide_stopped { return 79 }
    // Three immediate steps, mute input, skip and compact portrait/landscape
    // bounds are all covered without a tiger hotspot.
    narrated: TitleState
    TitleStart(*narrated)
    intro := TitleGuide(*narrated, 10.0, false, false, 0)
    if !intro.active || intro.step != 0 || !intro.voice || intro.stop { return 91 }
    intro = TitleGuide(*narrated, 10.2, false, false, 0)
    if intro.voice || intro.step != 0 { return 92 }
    intro = TitleGuide(*narrated, 12.2, false, false, 0)
    if !intro.active || intro.step != 1 || !intro.voice { return 93 }
    intro = TitleGuide(*narrated, 15.3, false, false, 0)
    if !intro.active || intro.step != 2 || !intro.voice { return 94 }
    intro = TitleGuide(*narrated, 17.4, false, false, 0)
    if intro.active || intro.voice || !intro.stop || !intro.finished || narrated.guide_step != 3 { return 95 }
    intro = TitleGuide(*narrated, 17.5, false, false, 0)
    if intro.stop || intro.finished { return 96 }
    quiet: TitleState
    TitleStart(*quiet)
    quiet_intro := TitleGuide(*quiet, 10.0, true, false, 1)
    if !quiet_intro.active || quiet_intro.voice { return 97 }
    quiet_intro = TitleGuide(*quiet, 12.7, true, false, 1)
    if !quiet_intro.active || quiet_intro.voice || quiet_intro.step != 1 { return 98 }
    skipped: TitleState
    TitleStart(*skipped)
    TitleGuideSkip(*skipped)
    skipped_intro := TitleGuide(*skipped, 10.0, false, false, 2)
    if skipped_intro.active || skipped_intro.voice || !skipped_intro.stop || !skipped_intro.finished { return 99 }
    landscape := TitleGuideLayout(960, 600, TitleGuideRect.{420, 200, 80, 80})
    if landscape.bubble.width > 228 || landscape.bubble.height != 48 ||
       landscape.hit.x < 0 || landscape.hit.y < 0 ||
       landscape.hit.x + landscape.hit.width > 960 || landscape.hit.y + landscape.hit.height > 600 { return 100 }
    portrait := TitleGuideLayout(400, 900, TitleGuideRect.{160, 80, 80, 80})
    if portrait.bubble.width > 228 || portrait.bubble.height != 48 ||
       portrait.hit.x < 0 || portrait.hit.y < 0 ||
       portrait.hit.x + portrait.hit.width > 400 || portrait.hit.y + portrait.hit.height > 900 { return 101 }
    for language: cast(s32)0..2 {
        for step: cast(s32)0..2 {
            if TitleGuideText(step, language) == "" || TitleGuideDuration(step, language) > 3.1 { return 102 + language * 3 + step }
            path := TitleGuideVoicePath(step, language)
            if path.count < 4 || path[path.count - 4:] != ".wav" { return 112 + language * 3 + step }
        }
    }
    paper_failure := TitlePaperChecks()
    if paper_failure != 0 { return paper_failure }
    Report("local title scene test passed\n")
    return 0
}

paper_collects: s32;
// Answers new only the first time, as the hosts' collection does.
PaperCollect :: (slug: string) -> bool {
    paper_collects += 1
    return paper_collects == 1 && slug == "treehouse-scene"
}

// The paper of STATE's scene once its picture has panned.
TitlePlaceAfterPan :: (state: TitleState, place: TitlePaperPlace, width: float32, height: float32) -> TitlePaperPlace {
    return TitlePaperSpot(state.scene, TitleFit(width, height, state.pan_x, state.pan_y, state.scene), width, height)
}

TitlePaperChecks :: () -> s32 {
    // Each paper shares its foreground's scene transform, including on pan
    // and rotation. Its touch target may overlap that foreground's hotspot.
    names: [3]string = .["treehouse", "bookshelf", "campus"]
    slugs: [3]string = .["treehouse-scene", "bookshelf-scene", "campus-scene"]
    widths: [8]float32 = .[1280.0, 960.0, 1024.0, 2560.0, 420.0, 390.0, 768.0, 600.0]
    heights: [8]float32 = .[720.0, 600.0, 768.0, 1080.0, 900.0, 844.0, 1024.0, 800.0]
    for named: cast(s32)0..2 {
        base := SceneNamed(names[named])
        if base < 0 { return 200 + named }
        index := TitlePaperIndex(base)
        if index < 0 || collectible_slugs[index] != slugs[named] || collectible_how_kinds[index] != COLLECTIBLE_HOW_PAPER ||
            collectible_paint_kinds[index] != COLLECTIBLE_PAINT_SCENE { return 203 + named }
        for size: cast(s32)0..7 {
            scene := ResolveTitleSceneVariant(base, widths[size], heights[size])
            if TitlePaperIndex(scene) != index { return 206 + named }
            if (size >= 4) != (scene != base) { return 209 + named }
            view := TitleFit(widths[size], heights[size], 0.0, 0.0, scene)
            place := TitlePaperSpot(scene, view, widths[size], heights[size])
            if place.index != index || place.size <= 0.0 || place.reveal_x <= 0.0 { return 212 + named }
            if TITLE_SCENE_FOREGROUND[scene] == "" || TITLE_SCENE_BACKGROUND[scene] == "" { return 215 + named }
            if !Near(TitleSourceX(view, place.x), cast(float32)TITLE_SCENE_PAPER[scene * 4]) ||
                !Near(TitleSourceY(view, place.y), cast(float32)TITLE_SCENE_PAPER[scene * 4 + 1]) { return 218 }
            half_shown := TitlePaperRevealed(place, 0.5)
            fully_shown := TitlePaperRevealed(place, 1.0)
            if !Near(half_shown.x, place.x + place.reveal_x * 0.5) ||
                !Near(fully_shown.x, place.x + place.reveal_x) || !Near(fully_shown.y, place.y) { return 219 }
            if !TitlePaperHit(place, fully_shown.x, fully_shown.y) { return 220 }
            // Panned to either edge it still lies in the same painted spot.
            panned := TitleFit(widths[size], heights[size], 9999.0, 9999.0, scene)
            moved := TitlePaperSpot(scene, panned, widths[size], heights[size])
            if !Near(moved.x - panned.x, place.x - view.x) || !Near(moved.y - panned.y, place.y - view.y) { return 245 + named }
        }
    }
    // The waterfront scenes hide no paper, and nothing there takes the pointer.
    for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
        name := TITLE_SCENE_NAME[TITLE_SCENE_BASE[scene]]
        if name == "treehouse" || name == "bookshelf" || name == "campus" { continue }
        if TitlePaperIndex(scene) >= 0 { return 248 }
        none: TitlePapers
        empty := TitlePaperSpot(scene, TitleFit(960.0, 600.0, 0.0, 0.0, scene), 960.0, 600.0)
        input := TitlePaperPointer(*none, empty, false, empty.x, empty.y, true, true, false, 1.0, PaperCollect)
        if input.owned || input.collected || paper_collects != 0 { return 249 }
    }

    // A tap on the treehouse paper collects it once and flies; the scene never
    // sees the tap, so nothing glows, opens or pans.
    for portrait: cast(s32)0..1 {
        paper_collects = 0
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        papers: TitlePapers
        state: TitleState
        TitleStart(*state)
        TitleResolve(*state, width, height)
        view := TitleFit(width, height, 0.0, 0.0, state.scene)
        place := TitlePaperSpot(state.scene, view, width, height)
        if place.index < 0 { return 250 }
        // A mouse resting on the paper makes nothing glow.
        hover := TitlePaperPointer(*papers, place, false, place.x, place.y, false, false, false, 1.0, PaperCollect)
        unused TitlePointer(*state, view, place.x - 40.0, place.y, false, false, false, hover.owned, 0.9)
        unused TitlePointer(*state, view, place.x, place.y, false, false, false, hover.owned, 1.0)
        if !hover.owned || TitleGlowing(state) >= 0 { return 251 }
        first_reveal := papers.reveal[place.index]
        if first_reveal <= 0.0 || first_reveal >= 1.0 { return 263 }
        unused TitlePaperPointer(*papers, place, false, -100.0, -100.0, false, false, false, 1.05, PaperCollect)
        if papers.reveal[place.index] >= first_reveal { return 264 }
        for frame: cast(s32)0..29 {
            shown := TitlePaperRevealed(place, papers.reveal[place.index])
            reveal := TitlePaperPointer(*papers, place, false, shown.x + shown.size * 0.32, shown.y,
                false, false, false, 1.1 + cast(float64)frame * 0.016, PaperCollect)
            if !reveal.owned { return 265 }
        }
        if papers.reveal[place.index] < 0.99 { return 266 }
        press := TitlePaperPointer(*papers, place, false, place.x, place.y, true, true, false, 2.0, PaperCollect)
        step := TitlePointer(*state, view, place.x, place.y, true, true, false, press.owned, 2.0)
        if press.owned || press.collected || paper_collects != 0 || step.game >= 0 { return 252 }
        release := TitlePaperPointer(*papers, place, false, place.x + 3.0, place.y + 2.0, false, false, true, 2.1, PaperCollect)
        step = TitlePointer(*state, view, place.x + 3.0, place.y + 2.0, false, false, true, release.owned, 2.1)
        if !release.owned || !release.collected || paper_collects != 1 { return 253 }
        if step.game >= 0 || step.moved || state.pending >= 0 || state.pan_x != 0.0 || state.pan_y != 0.0 { return 254 }
        flying := papers.papers[place.index]
        if flying.state != SECRET_PAPER_FLYING || SecretPaperProgress(flying, 2.1 + COLLECT_FLIGHT_SECONDS / 2.0) <= 0.0 { return 255 }
        if TitleTick(*state, 3.0).game >= 0 || state.scene != ResolveTitleSceneVariant(0, width, height) { return 256 }
        // Gone for good: after its flight nothing lies there to tap.
        again := TitlePaperPointer(*papers, place, true, place.x, place.y, true, true, false, 5.0, PaperCollect)
        if again.owned || papers.papers[place.index].state != SECRET_PAPER_GONE { return 257 }
        unused TitlePaperPointer(*papers, place, true, place.x, place.y, false, false, true, 5.1, PaperCollect)
        if paper_collects != 1 { return 258 }
        // A paper already in the collection never shows, even on a fresh start.
        fresh: TitlePapers
        earned := TitlePaperPointer(*fresh, place, true, place.x, place.y, true, true, false, 6.0, PaperCollect)
        if earned.owned || SecretPaperShown(fresh.papers[place.index], place.index, true) { return 259 }
        // A press that slides off the paper before release collects nothing.
        slid: TitlePapers
        unused TitlePaperPointer(*slid, place, false, place.x, place.y, true, true, false, 7.0, PaperCollect)
        off := TitlePaperPointer(*slid, place, false, place.x + 200.0, place.y, false, false, true, 7.2, PaperCollect)
        if off.collected || slid.papers[place.index].state != SECRET_PAPER_WAITING || paper_collects != 1 { return 260 }
        // A drag that starts on the paper pans the picture, as anywhere else, and collects nothing.
        dragged: TitlePapers
        drag: TitleState
        TitleStart(*drag)
        TitleResolve(*drag, width, height)
        if view.pan_x_limit <= 0.0 { return 261 }
        unused TitlePaperPointer(*dragged, place, false, place.x, place.y, true, true, false, 8.0, PaperCollect)
        unused TitlePointer(*drag, view, place.x, place.y, true, true, false, false, 8.0)
        unused TitlePaperPointer(*dragged, place, false, place.x - 40.0, place.y, true, false, false, 8.1, PaperCollect)
        unused TitlePointer(*drag, view, place.x - 40.0, place.y, true, false, false, false, 8.1)
        moved_paper := TitlePlaceAfterPan(drag, place, width, height)
        dropped := TitlePaperPointer(*dragged, moved_paper, false, place.x - 40.0, place.y, false, false, true, 8.2, PaperCollect)
        unused TitlePointer(*drag, view, place.x - 40.0, place.y, false, false, true, dropped.owned, 8.2)
        if drag.pan_x >= 0.0 || dropped.collected || dragged.papers[place.index].state != SECRET_PAPER_WAITING ||
            paper_collects != 1 { return 262 }
        // A touch needs no preliminary mouse hover to collect the idle peek.
        touch: TitlePapers
        paper_collects = 0
        unused TitlePaperPointer(*touch, place, false, place.x + place.size * 0.32, place.y,
            true, true, false, 9.0, PaperCollect)
        tapped := TitlePaperPointer(*touch, place, false, place.x + place.size * 0.32, place.y,
            false, false, true, 9.1, PaperCollect)
        if !tapped.collected || paper_collects != 1 { return 267 }
    }
    return 0
}

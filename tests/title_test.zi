// The treehouse title screen's fit, hit testing and navigation, without a window.
#import "kryon/geometry"
#import, file "../host/jungle_title.zi";
#import, file "../host/jungle_progress.zi";
#import, file "../host/jungle_title_animation.zi";
#import, file "../host/jungle_title_data.zi";
#import, file "../host/platform.zi";
#import, file "../retro/language.zi";
#import, file "../retro/paper_rules.zi";
#import, file "../retro/collectibles.zi";
#import, file "../retro/collect_flight.zi";

Near :: (a: float32, b: float32) -> bool { return a - b < 0.01 && b - a < 0.01 }

// A point whose actual scene hit resolves to HOTSPOT, searched on a grid
// over its glow picture; false when no clickable painted point exists.
OwnPoint :: (scene: s32, hotspot: s32, x: *float32, y: *float32) -> bool {
    rect := hotspot * 4
    for row: cast(s32)1..39 {
        for column: cast(s32)1..39 {
            px := cast(float32)TITLE_GLOW_RECT[rect] + cast(float32)(TITLE_GLOW_RECT[rect + 2] * column) / 40.0
            py := cast(float32)TITLE_GLOW_RECT[rect + 1] + cast(float32)(TITLE_GLOW_RECT[rect + 3] * row) / 40.0
            if !TitleInside(hotspot, px, py) { continue }
            // Resolve an actual painted point, including any foreground
            // overlap with another scene item.
            if TitleHit(scene, px, py) == hotspot { x.* = px; y.* = py; return true }
        }
    }
    return false
}

SceneNamed :: (name: string) -> s32 {
    for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 { if TITLE_SCENE_NAME[scene] == name { return scene } }
    return -1
}

HotspotNamed :: (scene: s32, id: string) -> s32 {
    first := TITLE_SCENE_FIRST[scene]
    for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 { if TITLE_HOTSPOT_ID[hotspot] == id { return hotspot } }
    return -1
}

// Every Beach crab walks its own loop: it moves and pauses on its own, and its
// moving picture carries its actual polygon target in both orientations,
// including a stationary pointer and a press/release pair.
BeachCrabMotionTest :: () -> s32 {
    for orientation: cast(s32)0..1 {
        scene := SceneNamed(ifx orientation == 0 then "beach" else "beach-portrait")
        crab := HotspotNamed(scene, "crab-big")
        baby := HotspotNamed(scene, "crab-baby-step")
        far := HotspotNamed(scene, "crab-sand-1")
        sign := HotspotNamed(scene, "port-path")
        if crab < 0 || baby < 0 || far < 0 || sign < 0 { return 760 }
        if TITLE_HOTSPOT_WALK_COUNT[crab] < 3 || TITLE_HOTSPOT_WALK_COUNT[baby] < 3 ||
            TITLE_HOTSPOT_WALK_COUNT[sign] != 0 { return 761 }
        // It rests where it is drawn at the start of its loop, walks away,
        // and one crab can pause while another walks.
        cycle := cast(float64)TITLE_HOTSPOT_WALK_CYCLE[crab]
        phase := cast(float64)TITLE_HOTSPOT_WALK_PHASE[crab]
        start := TitleHotspotMotion(crab, cycle - phase)
        if !Near(start.x, 0.0) || !Near(start.y, 0.0) { return 762 }
        farthest: float32 = 0.0
        moved_at: float64 = -1.0
        independent := false
        for tick: cast(s32)0..cast(s32)(cycle * 4.0) {
            now := cast(float64)tick / 4.0
            here := TitleHotspotMotion(crab, now)
            later := TitleHotspotMotion(crab, now + 0.25)
            other := TitleHotspotMotion(baby, now)
            other_later := TitleHotspotMotion(baby, now + 0.25)
            reach := here.x * here.x + here.y * here.y
            if reach > farthest { farthest = reach }
            if reach > 400.0 && moved_at < 0.0 { moved_at = now }
            walking := !Near(here.x, later.x) || !Near(here.y, later.y)
            resting := Near(other.x, other_later.x) && Near(other.y, other_later.y)
            if walking && resting { independent = true }
        }
        if farthest < 1600.0 || moved_at < 0.0 || !independent { return 763 }
        motion := TitleHotspotMotion(sign, 3.0)
        if !Near(motion.x, 0.0) || !Near(motion.y, 0.0) { return 764 }
        x: float32
        y: float32
        if !OwnPoint(scene, crab, *x, *y) { return 765 }
        for tick: cast(s32)0..cast(s32)(cycle * 4.0) {
            now := cast(float64)tick / 4.0
            motion = TitleHotspotMotion(crab, now)
            if !TitleInside(crab, x + motion.x, y + motion.y, now) { return 766 }
        }
        // A vacated spot is no longer this crab's target while it is away.
        motion = TitleHotspotMotion(crab, moved_at)
        rect := crab * 4
        left_behind := false
        for row: cast(s32)1..39 {
            for column: cast(s32)1..39 {
                px := cast(float32)TITLE_GLOW_RECT[rect] + cast(float32)(TITLE_GLOW_RECT[rect + 2] * column) / 40.0
                py := cast(float32)TITLE_GLOW_RECT[rect + 1] + cast(float32)(TITLE_GLOW_RECT[rect + 3] * row) / 40.0
                if TitleInside(crab, px, py) && !TitleInside(crab, px, py, moved_at) { left_behind = true }
            }
        }
        if !left_behind { return 767 }
        state: TitleState
        TitleStart(*state)
        state.scene = scene
        state.hover_mode = true
        width: float32 = ifx orientation == 0 then 960.0 else 420.0
        height: float32 = ifx orientation == 0 then 600.0 else 900.0
        view := TitleFit(width, height, 0.0, 0.0, scene)
        if TitleHit(scene, x + motion.x, y + motion.y, moved_at) != crab { return 768 }
        wx := view.x + (x + motion.x) * view.scale
        wy := view.y + (y + motion.y) * view.scale
        unused TitlePointer(*state, view, wx, wy, false, false, false, false, moved_at)
        if state.hovered != crab || TitleGlowing(state) != crab { return 769 }
        unused TitlePointer(*state, view, wx, wy, true, true, false, false, moved_at)
        opened := TitlePointer(*state, view, wx, wy, false, false, true, false, moved_at + 0.01)
        if opened.game != crab { return 770 }
    }
    return 0
}

#program_export
main :: () -> s32 {
    crab_result := BeachCrabMotionTest()
    if crab_result != 0 { return crab_result }
    exploration := ExplorationParse("")
    if !TitleCloudCovered(*exploration, 1330.0, 860.0) { return 740 }
    unused ExplorationVisit(*exploration, "campus")
    if TitleCloudCovered(*exploration, 1330.0, 860.0) ||
        !TitleCloudCovered(*exploration, 2840.0, 1820.0) { return 741 }
    restored := ExplorationParse(ExplorationText(*exploration))
    if TitleCloudCovered(*restored, 1330.0, 860.0) || !TitleCloudCovered(*restored, 3010.0, 1980.0) { return 742 }
    if TitleFogVisits(*exploration) != TitleFogVisits(*restored) { return 743 }
    campus_area: s32 = -1
    for area: cast(s32)0..TITLE_MAP_AREA_COUNT-1 { if TITLE_MAP_AREA[area]=="campus" { campus_area=area } }
    if campus_area<0 { return 744 }
    cx:=cast(float32)TITLE_MAP_CENTER[campus_area*2]
    cy:=cast(float32)TITLE_MAP_CENTER[campus_area*2+1]
    visits:=TitleFogVisits(*exploration)
    if TitleFogAlpha(cast(u32)0,cx,cy)!=cast(u8)255 || TitleFogAlpha(visits,cx,cy)!=cast(u8)0 { return 745 }
    previous_alpha: u8
    // Down from Campus into the unvisited forest: one smooth, rising rim.
    for offset: cast(s32)0..650 {
        alpha:=TitleFogAlpha(visits,cx,cy+cast(float32)offset)
        if alpha<previous_alpha { return 746 }
        if offset>0 && cast(s32)alpha-cast(s32)previous_alpha>5 { return 747 }
        previous_alpha=alpha
    }
    if previous_alpha!=cast(u8)255 { return 748 }
    mask: [TITLE_FOG_BYTES]u8
    if TitleFogMask(visits,mask[:8]) || !TitleFogMask(cast(u32)0,mask[:]) { return 749 }
    for sample: cast(s32)0..TITLE_FOG_WIDTH*TITLE_FOG_HEIGHT-1 {
        if mask[sample*4+3]!=cast(u8)255 { return 750 }
    }
    if !TitleFogMask(visits,mask[:]) { return 751 }
    inner:=((cast(s32)cy*TITLE_FOG_HEIGHT/TITLE_SCENE_HEIGHT[TITLE_MAP_SCENE])*TITLE_FOG_WIDTH+
        cast(s32)cx*TITLE_FOG_WIDTH/TITLE_SCENE_WIDTH[TITLE_MAP_SCENE])*4+3
    if mask[inner]!=cast(u8)0 || mask[TITLE_FOG_BYTES-1]!=cast(u8)255 { return 752 }
    if TitleAnimationFrame(0.0, 8.0, 8) != 0 { return 230 }
    if TitleAnimationFrame(0.124, 8.0, 8) != 0 { return 231 }
    if TitleAnimationFrame(0.125, 8.0, 8) != 1 { return 232 }
    if TitleAnimationFrame(0.999, 8.0, 8) != 7 { return 233 }
    if TitleAnimationFrame(1.0, 8.0, 8) != 0 { return 234 }
    if TitleAnimationFrame(1000000.125, 8.0, 8) != 1 { return 235 }
    if TitleAnimationFrame(-0.125, 8.0, 8) != 7 { return 236 }
    if TitleAnimationFrame(1.0, 0.0, 8) != 0 { return 237 }
    if TitleAnimationFrame(1.0, 8.0, 0) != 0 { return 238 }
    atlas := TitleAnimationSource(5, 4, 32, 24)
    if !Near(atlas.x, 32.0) || !Near(atlas.y, 24.0) { return 239 }
    if !Near(atlas.width, 32.0) || !Near(atlas.height, 24.0) { return 240 }
    if !Near(TitleAnimationEase(0.0), 0.0) || !Near(TitleAnimationEase(1.0), 1.0) { return 241 }

    for visit: cast(s64)0..30 {
        a := TitleVisitRandom(visit, 1, 0)
        b := TitleVisitRandom(visit + 1, 1, 0)
        if a < 0.0 || a >= 1.0 || a == b { return 242 }
    }
    animal_target := Rectangle.{10, 10, 20, 20}
    if !TitleAnimalHit(20, 20, animal_target) { return 243 }
    if TitleAnimalHit(10, 10, animal_target) { return 244 }
    if TitleWindowOpening(0, 0, false) { return 245 }
    if !TitleWindowOpening(120, 60, false) { return 246 }

    startled := TitleFlee(0.05, 100, 200, 1000)
    away := TitleFlee(2.0, 100, 200, 1000)
    if !Near(startled.x, 100) || !Near(startled.y, 200) { return 247 }
    if away.x < 1000 || away.y > 0 { return 248 }

    // Title -> game -> title changes policy once each. Resizing/rotating or
    // repeating either route never issues another request or resets state.
    if !ApplyTitleOrientationPolicy(true) || title_orientation_policy != 4 { return 101 }
    if ApplyTitleOrientationPolicy(true) { return 102 }
    if !ApplyTitleOrientationPolicy(false) || title_orientation_policy != 6 { return 103 }
    if ApplyTitleOrientationPolicy(false) { return 104 }
    if !ApplyTitleOrientationPolicy(true) || title_orientation_policy != 4 { return 105 }
    if ApplyTitleOrientationPolicy(true) { return 106 }

    // Even-odd polygons: a square, a square with a square hole, and two
    // squares joined by a zero-width bridge.
    square_x: [4]s32 = .[0, 10, 10, 0]
    square_y: [4]s32 = .[0, 0, 10, 10]
    if !PointInPolygon(square_x[:], square_y[:], 5.0, 5.0) { return 1 }
    if PointInPolygon(square_x[:], square_y[:], 11.0, 5.0) { return 2 }
    if PointInPolygon(square_x[:], square_y[:], 5.0, -1.0) { return 3 }
    hole_x: [10]s32 = .[0, 10, 10, 0, 0, 3, 3, 7, 7, 3]
    hole_y: [10]s32 = .[0, 0, 10, 10, 0, 3, 7, 7, 3, 3]
    if PointInPolygon(hole_x[:], hole_y[:], 5.0, 5.0) { return 4 }
    if !PointInPolygon(hole_x[:], hole_y[:], 1.5, 5.0) { return 5 }
    pair_x: [10]s32 = .[0, 4, 4, 10, 10, 14, 14, 10, 10, 4]
    pair_y: [10]s32 = .[0, 0, 2, 2, 0, 0, 4, 4, 2, 2]
    if !PointInPolygon(pair_x[:], pair_y[:], 2.0, 1.0) || !PointInPolygon(pair_x[:], pair_y[:], 12.0, 3.0) { return 6 }
    if PointInPolygon(pair_x[:], pair_y[:], 7.0, 3.0) { return 7 }

    // Cover fit: the source size fits exactly; a wider window fills its
    // width; a portrait window fills its height and pans sideways only.
    exact := TitleFit(cast(float32)TITLE_SOURCE_WIDTH, cast(float32)TITLE_SOURCE_HEIGHT, 50.0, 50.0)
    if !Near(exact.scale, 1.0) || !Near(exact.x, 0.0) || !Near(exact.y, 0.0) { return 10 }
    wide := TitleFit(3344.0, 941.0, 0.0, 0.0)
    if !Near(wide.scale, 2.0) || !Near(wide.x, 0.0) || !Near(wide.y, -470.5) || !Near(wide.pan_x_limit, 0.0) { return 11 }
    phone := TitleFit(400.0, 941.0, 0.0, 0.0)
    if !Near(phone.scale, 1.0) || !Near(phone.x, -636.0) || !Near(phone.pan_x_limit, 636.0) || !Near(phone.pan_y_limit, 0.0) { return 12 }
    panned := TitleFit(400.0, 941.0, 10000.0, 30.0)
    if !Near(panned.x, 0.0) || !Near(panned.y, 0.0) { return 13 }
    panned = TitleFit(400.0, 941.0, -10000.0, 0.0)
    if !Near(panned.x, 400.0 - cast(float32)TITLE_SOURCE_WIDTH) { return 14 }
    half := TitleFit(836.0, 470.5, 0.0, 0.0)
    if !Near(TitleSourceX(half, 418.0), 836.0) || !Near(TitleSourceY(half, 100.0), 200.0) { return 15 }

    // Portrait Campus keeps its original painting (every mapped object, x
    // 256..1280) whole at phone and tall sizes, and its side strips fill
    // wider portrait windows edge to edge.
    campus_portrait := SceneNamed("campus-portrait")
    campus_widths: [5]float32 = .[420.0, 1080.0, 700.0, 960.0, 1000.0]
    campus_heights: [5]float32 = .[900.0, 2340.0, 1100.0, 1022.0, 1001.0]
    for size: cast(s32)0..4 {
        view := TitleFit(campus_widths[size], campus_heights[size], 9999.0, 9999.0, campus_portrait)
        if view.x + 256.0 * view.scale < -0.01 || view.y < -0.01 || view.pan_x_limit != 0.0 || view.pan_y_limit != 0.0 { return 280 }
        if view.x + 1280.0 * view.scale > campus_widths[size] + 0.01 ||
            view.y + 1536.0 * view.scale > campus_heights[size] + 0.01 { return 281 }
        if size >= 3 && (view.x > 0.01 || view.x + 1536.0 * view.scale < campus_widths[size] - 0.01 ||
            view.y > 0.01 || view.y + 1536.0 * view.scale < campus_heights[size] - 0.01) { return 282 }
    }

    // Every painted item can be hit through the window mapping, and only
    // inside its own scene.
    for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
        first := TITLE_SCENE_FIRST[scene]
        // Only a look-only view (the window's outside view) has none; it has Back.
        if TITLE_SCENE_HOTSPOTS[scene] < 1 && TITLE_SCENE_BACK[scene] == 0 { return 20 }
        for hotspot: first..first + TITLE_SCENE_HOTSPOTS[scene] - 1 {
            x: float32
            y: float32
            if !OwnPoint(scene, hotspot, *x, *y) { Report("no clickable point for "); Report(TITLE_HOTSPOT_ID[hotspot]); return 21 }
            if TitleHit(scene, x, y) != hotspot { return 22 }
            view := TitleFit(400.0, 941.0, 0.0, 0.0, scene)
            if TitleHit(scene, TitleSourceX(view, view.x + x * view.scale), TitleSourceY(view, view.y + y * view.scale)) != hotspot { return 23 }
            if TITLE_HOTSPOT_GUIDE[hotspot] == 0 && TITLE_HOTSPOT_NOTICE[hotspot] == 0 && TITLE_HOTSPOT_DIALOGUE[hotspot] == 0 && TITLE_HOTSPOT_LOCKED[hotspot] == 0 && TITLE_HOTSPOT_LOOK[hotspot] == 0 && (TITLE_HOTSPOT_TARGET[hotspot] >= 0) == (TITLE_HOTSPOT_GAME[hotspot] != "") { return 24 }
        }
    }
    if TitleHit(0, -5.0, -5.0) != -1 || TitleHit(TITLE_SCENE_COUNT, 10.0, 10.0) != -1 { return 25 }

    treehouse := SceneNamed("treehouse")
    bookshelf := SceneNamed("bookshelf")
    campus := SceneNamed("campus")
    if treehouse != 0 || bookshelf < 0 || campus < 0 { return 30 }
    if TITLE_SCENE_PARENT[bookshelf] != treehouse || TITLE_SCENE_PARENT[campus] != treehouse { return 31 }

    // Every waterfront route works with the actual touch delay in both
    // compositions: Campus, Jungle Path, Beach, Port, Aquarium and Market.
    // Rotation resolves each canonical destination; Back climbs from
    // Aquarium through Beach and Jungle Path to Campus
    // without launching an activity.
    jungle_path := SceneNamed("jungle-path")
    beach := SceneNamed("beach")
    port := SceneNamed("port")
    market := SceneNamed("market")
    aquarium := SceneNamed("aquarium")
    if jungle_path < 0 || port < 0 || market < 0 || aquarium < 0 || beach < 0 { return 120 }
    if TITLE_SCENE_PARENT[jungle_path] != campus || TITLE_SCENE_PARENT[port] != market || TITLE_SCENE_PARENT[beach] != jungle_path ||
       TITLE_SCENE_PARENT[aquarium] != beach || TITLE_SCENE_PARENT[market] != port { return 121 }
    for portrait: cast(s32)0..1 {
        route: TitleState
        TitleStart(*route)
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        origins: [10]s32 = .[campus, jungle_path, beach, aquarium, beach, port, market, port, beach, jungle_path]
        destinations: [10]s32 = .[jungle_path, beach, aquarium, beach, port, market, port, beach, jungle_path, campus]
        entrances: [10]string = .["jungle-path", "port-path", "aquarium-path", "beach-stairs", "port-path", "market-path", "port-path", "beach-path", "campus-path", "campus-path"]
        for leg: cast(s32)0..9 {
            TitleEnter(*route, origins[leg])
            TitleResolve(*route, width, height)
            hotspot := HotspotNamed(route.scene, entrances[leg])
            x: float32
            y: float32
            if hotspot < 0 || !OwnPoint(route.scene, hotspot, *x, *y) { return 122 }
            if leg == 0 && TitleHotspotRest(hotspot) == "" { return 123 }
            route_view := TitleFit(width, height, 0.0, 0.0, route.scene)
            sx := route_view.x + x * route_view.scale
            sy := route_view.y + y * route_view.scale
            unused TitlePointer(*route, route_view, sx, sy, true, true, false, false, 10.0)
            unused TitlePointer(*route, route_view, sx, sy, false, false, true, false, 10.1)
            if TitleGlowing(route) != hotspot || route.pending != hotspot { return 124 }
            entered := TitleTick(*route, 10.11 + TITLE_TAP_SECONDS)
            if !entered.moved || entered.game >= 0 || route.scene != destinations[leg] { return 125 }
            TitleResolve(*route, width, height)
            if route.scene != ResolveTitleSceneVariant(destinations[leg], width, height) { return 126 }
        }
        TitleEnter(*route, aquarium)
        TitleResolve(*route, width, height)
        unused TitleKey(*route, 256)
        TitleResolve(*route, width, height)
        if TITLE_SCENE_BASE[route.scene] != beach { return 127 }
        unused TitleKey(*route, 256)
        TitleResolve(*route, width, height)
        if TITLE_SCENE_BASE[route.scene] != jungle_path { return 128 }
        unused TitleKey(*route, 256)
        TitleResolve(*route, width, height)
        if TITLE_SCENE_BASE[route.scene] != campus { return 129 }
        // The Market's shops are only to look at: a tap lights the shop and
        // neither travels nor opens a game.
        TitleEnter(*route, market)
        TitleResolve(*route, width, height)
        shop := HotspotNamed(route.scene, "bakery")
        shop_x: float32
        shop_y: float32
        if shop < 0 || TITLE_HOTSPOT_LOOK[shop] == 0 || !OwnPoint(route.scene, shop, *shop_x, *shop_y) { return 150 }
        shop_view := TitleFit(width, height, 0.0, 0.0, route.scene)
        unused TitlePointer(*route, shop_view, shop_view.x + shop_x * shop_view.scale, shop_view.y + shop_y * shop_view.scale, true, true, false, false, 20.0)
        unused TitlePointer(*route, shop_view, shop_view.x + shop_x * shop_view.scale, shop_view.y + shop_y * shop_view.scale, false, false, true, false, 20.1)
        looked := TitleTick(*route, 20.11 + TITLE_TAP_SECONDS)
        if looked.moved || looked.game >= 0 || TITLE_SCENE_BASE[route.scene] != market { return 151 }
        // The Farm's path to the Market and the separate Beach open from a game.
        TitleEnter(*route, campus)
        if TitleSceneNamed("market") != market || TitleSceneNamed("beach") != beach || TitleSceneNamed("nowhere") != -1 { return 152 }
        if !TitleOpenSceneFromGame(*route, market) || route.scene != market { return 153 }
        if TitleOpenSceneFromGame(*route, -1) || route.scene != market { return 154 }
    }

    // The approved portrait composition has independent coordinates and
    // resolves back to its canonical room when rotated to landscape.
    portrait_campus := ResolveTitleSceneVariant(campus, 420.0, 900.0)
    if portrait_campus == campus || TITLE_SCENE_WIDTH[portrait_campus] != 1536 { return 84 }
    if ResolveTitleSceneVariant(portrait_campus, 900.0, 420.0) != campus { return 85 }
    portrait_fit := TitleFit(1024.0, 1536.0, 0.0, 0.0, portrait_campus)
    if !Near(portrait_fit.scale, 1.0) || !Near(portrait_fit.x, -256.0) || !Near(portrait_fit.y, 0.0) { return 88 }
    rotated: TitleState
    TitleStart(*rotated)
    rotated.pending = 0
    rotated.tracking = true
    TitleResolve(*rotated, 420.0, 900.0)
    if rotated.scene == treehouse || rotated.pending >= 0 || rotated.tracking { return 89 }
    TitleResolve(*rotated, 900.0, 420.0)
    if rotated.scene != treehouse { return 90 }

    // The bookshelf ladder returns to the canonical treehouse in either orientation.
    for shelf_scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
        if TITLE_SCENE_BASE[shelf_scene] != bookshelf { continue }
        back_ladder := HotspotNamed(shelf_scene, "ladder")
        returning: TitleState
        TitleStart(*returning)
        TitleEnter(*returning, shelf_scene)
        back_step := TitleActivate(*returning, back_ladder)
        if !back_step.moved || TITLE_SCENE_BASE[returning.scene] != treehouse { return 114 }
    }

    // The round window glows under the mouse and opens the outside view in
    // either orientation; that view has only Back, which (like Escape)
    // returns to the room. The room itself is a plate plus object layers.
    window_view := SceneNamed("window")
    if window_view < 0 || TITLE_SCENE_BACK[window_view] != 1 || TITLE_SCENE_HOTSPOTS[window_view] != 0 { return 130 }
    if TITLE_SCENE_PARENT[window_view] != treehouse || TITLE_SCENE_BACK[treehouse] != 0 { return 131 }
    if TITLE_SCENE_PORTRAIT[window_view] == window_view || TITLE_SCENE_BACK[TITLE_SCENE_PORTRAIT[window_view]] != 1 { return 132 }
    if TITLE_SCENE_OBJECTS[treehouse] < 10 || TITLE_SCENE_OBJECTS[TITLE_SCENE_PORTRAIT[treehouse]] < 10 { return 133 }
    for portrait: cast(s32)0..1 {
        looking: TitleState
        TitleStart(*looking)
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        TitleResolve(*looking, width, height)
        if TITLE_SCENE_BASE[looking.scene] != treehouse || (looking.scene != treehouse) != (portrait == 1) { return 134 }
        window := HotspotNamed(looking.scene, "window")
        wx: float32
        wy: float32
        if window < 0 || TITLE_HOTSPOT_TARGET[window] != window_view || !OwnPoint(looking.scene, window, *wx, *wy) { return 135 }
        look_view := TitleFit(width, height, 0.0, 0.0, looking.scene)
        sx := look_view.x + wx * look_view.scale
        sy := look_view.y + wy * look_view.scale
        // A mouse that moves onto the window hovers it.
        unused TitlePointer(*looking, look_view, sx + 2.0, sy, false, false, false, false, 2.95)
        unused TitlePointer(*looking, look_view, sx, sy, false, false, false, false, 3.0)
        if !looking.hover_mode || TitleGlowing(looking) != window { return 136 }
        unused TitlePointer(*looking, look_view, sx, sy, true, true, false, false, 3.1)
        opened := TitlePointer(*looking, look_view, sx, sy, false, false, true, false, 3.2)
        if !opened.moved || opened.game >= 0 || TITLE_SCENE_BASE[looking.scene] != window_view { return 137 }
        TitleResolve(*looking, width, height)
        if looking.scene != ResolveTitleSceneVariant(window_view, width, height) || TITLE_SCENE_BACK[looking.scene] != 1 { return 138 }
        // Nothing to select outside: arrows, Enter and number keys stay put.
        for key: cast(s32)262..265 { if TitleKey(*looking, key).moved || looking.selected >= 0 { return 139 } }
        if TitleKey(*looking, 257).moved || TitleKey(*looking, 49).moved || TITLE_SCENE_BASE[looking.scene] != window_view { return 140 }
        if TitleHit(looking.scene, wx, wy) != -1 { return 141 }
        back := TitleKey(*looking, 256)
        TitleResolve(*looking, width, height)
        if !back.moved || TITLE_SCENE_BASE[looking.scene] != treehouse { return 142 }
    }

    // Keyboard: arrows glow items in order, Enter opens a scene or game,
    // Escape climbs back and Home returns to the treehouse.
    state: TitleState
    TitleStart(*state)
    if state.scene != treehouse || TitleGlowing(state) != -1 { return 40 }
    step := TitleKey(*state, 264)
    if !step.moved || state.selected != TITLE_SCENE_FIRST[treehouse] || TitleGlowing(state) != state.selected { return 41 }
    unused TitleKey(*state, 265)
    if state.selected != TITLE_SCENE_FIRST[treehouse] + TITLE_SCENE_HOTSPOTS[treehouse] - 1 { return 42 }
    shelf := HotspotNamed(treehouse, "bookshelf")
    for turn: cast(s32)0..TITLE_SCENE_HOTSPOTS[treehouse] - 1 { if state.selected != shelf { unused TitleKey(*state, 262) } }
    if state.selected != shelf { return 43 }
    step = TitleKey(*state, 257)
    if !step.moved || step.game >= 0 || state.scene != bookshelf || TitleGlowing(state) != -1 { return 44 }
    abc := HotspotNamed(bookshelf, "book-abc")
    step = TitleKey(*state, 49 + abc - TITLE_SCENE_FIRST[bookshelf])
    if step.game != abc || TITLE_HOTSPOT_GAME[abc] != "ABC Book" || state.scene != bookshelf { return 45 }
    step = TitleKey(*state, 256)
    if !step.moved || state.scene != treehouse { return 46 }
    step = TitleKey(*state, 256)
    if step.moved || state.scene != treehouse { return 47 }
    TitleEnter(*state, campus)
    hut := HotspotNamed(campus, "music-hut")
    if TITLE_HOTSPOT_GAME[hut] != "Music Room" { return 48 }
    piano := HotspotNamed(campus, "piano")
    if piano < 0 || TITLE_HOTSPOT_GAME[piano] != "Little Piano" { return 74 }
    for hotspot: cast(s32)0..TITLE_HOTSPOT_COUNT - 1 {
        if TITLE_HOTSPOT_ID[hotspot] == "tiger-guide" { return 82 }
    }
    unused TitleKey(*state, 262)
    if !state.guide_stopped { return 83 }
    if ResolveTitleSceneVariant(campus, 960.0, 600.0) != campus { return 75 }
    if ResolveTitleSceneVariant(campus, 400.0, 900.0) != TITLE_SCENE_PORTRAIT[campus] { return 76 }
    unused TitleKey(*state, 256)
    if state.scene != treehouse { return 77 }
    unused TitleKey(*state, 268)
    if state.scene != treehouse || state.selected != -1 { return 49 }

    // A mouse hovers, glows exactly the item under it, and opens it on click.
    view := TitleFit(cast(float32)TITLE_SOURCE_WIDTH, cast(float32)TITLE_SOURCE_HEIGHT, 0.0, 0.0)
    easel := HotspotNamed(treehouse, "easel")
    ex: float32
    ey: float32
    if easel < 0 || !OwnPoint(treehouse, easel, *ex, *ey) { return 50 }
    unused TitlePointer(*state, view, 1.0, 1.0, false, false, false, false, 1.0)
    unused TitlePointer(*state, view, ex, ey, false, false, false, false, 1.1)
    if !state.hover_mode || TitleGlowing(state) != easel { return 51 }
    unused TitlePointer(*state, view, ex, ey, false, false, false, true, 1.15)
    if TitleGlowing(state) != -1 { return 52 }
    unused TitlePointer(*state, view, ex, ey, true, true, false, false, 1.2)
    step = TitlePointer(*state, view, ex, ey, false, false, true, false, 1.3)
    if step.game != easel || TITLE_HOTSPOT_GAME[easel] != "Coloring Book" { return 53 }
    // Keys take the glow back from the mouse.
    unused TitleKey(*state, 262)
    if state.hover_mode || TitleGlowing(state) != TITLE_SCENE_FIRST[treehouse] { return 54 }

    // Touch: no hover; a tap glows its item and opens it a moment later.
    touch: TitleState
    TitleStart(*touch)
    ladder := HotspotNamed(treehouse, "ladder")
    lx: float32
    ly: float32
    if ladder < 0 || !OwnPoint(treehouse, ladder, *lx, *ly) { return 60 }
    unused TitlePointer(*touch, view, lx, ly, false, false, false, false, 2.0)
    unused TitlePointer(*touch, view, lx, ly, true, true, false, false, 2.1)
    if touch.hover_mode || TitleGlowing(touch) != ladder { return 61 }
    step = TitlePointer(*touch, view, lx, ly, false, false, true, false, 2.2)
    if step.game >= 0 || step.moved || TitleGlowing(touch) != ladder { return 62 }
    step = TitleTick(*touch, 2.3)
    if step.moved || touch.scene != treehouse { return 63 }
    step = TitleTick(*touch, 2.21 + TITLE_TAP_SECONDS)
    if !step.moved || touch.scene != campus || TitleGlowing(touch) != -1 { return 64 }
    // A tap opening a game reports it after the glow.
    frogs := HotspotNamed(campus, "frogs")
    fx: float32
    fy: float32
    if frogs < 0 || !OwnPoint(campus, frogs, *fx, *fy) { return 65 }
    unused TitlePointer(*touch, view, fx, fy, true, true, false, false, 3.0)
    unused TitlePointer(*touch, view, fx, fy, false, false, true, false, 3.05)
    step = TitleTick(*touch, 3.06 + TITLE_TAP_SECONDS)
    if step.game != frogs || TITLE_HOTSPOT_GAME[frogs] != "Animal Counting" { return 66 }
    // A quick tap pressed and released within one frame still counts.
    TitleEnter(*touch, treehouse)
    unused TitlePointer(*touch, view, lx, ly, false, true, true, false, 4.0)
    step = TitleTick(*touch, 4.01 + TITLE_TAP_SECONDS)
    if touch.scene != campus { return 67 }

    // A physical path sign always animates before travel, including mouse
    // clicks after hovering. Exercise the model before new art is selected.
    sign := HotspotNamed(campus, "jungle-path")
    TitleEnter(*touch, campus)
    sign_view := TitleFit(cast(float32)TITLE_SOURCE_WIDTH, cast(float32)TITLE_SOURCE_HEIGHT, 0.0, 0.0, campus)
    sx: float32
    sy: float32
    if !OwnPoint(campus, sign, *sx, *sy) { return 270 }
    touch.hover_mode = true
    unused TitlePointer(*touch, sign_view, sx, sy, true, true, false, false, 7.0)
    step = TitlePointer(*touch, sign_view, sx, sy, false, false, true, false, 7.1)
    if step.moved || touch.scene != campus || touch.pending != sign { return 271 }
    if !Near(TitleSignLift(touch, sign, 7.1), 0.0) { return 272 }
    if !Near(TitleSignLift(touch, sign, 7.1 + TITLE_TAP_SECONDS / 2.0), -3.0) { return 273 }
    // A semantic click on the same frame must not reset the tap timer.
    TitleQueue(*touch, sign, 7.2)
    step = TitleTick(*touch, 7.1 + TITLE_TAP_SECONDS / 2.0)
    if step.moved || touch.scene != campus { return 274 }
    step = TitleTick(*touch, 7.11 + TITLE_TAP_SECONDS)
    if !step.moved || touch.scene != jungle_path { return 275 }
    unused TitleKey(*touch, 256)
    if touch.scene != campus { return 276 }
    // Desert leads to its own painted scene in both orientations. The magic
    // bird house on the tree opens a tap-through bubble, which freezes the
    // scene until its last line, and the Campus sign leads back.
    sign = HotspotNamed(campus, "desert-path")
    desert := SceneNamed("desert")
    if sign < 0 || desert < 0 || TITLE_HOTSPOT_NOTICE[sign] != 0 || TITLE_HOTSPOT_TARGET[sign] != desert { return 283 }
    if TITLE_SCENE_PARENT[desert] != campus || TITLE_DIALOGUE_COUNT != 1 { return 284 }
    for portrait: cast(s32)0..1 {
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        talk: TitleState
        TitleStart(*talk)
        TitleEnter(*talk, campus)
        TitleResolve(*talk, width, height)
        path := HotspotNamed(talk.scene, "desert-path")
        view := TitleFit(width, height, 0.0, 0.0, talk.scene)
        tx: float32
        ty: float32
        if path < 0 || !OwnPoint(talk.scene, path, *tx, *ty) { return 285 }
        wx := view.x + tx * view.scale
        wy := view.y + ty * view.scale
        // A touch tap on the sign glows, then travels.
        unused TitlePointer(*talk, view, wx, wy, true, true, false, false, 10.0)
        unused TitlePointer(*talk, view, wx, wy, false, false, true, false, 10.05)
        if TITLE_SCENE_BASE[talk.scene] != campus { return 286 }
        step = TitleTick(*talk, 10.06 + TITLE_TAP_SECONDS)
        TitleResolve(*talk, width, height)
        if !step.moved || TITLE_SCENE_BASE[talk.scene] != desert { return 287 }
        if (talk.scene != desert) != (portrait == 1) { return 288 }
        // No bird yet, only the bird house on the tree: it speaks.
        house := HotspotNamed(talk.scene, "desert-bird-house")
        back := HotspotNamed(talk.scene, "campus-path")
        if house < 0 || back < 0 || TITLE_SCENE_HOTSPOTS[talk.scene] != 2 { return 289 }
        if TITLE_HOTSPOT_DIALOGUE[house] != 1 || TITLE_HOTSPOT_GAME[house] != "" { return 290 }
        if TITLE_SIGN_LABEL[back] != "Campus" || TITLE_SIGN_DIRECTION[back] != 1 || TITLE_HOTSPOT_TARGET[back] != campus { return 291 }
        if TitleHotspotRest(house) != "assets/jungle/title/objects/desert-bird-house.avif" { return 292 }
        // A point that is the bird house's own.
        view = TitleFit(width, height, 0.0, 0.0, talk.scene)
        if !OwnPoint(talk.scene, house, *tx, *ty) { return 293 }
        wx = view.x + tx * view.scale
        wy = view.y + ty * view.scale
        // A mouse click after hovering opens the bubble at once.
        unused TitlePointer(*talk, view, wx + 2.0, wy, false, false, false, false, 11.0)
        unused TitlePointer(*talk, view, wx, wy, false, false, false, false, 11.05)
        if talk.hovered != house { return 294 }
        unused TitlePointer(*talk, view, wx, wy, true, true, false, false, 11.1)
        step = TitlePointer(*talk, view, wx, wy, false, false, true, false, 11.2)
        if talk.dialogue != 1 || talk.dialogue_line != 0 || talk.dialogue_hotspot != house || step.moved || step.game >= 0 { return 295 }
        if TitleDialogueText(talk, 0) != "Hello! This is the big desert." ||
            TitleDialogueText(talk, 1) != "Hallo! Das ist die große Wüste." ||
            TitleDialogueText(talk, 2) != "¡Hola! Este es el gran desierto." { return 296 }
        // Each line is voiced once per language; muted never plays.
        unused TitleDialogueVoice(*talk, 0, false)
        if TitleDialogueVoice(*talk, 0, false) != "" { return 297 }
        if TitleDialogueVoice(*talk, 1, false) != TITLE_DIALOGUE_VOICE[TitleDialogueEntry(talk, 1)] { return 298 }
        if TitleDialogueVoice(*talk, 2, true) != "" || talk.dialogue_language != 2 { return 299 }
        // The open bubble owns taps and keys: no travel, glow or pan.
        shown := talk.scene
        unused TitleKey(*talk, 256)
        unused TitleKey(*talk, 268)
        unused TitleKey(*talk, 49)
        unused TitleKey(*talk, 262)
        TitleQueue(*talk, back, 12.0)
        unused TitleTick(*talk, 13.0)
        unused TitlePointer(*talk, view, wx, wy, true, true, false, false, 12.1)
        unused TitlePointer(*talk, view, wx - 40.0, wy, true, false, false, false, 12.15)
        unused TitlePointer(*talk, view, wx - 40.0, wy, false, false, true, false, 12.2)
        if talk.scene != shown || talk.pending >= 0 || talk.tracking || talk.selected >= 0 || talk.pan_x != 0.0 ||
            talk.dialogue != 1 || talk.dialogue_line != 0 { return 300 }
        // Tap through every line; the last tap closes the bubble.
        lines := TITLE_DIALOGUE_LINES[0]
        if lines < 3 || lines > 6 { return 301 }
        for line: cast(s32)1..lines - 1 {
            if !TitleDialogueAdvance(*talk) || talk.dialogue_line != line || talk.dialogue_spoken != -1 { return 302 }
            for language_index: cast(s32)0..2 { if TitleDialogueText(talk, language_index) == "" { return 303 } }
        }
        if TitleDialogueAdvance(*talk) || talk.dialogue != 0 || talk.scene != shown || TitleDialogueText(talk, 0) != "" { return 304 }
        // Another tap opens the bubble again from its first line; closing ends it.
        unused TitleActivate(*talk, house)
        if talk.dialogue != 1 || talk.dialogue_hotspot != house || talk.dialogue_line != 0 { return 305 }
        TitleDialogueClose(*talk)
        if talk.dialogue != 0 || talk.dialogue_hotspot != -1 { return 306 }
        // The bubble stays inside the window, under the corner controls, above the head.
        unit := (ifx width < height then width else height) / 300.0
        if unit < 1.0 { unit = 1.0 }
        units_x := cast(s32)(width / unit)
        units_y := cast(s32)(height / unit)
        at := house * 4
        anchor := TitleGuideRect.{cast(s32)((view.x + cast(float32)TITLE_GLOW_RECT[at] * view.scale) / unit),
            cast(s32)((view.y + cast(float32)TITLE_GLOW_RECT[at + 1] * view.scale) / unit),
            cast(s32)(cast(float32)TITLE_GLOW_RECT[at + 2] * view.scale / unit),
            cast(s32)(cast(float32)TITLE_GLOW_RECT[at + 3] * view.scale / unit)}
        place := TitleDialogueLayout(units_x, units_y, anchor)
        if place.bubble.x < 6 || place.bubble.x + place.bubble.width > units_x - 6 || place.bubble.y < 40 ||
            place.bubble.y + place.bubble.height > units_y - 8 { return 307 }
        if !place.tail_below || place.bubble.y + place.bubble.height > anchor.y { return 308 }
        if place.close.x + place.close.width > place.bubble.x + place.bubble.width || place.text.width < 120 { return 309 }
        // The Campus sign and Back both return to Campus.
        step = TitleActivate(*talk, back)
        if !step.moved || talk.scene != campus { return 310 }
        TitleEnter(*talk, shown)
        unused TitleKey(*talk, 256)
        if talk.scene != campus { return 311 }
    }

    // Portrait: dragging pans the picture and never taps; keys center the
    // selection.
    pan: TitleState
    TitleStart(*pan)
    phone_view := TitleFit(400.0, 941.0, pan.pan_x, pan.pan_y)
    unused TitlePointer(*pan, phone_view, 200.0, 400.0, true, true, false, false, 5.0)
    unused TitlePointer(*pan, phone_view, 300.0, 402.0, true, false, false, false, 5.1)
    step = TitlePointer(*pan, phone_view, 300.0, 402.0, false, false, true, false, 5.2)
    if !Near(pan.pan_x, 100.0) || !Near(pan.pan_y, 0.0) || pan.pending >= 0 || step.game >= 0 { return 70 }
    unused TitlePointer(*pan, phone_view, 0.0, 400.0, true, true, false, false, 5.3)
    unused TitlePointer(*pan, phone_view, 2000.0, 400.0, true, false, false, false, 5.4)
    if !Near(pan.pan_x, phone_view.pan_x_limit) { return 71 }
    unused TitlePointer(*pan, phone_view, 2000.0, 400.0, false, false, true, false, 5.5)
    TitleEnter(*pan, treehouse)
    if !Near(pan.pan_x, 0.0) { return 72 }
    unused TitleKey(*pan, 262)
    TitleFocus(*pan, 400.0, 941.0)
    focused := TitleFit(400.0, 941.0, pan.pan_x, pan.pan_y)
    rect := pan.selected * 4
    center := focused.x + (cast(float32)TITLE_GLOW_RECT[rect] + cast(float32)TITLE_GLOW_RECT[rect + 2] / 2.0) * focused.scale
    if center < 0.0 || center > 400.0 { return 73 }
    // Corner controls must never start a pan, even when pressed and dragged.
    TitleEnter(*pan, treehouse)
    unused TitlePointer(*pan, phone_view, 10.0, 10.0, true, true, false, true, 6.0)
    unused TitlePointer(*pan, phone_view, 200.0, 10.0, true, false, false, false, 6.1)
    if pan.tracking || pan.pan_x != 0.0 || pan.pending >= 0 { return 78 }
    if !pan.guide_stopped { return 79 }
    // Three immediate steps, mute input, skip and compact portrait/landscape
    // bounds are all covered without a tiger hotspot.
    narrated: TitleState
    TitleStart(*narrated)
    intro := TitleGuide(*narrated, 10.0, false, false, 0)
    if !intro.active || intro.step != 0 || !intro.voice || intro.stop { return 91 }
    intro = TitleGuide(*narrated, 10.2, false, false, 0)
    if intro.voice || intro.step != 0 { return 92 }
    intro = TitleGuide(*narrated, 12.2, false, false, 0)
    if !intro.active || intro.step != 1 || !intro.voice { return 93 }
    intro = TitleGuide(*narrated, 15.3, false, false, 0)
    if !intro.active || intro.step != 2 || !intro.voice { return 94 }
    intro = TitleGuide(*narrated, 17.4, false, false, 0)
    if intro.active || intro.voice || !intro.stop || !intro.finished || narrated.guide_step != 3 { return 95 }
    intro = TitleGuide(*narrated, 17.5, false, false, 0)
    if intro.stop || intro.finished { return 96 }
    quiet: TitleState
    TitleStart(*quiet)
    quiet_intro := TitleGuide(*quiet, 10.0, true, false, 1)
    if !quiet_intro.active || quiet_intro.voice { return 97 }
    quiet_intro = TitleGuide(*quiet, 12.7, true, false, 1)
    if !quiet_intro.active || quiet_intro.voice || quiet_intro.step != 1 { return 98 }
    skipped: TitleState
    TitleStart(*skipped)
    TitleGuideSkip(*skipped)
    skipped_intro := TitleGuide(*skipped, 10.0, false, false, 2)
    if skipped_intro.active || skipped_intro.voice || !skipped_intro.stop || !skipped_intro.finished { return 99 }
    landscape := TitleGuideLayout(960, 600, TitleGuideRect.{420, 200, 80, 80})
    if landscape.bubble.width > 228 || landscape.bubble.height != 48 ||
       landscape.hit.x < 0 || landscape.hit.y < 0 ||
       landscape.hit.x + landscape.hit.width > 960 || landscape.hit.y + landscape.hit.height > 600 { return 100 }
    portrait := TitleGuideLayout(400, 900, TitleGuideRect.{160, 80, 80, 80})
    if portrait.bubble.width > 228 || portrait.bubble.height != 48 ||
       portrait.hit.x < 0 || portrait.hit.y < 0 ||
       portrait.hit.x + portrait.hit.width > 400 || portrait.hit.y + portrait.hit.height > 900 { return 101 }
    for language: cast(s32)0..2 {
        for step: cast(s32)0..2 {
            if TitleGuideText(step, language) == "" || TitleGuideDuration(step, language) > 3.1 { return 102 + language * 3 + step }
            path := TitleGuideVoicePath(step, language)
            if path.count < 4 || path[path.count - 4:] != ".wav" { return 112 + language * 3 + step }
        }
    }
    paper_failure := TitlePaperChecks()
    if paper_failure != 0 { return paper_failure }
    map_failure := TitleMapChecks()
    if map_failure != 0 { return map_failure }
    fog_failure := TitleFogChecks()
    if fog_failure != 0 { return fog_failure }
    place_failure := TitlePlaceChecks()
    if place_failure != 0 { return place_failure }
    Report("local title scene test passed\n")
    return 0
}

// The web loading screen of a slow title scene names that scene's place in
// every language and orientation, never the books (web/index.html sceneReady).
TitlePlaceChecks :: () -> s32 {
    expected: [9]string = .["Campus", "Campus", "Campus", "Port", "Hafen", "Puerto", "Treehouse", "Baumhaus", "Casa del árbol"]
    named: [3]string = .["campus", "port", "treehouse"]
    for language: cast(s32)0..2 {
        LanguageSet(ifx language == 1 then "de" else ifx language == 2 then "es" else "en")
        for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
            place := TitleScenePlace(scene)
            if place == "" { return 800 + language }
            if place != TitleScenePlace(TITLE_SCENE_BASE[scene]) { return 803 + language }
            if place == "Opening your books…" || place == "Deine Bücher werden geöffnet…" || place == "Abriendo tus libros…" { return 806 + language }
        }
        for at: cast(s32)0..2 {
            scene := SceneNamed(named[at])
            if scene < 0 || TitleScenePlace(scene) != expected[at * 3 + language] { return 810 + at * 3 + language }
            if TitleScenePlace(TITLE_SCENE_PORTRAIT[scene]) != expected[at * 3 + language] { return 820 + at * 3 + language }
        }
    }
    LanguageSet("en")
    if TitleScenePlace(-1) != "" || TitleScenePlace(TITLE_SCENE_COUNT) != "" { return 830 }
    if TitleScenePlace(SceneNamed("map")) != "World map" || TitleScenePlace(SceneNamed("jungle-path")) != "Jungle Path" { return 831 }
    return 0
}

paper_collects: s32;
// Answers new only the first time, as the hosts' collection does.
PaperCollect :: (slug: string) -> bool {
    paper_collects += 1
    return paper_collects == 1 && slug == "treehouse-scene"
}

// The paper of STATE's scene once its picture has panned.
TitlePlaceAfterPan :: (state: TitleState, place: TitlePaperPlace, width: float32, height: float32) -> TitlePaperPlace {
    return TitlePaperSpot(state.scene, TitleFit(width, height, state.pan_x, state.pan_y, state.scene), width, height)
}

TitlePaperChecks :: () -> s32 {
    // Each paper shares its foreground's scene transform, including on pan
    // and rotation. Its touch target may overlap that foreground's hotspot.
    names: [3]string = .["treehouse", "bookshelf", "campus"]
    slugs: [3]string = .["treehouse-scene", "bookshelf-scene", "campus-scene"]
    widths: [8]float32 = .[1280.0, 960.0, 1024.0, 2560.0, 420.0, 390.0, 768.0, 600.0]
    heights: [8]float32 = .[720.0, 600.0, 768.0, 1080.0, 900.0, 844.0, 1024.0, 800.0]
    for named: cast(s32)0..2 {
        base := SceneNamed(names[named])
        if base < 0 { return 200 + named }
        index := TitlePaperIndex(base)
        if index < 0 || collectible_slugs[index] != slugs[named] || collectible_how_kinds[index] != COLLECTIBLE_HOW_PAPER ||
            collectible_paint_kinds[index] != COLLECTIBLE_PAINT_SCENE { return 203 + named }
        for size: cast(s32)0..7 {
            scene := ResolveTitleSceneVariant(base, widths[size], heights[size])
            if TitlePaperIndex(scene) != index { return 206 + named }
            if (size >= 4) != (scene != base) { return 209 + named }
            view := TitleFit(widths[size], heights[size], 0.0, 0.0, scene)
            place := TitlePaperSpot(scene, view, widths[size], heights[size])
            if place.index != index || place.size <= 0.0 || place.reveal_x <= 0.0 { return 212 + named }
            if TITLE_SCENE_BACKGROUND[scene] == "" ||
                (TITLE_SCENE_FOREGROUND[scene] == "" && TITLE_SCENE_OBJECTS[scene] == 0) { return 215 + named }
            if !Near(TitleSourceX(view, place.x), cast(float32)TITLE_SCENE_PAPER[scene * 4]) ||
                !Near(TitleSourceY(view, place.y), cast(float32)TITLE_SCENE_PAPER[scene * 4 + 1]) { return 218 }
            half_shown := TitlePaperRevealed(place, 0.5)
            fully_shown := TitlePaperRevealed(place, 1.0)
            if !Near(half_shown.x, place.x + place.reveal_x * 0.5) ||
                !Near(fully_shown.x, place.x + place.reveal_x) || !Near(fully_shown.y, place.y) { return 219 }
            if !TitlePaperHit(place, fully_shown.x, fully_shown.y) { return 220 }
            // Panned to either edge it still lies in the same painted spot.
            panned := TitleFit(widths[size], heights[size], 9999.0, 9999.0, scene)
            moved := TitlePaperSpot(scene, panned, widths[size], heights[size])
            if !Near(moved.x - panned.x, place.x - view.x) || !Near(moved.y - panned.y, place.y - view.y) { return 245 + named }
        }
    }
    // The waterfront scenes hide no paper, and nothing there takes the pointer.
    for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
        name := TITLE_SCENE_NAME[TITLE_SCENE_BASE[scene]]
        if name == "treehouse" || name == "bookshelf" || name == "campus" { continue }
        if TitlePaperIndex(scene) >= 0 { return 248 }
        none: TitlePapers
        empty := TitlePaperSpot(scene, TitleFit(960.0, 600.0, 0.0, 0.0, scene), 960.0, 600.0)
        input := TitlePaperPointer(*none, empty, false, empty.x, empty.y, true, true, false, 1.0, PaperCollect)
        if input.owned || input.collected || paper_collects != 0 { return 249 }
    }

    // A tap on the treehouse paper collects it once and flies; the scene never
    // sees the tap, so nothing glows, opens or pans.
    for portrait: cast(s32)0..1 {
        paper_collects = 0
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        papers: TitlePapers
        state: TitleState
        TitleStart(*state)
        TitleResolve(*state, width, height)
        view := TitleFit(width, height, 0.0, 0.0, state.scene)
        place := TitlePaperSpot(state.scene, view, width, height)
        if place.index < 0 { return 250 }
        // A mouse resting on the paper makes nothing glow.
        hover := TitlePaperPointer(*papers, place, false, place.x, place.y, false, false, false, 1.0, PaperCollect)
        unused TitlePointer(*state, view, place.x - 40.0, place.y, false, false, false, hover.owned, 0.9)
        unused TitlePointer(*state, view, place.x, place.y, false, false, false, hover.owned, 1.0)
        if !hover.owned || TitleGlowing(state) >= 0 { return 251 }
        first_reveal := papers.reveal[place.index]
        if first_reveal <= 0.0 || first_reveal >= 1.0 { return 263 }
        unused TitlePaperPointer(*papers, place, false, -100.0, -100.0, false, false, false, 1.05, PaperCollect)
        if papers.reveal[place.index] >= first_reveal { return 264 }
        for frame: cast(s32)0..29 {
            shown := TitlePaperRevealed(place, papers.reveal[place.index])
            reveal := TitlePaperPointer(*papers, place, false, shown.x + shown.size * 0.32, shown.y,
                false, false, false, 1.1 + cast(float64)frame * 0.016, PaperCollect)
            if !reveal.owned { return 265 }
        }
        if papers.reveal[place.index] < 0.99 { return 266 }
        press := TitlePaperPointer(*papers, place, false, place.x, place.y, true, true, false, 2.0, PaperCollect)
        step := TitlePointer(*state, view, place.x, place.y, true, true, false, press.owned, 2.0)
        if press.owned || press.collected || paper_collects != 0 || step.game >= 0 { return 252 }
        release := TitlePaperPointer(*papers, place, false, place.x + 3.0, place.y + 2.0, false, false, true, 2.1, PaperCollect)
        step = TitlePointer(*state, view, place.x + 3.0, place.y + 2.0, false, false, true, release.owned, 2.1)
        if !release.owned || !release.collected || paper_collects != 1 { return 253 }
        if step.game >= 0 || step.moved || state.pending >= 0 || state.pan_x != 0.0 || state.pan_y != 0.0 { return 254 }
        flying := papers.papers[place.index]
        if flying.state != SECRET_PAPER_FLYING || SecretPaperProgress(flying, 2.1 + COLLECT_FLIGHT_SECONDS / 2.0) <= 0.0 { return 255 }
        if TitleTick(*state, 3.0).game >= 0 || state.scene != ResolveTitleSceneVariant(0, width, height) { return 256 }
        // Gone for good: after its flight nothing lies there to tap.
        again := TitlePaperPointer(*papers, place, true, place.x, place.y, true, true, false, 5.0, PaperCollect)
        if again.owned || papers.papers[place.index].state != SECRET_PAPER_GONE { return 257 }
        unused TitlePaperPointer(*papers, place, true, place.x, place.y, false, false, true, 5.1, PaperCollect)
        if paper_collects != 1 { return 258 }
        // A paper already in the collection never shows, even on a fresh start.
        fresh: TitlePapers
        earned := TitlePaperPointer(*fresh, place, true, place.x, place.y, true, true, false, 6.0, PaperCollect)
        if earned.owned || SecretPaperShown(fresh.papers[place.index], place.index, true) { return 259 }
        // A press that slides off the paper before release collects nothing.
        slid: TitlePapers
        unused TitlePaperPointer(*slid, place, false, place.x, place.y, true, true, false, 7.0, PaperCollect)
        off := TitlePaperPointer(*slid, place, false, place.x + 200.0, place.y, false, false, true, 7.2, PaperCollect)
        if off.collected || slid.papers[place.index].state != SECRET_PAPER_WAITING || paper_collects != 1 { return 260 }
        // A drag that starts on the paper pans the picture, as anywhere else, and collects nothing.
        dragged: TitlePapers
        drag: TitleState
        TitleStart(*drag)
        TitleResolve(*drag, width, height)
        if view.pan_x_limit <= 0.0 { return 261 }
        unused TitlePaperPointer(*dragged, place, false, place.x, place.y, true, true, false, 8.0, PaperCollect)
        unused TitlePointer(*drag, view, place.x, place.y, true, true, false, false, 8.0)
        unused TitlePaperPointer(*dragged, place, false, place.x - 40.0, place.y, true, false, false, 8.1, PaperCollect)
        unused TitlePointer(*drag, view, place.x - 40.0, place.y, true, false, false, false, 8.1)
        moved_paper := TitlePlaceAfterPan(drag, place, width, height)
        dropped := TitlePaperPointer(*dragged, moved_paper, false, place.x - 40.0, place.y, false, false, true, 8.2, PaperCollect)
        unused TitlePointer(*drag, view, place.x - 40.0, place.y, false, false, true, dropped.owned, 8.2)
        if drag.pan_x >= 0.0 || dropped.collected || dragged.papers[place.index].state != SECRET_PAPER_WAITING ||
            paper_collects != 1 { return 262 }
        // A touch needs no preliminary mouse hover to collect the idle peek.
        touch: TitlePapers
        paper_collects = 0
        unused TitlePaperPointer(*touch, place, false, place.x + place.size * 0.32, place.y,
            true, true, false, 9.0, PaperCollect)
        tapped := TitlePaperPointer(*touch, place, false, place.x + place.size * 0.32, place.y,
            false, false, true, 9.1, PaperCollect)
        if !tapped.collected || paper_collects != 1 { return 267 }
    }
    return 0
}

// The world map: every landmark is hovered and opens its place, a locked one
// stays with a wobble, Back returns where the map was opened, every other scene
// shows the map button, and the landmarks stay whole at every window size.
// Every place on the map visited.
TITLE_FOG_ALL :: 511

TitleFogArea :: (name: string) -> s32 {
    for area: cast(s32)0..TITLE_MAP_AREA_COUNT-1 { if TITLE_MAP_AREA[area]==name { return area } }
    return -1
}

TitleFogBit :: (name: string) -> u32 {
    area := TitleFogArea(name)
    if area < 0 { return cast(u32)0 }
    return cast(u32)1 << cast(u32)area
}

MapLandmark :: (scene: s32, id: string) -> s32 {
    for hotspot: TITLE_SCENE_FIRST[scene]..TITLE_SCENE_FIRST[scene]+TITLE_SCENE_HOTSPOTS[scene]-1 {
        if TITLE_HOTSPOT_ID[hotspot]==id { return hotspot }
    }
    return -1
}

// The fog follows the map: a visit clears that place's whole region, two
// visited neighbours clear the land between them, and a landmark still under
// fog takes no hover, pointing hand, glow, tap or key.
TitleFogChecks :: () -> s32 {
    if TITLE_MAP_AREA_COUNT != 9 || TitleFogBit("desert") != cast(u32)0x100 { return 780 }
    campus := TitleFogBit("campus")
    farm := TitleFogBit("farm")
    both := campus | farm
    // Campus, then Farm: the meadows, the forest between them and the path's
    // edges are all clear; land only the route clears waits for both visits.
    clear: [18]float32 = .[1438.0, 723.0, 738.0, 666.0, 1150.0, 790.0, 1000.0, 740.0, 1100.0, 650.0,
        1250.0, 850.0, 900.0, 800.0, 1700.0, 760.0, 1060.0, 860.0]
    for at: cast(s32)0..8 {
        if TitleFogAlpha(both, clear[at*2], clear[at*2+1]) != cast(u8)0 { return 781 }
    }
    if TitleFogAlpha(campus, 1060.0, 860.0) < cast(u8)128 || TitleFogAlpha(farm, 1060.0, 860.0) < cast(u8)128 { return 782 }
    // Unvisited places stay under full cover.
    covered: [10]float32 = .[380.0, 280.0, 330.0, 585.0, 889.0, 254.0, 2840.0, 1820.0, 2400.0, 1500.0]
    for at: cast(s32)0..4 {
        if TitleFogAlpha(both, covered[at*2], covered[at*2+1]) != cast(u8)255 { return 783 }
    }
    // Every place's own landmark is usable once that place is visited.
    map: s32 = TITLE_MAP_SCENE
    for area: cast(s32)0..TITLE_MAP_AREA_COUNT-1 {
        state: TitleState
        TitleStart(*state)
        TitleEnter(*state, map)
        state.map_visits = cast(u32)1 << cast(u32)area
        hotspot := MapLandmark(map, TITLE_MAP_AREA[area])
        if hotspot < 0 { continue }
        if !TitleHotspotDiscovered(state, hotspot) { return 784 }
    }
    // Only Campus and Farm visited: the Port, still under fog, ignores the
    // pointer, the pointing hand, glow, taps and keys.
    for portrait: cast(s32)0..1 {
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        state: TitleState
        TitleStart(*state)
        TitleEnter(*state, SceneNamed("campus"))
        if !TitleMapOpen(*state, state.scene) { return 785 }
        TitleResolve(*state, width, height)
        shown := state.scene
        state.map_visits = both
        port := MapLandmark(shown, "port")
        farm_spot := MapLandmark(shown, "farm")
        if port < 0 || farm_spot < 0 || TitleHotspotDiscovered(state, port) || !TitleHotspotDiscovered(state, farm_spot) { return 786 }
        x: float32
        y: float32
        if !OwnPoint(shown, port, *x, *y) { return 787 }
        view := TitleFit(width, height, 0.0, 0.0, shown)
        sx := view.x + x * view.scale
        sy := view.y + y * view.scale
        unused TitlePointer(*state, view, sx + 2.0, sy, false, false, false, false, 2.95)
        unused TitlePointer(*state, view, sx, sy, false, false, false, false, 3.0)
        pointed := TitleSpotHit(state, x, y)
        if TitleHit(shown, x, y) != port || pointed != -1 || state.hovered != -1 || TitleGlowing(state) != -1 { return 788 }
        if TitleCursorClickable(*state, port, false, false, false) || TitleCursorClickable(*state, pointed, false, false, false) { return 789 }
        unused TitlePointer(*state, view, sx, sy, true, true, false, false, 3.1)
        step := TitlePointer(*state, view, sx, sy, false, false, true, false, 3.2)
        tick := TitleTick(*state, 4.0)
        if step.moved || step.game >= 0 || tick.moved || tick.game >= 0 || state.scene != shown || state.pending >= 0 { return 790 }
        direct := TitleActivate(*state, port)
        key := TitleKey(*state, 49 + port - TITLE_SCENE_FIRST[shown])
        if direct.moved || key.moved || state.scene != shown { return 791 }
        // Arrow keys pass over landmarks under fog.
        for press: cast(s32)0..TITLE_SCENE_HOTSPOTS[shown] {
            unused TitleKey(*state, 262)
            if state.selected < 0 || !TitleHotspotDiscovered(state, state.selected) { return 792 }
        }
        // Once the Port is visited, the same tap travels there.
        state.map_visits = both | TitleFogBit("port")
        if !TitleCursorClickable(*state, TitleSpotHit(state, x, y), false, false, false) { return 793 }
        unused TitlePointer(*state, view, sx + 2.0, sy, false, false, false, false, 4.95)
        unused TitlePointer(*state, view, sx, sy, false, false, false, false, 5.0)
        if TitleGlowing(state) != port { return 795 }
        unused TitlePointer(*state, view, sx, sy, true, true, false, false, 5.1)
        step = TitlePointer(*state, view, sx, sy, false, false, true, false, 5.2)
        if !step.moved || state.scene != TITLE_HOTSPOT_TARGET[port] { return 794 }
    }
    return 0
}

TitleMapChecks :: () -> s32 {
    map: s32 = TITLE_MAP_SCENE
    if map < 0 || TITLE_SCENE_NAME[map] != "map" || TITLE_SCENE_BACK[map] == 0 { return 700 }
    tall := TITLE_SCENE_PORTRAIT[map]
    if tall == map || TITLE_SCENE_BASE[tall] != map { return 701 }
    for scene: cast(s32)0..TITLE_SCENE_COUNT - 1 {
        if TitleMapEntry(scene) == TitleOnMap(scene) { return 702 }
    }
    campus := SceneNamed("campus")
    desert := SceneNamed("desert")
    if campus < 0 || desert < 0 { return 703 }
    locked: s32 = 0
    for portrait: cast(s32)0..1 {
        width: float32 = ifx portrait == 1 then 420.0 else 960.0
        height: float32 = ifx portrait == 1 then 900.0 else 600.0
        shown := ifx portrait == 1 then tall else map
        first := TITLE_SCENE_FIRST[shown]
        if TITLE_SCENE_HOTSPOTS[shown] != TITLE_SCENE_HOTSPOTS[map] || TITLE_SCENE_HOTSPOTS[map] < 8 { return 704 }
        for hotspot: first..first + TITLE_SCENE_HOTSPOTS[shown] - 1 {
            if TITLE_HOTSPOT_ID[hotspot] != "desert" &&
                (TitleHotspotRest(hotspot) == "" || TitleHotspotGlow(hotspot) == "") { return 705 }
            x: float32
            y: float32
            if !OwnPoint(shown, hotspot, *x, *y) { return 706 }
            state: TitleState
            TitleStart(*state)
            TitleEnter(*state, campus)
            if !TitleMapOpen(*state, campus) || !TitleOnMap(state.scene) { return 707 }
            // Every place visited: no landmark lies under fog.
            state.map_visits = cast(u32)TITLE_FOG_ALL
            TitleResolve(*state, width, height)
            if state.scene != shown { return 708 }
            view := TitleFit(width, height, 0.0, 0.0, state.scene)
            sx := view.x + x * view.scale
            sy := view.y + y * view.scale
            // A mouse over the landmark highlights it; a click travels there.
            unused TitlePointer(*state, view, sx + 2.0, sy, false, false, false, false, 2.95)
            unused TitlePointer(*state, view, sx, sy, false, false, false, false, 3.0)
            if TitleGlowing(state) != hotspot { return 709 }
            unused TitlePointer(*state, view, sx, sy, true, true, false, false, 3.1)
            step := TitlePointer(*state, view, sx, sy, false, false, true, false, 3.2)
            if TITLE_HOTSPOT_LOCKED[hotspot] != 0 {
                if portrait == 0 { locked += 1 }
                if state.scene != shown || step.moved || step.game >= 0 || !state.locked_cue ||
                    state.locked_hotspot != hotspot + 1 { return 710 }
                state.locked_cue = false
                state.locked_at = 3.2
                if TitleLockedWobble(state, hotspot, 3.3) == 0.0 || TitleLockedWobble(state, hotspot, 3.9) != 0.0 ||
                    TitleLockedWobble(state, first, 3.3) != 0.0 && first != hotspot { return 711 }
            } else if TITLE_HOTSPOT_TARGET[hotspot] >= 0 {
                if !step.moved || step.game >= 0 || state.scene != TITLE_HOTSPOT_TARGET[hotspot] || TitleOnMap(state.scene) { return 712 }
            } else {
                // A game plays over its usual scene, so leaving it lands there.
                if step.game != hotspot || TITLE_HOTSPOT_GAME[hotspot] == "" || TITLE_HOTSPOT_HOME[hotspot] < 0 ||
                    state.scene != TITLE_HOTSPOT_HOME[hotspot] { return 713 }
            }
        }
    }
    if locked < 1 { return 714 }
    // Back (the button sends Escape) returns to where the map was opened.
    back: TitleState
    TitleStart(*back)
    TitleEnter(*back, TITLE_SCENE_PORTRAIT[desert])
    if !TitleMapOpen(*back, back.scene) { return 715 }
    returned := TitleKey(*back, 256)
    if !returned.moved || returned.game >= 0 || back.scene != desert || back.map_from != 0 { return 716 }
    if TitleMapOpen(*back, map) || TitleMapOpen(*back, tall) { return 717 }
    // Opened from the Farm game, Back opens the Farm again over Campus.
    farm: TitleState
    TitleStart(*farm)
    TitleEnter(*farm, campus)
    if !TitleMapOpenFromGame(*farm, "Farm") || !TitleOnMap(farm.scene) { return 718 }
    returned = TitleKey(*farm, 256)
    if returned.game < 0 || TITLE_HOTSPOT_GAME[returned.game] != "Farm" || farm.scene != campus { return 719 }
    // Without an origin, Back climbs to the treehouse.
    lost: TitleState
    TitleStart(*lost)
    TitleEnter(*lost, map)
    unused TitleKey(*lost, 256)
    if lost.scene != 0 { return 720 }
    // Phones, tablets and desktops in both orientations: no panning, and every
    // landmark whole inside the window.
    sizes: [16]float32 = .[360.0, 800.0, 412.0, 915.0, 768.0, 1024.0, 1080.0, 1920.0,
        800.0, 360.0, 1024.0, 768.0, 1366.0, 768.0, 1920.0, 1080.0]
    for size: cast(s32)0..7 {
        width := sizes[size * 2]
        height := sizes[size * 2 + 1]
        shown := ResolveTitleSceneVariant(map, width, height)
        if (shown == tall) != (height > width) { return 721 }
        view := TitleFit(width, height, 0.0, 0.0, shown)
        if view.pan_x_limit != 0.0 || view.pan_y_limit != 0.0 { return 722 }
        // The owner selected the whole painting, including terrain beyond
        // the landmarks. Both orientations must contain every painted pixel.
        if view.x < -0.5 || view.y < -0.5 ||
            view.x + cast(float32)TITLE_SCENE_WIDTH[shown] * view.scale > width + 0.5 ||
            view.y + cast(float32)TITLE_SCENE_HEIGHT[shown] * view.scale > height + 0.5 { return 724 }
        first := TITLE_SCENE_FIRST[shown]
        for hotspot: first..first + TITLE_SCENE_HOTSPOTS[shown] - 1 {
            at := hotspot * 4
            left := view.x + cast(float32)TITLE_GLOW_RECT[at] * view.scale
            top := view.y + cast(float32)TITLE_GLOW_RECT[at + 1] * view.scale
            right := left + cast(float32)TITLE_GLOW_RECT[at + 2] * view.scale
            bottom := top + cast(float32)TITLE_GLOW_RECT[at + 3] * view.scale
            if left < -0.5 || top < -0.5 || right > width + 0.5 || bottom > height + 0.5 { return 723 }
        }
    }
    return 0
}

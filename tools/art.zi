// Makes Jungle's pixel art from the SVG drawings in art/, with Inkscape and
// ImageMagick. Run from the repository root after changing any drawing:
//
//     make art
//
// Sprites are drawn small and cut down to the sixteen colors of an old PC
// color card, with hard edges. Letters come from GNU Unifont, 8 by 16. Each
// coloring page becomes black lines on white, 240 by 180, written into
// games/paint/paint_pages.zi so Dino Paint carries its pages in its code.
#import "c_string"
#import "byte_text_linux"
#import "file"
#import "number_text"
#import "text_buffer"
#import "process_capture_linux"

libc :: #system_library "libc";
WriteError :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";

ITEMS: [8]string = .["banana", "butterfly", "coconut", "flower", "frog", "ladybug", "mango", "snail"];
PAGES: [6]string = .["trex", "triceratops", "stegosaurus", "brachiosaurus", "pteranodon", "egg"];
// The sixteen colors, as in retro/retro.zi.
PALETTE: [16]string = .["0 0 0", "0 0 170", "0 170 0", "0 170 170", "170 0 0", "170 0 170", "170 85 0",
"170 170 170", "85 85 85", "85 85 255", "85 255 85", "85 255 255", "255 85 85", "255 85 255",
"255 255 85", "255 255 255"];

PAGE_WIDTH :: 240
PAGE_HEIGHT :: 180
// Pages are written in parts of 60 rows.
PAGE_PARTS :: 3

output: [65536]u8;

Report :: (message: string) {
    bytes: [1024]u8
    if CopyCString(message, bytes[:]) { unused WriteError(2, *bytes[0], cast(usize)message.count) }
}

Cat :: (a: string, b: string = "", c: string = "", d: string = "", e: string = "", f: string = "", g: string = "",
    h: string = "", i: string = "") -> string {
    text: Vec(u8)
    parts: [9]string = .[a, b, c, d, e, f, g, h, i]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Number :: (value: s32) -> string {
    digits: [24]u8
    return Cat(FormatInteger(cast(s64)value, digits[:]))
}

// Runs a command and reports whether it succeeded.
Run :: (arguments: []string) -> bool {
    result := CaptureOutput(arguments, output[:])
    if result.error || result.truncated || result.code != 0 {
        Report(Cat("art: failed: ", arguments[0], " ", arguments[arguments.count - 1], "\n"))
        return false
    }
    return true
}

// The palette as a 16 by 1 picture for ImageMagick's -remap.
Palette :: () -> bool {
    text: Vec(u8)
    BuilderPrint(*text, "P3\n16 1\n255\n")
    for color: PALETTE { BuilderPrint(*text, "%\n", color) }
    return WriteEntireFile("build/art/palette.ppm", BuilderFinish(text))
}

// An SVG drawing as a small sprite: palette colors only and fully clear or
// fully solid pixels, so it scales up as hard squares.
Sprite :: (source: string, target: string, width: s32, height: s32) -> bool {
    raw := "build/art/sprite-raw.png"
    colors := "build/art/sprite-colors.png"
    mask := "build/art/sprite-mask.png"
    draw: [6]string = .["inkscape", "--export-type=png", Cat("--export-filename=", raw),
    Cat("--export-width=", Number(width)), Cat("--export-height=", Number(height)), source]
    flatten: [13]string = .["convert", raw, "-background", "white", "-alpha", "remove", "-alpha", "off",
    "-dither", "None", "-remap", "build/art/palette.ppm", colors]
    cut: [7]string = .["convert", raw, "-alpha", "extract", "-threshold", "50%", mask]
    // No dates or other metadata, so drawing the same art writes the same file.
    join: [12]string = .["convert", colors, mask, "-alpha", "off", "-compose", "CopyOpacity", "-composite",
    "-strip", "-define", "png:exclude-chunks=date,time", Cat("PNG32:", target)]
    return Run(draw[:]) && Run(flatten[:]) && Run(cut[:]) && Run(join[:])
}

// The printable ASCII letters of GNU Unifont, 16 to a row, white on clear.
Font :: () -> bool {
    text: Vec(u8)
    BuilderPrint(*text, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"128\" height=\"96\" viewBox=\"0 0 128 96\">")
    BuilderPrint(*text, "<g font-family=\"Unifont\" font-size=\"16\" fill=\"#ffffff\">")
    for code: cast(s32)32..126 {
        at := code - 32
        BuilderPrint(*text, "<text x=\"%\" y=\"%\" xml:space=\"preserve\">", (at % 16) * 8, (at / 16) * 16 + 14)
        if code == 38 { BuilderPrint(*text, "&amp;") }
        else if code == 60 { BuilderPrint(*text, "&lt;") }
        else if code == 62 { BuilderPrint(*text, "&gt;") }
        else {
            letter: [1]u8
            letter[0] = cast(u8)code
            BuilderPrint(*text, "%", TextView(letter[:]))
        }
        BuilderPrint(*text, "</text>")
    }
    BuilderPrint(*text, "</g></svg>\n")
    if !WriteEntireFile("build/art/font.svg", BuilderFinish(text)) { return false }
    draw: [6]string = .["inkscape", "--export-type=png", "--export-filename=build/art/font-raw.png",
    "--export-png-antialias=0", "--export-width=128", "build/art/font.svg"]
    clean: [11]string = .["convert", "build/art/font-raw.png", "-channel", "A", "-threshold", "50%", "+channel",
    "-strip", "-define", "png:exclude-chunks=date,time", "PNG32:build/art/font.png"]
    return Run(draw[:]) && Run(clean[:])
}

CopyFile :: (source: string, target: string) -> bool {
    bytes, found := ReadEntireFile(source)
    return found && WriteEntireFile(target, bytes)
}

HEX :: "0123456789abcdef"

// One page's black lines, one bit per pixel, as hex: a PBM file's rows.
PageLines :: (name: string) -> string {
    source := Cat("art/dinos/", name, ".svg")
    raw := "build/art/page-raw.png"
    bits := "build/art/page.pbm"
    draw: [8]string = .["inkscape", "--export-type=png", Cat("--export-filename=", raw),
    Cat("--export-width=", Number(PAGE_WIDTH)), Cat("--export-height=", Number(PAGE_HEIGHT)),
    "--export-background=white", "--export-background-opacity=1", source]
    // Anything darker than light gray is a line, so lines stay closed.
    flat: [7]string = .["convert", raw, "-colorspace", "Gray", "-threshold", "75%", Cat("pbm:", bits)]
    if !Run(draw[:]) || !Run(flat[:]) { return "" }
    data, found := ReadEntireFile(bits)
    if !found { return "" }
    // "P4", the size and the maximum, each ended by whitespace.
    at: s64 = 0
    fields: s32 = 0
    while at < data.count && fields < 3 {
        while at < data.count && (data[at] == cast(u8)10 || data[at] == cast(u8)32) { at += 1 }
        while at < data.count && data[at] != cast(u8)10 && data[at] != cast(u8)32 { at += 1 }
        fields += 1
    }
    at += 1
    size := cast(s64)(PAGE_WIDTH / 8 * PAGE_HEIGHT)
    if data.count - at != size || data[:2] != "P4" {
        Report(Cat("art: unexpected line picture for ", name, "\n"))
        return ""
    }
    // One line of hex per row of pixels.
    hex: Vec(u8)
    for index: at..data.count - 1 {
        byte := data[index]
        pair: [2]u8
        pair[0] = HEX[cast(s64)(byte >> 4)]
        pair[1] = HEX[cast(s64)(byte & cast(u8)15)]
        BuilderPrint(*hex, "%", TextView(pair[:]))
        if (index - at + 1) % cast(s64)(PAGE_WIDTH / 8) == 0 { BuilderPrint(*hex, "\n") }
    }
    return BuilderFinish(hex)
}

Pages :: () -> bool {
    code: Vec(u8)
    BuilderPrint(*code, "// Generated by tools/art.zi from art/dinos/*.svg; do not edit.\n")
    BuilderPrint(*code, "// Each page's lines, % by %, one bit per pixel (1 is black), as hex, a row a line,\n", PAGE_WIDTH, PAGE_HEIGHT)
    BuilderPrint(*code, "// in % parts so each text stays under Ziran's 4095-character limit.\n\n", PAGE_PARTS)
    BuilderPrint(*code, "PAGE_COUNT :: %\nPAGE_PARTS :: %\n\n", PAGES.count, PAGE_PARTS)
    // One part's rows of hex, each row ending in a line break.
    part_length := cast(s64)(PAGE_HEIGHT / PAGE_PARTS * (PAGE_WIDTH / 4 + 1))
    for index: cast(s32)0..cast(s32)PAGES.count - 1 {
        lines := PageLines(PAGES[index])
        if lines.count != part_length * cast(s64)PAGE_PARTS { return false }
        for part: cast(s32)0..PAGE_PARTS - 1 {
            start := part_length * cast(s64)part
            BuilderPrint(*code, "PAGE_LINES_%_% :: #string END\n%END;\n\n", index, part, lines[start:start + part_length])
        }
    }
    BuilderPrint(*code, "PageLines :: (page: s32, part: s32) -> string {\n")
    for index: cast(s32)0..cast(s32)PAGES.count - 1 {
        for part: cast(s32)0..PAGE_PARTS - 1 {
            BuilderPrint(*code, "    if page == % && part == % { return PAGE_LINES_%_% }\n", index, part, index, part)
        }
    }
    BuilderPrint(*code, "    return \"\"\n}\n")
    return WriteEntireFile("games/paint/paint_pages.zi", BuilderFinish(code))
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    folders: [9]string = .["build", "build/art", "assets", "assets/jungle", "assets/jungle-math",
    "assets/jungle-math/items", "assets/dino-paint", "assets/jungle/sounds", "assets/jungle-math/sounds"]
    for folder: folders { unused CreateDirectory(folder) }
    unused CreateDirectory("assets/dino-paint/sounds")
    ok := Palette() && Font()
    fonts: [3]string = .["assets/jungle/font.png", "assets/jungle-math/font.png", "assets/dino-paint/font.png"]
    for target: fonts { ok = ok && CopyFile("build/art/font.png", target) }
    for name: ITEMS {
        ok = ok && Sprite(Cat("art/items/", name, ".svg"), Cat("assets/jungle-math/items/", name, "-32.png"), 32, 32)
        ok = ok && Sprite(Cat("art/items/", name, ".svg"), Cat("assets/jungle-math/items/", name, "-24.png"), 24, 24)
        ok = ok && Sprite(Cat("art/items/", name, ".svg"), Cat("assets/jungle-math/items/", name, "-16.png"), 16, 16)
    }
    ok = ok && Sprite("art/scenes/stone.svg", "assets/jungle-math/stone.png", 40, 30)
    ok = ok && Sprite("art/items/frog.svg", "assets/jungle/math.png", 32, 32)
    ok = ok && Sprite("art/icons/dino.svg", "assets/jungle/paint.png", 32, 32)
    ok = ok && Sprite("art/icon.svg", "assets/jungle/icon.png", 64, 64)
    ok = ok && Pages()
    if !ok { return 1 }
    Report("art: pixel art written to assets/ and games/paint/paint_pages.zi\n")
    return 0
}

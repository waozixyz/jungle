// Makes Jungle's pixel art from the SVG drawings in art/, with Inkscape and
// ImageMagick. Run from the repository root after changing any drawing:
//
//     make art
//
// Sprites are drawn small and cut down to the sixteen colors of an old PC
// color card, with hard edges. Letters come from GNU Unifont, 8 by 16.
// Dino Colors' scenes and dinosaurs come from the original Bert's Dinosaurs
// artwork, so they live in assets/dino-paint/art and games/paint is not
// rewritten by this tool.
#import "c_string"
#import "byte_text_linux"
#import "file"
#import "number_text"
#import "text_buffer"
#import "process_capture_linux"
#import, file "../host/canvas_png.zi";
#import, file "../games/paint/paint_palette.zi";

libc :: #system_library "libc";
WriteError :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";

// The sixteen colors, as in retro/retro.zi.
PALETTE: [16]string = .["0 0 0", "0 0 170", "0 170 0", "0 170 170", "170 0 0", "170 0 170", "170 85 0",
"170 170 170", "85 85 85", "85 85 255", "85 255 85", "85 255 255", "255 85 85", "255 85 255",
"255 255 85", "255 255 255"];

output: [65536]u8;

Report :: (message: string) {
    bytes: [1024]u8
    if CopyCString(message, bytes[:]) { unused WriteError(2, *bytes[0], cast(usize)message.count) }
}

Cat :: (a: string, b: string = "", c: string = "", d: string = "", e: string = "", f: string = "", g: string = "",
    h: string = "", i: string = "") -> string {
    text: Vec(u8)
    parts: [9]string = .[a, b, c, d, e, f, g, h, i]
    for part: parts { BuilderPrint(*text, "%", part) }
    return BuilderFinish(text)
}

Number :: (value: s32) -> string {
    digits: [24]u8
    return Cat(FormatInteger(cast(s64)value, digits[:]))
}

// Runs a command and reports whether it succeeded.
Run :: (arguments: []string) -> bool {
    result := CaptureOutput(arguments, output[:])
    if result.error || result.truncated || result.code != 0 {
        Report(Cat("art: failed: ", arguments[0], " ", arguments[arguments.count - 1], "\n"))
        return false
    }
    return true
}

// The palette as a 16 by 1 picture for ImageMagick's -remap.
Palette :: () -> bool {
    text: Vec(u8)
    BuilderPrint(*text, "P3\n16 1\n255\n")
    for color: PALETTE { BuilderPrint(*text, "%\n", color) }
    return WriteEntireFile("build/art/palette.ppm", BuilderFinish(text))
}

// An SVG drawing as a small sprite: palette colors only and fully clear or
// fully solid pixels, so it scales up as hard squares.
Sprite :: (source: string, target: string, width: s32, height: s32) -> bool {
    raw := "build/art/sprite-raw.png"
    colors := "build/art/sprite-colors.png"
    mask := "build/art/sprite-mask.png"
    draw: [7]string = .["inkscape", "--export-type=png", Cat("--export-filename=", raw),
    Cat("--export-width=", Number(width)), Cat("--export-height=", Number(height)),
    "--export-png-antialias=0", source]
    flatten: [13]string = .["convert", raw, "-background", "white", "-alpha", "remove", "-alpha", "off",
    "-dither", "None", "-remap", "build/art/palette.ppm", colors]
    cut: [7]string = .["convert", raw, "-alpha", "extract", "-threshold", "50%", mask]
    // No dates or other metadata, so drawing the same art writes the same file.
    join: [12]string = .["convert", colors, mask, "-alpha", "off", "-compose", "CopyOpacity", "-composite",
    "-strip", "-define", "png:exclude-chunks=date,time", Cat("PNG32:", target)]
    return Run(draw[:]) && Run(flatten[:]) && Run(cut[:]) && Run(join[:])
}

// The ASCII and Latin-1 letters of GNU Unifont, 16 to a row, white on clear.
Font :: () -> bool {
    text: Vec(u8)
    BuilderPrint(*text, "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"128\" height=\"224\" viewBox=\"0 0 128 224\">")
    BuilderPrint(*text, "<g font-family=\"Unifont\" font-size=\"16\" fill=\"#ffffff\">")
    for code: cast(s32)32..255 {
        at := code - 32
        BuilderPrint(*text, "<text x=\"%\" y=\"%\" xml:space=\"preserve\">", (at % 16) * 8, (at / 16) * 16 + 14)
        if code < 127 || code >= 160 { BuilderPrint(*text, "&#%;", code) }
        BuilderPrint(*text, "</text>")
    }
    BuilderPrint(*text, "</g></svg>\n")
    if !WriteEntireFile("build/art/font.svg", BuilderFinish(text)) { return false }
    draw: [6]string = .["inkscape", "--export-type=png", "--export-filename=build/art/font-raw.png",
    "--export-png-antialias=0", "--export-width=128", "build/art/font.svg"]
    clean: [11]string = .["convert", "build/art/font-raw.png", "-channel", "A", "-threshold", "50%", "+channel",
    "-strip", "-define", "png:exclude-chunks=date,time", "PNG32:build/art/font.png"]
    return Run(draw[:]) && Run(clean[:])
}

CopyFile :: (source: string, target: string) -> bool {
    bytes, found := ReadEntireFile(source)
    return found && WriteEntireFile(target, bytes)
}

// The original crayon colors and checkerboard fills, also used by exports.
Crayons :: () -> bool {
    unused CreateDirectory("assets/dino-paint/crayons")
    pixels: [44 * 20]u8
    for crayon: cast(s32)0..29 {
        for y: cast(s32)0..19 {
            for x: cast(s32)0..43 { pixels[y * 44 + x] = cast(u8)PaintDisplayIndex(16 + crayon, x, y) }
        }
        picture := PngIndexed(44, 20, paint_colors[:], pixels[:])
        if picture == "" || !WriteEntireFile(Cat("assets/dino-paint/crayons/", Number(crayon + 1), ".png"), picture) { return false }
    }
    return true
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    folders: [7]string = .["build", "build/art", "assets", "assets/jungle", "assets/dino-paint",
        "assets/jungle-book", "assets/jungle-book/items"]
    for folder: folders { unused CreateDirectory(folder) }
    ok := Palette() && Font()
    fonts: [4]string = .["assets/animal-count/latin.png", "assets/jungle/font.png", "assets/dino-paint/font.png", "assets/jungle-book/font.png"]
    for target: fonts { ok = ok && CopyFile("build/art/font.png", target) }
    ok = ok && Crayons()
    ok = ok && Sprite("art/items/frog.svg", "assets/jungle/math.png", 32, 32)
    ok = ok && Sprite("art/icons/dino.svg", "assets/jungle/paint.png", 32, 32)
    ok = ok && Sprite("art/icon.svg", "assets/jungle/icon.png", 64, 64)
    if !ok { return 1 }
    Report("art: menu, fonts and VGA crayons written to assets/\n")
    return 0
}

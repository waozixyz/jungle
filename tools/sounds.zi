// Makes Jungle's sound effects as 16-bit mono WAV files, in the square-wave
// beeps of an old PC speaker, kept soft for small ears:
//
//     make sounds
#import "c_string"
#import "file"
#import "text_buffer"
#import "number_text"
#import, file "animal_score.zi";

RATE :: 22050
LIMIT :: 500000

samples: [LIMIT]float64;
length: s32;
bytes: [44 + 2 * LIMIT]u8;
cursor: float64;

Clear :: () {
    length = 0
    cursor = 0.0
}

// A square-wave note, or a slide from one pitch to another, after the
// notes before it. A short ramp at each end keeps it from clicking.
Note :: (from: float64, to: float64, seconds: float64, loudness: float64 = 0.18) {
    first := cast(s32)(cursor * cast(float64)RATE)
    count := cast(s32)(seconds * cast(float64)RATE)
    phase: float64 = 0.0
    for step: cast(s32)0..count - 1 {
        at := first + step
        if at >= LIMIT { break }
        share := cast(float64)step / cast(float64)count
        frequency := from + (to - from) * share
        phase += frequency / cast(float64)RATE
        phase -= cast(float64)cast(s32)phase
        edge := 1.0
        ramp := cast(float64)RATE * 0.004
        if cast(float64)step < ramp { edge = cast(float64)step / ramp }
        if cast(float64)(count - step) < ramp { edge = cast(float64)(count - step) / ramp }
        value := ifx phase < 0.5 then loudness else -loudness
        if frequency <= 0.0 { value = 0.0 }
        samples[at] = value * edge
        if at + 1 > length { length = at + 1 }
    }
    cursor += seconds
}

Rest :: (seconds: float64) { Note(0.0, 0.0, seconds) }

Play :: (pitch: s32, seconds: float64) { Note(cast(float64)pitch, cast(float64)pitch, seconds); Rest(0.02) }

Put32 :: (at: s32, value: s32) {
    bytes[at] = cast(u8)(value & 255)
    bytes[at + 1] = cast(u8)((value >> 8) & 255)
    bytes[at + 2] = cast(u8)((value >> 16) & 255)
    bytes[at + 3] = cast(u8)((value >> 24) & 255)
}

Put16 :: (at: s32, value: s32) {
    bytes[at] = cast(u8)(value & 255)
    bytes[at + 1] = cast(u8)((value >> 8) & 255)
}

Save :: (name: string) -> bool {
    data := length * 2
    text := "RIFF....WAVEfmt "
    for at: cast(s32)0..15 { bytes[at] = text[at] }
    Put32(4, 36 + data)
    Put32(16, 16)
    Put16(20, 1)
    Put16(22, 1)
    Put32(24, RATE)
    Put32(28, RATE * 2)
    Put16(32, 2)
    Put16(34, 16)
    chunk := "data"
    for at: cast(s32)0..3 { bytes[36 + at] = chunk[at] }
    Put32(40, data)
    for at: cast(s32)0..length - 1 { Put16(44 + 2 * at, cast(s32)(samples[at] * 30000.0)) }
    return WriteEntireFile(name, TextView(bytes[:44 + data]))
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    unused argc
    unused argv
    folders: [7]string = .["assets", "assets/jungle", "assets/jungle/sounds", "assets/animal-count", "assets/animal-count/sounds",
    "assets/dino-paint", "assets/dino-paint/sounds"]
    for folder: folders { unused CreateDirectory(folder) }
    ok := true
    // The menu: a blip to move, a run up to start a game.
    Clear(); Note(880.0, 880.0, 0.03)
    ok = Save("assets/jungle/sounds/select.wav") && ok
    Clear(); Note(523.25, 523.25, 0.06); Note(659.25, 659.25, 0.06); Note(783.99, 783.99, 0.06); Note(1046.5, 1046.5, 0.12)
    ok = Save("assets/jungle/sounds/start.wav") && ok
    // Animal Counting.
    Clear(); Note(1318.5, 1318.5, 0.02, 0.12)
    ok = Save("assets/animal-count/sounds/key.wav") && ok
    // ANIMALS.PAS: the eight four-note flourishes and 50..70 Hz miss sweep.
    notes: [32]s32 = .[523,659,784,1046,440,523,659,880,392,494,587,784,
        494,587,740,988,330,392,494,659,294,350,440,587,350,440,523,698,523,659,784,1046]
    for tune: cast(s32)0..7 {
        Clear()
        for note: cast(s32)0..3 { Play(notes[tune * 4 + note], ifx note == 3 then 0.3 else 0.05) }
        digits: [24]u8
        name: Vec(u8)
        BuilderPrint(*name, "assets/animal-count/sounds/right-%.wav", FormatInteger(cast(s64)tune, digits[:]))
        ok = Save(BuilderFinish(name)) && ok
    }
    Clear()
    for pitch: cast(s32)50..70 { Note(cast(float64)pitch, cast(float64)pitch, 0.01, 0.14) }
    ok = Save("assets/animal-count/sounds/miss.wav") && ok
    Clear(); Note(392.0, 392.0, 0.05); Note(523.25, 523.25, 0.05); Note(659.25, 659.25, 0.1)
    ok = Save("assets/animal-count/sounds/start.wav") && ok
    // The Animal Fair reward, with the original note lengths and pauses.
    Clear()
    Play(523, 0.05); Play(659, 0.05); Play(784, 0.05); Play(1046, 0.3); Rest(0.5)
    for index: cast(s32)0..cast(s32)REWARD_NOTES.count - 1 {
        pitch := cast(float64)REWARD_NOTES[index]
        Note(pitch, pitch, REWARD_SECONDS[index])
    }
    ok = Save("assets/animal-count/sounds/reward.wav") && ok
    // Dino Paint.
    Clear(); Note(1046.5, 1046.5, 0.02, 0.12)
    ok = Save("assets/dino-paint/sounds/click.wav") && ok
    Clear(); Note(300.0, 1200.0, 0.14)
    ok = Save("assets/dino-paint/sounds/fill.wav") && ok
    Clear(); Note(700.0, 760.0, 0.04, 0.1)
    ok = Save("assets/dino-paint/sounds/brush.wav") && ok
    Clear(); Note(1200.0, 300.0, 0.2)
    ok = Save("assets/dino-paint/sounds/clear.wav") && ok
    Clear(); Note(660.0, 440.0, 0.08)
    ok = Save("assets/dino-paint/sounds/undo.wav") && ok
    Clear(); Note(440.0, 440.0, 0.05); Note(660.0, 660.0, 0.08)
    ok = Save("assets/dino-paint/sounds/open.wav") && ok
    return ifx ok then 0 else 1
}

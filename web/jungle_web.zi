// Painted navigation consumes titles; full descriptions, ages and icons remain
// in games/catalog.txt for native catalog loading.
web_games: [14]MenuGame = .[
    MenuGame.{.title = "Picture Book"},
    MenuGame.{.title = "ABC Book"},
    MenuGame.{.title = "123 Book"},
    MenuGame.{.title = "Animal Counting"},
    MenuGame.{.title = "Coloring Book"},
    MenuGame.{.title = "Jigsaw Puzzles"},
    MenuGame.{.title = "Little Piano"},
    MenuGame.{.title = "Shapes & Sorting"},
    MenuGame.{.title = "Matching Pairs"},
    MenuGame.{.title = "Hide & Seek"},
    MenuGame.{.title = "Music Room"},
    MenuGame.{.title = "Farm"},
    MenuGame.{.title = "Little Fishing Boat"},
    MenuGame.{.title = "Crab Family Counting"},
];
active_game: s32 = -1;
web_loading_game: s32 = -1;
selected: s32;
web_initialized: bool;
web_muted: bool;
web_home: bool;
// The title scene a game's way out leads to ("scene:market"), as on the desktop, or -1.
web_scene_from_game: s32 = -1;
// Farm view reports are independent of the full-window content policy.
web_farm_entrance: bool = true;
// The title bar's back arrow reaches the game as Escape on the next frame.
web_back_pending: bool;
web_speed_pending: bool;
web_voice_paused: bool;
web_audio: s32;
web_title_guide: bool;
web_title_guide_muted: bool;
web_title_guide_seen: bool;
web_narration: bool;
audio_rejected: s32;
canvas_sequence: s32;
export_pixels: [CANVAS_PIXELS]u8;

GamePrefix :: () -> string {
    if active_game == 13 { return "jungle.beach_families/" }
    if active_game == 12 { return "jungle.fishing/" }
    if active_game == 11 { return "jungle.garden/" }
    if active_game == 10 { return "jungle.drums/" }
    if active_game == 9 { return "jungle.hide_seek/" }
    if active_game == 8 { return "jungle.matching/" }
    if active_game == 7 { return "jungle.shapes/" }
    if active_game == 6 { return "jungle.piano/" }
    if active_game == 5 { return "jungle.jigsaw/" }
    if active_game == 0 { return "jungle.book/" }
    if active_game == 1 { return "jungle.abc/" }
    if active_game == 2 { return "jungle.numbers/" }
    if active_game == 3 { return "jungle.animals/" }
    return "jungle.paint/"
}

RunGame :: () -> s32 {
    if active_game == 13 { return BeachFamilies.GameMain() }
    if active_game == 12 { return Fishing.GameMain() }
    if active_game == 11 { return Garden.GameMain() }
    if active_game == 10 { return Drums.GameMain() }
    if active_game == 9 { return HideSeek.GameMain() }
    if active_game == 8 { return Matching.GameMain() }
    if active_game == 7 { return Shapes.GameMain() }
    if active_game == 0 { return Book.GameMain() }
    if active_game == 1 { return ABC.GameMain() }
    if active_game == 2 { return Numbers.GameMain() }
    if active_game == 3 { return Counting.GameMain() }
    if active_game == 4 { return Paint.GameMain() }
    if active_game == 5 { return Jigsaw.GameMain() }
    if active_game == 6 { return Piano.GameMain() }
    return 0
}

#program_export
WebIdentity :: (id: string, minimum_api: s32) {
    if active_game < 0 { Runner.AppIdentityHost(id, minimum_api) }
}

#program_export
WebRead :: (name: string) -> string {
    return Runner.DocumentReadHost(Cat(GamePrefix(), name))
}

#program_export
WebWrite :: (name: string, value: string) -> bool {
    return Runner.DocumentWriteHost(Cat(GamePrefix(), name), value)
}

#program_export
WebAsset :: (name: string) -> string {
    if name.count > 7 && name[:7] == "canvas-" { return Cat("/", name) }
    return name
}

#program_export
WebKeyboard :: (visible: bool) {
    scope := WebScope()
    defer WebEnd(scope)
    WebSet(WebModule, WebName("jungleKeyboardWanted"), WebBool(visible))
    document := WebGetObject(WebGlobal, WebName("document"))
    input := WebAsObject(WebCall1(document, WebName("getElementById"), WebText("mobile-input")))
    if input != 0 {
        WebSet(input, WebName("disabled"), WebBool(!visible))
        unused WebCall2(input, WebName("setAttribute"), WebText("aria-label"), WebText(Tr("Write your story")))
        if !visible { unused WebCall0(input, WebName("blur")) }
    }
}

StopAudio :: () {
    if web_audio == 0 { return }
    scope := WebScope()
    defer WebEnd(scope)
    unused WebCall0(web_audio, WebName("pause"))
    unused WebCall1(web_audio, WebName("removeAttribute"), WebText("src"))
    unused WebCall0(web_audio, WebName("load"))
    WebRelease(web_audio)
    web_audio = 0
    web_narration = false
    web_voice_paused = false
}

AudioRejected :: (context: s32, error: s32, second: s32, third: s32) {
    unused context; unused error; unused second; unused third
}

// HTML media loads asynchronously. Never await a network request inside a
// Canvas frame: input received during that wait would be cleared at frame end.
PlayAudio :: (path: string, narration: bool) {
    StopAudio()
    if web_muted || path == "" { return }
    scope := WebScope()
    defer WebEnd(scope)
    audio := WebAsObject(WebCall2(WebModule, WebName("jungleAudio"), WebText(path), WebText(ifx narration then english_speech_profile else "normal")))
    if audio == 0 { return }
    web_audio = WebKeep(audio)
    web_narration = narration
    WebSet(web_audio, WebName("volume"), WebNumber(ifx narration then 0.45 else cast(float64)AudioEffectGain(path) / 100.0))
    promise := WebAsObject(WebCall0(web_audio, WebName("play")))
    if audio_rejected == 0 { audio_rejected = WebFunction(AudioRejected, 0) }
    if promise != 0 { unused WebCall1(promise, WebName("catch"), WebObject(audio_rejected)) }
}

VoiceState :: () -> string {
    if web_audio == 0 || !web_narration || web_muted { return "idle" }
    if web_voice_paused { return "paused" }
    scope := WebScope()
    defer WebEnd(scope)
    if WebGetObject(web_audio, WebName("error")) != 0 { return "idle" }
    if WebAsBool(WebGet(web_audio, WebName("jungleLoading"))) { return "loading" }
    if WebAsBool(WebGet(web_audio, WebName("ended"))) { return "ended" }
    if WebAsBool(WebGet(web_audio, WebName("paused"))) { return "idle" }
    if WebGetNumber(web_audio, WebName("readyState")) < 3.0 { return "loading" }
    return "playing"
}

ToggleAudio :: () {
    web_muted = !web_muted
    StopAudio()
    unused Runner.DocumentWriteHost("settings/sound.txt", ifx web_muted then "off" else "quiet")
}

// The outlines are embedded in the program, so reading one never waits.
PaintViewWebRead :: (path: string) -> string {
    data, found := ReadEntireFile(Cat("/", path))
    return ifx found then data else ""
}

canvas_ink_sequences: [2]s32;
CanvasInk :: (request: string, kind: s32) -> string {
    data := PaintViewInkPng(request, PaintViewWebRead)
    if data == "" { return "" }
    prefix := ifx kind == 0 then "canvas-ink-" else "canvas-tile-"
    canvas_ink_sequences[kind] += 1
    name := Cat(prefix, NumberText(canvas_ink_sequences[kind]), ".png")
    if !WriteEntireFile(Cat("/", name), data) { return "" }
    if canvas_ink_sequences[kind] > 4 { unused RemoveFile(Cat("/", prefix, NumberText(canvas_ink_sequences[kind] - 4), ".png")) }
    return name
}

CanvasColors :: (request: string) -> string {
    page: PaintPage
    if PictureFromGame(request, export_pixels[:], *page) != request.count { return "" }
    data := PaintViewColorsPng(export_pixels[:], page)
    if data == "" { return "" }
    canvas_sequence += 1
    name := Cat("canvas-", NumberText(canvas_sequence), ".png")
    if !WriteEntireFile(Cat("/", name), data) { return "" }
    if canvas_sequence > 24 { unused RemoveFile(Cat("/canvas-", NumberText(canvas_sequence - 24), ".png")) }
    return name
}

// The last built WebService reply, refilled in place: the page copies a reply
// before it calls again, so replies built each call never pile up.
web_reply: Text;
WebReply :: (text: string) -> string {
    VecClear(web_reply.bytes)
    BuilderAppend(web_reply.bytes, text)
    return TextView(web_reply)
}

// "<count> <x0> <y0> <x1> <y1> <wheel> <density>" in thousandths.
WebPaintTouches :: () -> Text {
    count := GetTouchPointCount()
    a := ifx count > 0 then GetTouchPosition(0) else Vector2.{}
    b := ifx count > 1 then GetTouchPosition(1) else Vector2.{}
    text: Vec(u8)
    BuilderPrint(*text, "% % % % % % 1000", count, cast(s64)(a.x * 1000.0), cast(s64)(a.y * 1000.0),
        cast(s64)(b.x * 1000.0), cast(s64)(b.y * 1000.0), cast(s64)(GetMouseWheelMove() * 1000.0))
    return BuilderFinish(text)
}

CanvasImage :: (request: string, preview: bool = false) -> string {
    data: string
    if preview { data = PaintPreviewPng(request) }
    else {
        page: PaintPage
        if PictureFromGame(request, export_pixels[:], *page) != request.count { return "" }
        data = PngIndexed(page.width, page.height, paint_colors[:], export_pixels[:])
    }
    if data == "" { return "" }
    canvas_sequence += 1
    name := Cat("canvas-", NumberText(canvas_sequence), ".png")
    if !WriteEntireFile(Cat("/", name), data) { return "" }
    if canvas_sequence > 24 { unused RemoveFile(Cat("/canvas-", NumberText(canvas_sequence - 24), ".png")) }
    return name
}

WebExport :: (request: string, printing: bool) -> string {
    page: PaintPage
    length := PictureFromGame(request, export_pixels[:], *page)
    if length < 0 { return "failed" }
    png := PngIndexed(page.width, page.height, paint_colors[:], export_pixels[:])
    story := request[length:]
    if printing { return WebPrint(png, story) }
    if !ExportBytes(png, "jungle-picture.png", "image/png", "Jungle Academy") { return "failed" }
    unused ExportBytes(story, "jungle-story.txt", "text/plain;charset=utf-8", "Jungle Academy")
    return "exported"
}

print_ready: s32;
print_url: WebValue;
PrintLoaded :: (context: s32, event: s32, second: s32, third: s32) {
    unused WebCall0(WebGlobal, WebName("print"))
}

WebPrint :: (png: string, story: string) -> string {
    scope := WebScope()
    defer WebEnd(scope)
    descriptor := cast(*TextDescriptor)(*png)
    bytes := WebBytes(WebBytesUint8, cast(*void)descriptor.data, cast(s32)png.count)
    parts := WebNewArray()
    unused WebCall1(parts, WebName("push"), WebObject(bytes))
    options := WebNewObject()
    WebSet(options, WebName("type"), WebText("image/png"))
    blob := WebNew2(WebGetObject(WebGlobal, WebName("Blob")), WebObject(parts), WebObject(options))
    url_class := WebGetObject(WebGlobal, WebName("URL"))
    document := WebGetObject(WebGlobal, WebName("document"))
    image := WebAsObject(WebCall1(document, WebName("getElementById"), WebText("print-picture")))
    text := WebAsObject(WebCall1(document, WebName("getElementById"), WebText("print-story")))
    if image == 0 || text == 0 || blob == 0 { return "failed" }
    if print_ready == 0 { print_ready = WebFunction(PrintLoaded, 0) }
    WebSet(text, WebName("textContent"), WebText(story))
    WebSet(image, WebName("onload"), WebObject(print_ready))
    WebSet(image, WebName("src"), WebCall1(url_class, WebName("createObjectURL"), WebObject(blob)))
    return ifx WebFailed() then "failed" else "printed"
}

web_piano_held: [22]u8;
// The collected stencils, in the settings/collection.txt document; see CollectionService.
web_collection: Collection;

// A title scene's paper: true only the first time its line art is collected.
WebTitlePaperCollect :: (slug: string) -> bool { return WebCollectionService("jungle.collect", slug) == "new" }

// The awards, in the settings/awards.txt document; see host/jungle_awards.zi.
WebExplorationSave :: () {
    if !title_exploration.dirty || !title_exploration.valid { return }
    if Runner.DocumentWriteHost("settings/explored.txt", ExplorationText(*title_exploration)) {
        if Runner.DocumentFlushHost() { title_exploration.dirty = false }
    }
}

// The toucan's gifts, in the settings/treasure.txt document; see host/jungle_treasure.zi.
WebTreasureSave :: () {
    if toucan_treasure.valid {
        if Runner.DocumentWriteHost("settings/treasure.txt", TreasureText(*toucan_treasure)) { unused Runner.DocumentFlushHost() }
    }
}

WebAwardsSave :: () {
    if awards_earned.valid { unused Runner.DocumentWriteHost("settings/awards.txt", AwardsText(*awards_earned)) }
}

WebCollectionService :: (service: string, request: string) -> string {
    reply, changed := CollectionService(*web_collection, service, request)
    if changed { WebCollectionSave() }
    return reply
}

// Apart from the service, which changes the collection, so the text is freed once written.
WebCollectionSave :: () {
    unused Runner.DocumentWriteHost("settings/collection.txt", CollectionText(web_collection.slugs))
}

#program_export
WebService :: (name: string, request: string) -> string {
    if name == "jungle.piano-held" {
        for at: cast(s32)0..PianoKeys.PIANO_SHORTCUTS - 1 {
            web_piano_held[at] = ifx IsKeyDown(PianoKeys.PianoShortcutCode(at)) then cast(u8)49 else cast(u8)48
        }
        web_piano_held[PianoKeys.PIANO_SHORTCUTS] = 0
        return TextFromBytes(web_piano_held[:PianoKeys.PIANO_SHORTCUTS])
    }
    // A drawn picture downloads ahead of prefetched ones (index.html).
    if name == "jungle.image" || name == "jungle.image-prefetch" {
        scope := WebScope()
        defer WebEnd(scope)
        if !WebAsBool(WebCall2(WebModule, WebName("jungleImageReady"), WebText(request),
            WebBool(name == "jungle.image-prefetch"))) { return "pending" }
        return ifx Raster.ImageWidth(request) > 0 then "ready" else "pending"
    }
    // The path to draw for a picture now: its full picture once decoded,
    // meanwhile its few-KB preview, or "" while neither is ready. A preview
    // has its own path (index.html previewFile), so Canvas textures and DOM
    // image URLs, cached by path, switch to the full bytes exactly once.
    if name == "jungle.image-shown" {
        scope := WebScope()
        defer WebEnd(scope)
        if WebAsBool(WebCall1(WebModule, WebName("jungleImageReady"), WebText(request))) &&
            Raster.ImageWidth(request) > 0 { return request }
        if request.count > 7 && request[:7] == "assets/" &&
            WebAsBool(WebCall1(WebModule, WebName("junglePreviewReady"), WebText(request))) {
            preview := Cat("assets/previews/", request[7:])
            if Raster.ImageWidth(preview) > 0 { return preview }
        }
        return ""
    }
    if name == "jungle.voice-frames" {
        scope := WebScope()
        defer WebEnd(scope)
        return WebReply(NumberText(cast(s32)WebAsNumber(WebCall2(WebModule, WebName("jungleVoiceFrames"), WebText(request), WebText(english_speech_profile)))))
    }
    if name == "jungle.speech-profile" {
        if request != "" {
            SpeechProfileSet(request)
            unused Runner.DocumentWriteHost("settings/speech-profile.txt", english_speech_profile)
        }
        return english_speech_profile
    }
    if name == "jungle.voice-state" { return VoiceState() }
    if name == "jungle.voice-control" {
        if web_audio != 0 && web_narration {
            web_voice_paused = request == "pause"
            scope := WebScope()
            defer WebEnd(scope)
            if request == "pause" { unused WebCall0(web_audio, WebName("pause")) }
            else {
                promise := WebAsObject(WebCall0(web_audio, WebName("play")))
                if audio_rejected == 0 { audio_rejected = WebFunction(AudioRejected, 0) }
                if promise != 0 { unused WebCall1(promise, WebName("catch"), WebObject(audio_rejected)) }
            }
        }
        return "ok"
    }
    if name == "jungle.collection" { return WebReply(CollectionMask(web_collection.slugs)) }
    if name == "jungle.collect" { return WebCollectionService(name, request) }
    if name == "jungle.treasure" { return WebReply(TreasureMask(toucan_treasure.items)) }
    if name == "jungle.book-start" { return title_book_requested }
    // Picture Book's open book downloads alone, then the next one in the
    // background (index.html jungleBookOpen); "back" once its download was left.
    if name == "jungle.book-open" {
        scope := WebScope()
        defer WebEnd(scope)
        return ifx WebAsBool(WebCall2(WebModule, WebName("jungleBookOpen"), WebNumber(cast(float64)active_game), WebText(request))) then "back" else "ok"
    }
    if name == "jungle.language" { return LanguageCode() }
    if name == "jungle.home" {
        if request.count > 6 && request[:6] == "scene:" { web_scene_from_game = TitleSceneNamed(request[6:]) }
        web_home = true
        return "ok"
    }
    if name == "jungle.farm-view" && active_game >= 0 && web_games[active_game].title == "Farm" {
        if request == "entrance" { web_farm_entrance = true }
        if request == "garden" { web_farm_entrance = false }
        return ifx web_farm_entrance then "entrance" else "garden"
    }
    if name == "jungle.secondary" { return ifx IsMouseButtonDown(1) then "down" else "up" }
    if name == "jungle.sound" || name == "jungle.voice" {
        PlayAudio(request, name == "jungle.voice")
        return "played"
    }
    if name == "jungle.canvas" { return CanvasImage(request) }
    if name == "jungle.paint-ops" {
        same := PaintViewOpsSame(request)
        ok := PaintViewOpsSet(request, PaintViewWebRead)
        return ifx !ok then "failed" else ifx same then "same" else "changed"
    }
    if name == "jungle.paint-colors" { return CanvasColors(request) }
    if name == "jungle.paint-ink" { return CanvasInk(request, 0) }
    if name == "jungle.paint-tile" { return CanvasInk(request, 1) }
    if name == "jungle.touches" { return WebReply(WebPaintTouches()) }
    if name == "jungle.paint-preview" { return CanvasImage(request, true) }
    if name == "jungle.export" || name == "jungle.print" { return WebExport(request, name == "jungle.print") }
    return "{\"status\":\"unavailable\"}"
}

UpdateSiteLanguage :: () {
    scope := WebScope()
    defer WebEnd(scope)
    unused WebCall1(WebModule, WebName("jungleLanguage"), WebText(LanguageCode()))
}

// Never identify or frame a game until its complete activity is ready.
OpenGame :: (index: s32) {
    StopAudio()
    web_loading_game = index
}

WebActivityReady :: (index: s32) -> s32 {
    scope := WebScope()
    defer WebEnd(scope)
    return cast(s32)WebAsNumber(WebCall5(WebModule, WebName("jungleActivityReady"), WebNumber(cast(float64)index),
        WebText(LanguageCode()), WebText(english_speech_profile), WebText(Tr(web_games[index].title)), WebText(title_book_requested)))
}

BeginGame :: (index: s32) {
    abc_title_speed = 1; web_speed_pending = false
    WebKeyboard(false)
    selected = index
    active_game = index
    TitleExplorationGame(web_games[index].title)
    WebExplorationSave()
    web_farm_entrance = true
    web_loading_game = -1
    scope := WebScope()
    defer WebEnd(scope)
    unused WebCall1(WebModule, WebName("jungleActivityStarted"), WebNumber(cast(float64)index))
    Runner.canvas_app_mode = APP_IDENTIFY
    unused RunGame()
    Runner.canvas_app_mode = APP_FRAME
    PlayAudio("assets/jungle/sounds/start.wav", false)
    // The web game index is the catalog's, as the award table's is.
    if AwardGrant(*awards_earned, index) {
        WebAwardsSave()
        AwardShowBegin(*award_show, index)
        PlayAudio(TITLE_PAPER_CHIME, false)
    }
}

#program_export
JungleMain :: () -> s64 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        SetExitKey(0)
        AppIdentity("jungle", 1)
        AppDescribe("Jungle Academy", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE { return cast(s64)RunGame() }
    if mode != APP_FRAME { return 0 }
    if !web_initialized {
        unused JungleCursorsSet()
        LanguageSet(Runner.DocumentReadHost("settings/language.txt"))
        SpeechProfileSet(Runner.DocumentReadHost("settings/speech-profile.txt"))
        web_muted = Runner.DocumentReadHost("settings/sound.txt") == "off"
        web_title_guide_muted = Runner.DocumentReadHost("settings/guide-sound.txt") == "off"
        web_title_guide_seen = Runner.DocumentReadHost("settings/guide-seen.txt") == "yes"
        web_collection = CollectionParse(Runner.DocumentReadHost("settings/collection.txt"))
        awards_earned = AwardsParse(Runner.DocumentReadHost("settings/awards.txt"))
        toucan_treasure = TreasureParse(Runner.DocumentReadHost("settings/treasure.txt"))
        // A game that saved before awards existed has its folder: its award
        // comes quietly.
        opened: [AWARD_COUNT]bool
        for index: cast(s32)0..AWARD_COUNT - 1 {
            opened[index] = PathExists(Cat(Runner.canvas_app_files.root, "/", award_apps[index]))
        }
        if AwardsMigrate(*awards_earned, opened[:]) > 0 { WebAwardsSave() }
        title_exploration = ExplorationParse(Runner.DocumentReadHost("settings/explored.txt"))
        for index: cast(s32)0..AWARD_COUNT - 1 {
            if opened[index] || awards_earned.earned[index] { TitleExplorationGame(web_games[index].title) }
        }
        WebExplorationSave()
        UpdateSiteLanguage()
        web_initialized = true
    }
    key := AppKey()
    if web_loading_game >= 0 {
        // A new game's award picture loads with it, ready for its celebration.
        if web_loading_game < AWARD_COUNT && !awards_earned.earned[web_loading_game] { AwardPictureWarm(web_loading_game) }
        status := WebActivityReady(web_loading_game)
        if status == -1 {
            web_loading_game = -1
            scope := WebScope()
            defer WebEnd(scope)
            unused WebCall0(WebModule, WebName("junglePreloadReset"))
        } else if status == 1 { BeginGame(web_loading_game) }
        return 0
    }
    if active_game >= 0 {
        status := WebActivityReady(active_game)
        if status == -1 {
            Runner.canvas_app_mode = APP_SAVE
            unused RunGame()
            Runner.canvas_app_mode = APP_FRAME
            StopAudio()
            WebKeyboard(false)
            active_game = -1
            scope := WebScope()
            defer WebEnd(scope)
            unused WebCall0(WebModule, WebName("junglePreloadReset"))
        }
        if status != 1 { StopAudio(); return 0 }
    }
    // Games share this session; only a drawing game keeps its own cursor.
    if collection_book_open || active_game < 0 { unused CursorSet(AppSession(), .{}) }
    if collection_book_open {
        if CollectionBookFrame(AppSession(), AppBounds(), key, AppNow(), web_muted, *web_collection) { ToggleAudio() }
        return 0
    }
    if treasure_chest_open {
        if TreasureChestFrame(AppSession(), AppBounds(), key, AppNow(), web_muted, *toucan_treasure) { ToggleAudio() }
        return 0
    }
    toucan_today = TreasureToday()
    if active_game < 0 {
        if !title_state.started { TitleStart(*title_state) }
        TitleResolve(*title_state, AppBounds().width, AppBounds().height)
        scope := WebScope()
        defer WebEnd(scope)
        scene_status := cast(s32)WebAsNumber(WebCall2(WebModule, WebName("jungleSceneReady"), WebText(TITLE_SCENE_IMAGE[title_state.scene]),
            WebText(TitleScenePlace(title_state.scene))))
        if scene_status == -1 {
            TitleStart(*title_state)
            unused WebCall0(WebModule, WebName("junglePreloadReset"))
        }
        if scene_status != 1 { return 0 }
        action := JungleMenu(AppSession(), AppBounds(), key, AppNow(), "assets/jungle/font.png", web_games[:],
            *selected, web_muted, web_title_guide_muted, web_title_guide_seen, "", *web_collection, WebTitlePaperCollect)
        WebExplorationSave()
        if action.paper_collected { PlayAudio(TITLE_PAPER_CHIME, false) }
        if web_title_guide && (action.guide_stop || action.language_changed ||
            (action.guide_mute_toggle && !web_title_guide_muted)) {
            StopAudio()
            web_title_guide = false
        }
        if action.guide_voice != "" { PlayAudio(action.guide_voice, true); web_title_guide = true }
        if action.language_changed { unused Runner.DocumentWriteHost("settings/language.txt", LanguageCode()); UpdateSiteLanguage() }
        if action.guide_mute_toggle {
            web_title_guide_muted = !web_title_guide_muted
            unused Runner.DocumentWriteHost("settings/guide-sound.txt", ifx web_title_guide_muted then "off" else "on")
        }
        if action.guide_finished { unused Runner.DocumentWriteHost("settings/guide-seen.txt", "yes") }
        if action.sound_toggle { ToggleAudio() }
        if action.navigated { PlayAudio("assets/jungle/sounds/select.wav", false) }
        if action.locked_cue { PlayAudio(TITLE_NOT_YET_CUE, false) }
        if action.collection_open { CollectionBookOpen(); StopAudio(); web_title_guide = false }
        if action.chest_open { TreasureChestOpen(); StopAudio(); web_title_guide = false }
        if toucan_claimed { toucan_claimed = false; WebTreasureSave(); PlayAudio(TITLE_PAPER_CHIME, false) }
        if action.game >= 0 { OpenGame(action.game) }
    } else {
        if key == 299 {
            ToggleAudio()
            Runner.canvas_app_key = 0
            key = 0
        }
        if web_back_pending && key == 0 { key = 256; Runner.canvas_app_key = 256; web_back_pending = false }
        if web_speed_pending && key == 0 { key = ABC_SPEED_KEY; Runner.canvas_app_key = key; web_speed_pending = false }
        full_bounds := Runner.canvas_app_bounds
        full_scene := GameFullScene(web_games[active_game].title)
        Runner.canvas_app_bounds = GameContentBounds(full_bounds, web_games[active_game].title)
        unused RunGame()
        Runner.canvas_app_bounds = full_bounds
        if full_scene {
            if GameSceneBack(AppSession(), full_bounds, key, AppNow()) { web_back_pending = true }
            AwardShowFrame(AppSession(), full_bounds, 0, AwardCornerTarget(full_bounds), true, AppNow())
        } else {
            bar := GameTitleBar(AppSession(), full_bounds, key, AppNow(), web_games[active_game].title, web_muted)
            if bar.collection_open { CollectionBookOpen(); StopAudio() }
            if bar.back { web_back_pending = true }
            if bar.speed_toggle { web_speed_pending = true }
            if bar.sound_toggle { ToggleAudio() }
            AwardShowFrame(AppSession(), full_bounds, GAME_BAR_HEIGHT,
                ifx bar.collection_shown then bar.collection else AwardCornerTarget(full_bounds), !bar.collection_shown, AppNow())
        }
        if web_home {
            Runner.canvas_app_mode = APP_SAVE
            unused RunGame()
            Runner.canvas_app_mode = APP_FRAME
            StopAudio()
            WebKeyboard(false)
            active_game = -1
            web_home = false
            if web_scene_from_game >= 0 {
                unused TitleOpenSceneFromGame(*title_state, web_scene_from_game)
                web_scene_from_game = -1
            }
        }
    }
    return 0
}
